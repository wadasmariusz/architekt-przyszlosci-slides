---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 19 - Consumer odporny na kolejność"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.82), rgba(10,14,23,0.92))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="cooGrid19" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="cooGlow19" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="66%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#cooGrid19)"/>
    <circle cx="960" cy="540" r="540" fill="url(#cooGlow19)"/>
  </svg>

  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-shield-check"></i>Rozwiązanie #2</span>
      <h1 class="title">
        Consumer <span class="highlight">odporny na kolejność</span>
      </h1>
    </div>

    <section class="decision" aria-label="Schemat decyzyjny consumera">
      <article class="dec-node dec-receive">
        <div class="dec-ic"><i class="ti ti-mail-forward"></i></div>
        <h3>Event arrives</h3>
        <span class="dec-meta">dowolna kolejność</span>
      </article>

      <div class="dec-arrow" aria-hidden="true"><i class="ti ti-arrow-right"></i></div>

      <article class="dec-diamond" aria-label="Decyzja">
        <div class="diamond-inner">
          <span class="diamond-q">Czy poprzedni stan istnieje?</span>
        </div>
      </article>

      <div class="dec-branches" aria-label="Gałęzie decyzji">
        <div class="branch branch--yes">
          <span class="branch-tag">tak</span>
          <article class="branch-node branch-node--process">
            <div class="dec-ic"><i class="ti ti-player-play"></i></div>
            <h3>Przetwarzaj</h3>
            <span class="dec-meta">apply state change</span>
          </article>
        </div>

        <div class="branch branch--no">
          <span class="branch-tag">nie</span>
          <article class="branch-node branch-node--pending">
            <div class="dec-ic"><i class="ti ti-hourglass-low"></i></div>
            <h3>Odłóż do pending</h3>
            <span class="dec-meta">retry później</span>
          </article>
        </div>
      </div>
    </section>

    <section class="mechanisms" aria-label="Potrzebne mechanizmy">
      <header class="mechanisms-head">
        <i class="ti ti-tools"></i>
        <h2>Potrzebne mechanizmy</h2>
      </header>
      <ul class="mechanisms-list">
        <li>
          <span class="mech-ic"><i class="ti ti-versions"></i></span>
          <span class="mech-text"><strong>Wersja stanu</strong></span>
        </li>
        <li>
          <span class="mech-ic"><i class="ti ti-search"></i></span>
          <span class="mech-text"><strong>Sprawdzenie poprzednika</strong></span>
        </li>
        <li>
          <span class="mech-ic"><i class="ti ti-list-check"></i></span>
          <span class="mech-text"><strong>Kolejka oczekujących</strong></span>
        </li>
      </ul>
    </section>

    <div class="tradeoff" role="note">
      <i class="ti ti-arrows-right-left"></i>
      <p>
        <strong>Trade-off:</strong> większa elastyczność, ale <em>wyższy koszt utrzymania</em>
      </p>
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1660px;
    padding: 34px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 22px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 14px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 70px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 6px;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .decision {
    width: 100%;
    max-width: 1560px;
    display: grid;
    grid-template-columns: 1fr auto 1fr 1fr;
    align-items: center;
    gap: 18px;
    margin-bottom: 22px;
    padding: 24px 24px;
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.32);
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.55s forwards;
  }

  .dec-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 18px 14px;
    min-height: 180px;
    background: rgba(17, 24, 39, 0.5);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 16px;
  }

  .dec-receive {
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.18), rgba(17, 24, 39, 0.55));
    border-color: rgba(34, 211, 238, 0.42);
  }

  .dec-ic {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dec-ic i {
    font-size: 32px;
    color: var(--cyan-400);
  }

  .dec-node h3,
  .branch-node h3 {
    margin: 0;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.3px;
    line-height: 1.1;
    color: #f0f4f8;
  }

  .dec-meta {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 14px;
    font-weight: 700;
    color: rgba(148, 163, 184, 0.95);
    letter-spacing: 0.5px;
  }

  .dec-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
  }

  .dec-arrow i {
    font-size: 34px;
    color: rgba(34, 211, 238, 0.7);
  }

  .dec-diamond {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 180px;
  }

  .diamond-inner {
    position: relative;
    width: 240px;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(45deg);
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.20), rgba(17, 24, 39, 0.7));
    border: 2px solid rgba(34, 211, 238, 0.55);
    border-radius: 16px;
    box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.05), 0 18px 48px rgba(8, 145, 178, 0.22);
  }

  .diamond-q {
    transform: rotate(-45deg);
    max-width: 200px;
    text-align: center;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.2px;
    color: #e2f6ff;
  }

  .dec-branches {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 12px;
  }

  .branch {
    display: grid;
    grid-template-columns: 64px 1fr;
    align-items: center;
    gap: 14px;
  }

  .branch-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .branch--yes .branch-tag {
    background: rgba(34, 197, 94, 0.16);
    border: 1px solid rgba(34, 197, 94, 0.55);
    color: #d1fae5;
  }

  .branch--no .branch-tag {
    background: rgba(251, 191, 36, 0.16);
    border: 1px solid rgba(251, 191, 36, 0.55);
    color: #fde68a;
  }

  .branch-node {
    display: grid;
    grid-template-columns: 60px 1fr;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-radius: 14px;
    background: rgba(17, 24, 39, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.22);
    text-align: left;
  }

  .branch-node .dec-ic {
    width: 56px;
    height: 56px;
    border-radius: 14px;
  }

  .branch-node .dec-ic i { font-size: 28px; }

  .branch-node--process {
    border-color: rgba(34, 197, 94, 0.5);
    background: linear-gradient(135deg, rgba(20, 83, 45, 0.20), rgba(17, 24, 39, 0.55));
  }

  .branch-node--process .dec-ic {
    background: rgba(34, 197, 94, 0.14);
    border-color: rgba(74, 222, 128, 0.55);
  }

  .branch-node--process .dec-ic i { color: #4ade80; }

  .branch-node--pending {
    border-color: rgba(251, 191, 36, 0.5);
    background: linear-gradient(135deg, rgba(120, 53, 15, 0.22), rgba(17, 24, 39, 0.55));
  }

  .branch-node--pending .dec-ic {
    background: rgba(251, 191, 36, 0.14);
    border-color: rgba(251, 191, 36, 0.55);
  }

  .branch-node--pending .dec-ic i { color: #fbbf24; }

  .branch-node-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mechanisms {
    width: 100%;
    max-width: 1560px;
    padding: 18px 22px;
    margin-bottom: 18px;
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.14), rgba(17, 24, 39, 0.6));
    border: 1px solid rgba(34, 211, 238, 0.42);
    border-radius: 16px;
    box-shadow: 0 14px 36px rgba(8, 145, 178, 0.15);
    text-align: left;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.05s forwards;
  }

  .mechanisms-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(34, 211, 238, 0.28);
  }

  .mechanisms-head i {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 11px;
    background: rgba(34, 211, 238, 0.16);
    border: 1px solid rgba(34, 211, 238, 0.55);
    color: var(--cyan-400);
    font-size: 22px;
  }

  .mechanisms-head h2 {
    margin: 0;
    font-size: 22px;
    font-weight: 800;
    color: #e2f6ff;
    letter-spacing: -0.3px;
  }

  .mechanisms-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .mechanisms-list li {
    display: grid;
    grid-template-columns: 46px 1fr;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-radius: 12px;
    background: rgba(17, 24, 39, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.20);
  }

  .mech-ic {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 11px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
  }

  .mech-ic i { font-size: 22px; }

  .mech-text {
    font-size: 19px;
    font-weight: 600;
    color: #e2e8f0;
    line-height: 1.2;
  }

  .mech-text strong {
    color: #fff;
    font-weight: 800;
  }

  .tradeoff {
    width: auto;
    max-width: 1500px;
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 16px 24px;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(180, 83, 9, 0.20), rgba(17, 24, 39, 0.62));
    border: 1px solid rgba(251, 191, 36, 0.5);
    box-shadow: 0 14px 36px rgba(180, 83, 9, 0.22);
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.3s forwards;
  }

  .tradeoff > i {
    width: 52px;
    height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 13px;
    background: rgba(251, 191, 36, 0.16);
    border: 1px solid rgba(251, 191, 36, 0.55);
    color: #fbbf24;
    font-size: 28px;
    flex-shrink: 0;
  }

  .tradeoff p {
    margin: 0;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.3;
    color: #fff7ed;
    text-align: left;
  }

  .tradeoff strong {
    color: #fbbf24;
    font-weight: 900;
  }

  .tradeoff em {
    font-style: normal;
    color: #fde68a;
    font-weight: 800;
  }

  @media (max-width: 1300px) {
    .title {
      font-size: 50px;
    }

    .decision {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .dec-arrow {
      width: 100%;
      transform: rotate(90deg);
    }

    .dec-diamond { transform: scale(0.85); }

    .mechanisms-list { grid-template-columns: 1fr; }

    .tradeoff p { font-size: 19px; }
  }

  @media (max-width: 700px) {
    .content {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }

    .title {
      font-size: 38px;
    }

    .diamond-inner {
      width: 200px;
      height: 130px;
    }

    .diamond-q {
      font-size: 15px;
      max-width: 170px;
    }

    .mech-text {
      font-size: 17px;
    }
  }
</style>
</content>
</invoke>