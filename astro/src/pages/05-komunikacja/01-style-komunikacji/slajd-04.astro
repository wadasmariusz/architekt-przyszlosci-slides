---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 04 - Krytyczne okno awarii"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.82), rgba(10,14,23,0.92))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="crashGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.06)" stroke-width="1"/>
      </pattern>
      <radialGradient id="crashGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#f87171" stop-opacity="0.16"/>
        <stop offset="70%" stop-color="#f87171" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#f87171" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#crashGrid)"/>
    <circle cx="1100" cy="540" r="520" fill="url(#crashGlow)"/>
  </svg>

  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-bolt"></i>Awaria</span>
      <h1 class="title">
        Krytyczne <span class="highlight">Okno Awarii</span>
      </h1>
    </div>

    <section class="timeline" aria-label="Oś czasu awarii">
      <ol class="tl-list">
        <li class="tl-step">
          <span class="tl-dot"></span>
          <span class="tl-num">1</span>
          <span class="tl-label">Message received</span>
        </li>
        <li class="tl-step">
          <span class="tl-dot"></span>
          <span class="tl-num">2</span>
          <span class="tl-label">Stripe charged</span>
        </li>
        <li class="tl-step">
          <span class="tl-dot"></span>
          <span class="tl-num">3</span>
          <span class="tl-label">Local state saved</span>
        </li>
        <li class="tl-step tl-step--crash">
          <span class="tl-dot"></span>
          <span class="tl-num">4</span>
          <span class="tl-label">Crash</span>
          <span class="tl-badge">Crash before ACK</span>
        </li>
        <li class="tl-step tl-step--missing">
          <span class="tl-dot"></span>
          <span class="tl-num">5</span>
          <span class="tl-label">ACK not sent</span>
        </li>
      </ol>
    </section>

    <ul class="facts" aria-label="Stan systemu w momencie awarii">
      <li>
        <i class="ti ti-credit-card"></i>
        <span>Płatność została wykonana</span>
      </li>
      <li>
        <i class="ti ti-database"></i>
        <span>Stan lokalny mógł zostać zapisany</span>
      </li>
      <li>
        <i class="ti ti-send-off"></i>
        <span>Consumer nie zdążył wysłać ACK</span>
      </li>
      <li>
        <i class="ti ti-question-mark"></i>
        <span>Broker nadal nie ma pewności, że wiadomość została obsłużona</span>
      </li>
    </ul>
    
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 48px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 28px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 88px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 16px;
  }

  .title .highlight {
    background: linear-gradient(135deg, #fb7185, #f87171);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .timeline {
    width: 100%;
    max-width: 1500px;
    margin-bottom: 44px;
    padding: 28px 24px 24px;
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.32);
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.55s forwards;
  }

  .tl-list {
    list-style: none;
    margin: 0;
    padding: 24px 12px 6px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    position: relative;
  }

  .tl-list::before {
    content: '';
    position: absolute;
    top: 38px;
    left: 6%;
    right: 6%;
    height: 2px;
    background: linear-gradient(90deg, rgba(34, 211, 238, 0.45), rgba(248, 113, 113, 0.65));
    border-radius: 2px;
    z-index: 0;
  }

  .tl-step {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 12px 8px;
    text-align: center;
    opacity: 0;
    animation: fadeUp 0.7s ease-out forwards;
  }

  .tl-list > .tl-step:nth-child(1) { animation-delay: 0.7s; }
  .tl-list > .tl-step:nth-child(2) { animation-delay: 0.82s; }
  .tl-list > .tl-step:nth-child(3) { animation-delay: 0.94s; }
  .tl-list > .tl-step:nth-child(4) { animation-delay: 1.06s; }
  .tl-list > .tl-step:nth-child(5) { animation-delay: 1.18s; }

  .tl-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--cyan-400);
    border: 4px solid rgba(34, 211, 238, 0.20);
    box-shadow: 0 0 0 4px rgba(10, 14, 23, 0.9);
  }

  .tl-num {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 2px;
    color: rgba(148, 163, 184, 0.75);
    font-variant-numeric: tabular-nums;
  }

  .tl-label {
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
    color: #e2e8f0;
    letter-spacing: -0.2px;
  }

  .tl-step--crash .tl-dot {
    background: #f87171;
    border-color: rgba(248, 113, 113, 0.30);
    box-shadow:
      0 0 0 4px rgba(10, 14, 23, 0.9),
      0 0 24px rgba(248, 113, 113, 0.7);
    animation: crashPulse 1.6s ease-in-out infinite;
  }

  .tl-step--crash .tl-label,
  .tl-step--crash .tl-num {
    color: #fecaca;
  }

  .tl-badge {
    margin-top: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(248, 113, 113, 0.18);
    border: 1px solid rgba(248, 113, 113, 0.55);
    color: #fecaca;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .tl-step--missing .tl-dot {
    background: transparent;
    border-color: rgba(148, 163, 184, 0.55);
  }

  .tl-step--missing .tl-label,
  .tl-step--missing .tl-num {
    color: rgba(203, 213, 225, 0.7);
    font-style: italic;
  }

  .facts {
    list-style: none;
    margin: 0 0 36px;
    padding: 0;
    width: 100%;
    max-width: 1500px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 22px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.3s forwards;
  }

  .facts li {
    display: grid;
    grid-template-columns: 56px 1fr;
    align-items: center;
    gap: 18px;
    padding: 18px 22px;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 14px;
    text-align: left;
  }

  .facts li i {
    width: 48px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 26px;
  }

  .facts li span {
    font-size: 24px;
    font-weight: 500;
    line-height: 1.3;
    color: #e2e8f0;
    letter-spacing: -0.2px;
  }

  .note {
    width: auto;
    max-width: 1400px;
    display: inline-flex;
    gap: 22px;
    align-items: center;
    justify-content: flex-start;
    margin: 0 auto;
    padding: 22px 30px;
    background: linear-gradient(135deg, rgba(180, 83, 9, 0.22), rgba(120, 53, 15, 0.08));
    border: 1px solid rgba(251, 191, 36, 0.45);
    border-radius: 16px;
    box-shadow: 0 18px 48px rgba(180, 83, 9, 0.18);
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.55s forwards;
  }

  .note > i {
    width: 60px;
    height: 60px;
    border-radius: 14px;
    background: rgba(251, 191, 36, 0.16);
    border: 1px solid rgba(251, 191, 36, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    color: #fbbf24;
    flex-shrink: 0;
  }

  .note-body {
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .note-eyebrow {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(251, 191, 36, 0.85);
  }

  .note-main {
    margin: 0;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.3;
    color: #fff7ed;
  }

  .note-main .accent {
    color: #fbbf24;
    font-weight: 700;
  }

  @keyframes crashPulse {
    0%, 100% {
      box-shadow:
        0 0 0 4px rgba(10, 14, 23, 0.9),
        0 0 24px rgba(248, 113, 113, 0.7);
    }
    50% {
      box-shadow:
        0 0 0 4px rgba(10, 14, 23, 0.9),
        0 0 38px rgba(248, 113, 113, 0.95);
    }
  }

  @media (max-width: 1300px) {
    .title {
      font-size: 60px;
    }

    .tl-list {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .tl-list::before {
      display: none;
    }

    .tl-step {
      flex-direction: row;
      justify-content: flex-start;
      gap: 16px;
      text-align: left;
    }

    .tl-label {
      font-size: 22px;
    }

    .facts {
      grid-template-columns: 1fr;
    }

    .facts li span {
      font-size: 20px;
    }

    .note-main {
      font-size: 20px;
    }
  }

  @media (max-width: 700px) {
    .content {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }

    .title {
      font-size: 42px;
    }

    .eyebrow {
      font-size: 16px;
      letter-spacing: 4px;
    }

    .facts li {
      grid-template-columns: 44px 1fr;
      gap: 14px;
      padding: 14px 16px;
    }

    .facts li i {
      width: 40px;
      height: 40px;
      font-size: 22px;
    }

    .facts li span {
      font-size: 18px;
    }
  }
</style>
