---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 25 - TraceId w eventach"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.82), rgba(10,14,23,0.92))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="traceGrid25" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="traceGlow25" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="66%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#traceGrid25)"/>
    <circle cx="960" cy="540" r="540" fill="url(#traceGlow25)"/>
  </svg>

  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-route"></i>Observability</span>
      <h1 class="title">
        TraceId <span class="highlight">w eventach</span>
      </h1>
    </div>

    <section class="trace-board" aria-label="Rozproszony trace przez HTTP, kolejki i handlery">
      <header class="trace-banner">
        <span class="banner-label">wspólny</span>
        <code class="banner-id"><span class="key">TraceId</span> = <span class="val">abc-123</span></code>
        <div class="banner-line" aria-hidden="true"></div>
      </header>

      <ol class="trace-flow" aria-label="Etapy trace'a">
        <li class="hop hop--http">
          <div class="hop-ic"><i class="ti ti-world"></i></div>
          <h3>HTTP request</h3>
        </li>
        <li class="hop-arrow" aria-hidden="true"><i class="ti ti-arrow-right"></i></li>
        <li class="hop hop--publish">
          <div class="hop-ic"><i class="ti ti-send"></i></div>
          <h3>Publish event</h3>
        </li>
        <li class="hop-arrow" aria-hidden="true"><i class="ti ti-arrow-right"></i></li>
        <li class="hop hop--queue">
          <div class="hop-ic"><i class="ti ti-stack-2"></i></div>
          <h3>Queue</h3>
        </li>
        <li class="hop-arrow" aria-hidden="true"><i class="ti ti-arrow-right"></i></li>
        <li class="hop hop--consumer">
          <div class="hop-ic"><i class="ti ti-cpu"></i></div>
          <h3>Consumer A</h3>
        </li>
        <li class="hop-arrow" aria-hidden="true"><i class="ti ti-arrow-right"></i></li>
        <li class="hop hop--publish">
          <div class="hop-ic"><i class="ti ti-send"></i></div>
          <h3>Publish next event</h3>
        </li>
        <li class="hop-arrow" aria-hidden="true"><i class="ti ti-arrow-right"></i></li>
        <li class="hop hop--consumer">
          <div class="hop-ic"><i class="ti ti-cpu"></i></div>
          <h3>Consumer B</h3>
        </li>
      </ol>
    </section>

    <ul class="points" aria-label="Zasady propagacji TraceId">
      <li>
        <i class="ti ti-route"></i>
        <span>Propaguj <code>TraceId</code> i <code>ParentId</code> w <strong>metadanych wiadomości</strong></span>
      </li>
      <li>
        <i class="ti ti-link"></i>
        <span>Łącz <strong>HTTP, kolejki i handlery</strong> w jeden trace</span>
      </li>
      <li>
        <i class="ti ti-file-text"></i>
        <span>Loguj <code>TraceId</code> podczas <strong>przetwarzania eventu</strong></span>
      </li>
      <li class="points-good">
        <i class="ti ti-target-arrow"></i>
        <span><strong>Cel:</strong> widoczna pełna ścieżka procesu biznesowego</span>
      </li>
    </ul>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1700px;
    padding: 34px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 22px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 18px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 14px;
  }

  .level-chip i { font-size: 20px; }

  .title {
    font-size: 84px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0 0 8px;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .trace-board {
    width: 100%;
    max-width: 1640px;
    margin-bottom: 24px;
    padding: 22px 22px 26px;
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.32);
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.55s forwards;
  }

  .trace-banner {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 22px;
    margin: 0 auto 50px;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.28), rgba(17, 24, 39, 0.7));
    border: 1px solid rgba(34, 211, 238, 0.6);
    box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.06), 0 14px 36px rgba(8, 145, 178, 0.25);
  }

  .banner-label {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(165, 243, 252, 0.95);
  }

  .banner-id {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 22px;
    font-weight: 900;
    letter-spacing: 0.5px;
  }

  .banner-id .key { color: #a5f3fc; }
  .banner-id .val { color: var(--cyan-400); text-shadow: 0 0 18px rgba(34, 211, 238, 0.5); }

  .banner-line {
    position: absolute;
    top: 100%;
    left: 50%;
    width: 2px;
    height: 22px;
    background: linear-gradient(180deg, rgba(34, 211, 238, 0.85), rgba(34, 211, 238, 0));
    transform: translateX(-50%);
  }

  .trace-flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 6px;
    position: relative;
  }

  .trace-flow::before {
    content: '';
    position: absolute;
    top: -22px;
    left: 8%;
    right: 8%;
    height: 2px;
    background: linear-gradient(90deg,
      rgba(34, 211, 238, 0.0),
      rgba(34, 211, 238, 0.5),
      rgba(34, 211, 238, 0.5),
      rgba(34, 211, 238, 0.0)
    );
  }

  .hop {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 8px;
    min-height: 156px;
    background: rgba(17, 24, 39, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 14px;
  }

  .hop-ic {
    width: 60px;
    height: 60px;
    border-radius: 15px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hop-ic i {
    font-size: 30px;
    color: var(--cyan-400);
  }

  .hop h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.15;
    color: #f0f4f8;
    text-align: center;
  }

  .hop--http {
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.16), rgba(17, 24, 39, 0.55));
    border-color: rgba(168, 85, 247, 0.45);
  }

  .hop--http .hop-ic {
    background: rgba(168, 85, 247, 0.14);
    border-color: rgba(168, 85, 247, 0.5);
  }

  .hop--http .hop-ic i { color: #c4b5fd; }

  .hop--queue {
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.18), rgba(17, 24, 39, 0.6));
    border-color: rgba(34, 211, 238, 0.5);
    box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.05);
  }

  .hop--publish {
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.14), rgba(17, 24, 39, 0.55));
    border-color: rgba(251, 191, 36, 0.42);
  }

  .hop--publish .hop-ic {
    background: rgba(251, 191, 36, 0.14);
    border-color: rgba(251, 191, 36, 0.5);
  }

  .hop--publish .hop-ic i { color: #fbbf24; }

  .hop--consumer {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.16), rgba(17, 24, 39, 0.55));
    border-color: rgba(34, 197, 94, 0.45);
  }

  .hop--consumer .hop-ic {
    background: rgba(34, 197, 94, 0.14);
    border-color: rgba(74, 222, 128, 0.55);
  }

  .hop--consumer .hop-ic i { color: #4ade80; }

  .hop-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
  }

  .hop-arrow i {
    font-size: 22px;
    color: rgba(34, 211, 238, 0.7);
  }

  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 1640px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px 18px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.05s forwards;
  }

  .points li {
    display: grid;
    grid-template-columns: 52px 1fr;
    align-items: center;
    gap: 18px;
    padding: 16px 22px;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 14px;
    text-align: left;
  }

  .points li > i {
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 24px;
  }

  .points li span {
    font-size: 26px;
    font-weight: 500;
    line-height: 1.3;
    color: #e2e8f0;
    letter-spacing: 0;
  }

  .points li code {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 20px;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: 8px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
  }

  .points li strong {
    color: #fff;
    font-weight: 800;
  }

  .points-good {
    border-color: rgba(34, 197, 94, 0.5);
    background: linear-gradient(135deg, rgba(20, 83, 45, 0.22), rgba(17, 24, 39, 0.6));
  }

  .points-good > i {
    background: rgba(34, 197, 94, 0.16);
    border-color: rgba(74, 222, 128, 0.55);
    color: #4ade80;
  }

  .points-good span {
    color: #f0fdf4;
  }

  .points-good strong {
    color: #d1fae5;
  }

  @media (max-width: 1300px) {
    .title {
      font-size: 56px;
    }

    .trace-flow {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .trace-flow::before { display: none; }

    .hop-arrow {
      width: 100%;
      transform: rotate(90deg);
    }

    .points {
      grid-template-columns: 1fr;
    }

    .points li span {
      font-size: 19px;
    }
  }

  @media (max-width: 700px) {
    .content {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }

    .title {
      font-size: 42px;
    }

    .banner-id {
      font-size: 18px;
    }

    .hop h3 {
      font-size: 16px;
    }

    .points li {
      grid-template-columns: 40px 1fr;
      gap: 14px;
      padding: 14px 16px;
    }

    .points li > i {
      width: 40px;
      height: 40px;
      font-size: 22px;
    }

    .points li span {
      font-size: 17px;
    }
  }
</style>
</content>
</invoke>