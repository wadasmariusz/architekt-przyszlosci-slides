---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 13 - Drugie wyzwanie: kolejność"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.84), rgba(10,14,23,0.94))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="orderGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="orderGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.16"/>
        <stop offset="66%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#orderGrid)"/>
    <circle cx="960" cy="520" r="560" fill="url(#orderGlow)"/>
  </svg>

  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-arrows-shuffle"></i>Drugie Wyzwanie</span>
      <h1 class="title">Kolejność zdarzeń</h1>
      <p class="claim">
        <span>Delivery order</span>
        <strong>≠</strong>
        <span>processing order</span>
      </p>
    </div>

    <section class="storyboard" aria-label="Kolejność zdarzeń płatności i równoległe przetwarzanie">
      <article class="lane lane--domain">
        <header class="lane-head">
          <i class="ti ti-credit-card"></i>
          <div>
            <span>Biznes</span>
            <h2>Logiczna sekwencja</h2>
          </div>
        </header>

        <ol class="event-track event-track--domain">
          <li>
            <span class="step">1</span>
            <code>PaymentInitialized</code>
          </li>
          <li>
            <span class="step">2</span>
            <code>PaymentPaid</code>
          </li>
          <li>
            <span class="step">3</span>
            <code>PaymentRefunded</code>
          </li>
        </ol>

      </article>

      <article class="consumer-panel" aria-label="Skąd bierze się zmiana kolejności">
        <header class="lane-head lane-head--center">
          <i class="ti ti-stack-2"></i>
          <div>
            <span>System asynchroniczny</span>
            <h2>Broker + consumer pool</h2>
          </div>
        </header>

        <div class="dispatch" aria-hidden="true">
          <span class="message message--one">M1</span>
          <span class="message message--two">M2</span>
          <span class="message message--three">M3</span>
          <div class="broker">
            <i class="ti ti-route"></i>
            <span>topic / queue</span>
          </div>
        </div>

        <div class="consumer-stack">
          <div class="consumer-row consumer-row--slow">
            <span class="msg">M1</span>
            <span class="worker">Consumer A</span>
            <span class="delay">retry</span>
          </div>
          <div class="consumer-row consumer-row--mid">
            <span class="msg">M2</span>
            <span class="worker">Consumer B</span>
            <span class="delay">wolna zależność</span>
          </div>
          <div class="consumer-row consumer-row--fast">
            <span class="msg">M3</span>
            <span class="worker">Consumer C</span>
            <span class="delay">fast path</span>
          </div>
        </div>

        <ul class="factors" aria-label="Przyczyny zmiany kolejności">
          <li>równoległość</li>
          <li>retry</li>
          <li>opóźnienia</li>
        </ul>
      </article>

      <article class="lane lane--processing">
        <header class="lane-head">
          <i class="ti ti-clock-bolt"></i>
          <div>
            <span>Efekt</span>
            <h2>Kolejność obsługi</h2>
          </div>
        </header>

        <ol class="event-track event-track--processing">
          <li class="danger">
            <span class="step">1</span>
            <code>PaymentRefunded</code>
          </li>
          <li class="warn">
            <span class="step">2</span>
            <code>PaymentPaid</code>
          </li>
          <li class="danger">
            <span class="step">3</span>
            <code>PaymentInitialized</code>
          </li>
        </ol>

      </article>
    </section>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1660px;
    padding: 34px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 20px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 8px;
  }

  .level-chip i {
    font-size: 18px;
  }

  .title {
    font-size: 82px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0 0 40px;
  }

  .claim {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin: 0 0 20px;
    padding: 9px 22px;
    border: 1px solid rgba(34, 211, 238, 0.34);
    border-radius: 14px;
    background: rgba(17, 24, 39, 0.62);
    box-shadow: 0 18px 44px rgba(8, 145, 178, 0.16);
    color: rgba(226, 232, 240, 0.92);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.1;
  }

  .claim strong {
    color: var(--cyan-400);
    font-size: 34px;
    line-height: 0.8;
    text-shadow: 0 0 24px rgba(34, 211, 238, 0.6);
  }

  .storyboard {
    width: 100%;
    display: grid;
    grid-template-columns: 1.02fr 1.18fr 1.02fr;
    gap: 18px 20px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.55s forwards;
  }

  .lane,
  .consumer-panel {
    min-height: 392px;
    padding: 20px;
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.76), rgba(10, 14, 23, 0.64));
    border: 1px solid rgba(148, 163, 184, 0.22);
    text-align: left;
  }

  .lane--domain {
    border-color: rgba(34, 197, 94, 0.34);
  }

  .lane--processing {
    border-color: rgba(248, 113, 113, 0.38);
  }

  .consumer-panel {
    border-color: rgba(34, 211, 238, 0.38);
    background:
      linear-gradient(180deg, rgba(8, 145, 178, 0.14), rgba(10, 14, 23, 0.68));
  }

  .lane-head {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 14px;
    margin-bottom: 18px;
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
  }

  .lane-head i {
    width: 48px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    border-radius: 13px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.38);
    color: var(--cyan-400);
    font-size: 26px;
  }

  .lane--domain .lane-head i {
    color: #4ade80;
    border-color: rgba(74, 222, 128, 0.42);
    background: rgba(34, 197, 94, 0.12);
  }

  .lane--processing .lane-head i {
    color: #f87171;
    border-color: rgba(248, 113, 113, 0.46);
    background: rgba(248, 113, 113, 0.11);
  }

  .lane-head span {
    display: block;
    margin-bottom: 3px;
    color: rgba(148, 163, 184, 0.9);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .lane-head h2 {
    margin: 0;
    color: #f8fafc;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.05;
  }

  .event-track {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .event-track::before {
    content: '';
    position: absolute;
    top: 24px;
    bottom: 24px;
    left: 23px;
    width: 2px;
    background: linear-gradient(180deg, rgba(34, 197, 94, 0.75), rgba(34, 211, 238, 0.2));
  }

  .event-track--processing::before {
    background: linear-gradient(180deg, rgba(248, 113, 113, 0.76), rgba(251, 191, 36, 0.42));
  }

  .event-track li {
    position: relative;
    display: grid;
    grid-template-columns: 48px 1fr;
    align-items: center;
    gap: 14px;
    min-height: 62px;
    padding: 9px 12px 9px 0;
    border-radius: 14px;
    color: #e2e8f0;
  }

  .step {
    position: relative;
    z-index: 1;
    width: 48px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.94);
    border: 1px solid rgba(74, 222, 128, 0.55);
    color: #bbf7d0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 18px;
    font-weight: 900;
  }

  .event-track--processing .step {
    border-color: rgba(248, 113, 113, 0.58);
    color: #fecaca;
  }

  .event-track code {
    display: block;
    min-width: 0;
    padding: 13px 14px;
    overflow-wrap: anywhere;
    border-radius: 12px;
    background: rgba(2, 6, 23, 0.42);
    border: 1px solid rgba(148, 163, 184, 0.18);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 18px;
    font-weight: 800;
    color: #e5e7eb;
  }

  .event-track--domain code {
    border-color: rgba(74, 222, 128, 0.26);
    background: rgba(20, 83, 45, 0.16);
  }

  .event-track--processing .danger code {
    border-color: rgba(248, 113, 113, 0.34);
    background: rgba(127, 29, 29, 0.22);
    color: #fecaca;
  }

  .event-track--processing .warn code {
    border-color: rgba(251, 191, 36, 0.34);
    background: rgba(120, 53, 15, 0.2);
    color: #fde68a;
  }

  .lane-note {
    margin: 18px 0 0;
    color: rgba(226, 232, 240, 0.84);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.28;
  }

  .lane-note--danger {
    color: #fecaca;
  }

  .dispatch {
    position: relative;
    min-height: 84px;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .broker {
    width: 210px;
    height: 68px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 16px;
    background: rgba(8, 145, 178, 0.2);
    border: 1px solid rgba(34, 211, 238, 0.5);
    color: #cffafe;
    box-shadow: 0 0 34px rgba(34, 211, 238, 0.18);
  }

  .broker i {
    font-size: 28px;
    color: var(--cyan-400);
  }

  .broker span {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 16px;
    font-weight: 800;
  }

  .message {
    position: absolute;
    top: 2px;
    width: 42px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: rgba(2, 6, 23, 0.74);
    border: 1px solid rgba(148, 163, 184, 0.34);
    color: #f8fafc;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 15px;
    font-weight: 900;
  }

  .message--one {
    left: 78px;
  }

  .message--two {
    left: calc(50% - 21px);
    border-color: rgba(34, 211, 238, 0.42);
    color: #a5f3fc;
  }

  .message--three {
    right: 78px;
  }

  .consumer-stack {
    display: grid;
    gap: 11px;
    margin-bottom: 15px;
  }

  .consumer-row {
    display: grid;
    grid-template-columns: 46px 1fr auto;
    align-items: center;
    gap: 10px;
    min-height: 54px;
    padding: 8px 10px;
    border-radius: 13px;
    background: rgba(2, 6, 23, 0.38);
    border: 1px solid rgba(148, 163, 184, 0.18);
  }

  .consumer-row--fast {
    border-color: rgba(34, 197, 94, 0.35);
  }

  .consumer-row--mid {
    border-color: rgba(251, 191, 36, 0.3);
  }

  .consumer-row--slow {
    border-color: rgba(248, 113, 113, 0.34);
  }

  .msg {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: rgba(15, 23, 42, 0.9);
    border: 1px solid rgba(34, 211, 238, 0.32);
    color: #a5f3fc;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 15px;
    font-weight: 900;
  }

  .worker {
    color: #f8fafc;
    font-size: 18px;
    font-weight: 800;
  }

  .delay {
    justify-self: end;
    max-width: 130px;
    padding: 6px 9px;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.82);
    border: 1px solid rgba(148, 163, 184, 0.22);
    color: rgba(226, 232, 240, 0.9);
    font-size: 13px;
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
    text-transform: uppercase;
  }

  .consumer-row--fast .delay {
    color: #bbf7d0;
    border-color: rgba(74, 222, 128, 0.38);
  }

  .consumer-row--mid .delay {
    color: #fde68a;
    border-color: rgba(251, 191, 36, 0.34);
  }

  .consumer-row--slow .delay {
    color: #fecaca;
    border-color: rgba(248, 113, 113, 0.36);
  }

  .factors {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .factors li {
    min-width: 0;
    padding: 9px 8px;
    border-radius: 10px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.24);
    color: #cffafe;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.05;
    text-align: center;
  }

  .architect-rule {
    grid-column: 1 / 3;
    min-height: 72px;
    display: grid;
    grid-template-columns: 52px 1fr;
    align-items: center;
    gap: 16px;
    padding: 14px 22px;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.22), rgba(17, 24, 39, 0.72));
    border: 1px solid rgba(34, 211, 238, 0.46);
    text-align: left;
    box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.05);
  }

  .architect-rule i {
    width: 48px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 13px;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 25px;
  }

  .architect-rule p {
    margin: 0;
    color: #e2f6ff;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .architect-rule strong {
    color: var(--cyan-400);
    font-weight: 900;
  }

  @media (max-width: 1300px) {
    .content {
      padding-top: 28px;
    }

    .title {
      font-size: 52px;
    }

    .claim {
      font-size: 18px;
    }

    .storyboard {
      grid-template-columns: 1fr;
    }

    .lane,
    .consumer-panel {
      min-height: auto;
    }

    .architect-rule p {
      font-size: 19px;
    }
  }

  @media (max-width: 700px) {
    .content {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }

    .title {
      font-size: 38px;
    }

    .claim {
      flex-wrap: wrap;
      gap: 8px;
      padding: 8px 14px;
      font-size: 15px;
    }

    .claim strong {
      font-size: 28px;
    }

    .storyboard {
      padding: 14px;
    }

    .lane-head h2 {
      font-size: 22px;
    }

    .event-track code {
      font-size: 16px;
    }

    .consumer-row {
      grid-template-columns: 42px 1fr;
    }

    .delay {
      grid-column: 2;
      justify-self: start;
    }

    .factors {
      grid-template-columns: 1fr;
    }

    .architect-rule {
      grid-template-columns: 1fr;
    }
  }
</style>
