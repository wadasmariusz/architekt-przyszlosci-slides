---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 08 - At-least-once delivery"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.90))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="alaGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="alaGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#alaGrid)"/>
    <circle cx="960" cy="540" r="520" fill="url(#alaGlow)"/>
  </svg>

  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-shield-check"></i>Gwarancja dostarczenia</span>
      <h1 class="title">
        <span class="title-mono">At-least-once</span>
        <span class="title-sub"><span class="highlight">delivery</span></span>
      </h1>
    </div>

    <section class="flow" aria-label="Schemat dostarczenia">
      <div class="flow-node flow-node--single">
        <div class="flow-ic"><i class="ti ti-mail"></i></div>
        <span class="flow-tag">1 message</span>
        <span class="flow-label">published</span>
      </div>

      <div class="flow-arrow" aria-hidden="true"><i class="ti ti-arrow-right"></i></div>

      <div class="flow-node flow-node--multi">
        <div class="flow-stack" aria-hidden="true">
          <div class="flow-stack-card"></div>
          <div class="flow-stack-card"></div>
          <div class="flow-stack-card"></div>
        </div>
        <span class="flow-tag flow-tag--alt">1..N deliveries</span>
        <span class="flow-label">duplikaty możliwe</span>
      </div>

      <div class="flow-arrow" aria-hidden="true"><i class="ti ti-arrow-right"></i></div>

      <div class="flow-node flow-node--handler">
        <div class="flow-ic"><i class="ti ti-cpu"></i></div>
        <span class="flow-tag">handler</span>
        <span class="flow-label">wielokrotne wywołanie</span>
      </div>
    </section>

    <section class="contracts" aria-label="Co broker gwarantuje, a czego nie">
      <article class="contract contract--yes">
        <header class="contract-head">
          <i class="ti ti-check"></i>
          <h2>Broker gwarantuje</h2>
        </header>
        <p>Wiadomość zostanie dostarczona <strong>co najmniej raz</strong></p>
      </article>

      <article class="contract contract--no">
        <header class="contract-head">
          <i class="ti ti-x"></i>
          <h2>Nie gwarantuje</h2>
        </header>
        <p>Wiadomość zostanie przetworzona <strong>dokładnie raz</strong></p>
      </article>
    </section>

    <ul class="implications" aria-label="Konsekwencje">
      <li>
        <i class="ti ti-copy"></i>
        <span>Duplikaty są normalnym scenariuszem pracy systemu</span>
      </li>
      <li>
        <i class="ti ti-refresh"></i>
        <span>Handler musi być przygotowany na wielokrotne wywołanie</span>
      </li>
    </ul>

    <aside class="note" aria-label="Adnotacja">
      <i class="ti ti-info-circle"></i>
      <div class="note-body">
        <p class="note-main">
          Dotyczy typowych rozwiązań kolejkowych i event-driven, np.
        </p>
        <div class="note-chips">
          <span class="chip">RabbitMQ</span>
          <span class="chip">Kafka</span>
          <span class="chip">Service Bus</span>
        </div>
      </div>
    </aside>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 36px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 28px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 82px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 12px;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 18px;
    flex-wrap: nowrap;
    white-space: nowrap;
  }

  .title-mono,
  .title-sub {
    display: inline-block;
  }

  .title-mono {
    font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
    font-size: 82px;
    color: #f0f4f8;
    letter-spacing: -1.5px;
  }

  .title-sub {
    margin-top: 0;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .flow {
    width: 100%;
    max-width: 1500px;
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    margin-bottom: 36px;
    padding: 30px 24px;
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.32);
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.55s forwards;
  }

  .flow-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 12px;
    min-height: 180px;
    position: relative;
  }

  .flow-ic {
    width: 76px;
    height: 76px;
    border-radius: 20px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .flow-ic i {
    font-size: 40px;
    color: var(--cyan-400);
  }

  .flow-tag {
    margin-top: 6px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.45);
    color: var(--cyan-400);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 1px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }

  .flow-tag--alt {
    background: rgba(251, 191, 36, 0.14);
    border-color: rgba(251, 191, 36, 0.45);
    color: #fbbf24;
  }

  .flow-label {
    font-size: 18px;
    font-weight: 500;
    color: rgba(203, 213, 225, 0.78);
    font-style: italic;
    letter-spacing: 0.2px;
  }

  .flow-stack {
    position: relative;
    width: 96px;
    height: 76px;
  }

  .flow-stack-card {
    position: absolute;
    width: 72px;
    height: 56px;
    border-radius: 14px;
    background: rgba(251, 191, 36, 0.12);
    border: 1px solid rgba(251, 191, 36, 0.45);
  }

  .flow-stack-card:nth-child(1) {
    top: 0;
    left: 0;
    transform: rotate(-6deg);
    background: rgba(251, 191, 36, 0.10);
  }

  .flow-stack-card:nth-child(2) {
    top: 8px;
    left: 12px;
    transform: rotate(2deg);
    background: rgba(251, 191, 36, 0.14);
  }

  .flow-stack-card:nth-child(3) {
    top: 18px;
    left: 22px;
    transform: rotate(8deg);
    background: rgba(251, 191, 36, 0.18);
    box-shadow: 0 8px 24px rgba(251, 191, 36, 0.20);
  }

  .flow-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
  }

  .flow-arrow i {
    font-size: 38px;
    color: rgba(34, 211, 238, 0.65);
  }

  .contracts {
    width: 100%;
    max-width: 1500px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
    margin-bottom: 28px;
  }

  .contract {
    padding: 26px 30px;
    border-radius: 18px;
    background: rgba(17, 24, 39, 0.62);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.30);
    text-align: left;
    opacity: 0;
    animation: fadeUp 0.85s ease-out forwards;
  }

  .contracts > .contract:nth-child(1) { animation-delay: 0.85s; }
  .contracts > .contract:nth-child(2) { animation-delay: 1.05s; }

  .contract--yes {
    border-color: rgba(34, 197, 94, 0.45);
    background: linear-gradient(135deg, rgba(20, 83, 45, 0.20), rgba(17, 24, 39, 0.62));
  }

  .contract--no {
    border-color: rgba(248, 113, 113, 0.45);
    background: linear-gradient(135deg, rgba(127, 29, 29, 0.20), rgba(17, 24, 39, 0.62));
  }

  .contract-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 14px;
  }

  .contract-head i {
    width: 52px;
    height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    font-size: 28px;
    font-weight: 800;
  }

  .contract--yes .contract-head i {
    background: rgba(34, 197, 94, 0.18);
    border: 1px solid rgba(34, 197, 94, 0.55);
    color: #4ade80;
  }

  .contract--no .contract-head i {
    background: rgba(248, 113, 113, 0.18);
    border: 1px solid rgba(248, 113, 113, 0.55);
    color: #f87171;
  }

  .contract-head h2 {
    margin: 0;
    font-size: 26px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.3px;
    color: #f0f4f8;
  }

  .contract p {
    margin: 0;
    font-size: 26px;
    font-weight: 500;
    line-height: 1.3;
    color: #e2e8f0;
    letter-spacing: -0.2px;
  }

  .contract--yes p strong {
    color: #4ade80;
    font-weight: 800;
  }

  .contract--no p strong {
    color: #f87171;
    font-weight: 800;
  }

  .implications {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    width: 100%;
    max-width: 1500px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 22px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.25s forwards;
  }

  .implications li {
    display: grid;
    grid-template-columns: 52px 1fr;
    align-items: center;
    gap: 18px;
    padding: 16px 22px;
    background: rgba(17, 24, 39, 0.58);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 14px;
    text-align: left;
  }

  .implications li i {
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 24px;
  }

  .implications li span {
    font-size: 22px;
    font-weight: 500;
    line-height: 1.3;
    color: #e2e8f0;
    letter-spacing: -0.2px;
  }

  .note {
    width: auto;
    max-width: 1400px;
    display: inline-flex;
    gap: 22px;
    align-items: center;
    justify-content: flex-start;
    align-self: flex-start;
    margin: 0;
    padding: 20px 28px;
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(148, 163, 184, 0.28);
    border-radius: 16px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.45s forwards;
  }

  .note > i {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.42);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    color: var(--cyan-400);
    flex-shrink: 0;
  }

  .note-body {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    text-align: left;
  }

  .note-main {
    margin: 0;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
    color: #e2e8f0;
  }

  .note-chips {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .chip {
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.45);
    color: var(--cyan-400);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.4px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }

  @media (max-width: 1300px) {
    .title {
      font-size: 56px;
    }

    .title-mono {
      font-size: 48px;
    }

    .flow {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .flow-arrow {
      width: 100%;
      transform: rotate(90deg);
    }

    .contracts {
      grid-template-columns: 1fr;
    }

    .contract p {
      font-size: 22px;
    }

    .implications {
      grid-template-columns: 1fr;
    }

    .implications li span {
      font-size: 20px;
    }
  }

  @media (max-width: 700px) {
    .content {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }

    .title-mono {
      font-size: 34px;
    }

    .title {
      font-size: 38px;
    }

    .eyebrow {
      font-size: 16px;
      letter-spacing: 4px;
    }

    .contract-head h2 {
      font-size: 22px;
    }

    .contract p {
      font-size: 20px;
    }

    .implications li {
      grid-template-columns: 40px 1fr;
      gap: 14px;
      padding: 14px 16px;
    }

    .implications li i {
      width: 40px;
      height: 40px;
      font-size: 22px;
    }

    .implications li span {
      font-size: 18px;
    }
  }
</style>
