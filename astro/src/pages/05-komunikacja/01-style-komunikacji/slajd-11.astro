---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 11 - Idempotency key"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.90))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="idkGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="idkGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#idkGrid)"/>
    <circle cx="960" cy="540" r="520" fill="url(#idkGlow)"/>
  </svg>

  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-key"></i>Wzorzec #2</span>
      <h1 class="title">
        Idempotency <span class="highlight">key</span>
      </h1>
    </div>

    <section class="flow" aria-label="Diagram przepływu z idempotency key">
      <article class="node node--worker">
        <div class="node-ic"><i class="ti ti-cpu"></i></div>
        <h3>Worker</h3>
      </article>

      <div class="conn" aria-hidden="true">
        <i class="ti ti-arrow-right"></i>
      </div>

      <article class="node node--request">
        <div class="node-ic"><i class="ti ti-send"></i></div>
        <h3>API request</h3>
        <div class="header-card" aria-label="Nagłówek HTTP">
          <span class="header-key">Idempotency-Key:</span>
          <span class="header-val">a1b2-c3d4-e5f6</span>
        </div>
      </article>

      <div class="conn" aria-hidden="true">
        <i class="ti ti-arrow-right"></i>
      </div>

      <article class="node node--provider">
        <div class="node-ic"><i class="ti ti-credit-card"></i></div>
        <h3>Payment Provider</h3>
      </article>
    </section>
    <ul class="points" aria-label="Punkty kluczowe">
      <li>
        <i class="ti ti-key"></i>
        <span>Dla operacji wysyłany jest <strong>stabilny idempotency key</strong></span>
      </li>
      <li>
        <i class="ti ti-eye-check"></i>
        <span>Zewnętrzny system rozpoznaje powtórzony request</span>
      </li>
      <li>
        <i class="ti ti-shield-lock"></i>
        <span>Ta sama operacja nie zostaje wykonana drugi raz</span>
      </li>
      <li class="points-impact">
        <i class="ti ti-alert-circle"></i>
        <span>Szczególnie ważne przy <strong>płatnościach</strong> i innych operacjach z kosztownym efektem ubocznym</span>
      </li>
    </ul>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 40px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 28px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 80px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 12px;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .flow {
    width: 100%;
    max-width: 1500px;
    display: grid;
    grid-template-columns: 1fr auto 1.3fr auto 1fr;
    align-items: center;
    gap: 18px;
    margin-bottom: 28px;
    padding: 32px 24px;
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.32);
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.55s forwards;
  }

  .node {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 24px 16px;
    min-height: 220px;
    background: rgba(17, 24, 39, 0.5);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 16px;
  }

  .node-ic {
    width: 80px;
    height: 80px;
    border-radius: 20px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .node-ic i {
    font-size: 42px;
    color: var(--cyan-400);
  }

  .node h3 {
    margin: 0;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.3px;
    line-height: 1.1;
    color: #f0f4f8;
  }

  .node--request {
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.18), rgba(17, 24, 39, 0.55));
    border-color: rgba(34, 211, 238, 0.42);
  }

  .header-card {
    margin-top: 6px;
    padding: 10px 16px;
    border-radius: 10px;
    background: rgba(10, 14, 23, 0.85);
    border: 1px dashed rgba(34, 211, 238, 0.55);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 18px;
    line-height: 1;
    white-space: nowrap;
    box-shadow: 0 0 24px rgba(34, 211, 238, 0.18);
  }

  .header-key {
    color: rgba(148, 163, 184, 0.95);
    font-weight: 600;
  }

  .header-val {
    color: var(--cyan-400);
    font-weight: 800;
    letter-spacing: 0.5px;
  }

  .conn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
  }

  .conn i {
    font-size: 36px;
    color: rgba(34, 211, 238, 0.65);
  }

  .formula {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin: 0 auto 36px;
    padding: 22px 36px;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.22), rgba(17, 24, 39, 0.65));
    border: 1px solid rgba(34, 211, 238, 0.55);
    box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.05), 0 18px 48px rgba(8, 145, 178, 0.22);
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.95s forwards;
  }

  .formula-part {
    font-size: 30px;
    font-weight: 700;
    color: #e2f6ff;
    letter-spacing: -0.3px;
  }

  .formula-part code {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    color: var(--cyan-400);
    background: rgba(34, 211, 238, 0.12);
    padding: 2px 10px;
    border-radius: 8px;
    border: 1px solid rgba(34, 211, 238, 0.42);
    font-size: 26px;
    font-weight: 800;
  }

  .formula-part--neg {
    color: rgba(254, 202, 202, 0.95);
  }

  .formula-eq {
    font-size: 38px;
    font-weight: 800;
    color: var(--cyan-400);
    line-height: 1;
  }

  .formula-divider {
    font-size: 30px;
    color: rgba(148, 163, 184, 0.75);
    font-weight: 700;
    margin: 0 -8px;
  }

  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 1500px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px 22px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.2s forwards;
  }

  .points li {
    display: grid;
    grid-template-columns: 52px 1fr;
    align-items: center;
    gap: 18px;
    padding: 18px 22px;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 14px;
    text-align: left;
  }

  .points li i {
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 24px;
  }

  .points li span {
    font-size: 22px;
    font-weight: 500;
    line-height: 1.3;
    color: #e2e8f0;
    letter-spacing: -0.2px;
  }

  .points li strong {
    color: #fff;
    font-weight: 800;
  }

  .points-impact {
    border-color: rgba(251, 191, 36, 0.45);
    background: linear-gradient(135deg, rgba(180, 83, 9, 0.20), rgba(17, 24, 39, 0.6));
  }

  .points-impact i {
    background: rgba(251, 191, 36, 0.16);
    border-color: rgba(251, 191, 36, 0.55);
    color: #fbbf24;
  }

  .points-impact span {
    color: #fff7ed;
  }

  .points-impact strong {
    color: #fbbf24;
  }

  @media (max-width: 1300px) {
    .title {
      font-size: 60px;
    }

    .flow {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .conn {
      width: 100%;
      transform: rotate(90deg);
    }

    .header-card {
      font-size: 14px;
      padding: 8px 12px;
    }

    .formula {
      padding: 18px 22px;
    }

    .formula-part {
      font-size: 22px;
    }

    .formula-part code {
      font-size: 20px;
    }

    .formula-eq {
      font-size: 28px;
    }

    .points {
      grid-template-columns: 1fr;
    }

    .points li span {
      font-size: 20px;
    }
  }

  @media (max-width: 700px) {
    .content {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }

    .title {
      font-size: 42px;
    }

    .eyebrow {
      font-size: 16px;
      letter-spacing: 4px;
    }

    .node h3 {
      font-size: 22px;
    }

    .header-card {
      font-size: 12px;
    }

    .points li {
      grid-template-columns: 40px 1fr;
      gap: 14px;
      padding: 14px 16px;
    }

    .points li i {
      width: 40px;
      height: 40px;
      font-size: 22px;
    }

    .points li span {
      font-size: 18px;
    }
  }
</style>
