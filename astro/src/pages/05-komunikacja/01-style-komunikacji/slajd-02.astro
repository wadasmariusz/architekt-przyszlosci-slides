---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 02 - Model na papierze"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.90))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="paperGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="paperGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.14"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#paperGrid)"/>
    <circle cx="960" cy="560" r="500" fill="url(#paperGlow)"/>
  </svg>

  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-book-2"></i>Teoria</span>
      <h1 class="title">
        Komunikacja <span class="highlight">asynchroniczna</span>
      </h1>
    </div>

    <section class="flow" aria-label="Prosty model przepływu wiadomości">
      <article class="node">
        <div class="ic"><i class="ti ti-broadcast"></i></div>
        <h3>Publisher</h3>
        <p>publikuje wiadomość</p>
      </article>

      <div class="arrow" aria-hidden="true">
        <i class="ti ti-arrow-right"></i>
      </div>

      <article class="node">
        <div class="ic"><i class="ti ti-stack-2"></i></div>
        <h3>Broker / kolejka</h3>
        <p>przechowuje wiadomość</p>
      </article>

      <div class="arrow" aria-hidden="true">
        <i class="ti ti-arrow-right"></i>
      </div>

      <article class="node">
        <div class="ic"><i class="ti ti-cpu"></i></div>
        <h3>Consumer</h3>
        <p>pobiera i przetwarza wiadomość</p>
      </article>
    </section>

    <aside class="note" aria-label="Adnotacja architektoniczna">
      <i class="ti ti-alert-triangle"></i>
      <div class="note-body">
        <p class="note-main">
          Co w przypadku <span class="accent">awarii, retry, timeout&oacute;w i duplikatów ?</span>
        </p>
      </div>
    </aside>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 72px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 32px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.3s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 88px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 32px;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .flow {
    width: 100%;
    max-width: 1480px;
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 26px;
    margin-bottom: 72px;
  }

  .node {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 40px 26px;
    min-height: 280px;
    background: rgba(17, 24, 39, 0.62);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.32);
    text-align: center;
    opacity: 0;
    animation: fadeUp 0.85s ease-out forwards;
  }

  .flow > .node:nth-child(1) { animation-delay: 0.5s; }
  .flow > .node:nth-child(3) { animation-delay: 0.78s; }
  .flow > .node:nth-child(5) { animation-delay: 1.06s; }

  .node .ic {
    width: 92px;
    height: 92px;
    border-radius: 22px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .node .ic i {
    font-size: 48px;
    color: var(--cyan-400);
  }

  .node h3 {
    margin: 0;
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -0.4px;
    line-height: 1.1;
    color: #f0f4f8;
  }

  .node p {
    margin: 0;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.3;
    color: rgba(219, 234, 254, 0.86);
    max-width: 320px;
  }

  .arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 70px;
    opacity: 0;
    animation: fadeIn 0.7s ease-out forwards;
  }

  .flow > .arrow:nth-child(2) { animation-delay: 0.68s; }
  .flow > .arrow:nth-child(4) { animation-delay: 0.96s; }

  .arrow i {
    font-size: 56px;
    color: rgba(34, 211, 238, 0.65);
  }

  .note {
    width: auto;
    max-width: 1280px;
    display: inline-flex;
    gap: 22px;
    align-items: center;
    justify-content: flex-start;
    margin: 0 auto;
    padding: 26px 34px;
    background: linear-gradient(135deg, rgba(180, 83, 9, 0.22), rgba(120, 53, 15, 0.08));
    border: 1px solid rgba(251, 191, 36, 0.45);
    border-radius: 16px;
    box-shadow: 0 18px 48px rgba(180, 83, 9, 0.18);
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.25s forwards;
  }

  .note > i {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    background: rgba(251, 191, 36, 0.16);
    border: 1px solid rgba(251, 191, 36, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 34px;
    color: #fbbf24;
    flex-shrink: 0;
  }

  .note-body {
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .note-main {
    margin: 0;
    font-size: 28px;
    font-weight: 600;
    line-height: 1.3;
    color: #fff7ed;
  }

  .note-main .accent {
    color: #fbbf24;
    font-weight: 700;
  }

  .note-sub {
    margin: 0;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.3;
    color: rgba(254, 215, 170, 0.85);
    font-style: italic;
    letter-spacing: 0.2px;
  }

  @media (max-width: 1200px) {
    .title {
      font-size: 64px;
    }

    .flow {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .arrow {
      width: 100%;
      transform: rotate(90deg);
    }

    .node {
      min-height: 200px;
      padding: 28px 22px;
    }

    .node h3 {
      font-size: 28px;
    }

    .node p {
      font-size: 20px;
    }

    .note-main {
      font-size: 22px;
    }
  }
</style>
