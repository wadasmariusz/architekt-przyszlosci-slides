---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 01 - Wyzwania komunikacji asynchronicznej"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.82), rgba(10,14,23,0.92))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="asyncGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="asyncGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#asyncGrid)"/>
    <circle cx="960" cy="540" r="520" fill="url(#asyncGlow)"/>
  </svg>

  <div class="content">
    <h1 class="title">
      <span class="title-main">Wyzwania</span>
      <span class="title-sub">Komunikacji <span class="highlight">Asynchronicznej</span></span>
    </h1>

    <div class="accent-bar" aria-hidden="true"></div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: center;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 0 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 28px;
    font-size: 22px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 6px;
    color: rgba(34, 211, 238, 0.78);
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.25s forwards;
  }

  .title {
    font-size: 112px;
    font-weight: 800;
    letter-spacing: -1.5px;
    line-height: 1.02;
    margin: 0;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.45s forwards;
  }

  .title-main,
  .title-sub {
    display: block;
  }

  .title-sub {
    margin-top: 6px;
    font-size: 96px;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lede {
    max-width: 1180px;
    margin: 48px 0 0;
    font-size: 36px;
    font-weight: 400;
    line-height: 1.32;
    color: rgba(240, 244, 248, 0.86);
    letter-spacing: -0.2px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.75s forwards;
  }

  .accent-bar {
    width: 180px;
    height: 4px;
    margin-top: 48px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(34, 211, 238, 0), rgba(34, 211, 238, 0.85), rgba(34, 211, 238, 0));
    opacity: 0;
    animation: fadeIn 1.0s ease-out 1.0s forwards;
  }

  @media (max-width: 1200px) {
    .title {
      font-size: 80px;
    }

    .title-sub {
      font-size: 68px;
    }

    .lede {
      font-size: 28px;
    }
  }

  @media (max-width: 700px) {
    .eyebrow {
      font-size: 16px;
      letter-spacing: 4px;
    }

    .title {
      font-size: 54px;
    }

    .title-sub {
      font-size: 46px;
    }

    .lede {
      font-size: 22px;
    }
  }
</style>
