---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 15 - Brak globalnej kolejności"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.82), rgba(10,14,23,0.92))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="orderGrid15" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="orderGlow15" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="66%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#orderGrid15)"/>
    <circle cx="960" cy="540" r="540" fill="url(#orderGlow15)"/>
  </svg>

  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-arrows-shuffle"></i>Problem #1</span>
      <h1 class="title">
        Brak <span class="highlight">globalnej kolejności</span>
      </h1>
    </div>

    <section class="flow" aria-label="Diagram: Publisher, Queue, Consumer A i Consumer B">
      <article class="node node--publisher">
        <div class="node-ic"><i class="ti ti-broadcast"></i></div>
        <h3>Publisher</h3>
        <div class="msg-row msg-row--out" aria-label="Eventy wychodzące w kolejności 1, 2, 3">
          <span class="msg msg--one">1</span>
          <span class="msg msg--two">2</span>
          <span class="msg msg--three">3</span>
        </div>
        <span class="msg-caption">wysłane <strong>1 → 2 → 3</strong></span>
      </article>

      <div class="conn" aria-hidden="true"><i class="ti ti-arrow-right"></i></div>

      <article class="node node--queue">
        <div class="node-ic"><i class="ti ti-stack-2"></i></div>
        <h3>Queue</h3>
        <span class="node-meta">broker / topic</span>
      </article>

      <div class="conn conn--split" aria-hidden="true">
        <i class="ti ti-arrow-up-right"></i>
        <i class="ti ti-arrow-down-right"></i>
      </div>

      <div class="consumers">
        <article class="node node--consumer node--consumer-a">
          <div class="node-ic"><i class="ti ti-cpu"></i></div>
          <h3>Consumer A</h3>
          <div class="msg-row msg-row--in">
            <span class="msg msg--two">2</span>
            <span class="msg-arrow"><i class="ti ti-arrow-right"></i></span>
            <span class="msg msg--one">1</span>
          </div>
          <span class="msg-caption msg-caption--bad">odebrane <strong>2 → 1</strong></span>
        </article>

        <article class="node node--consumer node--consumer-b">
          <div class="node-ic"><i class="ti ti-cpu"></i></div>
          <h3>Consumer B</h3>
          <div class="msg-row msg-row--in">
            <span class="msg msg--three">3</span>
          </div>
          <span class="msg-caption msg-caption--bad">odebrane <strong>3</strong></span>
        </article>
      </div>
    </section>

    <ul class="points" aria-label="Punkty kluczowe">
      <li>
        <i class="ti ti-circle-x"></i>
        <span>Broker <strong>nie gwarantuje globalnej kolejności</strong> przetwarzania wiadomości</span>
      </li>
      <li>
        <i class="ti ti-arrows-shuffle"></i>
        <span>Eventy mogą zostać opublikowane w jednej kolejności, ale <strong>obsłużone w innej</strong></span>
      </li>
      <li class="points-impact">
        <i class="ti ti-alert-triangle"></i>
        <span><strong>Przyczyny:</strong> wielu consumerów, retry, opóźnienia, różne instancje</span>
      </li>
    </ul>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1660px;
    padding: 36px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 24px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 14px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 82px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 8px;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .flow {
    width: 100%;
    max-width: 1560px;
    display: grid;
    grid-template-columns: 1.05fr auto 0.85fr auto 1.25fr;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
    padding: 26px 22px;
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.32);
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.55s forwards;
  }

  .node {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    padding: 18px 14px;
    min-height: 226px;
    background: rgba(17, 24, 39, 0.5);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 16px;
  }

  .node-ic {
    width: 70px;
    height: 70px;
    border-radius: 18px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .node-ic i {
    font-size: 36px;
    color: var(--cyan-400);
  }

  .node h3 {
    margin: 0;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.3px;
    line-height: 1.1;
    color: #f0f4f8;
  }

  .node-meta {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 15px;
    font-weight: 700;
    color: rgba(148, 163, 184, 0.95);
    letter-spacing: 0.5px;
  }

  .node--publisher {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.16), rgba(17, 24, 39, 0.55));
    border-color: rgba(34, 197, 94, 0.42);
  }

  .node--publisher .node-ic {
    background: rgba(34, 197, 94, 0.14);
    border-color: rgba(74, 222, 128, 0.5);
  }

  .node--publisher .node-ic i { color: #4ade80; }

  .node--queue {
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.20), rgba(17, 24, 39, 0.6));
    border-color: rgba(34, 211, 238, 0.45);
    box-shadow: 0 0 28px rgba(34, 211, 238, 0.14);
  }

  .consumers {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 12px;
    align-self: stretch;
  }

  .node--consumer {
    min-height: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 14px;
    padding: 14px 16px;
    text-align: left;
    flex-wrap: wrap;
  }

  .node--consumer .node-ic {
    width: 54px;
    height: 54px;
    border-radius: 14px;
  }

  .node--consumer .node-ic i { font-size: 28px; }

  .node--consumer h3 {
    font-size: 20px;
    margin-right: auto;
  }

  .node--consumer-a {
    border-color: rgba(248, 113, 113, 0.42);
    background: linear-gradient(135deg, rgba(127, 29, 29, 0.20), rgba(17, 24, 39, 0.6));
  }

  .node--consumer-a .node-ic {
    background: rgba(248, 113, 113, 0.14);
    border-color: rgba(248, 113, 113, 0.5);
  }

  .node--consumer-a .node-ic i { color: #f87171; }

  .node--consumer-b {
    border-color: rgba(251, 191, 36, 0.42);
    background: linear-gradient(135deg, rgba(120, 53, 15, 0.22), rgba(17, 24, 39, 0.6));
  }

  .node--consumer-b .node-ic {
    background: rgba(251, 191, 36, 0.14);
    border-color: rgba(251, 191, 36, 0.5);
  }

  .node--consumer-b .node-ic i { color: #fbbf24; }

  .msg-row {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 12px;
    background: rgba(2, 6, 23, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.22);
  }

  .msg-row--in {
    margin-left: auto;
  }

  .msg {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(15, 23, 42, 0.9);
    border: 1px solid rgba(148, 163, 184, 0.35);
    color: #f8fafc;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 16px;
    font-weight: 900;
  }

  .msg--one {
    border-color: rgba(74, 222, 128, 0.55);
    color: #bbf7d0;
    background: rgba(20, 83, 45, 0.4);
  }

  .msg--two {
    border-color: rgba(34, 211, 238, 0.5);
    color: #a5f3fc;
    background: rgba(8, 145, 178, 0.32);
  }

  .msg--three {
    border-color: rgba(251, 191, 36, 0.55);
    color: #fde68a;
    background: rgba(120, 53, 15, 0.4);
  }

  .msg-arrow i {
    font-size: 18px;
    color: rgba(148, 163, 184, 0.85);
  }

  .msg-caption {
    font-size: 14px;
    font-weight: 700;
    color: rgba(226, 232, 240, 0.92);
    letter-spacing: 0.3px;
    text-transform: uppercase;
  }

  .msg-caption strong {
    color: #f8fafc;
    font-weight: 900;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: 1px;
  }

  .msg-caption--bad {
    color: #fecaca;
  }

  .msg-caption--bad strong {
    color: #fecaca;
  }

  .conn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
  }

  .conn i {
    font-size: 34px;
    color: rgba(34, 211, 238, 0.7);
  }

  .conn--split {
    flex-direction: column;
    gap: 26px;
  }

  .conn--split i:first-child { color: rgba(248, 113, 113, 0.7); }
  .conn--split i:last-child { color: rgba(251, 191, 36, 0.7); }

  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 1560px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.05s forwards;
  }

  .points li {
    display: grid;
    grid-template-columns: 52px 1fr;
    align-items: center;
    gap: 18px;
    padding: 18px 22px;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 14px;
    text-align: left;
  }

  .points li i {
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 24px;
  }

  .points li span {
    font-size: 24px;
    font-weight: 500;
    line-height: 1.3;
    color: #e2e8f0;
    letter-spacing: -0.2px;
  }

  .points li strong {
    color: #fff;
    font-weight: 800;
  }

  .points-impact {
    border-color: rgba(251, 191, 36, 0.45);
    background: linear-gradient(135deg, rgba(180, 83, 9, 0.20), rgba(17, 24, 39, 0.6));
  }

  .points-impact i {
    background: rgba(251, 191, 36, 0.16);
    border-color: rgba(251, 191, 36, 0.55);
    color: #fbbf24;
  }

  .points-impact span {
    color: #fff7ed;
  }

  .points-impact strong {
    color: #fbbf24;
  }

  @media (max-width: 1300px) {
    .title {
      font-size: 54px;
    }

    .flow {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .conn {
      width: 100%;
      transform: rotate(90deg);
    }

    .conn--split {
      flex-direction: row;
      transform: none;
    }

    .points {
      grid-template-columns: 1fr;
    }

    .points li span {
      font-size: 18px;
    }
  }

  @media (max-width: 700px) {
    .content {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }

    .title {
      font-size: 40px;
    }

    .node h3 {
      font-size: 20px;
    }

    .node--consumer {
      flex-direction: column;
      align-items: flex-start;
    }

    .msg-row--in {
      margin-left: 0;
    }

    .points li {
      grid-template-columns: 40px 1fr;
      gap: 14px;
      padding: 14px 16px;
    }

    .points li i {
      width: 40px;
      height: 40px;
      font-size: 22px;
    }

    .points li span {
      font-size: 17px;
    }
  }
</style>
