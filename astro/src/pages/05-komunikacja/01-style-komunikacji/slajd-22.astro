---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 22 - Inbox Pattern"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.82), rgba(10,14,23,0.92))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="inboxGrid22" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="inboxGlow22" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="66%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#inboxGrid22)"/>
    <circle cx="960" cy="540" r="540" fill="url(#inboxGlow22)"/>
  </svg>

  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-inbox"></i>Rozwiązanie #2 · Inbox</span>
      <h1 class="title">
        Inbox <span class="highlight">Pattern</span>
      </h1>
    </div>

    <section class="flow" aria-label="Diagram Inbox Pattern: happy path i duplikat">
      <article class="node node--message">
        <div class="node-ic"><i class="ti ti-mail-forward"></i></div>
        <h3>Message</h3>
        <span class="msg-id"><code>MessageId</code></span>
      </article>

      <div class="conn" aria-hidden="true"><i class="ti ti-arrow-right"></i></div>

      <article class="node node--inbox">
        <header class="inbox-head">
          <i class="ti ti-inbox"></i>
          <h3>Inbox</h3>
        </header>
        <div class="constraint">
          <span class="constraint-tag">CONSTRAINT</span>
          <code>MessageId UNIQUE</code>
        </div>
        <div class="duplicate" aria-label="Duplikat trafia tutaj">
          <span class="dup-arrow"><i class="ti ti-corner-down-right"></i></span>
          <div class="dup-body">
            <span class="dup-label">Duplicate MessageId</span>
            <span class="dup-effect"><i class="ti ti-x"></i>rejected / ignored</span>
          </div>
        </div>
      </article>

      <div class="conn" aria-hidden="true"><i class="ti ti-arrow-right"></i></div>

      <article class="node node--handler">
        <div class="node-ic"><i class="ti ti-cpu"></i></div>
        <h3>Handler</h3>
        <span class="once-badge"><i class="ti ti-check"></i>tylko raz</span>
      </article>

      <div class="conn" aria-hidden="true"><i class="ti ti-arrow-right"></i></div>

      <article class="node node--domain">
        <div class="node-ic"><i class="ti ti-affiliate"></i></div>
        <h3>Domain change</h3>
      </article>
    </section>

    <ul class="points" aria-label="Zasady Inbox Pattern">
      <li>
        <i class="ti ti-mail-down"></i>
        <span>Odbierana wiadomość trafia <strong>najpierw do</strong> <code>Inbox</code></span>
      </li>
      <li>
        <i class="ti ti-fingerprint"></i>
        <span><code>MessageId</code> jako <strong>unikalny identyfikator</strong></span>
      </li>
      <li>
        <i class="ti ti-circle-x"></i>
        <span>Duplikat zostaje <strong>odrzucony przez constraint</strong></span>
      </li>
      <li class="points-good">
        <i class="ti ti-circle-check"></i>
        <span>Handler wykonuje logikę domenową <strong>tylko raz</strong></span>
      </li>
    </ul>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1700px;
    padding: 36px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 24px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 14px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 78px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 8px;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .flow {
    width: 100%;
    max-width: 1640px;
    display: grid;
    grid-template-columns: 0.85fr auto 1.55fr auto 1fr auto 1fr;
    align-items: stretch;
    gap: 12px;
    margin-bottom: 28px;
    padding: 26px 22px;
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.32);
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.55s forwards;
  }

  .node {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 18px 14px;
    min-height: 260px;
    background: rgba(17, 24, 39, 0.5);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 16px;
  }

  .node-ic {
    width: 70px;
    height: 70px;
    border-radius: 18px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .node-ic i {
    font-size: 34px;
    color: var(--cyan-400);
  }

  .node h3 {
    margin: 0;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.3px;
    line-height: 1.1;
    color: #f0f4f8;
    text-align: center;
  }

  .node--message {
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.16), rgba(17, 24, 39, 0.55));
    border-color: rgba(168, 85, 247, 0.45);
  }

  .node--message .node-ic {
    background: rgba(168, 85, 247, 0.14);
    border-color: rgba(168, 85, 247, 0.5);
  }

  .node--message .node-ic i { color: #c4b5fd; }

  .msg-id {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(2, 6, 23, 0.62);
    border: 1px dashed rgba(168, 85, 247, 0.45);
  }

  .msg-id code {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 13px;
    font-weight: 800;
    color: #ddd6fe;
    letter-spacing: 0.5px;
  }

  .node--inbox {
    padding: 16px 16px;
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.22), rgba(17, 24, 39, 0.62));
    border-color: rgba(34, 211, 238, 0.55);
    box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.05), 0 18px 48px rgba(8, 145, 178, 0.22);
    align-items: stretch;
    gap: 12px;
  }

  .inbox-head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .inbox-head i {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.5);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--cyan-400);
    font-size: 28px;
  }

  .constraint {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-radius: 12px;
    background: rgba(2, 6, 23, 0.55);
    border: 1px dashed rgba(34, 211, 238, 0.5);
  }

  .constraint-tag {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(165, 243, 252, 0.95);
  }

  .constraint code {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 16px;
    font-weight: 800;
    color: var(--cyan-400);
    letter-spacing: 0.3px;
  }

  .duplicate {
    display: grid;
    grid-template-columns: 28px 1fr;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border-radius: 12px;
    background: rgba(127, 29, 29, 0.20);
    border: 1px solid rgba(248, 113, 113, 0.45);
    text-align: left;
  }

  .dup-arrow i {
    font-size: 22px;
    color: #f87171;
  }

  .dup-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .dup-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(252, 165, 165, 0.95);
  }

  .dup-effect {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 14px;
    font-weight: 800;
    color: #fecaca;
  }

  .dup-effect i { font-size: 16px; }

  .node--handler {
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.18), rgba(17, 24, 39, 0.55));
    border-color: rgba(34, 211, 238, 0.42);
  }

  .once-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(34, 197, 94, 0.16);
    border: 1px solid rgba(34, 197, 94, 0.5);
    color: #d1fae5;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .once-badge i { font-size: 14px; color: #4ade80; }

  .node--domain {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.16), rgba(17, 24, 39, 0.55));
    border-color: rgba(34, 197, 94, 0.45);
  }

  .node--domain .node-ic {
    background: rgba(34, 197, 94, 0.14);
    border-color: rgba(74, 222, 128, 0.55);
  }

  .node--domain .node-ic i { color: #4ade80; }

  .conn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
  }

  .conn i {
    font-size: 28px;
    color: rgba(34, 211, 238, 0.7);
  }

  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 1560px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px 18px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.05s forwards;
  }

  .points li {
    display: grid;
    grid-template-columns: 52px 1fr;
    align-items: center;
    gap: 18px;
    padding: 16px 22px;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 14px;
    text-align: left;
  }

  .points li > i {
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 24px;
  }

  .points li span {
    font-size: 21px;
    font-weight: 500;
    line-height: 1.3;
    color: #e2e8f0;
    letter-spacing: -0.2px;
  }

  .points li code {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 19px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 8px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
  }

  .points li strong {
    color: #fff;
    font-weight: 800;
  }

  .points-good {
    border-color: rgba(34, 197, 94, 0.5);
    background: linear-gradient(135deg, rgba(20, 83, 45, 0.22), rgba(17, 24, 39, 0.6));
  }

  .points-good > i {
    background: rgba(34, 197, 94, 0.16);
    border-color: rgba(74, 222, 128, 0.55);
    color: #4ade80;
  }

  .points-good span {
    color: #f0fdf4;
  }

  .points-good strong {
    color: #d1fae5;
  }

  @media (max-width: 1300px) {
    .title {
      font-size: 54px;
    }

    .flow {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .conn {
      width: 100%;
      transform: rotate(90deg);
    }

    .points {
      grid-template-columns: 1fr;
    }

    .points li span {
      font-size: 18px;
    }
  }

  @media (max-width: 700px) {
    .content {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }

    .title {
      font-size: 40px;
    }

    .node h3 {
      font-size: 18px;
    }

    .constraint code {
      font-size: 14px;
    }

    .points li {
      grid-template-columns: 40px 1fr;
      gap: 14px;
      padding: 14px 16px;
    }

    .points li > i {
      width: 40px;
      height: 40px;
      font-size: 22px;
    }

    .points li span {
      font-size: 17px;
    }
  }
</style>
</content>
</invoke>