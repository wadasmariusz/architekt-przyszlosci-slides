---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 05 - Timeout i ponowne dostarczenie"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.90))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="toGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="toGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.16"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#toGrid)"/>
    <circle cx="960" cy="560" r="520" fill="url(#toGlow)"/>
  </svg>

  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-stack-2"></i>Broker</span>
      <h1 class="title">
        Timeout i <span class="highlight">ponowne dostarczenie</span>
      </h1>
    </div>

    <section class="cycle" aria-label="Cykl stanu wiadomości">
      <article class="state state--available">
        <span class="state-num">1</span>
        <i class="ti ti-mail"></i>
        <h3>Available</h3>
        <p>w kolejce</p>
      </article>

      <div class="arrow" aria-hidden="true"><i class="ti ti-arrow-right"></i></div>

      <article class="state state--locked">
        <span class="state-num">2</span>
        <i class="ti ti-lock"></i>
        <h3>Locked / In-flight</h3>
        <p>przetwarzana</p>
      </article>

      <div class="arrow" aria-hidden="true"><i class="ti ti-arrow-right"></i></div>

      <article class="state state--timeout">
        <span class="state-num">3</span>
        <i class="ti ti-clock-exclamation"></i>
        <h3>Timeout</h3>
        <p>brak ACK</p>
      </article>

      <div class="arrow" aria-hidden="true"><i class="ti ti-arrow-right"></i></div>

      <article class="state state--available">
        <span class="state-num">4</span>
        <i class="ti ti-refresh"></i>
        <h3>Available again</h3>
        <p>wraca do kolejki</p>
      </article>

      <svg class="loop-back" viewBox="0 0 1400 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <marker id="loopArrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="rgba(34, 211, 238, 0.65)"/>
          </marker>
        </defs>
        <path d="M 1300 10 Q 1300 70 700 70 Q 100 70 100 20"
              fill="none"
              stroke="rgba(34, 211, 238, 0.55)"
              stroke-width="2"
              stroke-dasharray="8 8"
              marker-end="url(#loopArrow)"/>
        <text x="700" y="58" text-anchor="middle" fill="rgba(34, 211, 238, 0.85)" font-size="16" font-weight="600" letter-spacing="3">
          redelivery
        </text>
      </svg>
    </section>

    <ul class="steps" aria-label="Mechanizm timeoutu">
      <li>
        <span class="step-num">1</span>
        <span class="step-text">Consumer pobiera wiadomość i blokuje ją na czas przetwarzania</span>
      </li>
      <li>
        <span class="step-num">2</span>
        <span class="step-text">Broker oczekuje na ACK przez określony timeout</span>
      </li>
      <li>
        <span class="step-num">3</span>
        <span class="step-text">Brak ACK oznacza dla brokera: wiadomość nie została skutecznie przetworzona</span>
      </li>
      <li>
        <span class="step-num">4</span>
        <span class="step-text">Wiadomość wraca do kolejki i może trafić do innego workera</span>
      </li>
    </ul>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 48px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 28px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 80px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 24px;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .cycle {
    width: 100%;
    max-width: 1500px;
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    margin-bottom: 90px;
    padding-bottom: 60px;
  }

  .state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 26px 16px;
    min-height: 220px;
    background: rgba(17, 24, 39, 0.62);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.32);
    text-align: center;
    position: relative;
    opacity: 0;
    animation: fadeUp 0.85s ease-out forwards;
  }

  .cycle > .state:nth-child(1) { animation-delay: 0.55s; }
  .cycle > .state:nth-child(3) { animation-delay: 0.78s; }
  .cycle > .state:nth-child(5) { animation-delay: 1.01s; }
  .cycle > .state:nth-child(7) { animation-delay: 1.24s; }

  .state-num {
    position: absolute;
    top: 10px;
    left: 14px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 2px;
    color: rgba(148, 163, 184, 0.65);
    font-variant-numeric: tabular-nums;
  }

  .state i {
    width: 72px;
    height: 72px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 38px;
  }

  .state h3 {
    margin: 0;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.3px;
    line-height: 1.1;
    color: #f0f4f8;
  }

  .state p {
    margin: 0;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.3;
    color: rgba(203, 213, 225, 0.78);
    font-style: italic;
    letter-spacing: 0.3px;
  }

  .state--locked i {
    background: rgba(251, 191, 36, 0.14);
    border-color: rgba(251, 191, 36, 0.45);
    color: #fbbf24;
  }

  .state--timeout i {
    background: rgba(248, 113, 113, 0.14);
    border-color: rgba(248, 113, 113, 0.50);
    color: #f87171;
  }

  .state--timeout h3 {
    color: #fecaca;
  }

  .arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    opacity: 0;
    animation: fadeIn 0.7s ease-out forwards;
  }

  .cycle > .arrow:nth-child(2) { animation-delay: 0.7s; }
  .cycle > .arrow:nth-child(4) { animation-delay: 0.93s; }
  .cycle > .arrow:nth-child(6) { animation-delay: 1.16s; }

  .arrow i {
    font-size: 36px;
    color: rgba(34, 211, 238, 0.65);
  }

  .loop-back {
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: 0;
    width: 92%;
    height: 80px;
    opacity: 0;
    animation: fadeIn 1s ease-out 1.5s forwards;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 1400px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 22px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.7s forwards;
  }

  .steps li {
    display: grid;
    grid-template-columns: 52px 1fr;
    align-items: center;
    gap: 18px;
    padding: 18px 22px;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 14px;
    text-align: left;
  }

  .step-num {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 22px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .step-text {
    font-size: 22px;
    font-weight: 500;
    line-height: 1.3;
    color: #e2e8f0;
    letter-spacing: -0.2px;
  }

  @media (max-width: 1300px) {
    .title {
      font-size: 60px;
    }

    .cycle {
      grid-template-columns: 1fr;
      gap: 14px;
      padding-bottom: 0;
      margin-bottom: 44px;
    }

    .arrow {
      width: 100%;
      transform: rotate(90deg);
    }

    .loop-back {
      display: none;
    }

    .state {
      min-height: 160px;
      padding: 22px 18px;
    }

    .state h3 {
      font-size: 24px;
    }

    .steps {
      grid-template-columns: 1fr;
    }

    .step-text {
      font-size: 20px;
    }
  }

  @media (max-width: 700px) {
    .content {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }

    .title {
      font-size: 42px;
    }

    .eyebrow {
      font-size: 16px;
      letter-spacing: 4px;
    }

    .steps li {
      grid-template-columns: 40px 1fr;
      gap: 14px;
      padding: 14px 16px;
    }

    .step-num {
      width: 40px;
      height: 40px;
      font-size: 18px;
    }

    .step-text {
      font-size: 18px;
    }
  }
</style>
