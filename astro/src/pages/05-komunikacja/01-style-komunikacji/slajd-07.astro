---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 07 - To nie bug — to kontrakt brokera"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.84), rgba(10,14,23,0.94))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="contractGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="contractGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.20"/>
        <stop offset="65%" stop-color="#22d3ee" stop-opacity="0.05"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#contractGrid)"/>
    <circle cx="960" cy="540" r="560" fill="url(#contractGlow)"/>
  </svg>

  <div class="content">
    <p class="eyebrow">Zmiana perspektywy</p>

    <h1 class="title">
      <span class="title-main">To nie bug —</span>
      <span class="title-sub">to <span class="highlight">kontrakt brokera</span></span>
    </h1>

    <section class="manifesto" aria-label="Kluczowa teza">
      <div class="manifesto-side manifesto-side--left">
        <span class="side-label">Infrastructure</span>
        <span class="side-value">Correct</span>
      </div>

      <div class="manifesto-symbol" aria-hidden="true">
        <span class="symbol">≠</span>
      </div>

      <div class="manifesto-side manifesto-side--right">
        <span class="side-label">Business effect</span>
        <span class="side-value">Exactly-once</span>
      </div>
    </section>

    <ul class="claims" aria-label="Tezy slajdu">
      <li class="claim claim--ok">
        <i class="ti ti-check"></i>
        <span>Worker mógł wykonać poprawną logikę</span>
      </li>
      <li class="claim claim--ok">
        <i class="ti ti-check"></i>
        <span>Broker mógł działać zgodnie ze specyfikacją</span>
      </li>
      <li class="claim claim--problem">
        <i class="ti ti-alert-triangle"></i>
        <span>Mimo tego efekt biznesowy wystąpił dwa razy</span>
      </li>
      <li class="claim claim--rule">
        <i class="ti ti-shield-check"></i>
        <span><strong>Architektura musi zakładać duplikaty</strong></span>
      </li>
    </ul>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: center;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 40px 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 18px;
    font-size: 20px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 6px;
    color: rgba(34, 211, 238, 0.78);
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .title {
    font-size: 84px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 56px;
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.35s forwards;
  }

  .title-main,
  .title-sub {
    display: block;
  }

  .title-sub {
    margin-top: 4px;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .manifesto {
    width: 100%;
    max-width: 1500px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 24px;
    margin-bottom: 56px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.6s forwards;
  }

  .manifesto-side {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 44px 28px;
    border-radius: 22px;
    background: rgba(17, 24, 39, 0.65);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    box-shadow: 0 28px 70px rgba(2, 6, 23, 0.34);
  }

  .manifesto-side--left {
    border-color: rgba(34, 197, 94, 0.40);
    background: linear-gradient(135deg, rgba(20, 83, 45, 0.22), rgba(17, 24, 39, 0.65));
  }

  .manifesto-side--right {
    border-color: rgba(248, 113, 113, 0.45);
    background: linear-gradient(135deg, rgba(127, 29, 29, 0.22), rgba(17, 24, 39, 0.65));
  }

  .side-label {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: rgba(148, 163, 184, 0.78);
  }

  .manifesto-side--left .side-label {
    color: rgba(74, 222, 128, 0.85);
  }

  .manifesto-side--right .side-label {
    color: rgba(248, 113, 113, 0.85);
  }

  .side-value {
    font-size: 64px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    color: #f0f4f8;
  }

  .manifesto-side--left .side-value {
    color: #d1fae5;
  }

  .manifesto-side--right .side-value {
    color: #fecaca;
  }

  .manifesto-symbol {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
  }

  .symbol {
    font-size: 140px;
    font-weight: 800;
    line-height: 1;
    color: var(--cyan-400);
    text-shadow:
      0 0 32px rgba(34, 211, 238, 0.55),
      0 0 64px rgba(34, 211, 238, 0.25);
    animation: pulseSymbol 2.2s ease-in-out infinite;
  }

  .claims {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 1400px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 22px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.95s forwards;
  }

  .claim {
    display: grid;
    grid-template-columns: 52px 1fr;
    align-items: center;
    gap: 18px;
    padding: 20px 24px;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 14px;
    text-align: left;
  }

  .claim i {
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 24px;
  }

  .claim span {
    font-size: 24px;
    font-weight: 500;
    line-height: 1.3;
    color: #e2e8f0;
    letter-spacing: -0.2px;
  }

  .claim--ok i {
    background: rgba(34, 197, 94, 0.14);
    border-color: rgba(34, 197, 94, 0.45);
    color: #4ade80;
  }

  .claim--problem {
    border-color: rgba(248, 113, 113, 0.40);
    background: rgba(127, 29, 29, 0.18);
  }

  .claim--problem i {
    background: rgba(248, 113, 113, 0.16);
    border-color: rgba(248, 113, 113, 0.55);
    color: #f87171;
  }

  .claim--problem span {
    color: #fecaca;
  }

  .claim--rule {
    grid-column: 1 / -1;
    border-color: rgba(34, 211, 238, 0.55);
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.28), rgba(17, 24, 39, 0.65));
    box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.05);
  }

  .claim--rule i {
    background: rgba(34, 211, 238, 0.18);
    border-color: rgba(34, 211, 238, 0.55);
    color: var(--cyan-400);
  }

  .claim--rule span {
    color: #e2f6ff;
    font-size: 28px;
  }

  .claim--rule span strong {
    font-weight: 800;
  }

  @keyframes pulseSymbol {
    0%, 100% {
      text-shadow:
        0 0 32px rgba(34, 211, 238, 0.55),
        0 0 64px rgba(34, 211, 238, 0.25);
    }
    50% {
      text-shadow:
        0 0 44px rgba(34, 211, 238, 0.80),
        0 0 88px rgba(34, 211, 238, 0.35);
    }
  }

  @media (max-width: 1300px) {
    .title {
      font-size: 60px;
    }

    .manifesto {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .symbol {
      font-size: 80px;
    }

    .manifesto-side {
      padding: 28px 22px;
    }

    .side-value {
      font-size: 48px;
    }

    .claims {
      grid-template-columns: 1fr;
    }

    .claim span {
      font-size: 20px;
    }

    .claim--rule span {
      font-size: 24px;
    }
  }

  @media (max-width: 700px) {
    .content {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }

    .title {
      font-size: 40px;
    }

    .eyebrow {
      font-size: 16px;
      letter-spacing: 4px;
    }

    .side-value {
      font-size: 36px;
    }

    .side-label {
      font-size: 14px;
      letter-spacing: 3px;
    }

    .symbol {
      font-size: 60px;
    }

    .claim {
      grid-template-columns: 40px 1fr;
      gap: 14px;
      padding: 14px 16px;
    }

    .claim i {
      width: 40px;
      height: 40px;
      font-size: 22px;
    }

    .claim span {
      font-size: 18px;
    }
  }
</style>
