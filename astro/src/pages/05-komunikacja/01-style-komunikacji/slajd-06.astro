---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 06 - Duplikat operacji biznesowej"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.82), rgba(10,14,23,0.92))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="dupGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.06)" stroke-width="1"/>
      </pattern>
      <radialGradient id="dupGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#f87171" stop-opacity="0.14"/>
        <stop offset="70%" stop-color="#f87171" stop-opacity="0.03"/>
        <stop offset="100%" stop-color="#f87171" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#dupGrid)"/>
    <circle cx="1100" cy="540" r="520" fill="url(#dupGlow)"/>
  </svg>

  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-copy"></i>Konsekwencja</span>
      <h1 class="title">
        Duplikat <span class="highlight">operacji biznesowej</span>
      </h1>
    </div>

    <section class="tracks" aria-label="Porównanie dwóch przebiegów">
      <article class="track">
        <header class="track-head">
          <span class="track-tag">Worker A</span>
          <h2>Pierwsze przetworzenie</h2>
        </header>
        <div class="track-flow">
          <div class="event event--ok">
            <i class="ti ti-credit-card"></i>
            <span class="event-label">Charge OK</span>
          </div>
          <div class="track-arrow" aria-hidden="true"><i class="ti ti-arrow-right"></i></div>
          <div class="event event--crash">
            <i class="ti ti-bolt"></i>
            <span class="event-label">Crash before ACK</span>
          </div>
        </div>
      </article>

      <article class="track track--duplicate">
        <header class="track-head">
          <span class="track-tag track-tag--alt">Worker B</span>
          <h2>Drugie przetworzenie</h2>
        </header>
        <div class="track-flow">
          <div class="event event--redeliver">
            <i class="ti ti-refresh"></i>
            <span class="event-label">Redelivery</span>
          </div>
          <div class="track-arrow" aria-hidden="true"><i class="ti ti-arrow-right"></i></div>
          <div class="event event--duplicate">
            <i class="ti ti-credit-card"></i>
            <span class="event-label">Charge again</span>
            <span class="event-badge">duplikat</span>
          </div>
        </div>
      </article>
    </section>

    <ul class="facts" aria-label="Konsekwencje techniczne i biznesowe">
      <li>
        <i class="ti ti-repeat"></i>
        <span>Ta sama wiadomość może zostać obsłużona ponownie</span>
      </li>
      <li>
        <i class="ti ti-cpu"></i>
        <span>Drugi worker wykonuje ten sam scenariusz</span>
      </li>
      <li>
        <i class="ti ti-api"></i>
        <span>Zewnętrzne API może potraktować request jako nową operację</span>
      </li>
      <li class="facts-impact">
        <i class="ti ti-alert-octagon"></i>
        <span><strong>Efekt:</strong> klient zostaje obciążony dwa razy</span>
      </li>
    </ul>

  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 40px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 28px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 76px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 12px;
  }

  .title .highlight {
    background: linear-gradient(135deg, #fb7185, #f87171);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tracks {
    width: 100%;
    max-width: 1500px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
    margin-bottom: 36px;
  }

  .track {
    display: grid;
    grid-template-columns: 280px 1fr;
    align-items: center;
    gap: 28px;
    padding: 22px 28px;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 18px;
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.32);
    text-align: left;
    opacity: 0;
    animation: fadeUp 0.85s ease-out forwards;
  }

  .tracks > .track:nth-child(1) { animation-delay: 0.55s; }
  .tracks > .track:nth-child(2) { animation-delay: 0.95s; }

  .track--duplicate {
    border-color: rgba(248, 113, 113, 0.40);
    background: linear-gradient(135deg, rgba(127, 29, 29, 0.18), rgba(17, 24, 39, 0.6));
  }

  .track-head {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .track-tag {
    align-self: flex-start;
    padding: 4px 12px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.45);
    color: var(--cyan-400);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .track-tag--alt {
    background: rgba(248, 113, 113, 0.14);
    border-color: rgba(248, 113, 113, 0.50);
    color: #fecaca;
  }

  .track-head h2 {
    margin: 0;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.1;
    color: #f0f4f8;
    letter-spacing: -0.3px;
  }

  .track-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 18px;
  }

  .event {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 18px 22px;
    border-radius: 14px;
    background: rgba(17, 24, 39, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.22);
    min-height: 70px;
    position: relative;
  }

  .event i {
    font-size: 28px;
    color: var(--cyan-400);
  }

  .event-label {
    font-size: 22px;
    font-weight: 700;
    color: #e2e8f0;
    line-height: 1.15;
    letter-spacing: -0.2px;
  }

  .event--ok {
    border-color: rgba(34, 197, 94, 0.45);
    background: rgba(20, 83, 45, 0.18);
  }

  .event--ok i {
    color: #4ade80;
  }

  .event--ok .event-label {
    color: #d1fae5;
  }

  .event--crash {
    border-color: rgba(251, 191, 36, 0.45);
    background: rgba(180, 83, 9, 0.18);
  }

  .event--crash i {
    color: #fbbf24;
  }

  .event--crash .event-label {
    color: #fff7ed;
  }

  .event--redeliver {
    border-color: rgba(34, 211, 238, 0.42);
    background: rgba(8, 145, 178, 0.16);
  }

  .event--redeliver i {
    color: var(--cyan-400);
  }

  .event--duplicate {
    border-color: rgba(248, 113, 113, 0.55);
    background: rgba(127, 29, 29, 0.30);
    box-shadow: 0 0 28px rgba(248, 113, 113, 0.30);
  }

  .event--duplicate i {
    color: #f87171;
  }

  .event--duplicate .event-label {
    color: #fecaca;
  }

  .event-badge {
    position: absolute;
    top: -10px;
    right: 12px;
    padding: 3px 10px;
    border-radius: 999px;
    background: #b91c1c;
    border: 1px solid rgba(254, 202, 202, 0.55);
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .track-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
  }

  .track-arrow i {
    font-size: 32px;
    color: rgba(148, 163, 184, 0.65);
  }

  .facts {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    width: 100%;
    max-width: 1500px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px 22px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.35s forwards;
  }

  .facts li {
    display: grid;
    grid-template-columns: 52px 1fr;
    align-items: center;
    gap: 18px;
    padding: 16px 22px;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 14px;
    text-align: left;
  }

  .facts li i {
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 24px;
  }

  .facts li span {
    font-size: 22px;
    font-weight: 500;
    line-height: 1.3;
    color: #e2e8f0;
    letter-spacing: -0.2px;
  }

  .facts-impact {
    border-color: rgba(248, 113, 113, 0.50);
    background: rgba(127, 29, 29, 0.20);
  }

  .facts-impact i {
    background: rgba(248, 113, 113, 0.16);
    border-color: rgba(248, 113, 113, 0.55);
    color: #f87171;
  }

  .facts-impact span {
    color: #fecaca;
  }

  .facts-impact span strong {
    color: #fff;
    font-weight: 800;
  }

  .note {
    width: auto;
    max-width: 1400px;
    display: inline-flex;
    gap: 22px;
    align-items: center;
    justify-content: flex-start;
    margin: 0 auto;
    padding: 22px 30px;
    background: linear-gradient(135deg, rgba(180, 83, 9, 0.22), rgba(120, 53, 15, 0.08));
    border: 1px solid rgba(251, 191, 36, 0.45);
    border-radius: 16px;
    box-shadow: 0 18px 48px rgba(180, 83, 9, 0.18);
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.6s forwards;
  }

  .note > i {
    width: 60px;
    height: 60px;
    border-radius: 14px;
    background: rgba(251, 191, 36, 0.16);
    border: 1px solid rgba(251, 191, 36, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    color: #fbbf24;
    flex-shrink: 0;
  }

  .note-body {
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .note-eyebrow {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(251, 191, 36, 0.85);
  }

  .note-main {
    margin: 0;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.3;
    color: #fff7ed;
  }

  .note-main .accent {
    color: #fbbf24;
    font-weight: 700;
  }

  @media (max-width: 1300px) {
    .title {
      font-size: 58px;
    }

    .track {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .track-flow {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .track-arrow {
      width: 100%;
      transform: rotate(90deg);
    }

    .facts {
      grid-template-columns: 1fr;
    }

    .facts li span {
      font-size: 20px;
    }

    .note-main {
      font-size: 20px;
    }
  }

  @media (max-width: 700px) {
    .content {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }

    .title {
      font-size: 40px;
    }

    .eyebrow {
      font-size: 16px;
      letter-spacing: 4px;
    }

    .event-label {
      font-size: 18px;
    }

    .track-head h2 {
      font-size: 22px;
    }

    .facts li {
      grid-template-columns: 44px 1fr;
      gap: 14px;
      padding: 14px 16px;
    }

    .facts li i {
      width: 40px;
      height: 40px;
      font-size: 22px;
    }

    .facts li span {
      font-size: 18px;
    }
  }
</style>
