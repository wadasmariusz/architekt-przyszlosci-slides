---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 09 - Idempotentność jako wymaganie"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.90))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="idemGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="idemGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#idemGrid)"/>
    <circle cx="960" cy="540" r="520" fill="url(#idemGlow)"/>
  </svg>

  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-blueprint"></i>Zasada projektowa</span>
      <h1 class="title">
        Idempotentność <span class="highlight">jako wymaganie</span>
      </h1>
    </div>

    <section class="flow" aria-label="Zależność idempotentności">
      <article class="flow-node flow-node--multi">
        <div class="flow-stack" aria-hidden="true">
          <div class="flow-stack-card"></div>
          <div class="flow-stack-card"></div>
          <div class="flow-stack-card"></div>
        </div>
        <span class="flow-tag flow-tag--alt">Duplicate</span>
        <span class="flow-name">delivery</span>
      </article>

      <div class="flow-arrow" aria-hidden="true"><i class="ti ti-arrow-right"></i></div>

      <article class="flow-node flow-node--exec">
        <div class="flow-runs" aria-hidden="true">
          <i class="ti ti-player-play"></i>
          <i class="ti ti-player-play"></i>
          <i class="ti ti-player-play"></i>
        </div>
        <span class="flow-tag flow-tag--alt">Repeated</span>
        <span class="flow-name">handler execution</span>
      </article>

      <div class="flow-arrow" aria-hidden="true"><i class="ti ti-arrow-right"></i></div>

      <article class="flow-node flow-node--result">
        <div class="flow-ic flow-ic--result">
          <i class="ti ti-circle-check"></i>
        </div>
        <span class="flow-tag flow-tag--success">Same</span>
        <span class="flow-name">final state</span>
      </article>
    </section>

    <ul class="rules" aria-label="Reguły">
      <li>
        <i class="ti ti-rotate-clockwise"></i>
        <span>Handler może zostać uruchomiony wiele razy</span>
      </li>
      <li>
        <i class="ti ti-equal"></i>
        <span>Wynik biznesowy powinien pozostać taki sam</span>
      </li>
      <li>
        <i class="ti ti-shield-half"></i>
        <span>Operacje z efektami ubocznymi wymagają szczególnej ochrony</span>
      </li>
      <li class="rules-warning">
        <i class="ti ti-alert-octagon"></i>
        <span><strong>Brak idempotentności</strong> = ukryte ryzyko produkcyjne</span>
      </li>
    </ul>

    <aside class="note" aria-label="Adnotacja architektoniczna">
      <i class="ti ti-bookmark"></i>
      <div class="note-body">
        <p class="note-main">
          W systemach event-driven idempotentność <br>powinna być traktowana jak <span class="accent">wymaganie niefunkcjonalne</span>
        </p>
      </div>
    </aside>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 40px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 28px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 76px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 16px;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .flow {
    width: 100%;
    max-width: 1500px;
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    margin-bottom: 40px;
    padding: 32px 24px;
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.32);
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.55s forwards;
  }

  .flow-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    padding: 14px 12px;
    min-height: 220px;
  }

  .flow-stack {
    position: relative;
    width: 110px;
    height: 86px;
  }

  .flow-stack-card {
    position: absolute;
    width: 78px;
    height: 60px;
    border-radius: 14px;
    background: rgba(251, 191, 36, 0.12);
    border: 1px solid rgba(251, 191, 36, 0.45);
  }

  .flow-stack-card:nth-child(1) {
    top: 0;
    left: 0;
    transform: rotate(-6deg);
    background: rgba(251, 191, 36, 0.08);
  }

  .flow-stack-card:nth-child(2) {
    top: 10px;
    left: 14px;
    transform: rotate(2deg);
    background: rgba(251, 191, 36, 0.14);
  }

  .flow-stack-card:nth-child(3) {
    top: 22px;
    left: 28px;
    transform: rotate(9deg);
    background: rgba(251, 191, 36, 0.20);
    box-shadow: 0 8px 24px rgba(251, 191, 36, 0.20);
  }

  .flow-runs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    height: 86px;
  }

  .flow-runs i {
    width: 56px;
    height: 56px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: rgba(251, 191, 36, 0.12);
    border: 1px solid rgba(251, 191, 36, 0.45);
    color: #fbbf24;
    font-size: 26px;
  }

  .flow-ic--result {
    width: 96px;
    height: 96px;
    border-radius: 24px;
    background: rgba(34, 197, 94, 0.16);
    border: 1px solid rgba(34, 197, 94, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 32px rgba(34, 197, 94, 0.25);
  }

  .flow-ic--result i {
    font-size: 52px;
    color: #4ade80;
  }

  .flow-tag {
    margin-top: 10px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.45);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }

  .flow-tag--alt {
    background: rgba(251, 191, 36, 0.14);
    border-color: rgba(251, 191, 36, 0.45);
    color: #fbbf24;
  }

  .flow-tag--success {
    background: rgba(34, 197, 94, 0.16);
    border-color: rgba(34, 197, 94, 0.55);
    color: #4ade80;
  }

  .flow-name {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.3px;
    line-height: 1.1;
    color: #f0f4f8;
  }

  .flow-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
  }

  .flow-arrow i {
    font-size: 38px;
    color: rgba(34, 211, 238, 0.65);
  }

  .rules {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    width: 100%;
    max-width: 1500px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px 22px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.15s forwards;
  }

  .rules li {
    display: grid;
    grid-template-columns: 52px 1fr;
    align-items: center;
    gap: 18px;
    padding: 16px 22px;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 14px;
    text-align: left;
  }

  .rules li i {
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 24px;
  }

  .rules li span {
    font-size: 22px;
    font-weight: 500;
    line-height: 1.3;
    color: #e2e8f0;
    letter-spacing: -0.2px;
  }

  .rules-warning {
    border-color: rgba(248, 113, 113, 0.45);
    background: rgba(127, 29, 29, 0.20);
  }

  .rules-warning i {
    background: rgba(248, 113, 113, 0.16);
    border-color: rgba(248, 113, 113, 0.55);
    color: #f87171;
  }

  .rules-warning span {
    color: #fecaca;
  }

  .rules-warning span strong {
    color: #fff;
    font-weight: 800;
  }

  .note {
    width: auto;
    max-width: 1400px;
    display: inline-flex;
    gap: 22px;
    align-items: center;
    justify-content: flex-start;
    align-self: flex-start;
    margin: 0;
    padding: 22px 30px;
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.20), rgba(17, 24, 39, 0.62));
    border: 1px solid rgba(34, 211, 238, 0.50);
    border-radius: 16px;
    box-shadow: 0 18px 48px rgba(8, 145, 178, 0.20);
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.4s forwards;
  }

  .note > i {
    width: 60px;
    height: 60px;
    border-radius: 14px;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    color: var(--cyan-400);
    flex-shrink: 0;
  }

  .note-body {
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .note-eyebrow {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(34, 211, 238, 0.85);
  }

  .note-main {
    margin: 0;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.3;
    color: #e2f6ff;
  }

  .note-main .accent {
    color: var(--cyan-400);
    font-weight: 700;
  }

  @media (max-width: 1300px) {
    .title {
      font-size: 56px;
    }

    .flow {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .flow-arrow {
      width: 100%;
      transform: rotate(90deg);
    }

    .flow-node {
      min-height: 180px;
    }

    .rules {
      grid-template-columns: 1fr;
    }

    .rules li span {
      font-size: 20px;
    }

    .note-main {
      font-size: 20px;
    }
  }

  @media (max-width: 700px) {
    .content {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }

    .title {
      font-size: 40px;
    }

    .eyebrow {
      font-size: 16px;
      letter-spacing: 4px;
    }

    .flow-name {
      font-size: 20px;
    }

    .rules li {
      grid-template-columns: 40px 1fr;
      gap: 14px;
      padding: 14px 16px;
    }

    .rules li i {
      width: 40px;
      height: 40px;
      font-size: 22px;
    }

    .rules li span {
      font-size: 18px;
    }
  }
</style>
