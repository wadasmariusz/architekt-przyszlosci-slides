---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 17 - Kolejność w partycji"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.82), rgba(10,14,23,0.92))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="partGrid17" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="partGlow17" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="66%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#partGrid17)"/>
    <circle cx="960" cy="540" r="540" fill="url(#partGlow17)"/>
  </svg>

  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-layout-grid"></i>Rozwiązanie #1</span>
      <h1 class="title">
        Kolejność w <span class="highlight">partycji</span>
      </h1>
    </div>

    <section class="partitions" aria-label="Trzy partycje z kluczem OrderId">
      <article class="partition partition--active">
        <header class="partition-head">
          <span class="partition-tag"><i class="ti ti-database"></i>Partition 1</span>
          <span class="partition-key">
            <span class="key-label">partition key</span>
            <code>OrderId = 123</code>
          </span>
        </header>
        <ol class="events" aria-label="Eventy partycji 1">
          <li>
            <span class="ev-step">1</span>
            <code>Placed</code>
          </li>
          <li>
            <span class="ev-step">2</span>
            <code>Paid</code>
          </li>
          <li>
            <span class="ev-step">3</span>
            <code>Confirmed</code>
          </li>
        </ol>
        <footer class="partition-foot">
          <i class="ti ti-arrow-narrow-right"></i>
          <span>kolejność <strong>zachowana</strong></span>
        </footer>
      </article>

      <article class="partition partition--muted">
        <header class="partition-head">
          <span class="partition-tag"><i class="ti ti-database"></i>Partition 2</span>
          <span class="partition-key">
            <span class="key-label">partition key</span>
            <code>OrderId = 456</code>
          </span>
        </header>
        <ol class="events events--muted" aria-label="Eventy partycji 2">
          <li>
            <span class="ev-step">·</span>
            <code>inne eventy</code>
          </li>
          <li>
            <span class="ev-step">·</span>
            <code>inne eventy</code>
          </li>
          <li>
            <span class="ev-step">·</span>
            <code>inne eventy</code>
          </li>
        </ol>
        <footer class="partition-foot partition-foot--muted">
          <i class="ti ti-arrow-narrow-right"></i>
          <span>własna kolejność</span>
        </footer>
      </article>

      <article class="partition partition--muted">
        <header class="partition-head">
          <span class="partition-tag"><i class="ti ti-database"></i>Partition 3</span>
          <span class="partition-key">
            <span class="key-label">partition key</span>
            <code>OrderId = 789</code>
          </span>
        </header>
        <ol class="events events--muted" aria-label="Eventy partycji 3">
          <li>
            <span class="ev-step">·</span>
            <code>inne eventy</code>
          </li>
          <li>
            <span class="ev-step">·</span>
            <code>inne eventy</code>
          </li>
          <li>
            <span class="ev-step">·</span>
            <code>inne eventy</code>
          </li>
        </ol>
        <footer class="partition-foot partition-foot--muted">
          <i class="ti ti-arrow-narrow-right"></i>
          <span>własna kolejność</span>
        </footer>
      </article>
    </section>

    <ul class="points" aria-label="Zasady partycjonowania">
      <li>
        <i class="ti ti-lock-check"></i>
        <span>Gwarancja kolejności działa <strong>tylko w obrębie tej samej partycji</strong></span>
      </li>
      <li>
        <i class="ti ti-key"></i>
        <span>Eventy dla jednej encji powinny mieć <strong>ten sam</strong> <code>partition key</code></span>
      </li>
      <li>
        <i class="ti ti-shopping-cart"></i>
        <span>Dla zamówień naturalnym kandydatem bywa <code>OrderId</code></span>
      </li>
    </ul>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1660px;
    padding: 36px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 24px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 14px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 74px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 8px;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .partitions {
    width: 100%;
    max-width: 1560px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 26px;
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.55s forwards;
  }

  .partition {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 18px 18px 16px;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 18px;
    box-shadow: 0 18px 44px rgba(2, 6, 23, 0.28);
  }

  .partition--active {
    background: linear-gradient(180deg, rgba(8, 145, 178, 0.22), rgba(17, 24, 39, 0.6));
    border-color: rgba(34, 211, 238, 0.5);
    box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.05), 0 18px 48px rgba(8, 145, 178, 0.22);
  }

  .partition--muted {
    opacity: 0.86;
  }

  .partition-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
    text-align: left;
  }

  .partition-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.12);
    border: 1px solid rgba(148, 163, 184, 0.28);
    color: rgba(226, 232, 240, 0.95);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .partition-tag i { font-size: 16px; }

  .partition--active .partition-tag {
    background: rgba(34, 211, 238, 0.16);
    border-color: rgba(34, 211, 238, 0.5);
    color: var(--cyan-400);
  }

  .partition-key {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .key-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(148, 163, 184, 0.85);
  }

  .partition-key code {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 18px;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 8px;
    background: rgba(2, 6, 23, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.28);
    color: #e5e7eb;
  }

  .partition--active .partition-key code {
    border-color: rgba(34, 211, 238, 0.5);
    color: var(--cyan-400);
    background: rgba(8, 145, 178, 0.18);
  }

  .events {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .events::before {
    content: '';
    position: absolute;
    top: 20px;
    bottom: 20px;
    left: 19px;
    width: 2px;
    background: linear-gradient(180deg, rgba(34, 211, 238, 0.75), rgba(34, 211, 238, 0.22));
  }

  .events--muted::before {
    background: linear-gradient(180deg, rgba(148, 163, 184, 0.45), rgba(148, 163, 184, 0.15));
  }

  .events li {
    position: relative;
    display: grid;
    grid-template-columns: 40px 1fr;
    align-items: center;
    gap: 12px;
    padding: 8px 10px;
    border-radius: 12px;
    text-align: left;
  }

  .ev-step {
    position: relative;
    z-index: 1;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.94);
    border: 1px solid rgba(34, 211, 238, 0.55);
    color: var(--cyan-400);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 16px;
    font-weight: 900;
  }

  .events--muted .ev-step {
    border-color: rgba(148, 163, 184, 0.4);
    color: rgba(148, 163, 184, 0.85);
  }

  .events li code {
    display: block;
    padding: 10px 14px;
    border-radius: 10px;
    background: rgba(2, 6, 23, 0.42);
    border: 1px solid rgba(34, 211, 238, 0.28);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 18px;
    font-weight: 800;
    color: #e5e7eb;
  }

  .events--muted li code {
    border-color: rgba(148, 163, 184, 0.22);
    color: rgba(203, 213, 225, 0.85);
    font-style: italic;
    font-weight: 700;
  }

  .partition-foot {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.18);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: #a5f3fc;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.5px;
    align-self: flex-start;
  }

  .partition-foot i { font-size: 18px; }

  .partition-foot strong {
    color: var(--cyan-400);
    font-weight: 900;
  }

  .partition-foot--muted {
    background: rgba(148, 163, 184, 0.1);
    border-color: rgba(148, 163, 184, 0.32);
    color: rgba(226, 232, 240, 0.85);
  }

  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 1560px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.05s forwards;
  }

  .points li {
    display: grid;
    grid-template-columns: 52px 1fr;
    align-items: center;
    gap: 18px;
    padding: 18px 22px;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 14px;
    text-align: left;
  }

  .points li > i {
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 24px;
  }

  .points li span {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
    color: #e2e8f0;
    letter-spacing: -0.2px;
  }

  .points li code {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 18px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 8px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
  }

  .points li strong {
    color: #fff;
    font-weight: 800;
  }

  @media (max-width: 1300px) {
    .title {
      font-size: 54px;
    }

    .partitions {
      grid-template-columns: 1fr;
    }

    .points {
      grid-template-columns: 1fr;
    }

    .points li span {
      font-size: 18px;
    }
  }

  @media (max-width: 700px) {
    .content {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }

    .title {
      font-size: 40px;
    }

    .events li code {
      font-size: 16px;
    }

    .points li {
      grid-template-columns: 40px 1fr;
      gap: 14px;
      padding: 14px 16px;
    }

    .points li > i {
      width: 40px;
      height: 40px;
      font-size: 22px;
    }

    .points li span {
      font-size: 17px;
    }
  }
</style>
</content>
</invoke>