---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 03 - Przykład: płatność online"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.90))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="payGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="payGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.16"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#payGrid)"/>
    <circle cx="960" cy="560" r="520" fill="url(#payGlow)"/>
  </svg>

  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-credit-card"></i>Przykład</span>
      <h1 class="title">
        <span class="title-main">Płatność online</span>
      </h1>
    </div>

    <section class="flow" aria-label="Diagram sekwencji płatności">
      <article class="node">
        <div class="ic"><i class="ti ti-stack-2"></i></div>
        <h3>Queue</h3>
      </article>

      <div class="arrow" aria-hidden="true">
        <i class="ti ti-arrow-right"></i>
      </div>

      <article class="node">
        <div class="ic"><i class="ti ti-cpu"></i></div>
        <h3>Payment Worker</h3>
      </article>

      <div class="arrow" aria-hidden="true">
        <i class="ti ti-arrow-right"></i>
      </div>

      <article class="node">
        <div class="ic"><i class="ti ti-credit-card"></i></div>
        <h3>Stripe</h3>
      </article>

      <div class="arrow" aria-hidden="true">
        <i class="ti ti-arrow-right"></i>
      </div>

      <article class="node">
        <div class="ic"><i class="ti ti-database"></i></div>
        <h3>Database</h3>
      </article>
    </section>

    <ol class="steps" aria-label="Kroki happy path">
      <li class="step">
        <span class="step-num">1</span>
        <span class="step-text">Worker pobiera wiadomość z kolejki</span>
      </li>
      <li class="step">
        <span class="step-num">2</span>
        <span class="step-text">Wywołuje zewnętrzny system płatności, np. Stripe</span>
      </li>
      <li class="step">
        <span class="step-num">3</span>
        <span class="step-text">Otrzymuje status poprawnego obciążenia karty</span>
      </li>
      <li class="step">
        <span class="step-num">4</span>
        <span class="step-text">Zapisuje informację o zakończonej transakcji</span>
      </li>
    </ol>

    <p class="footnote">Happy path</p>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 56px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 24px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 88px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 52px;
  }

  .title-main,
  .title-sub {
    display: block;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .flow {
    width: 100%;
    max-width: 1500px;
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 18px;
    margin-bottom: 56px;
  }

  .node {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 30px 18px;
    min-height: 220px;
    background: rgba(17, 24, 39, 0.62);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.32);
    text-align: center;
    opacity: 0;
    animation: fadeUp 0.85s ease-out forwards;
  }

  .flow > .node:nth-child(1) { animation-delay: 0.55s; }
  .flow > .node:nth-child(3) { animation-delay: 0.78s; }
  .flow > .node:nth-child(5) { animation-delay: 1.01s; }
  .flow > .node:nth-child(7) { animation-delay: 1.24s; }

  .node .ic {
    width: 84px;
    height: 84px;
    border-radius: 20px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .node .ic i {
    font-size: 42px;
    color: var(--cyan-400);
  }

  .node h3 {
    margin: 0;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.3px;
    line-height: 1.1;
    color: #f0f4f8;
  }

  .arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    opacity: 0;
    animation: fadeIn 0.7s ease-out forwards;
  }

  .flow > .arrow:nth-child(2) { animation-delay: 0.7s; }
  .flow > .arrow:nth-child(4) { animation-delay: 0.93s; }
  .flow > .arrow:nth-child(6) { animation-delay: 1.16s; }

  .arrow i {
    font-size: 44px;
    color: rgba(34, 211, 238, 0.65);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 1280px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px 24px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.45s forwards;
  }

  .step {
    display: grid;
    grid-template-columns: 56px 1fr;
    align-items: center;
    gap: 20px;
    padding: 20px 24px;
    background: rgba(17, 24, 39, 0.58);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 14px;
    text-align: left;
  }

  .step-num {
    width: 48px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.4px;
    font-variant-numeric: tabular-nums;
  }

  .step-text {
    font-size: 24px;
    font-weight: 500;
    line-height: 1.3;
    color: #e2e8f0;
    letter-spacing: -0.2px;
  }

  .footnote {
    margin: 36px 0 0;
    font-size: 14px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: rgba(148, 163, 184, 0.6);
    opacity: 0;
    animation: fadeUp 0.8s ease-out 1.7s forwards;
  }

  @media (max-width: 1300px) {
    .title {
      font-size: 64px;
    }

    .flow {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .arrow {
      width: 100%;
      transform: rotate(90deg);
    }

    .node {
      min-height: 160px;
      padding: 22px 18px;
    }

    .node h3 {
      font-size: 24px;
    }

    .steps {
      grid-template-columns: 1fr;
    }

    .step-text {
      font-size: 20px;
    }
  }

  @media (max-width: 700px) {
    .content {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }

    .title {
      font-size: 44px;
    }

    .eyebrow {
      font-size: 16px;
      letter-spacing: 4px;
    }

    .step {
      grid-template-columns: 40px 1fr;
      gap: 14px;
      padding: 16px 18px;
    }

    .step-num {
      width: 40px;
      height: 40px;
      font-size: 20px;
    }

    .step-text {
      font-size: 18px;
    }
  }
</style>
