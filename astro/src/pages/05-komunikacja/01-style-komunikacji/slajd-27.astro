---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 27 - A jak to wygląda u Ciebie?"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.93))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="closingGrid27" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="closingGlow27" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="66%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#closingGrid27)"/>
    <circle cx="960" cy="500" r="560" fill="url(#closingGlow27)"/>
  </svg>

  <div class="content">
    <p class="eyebrow">
      <i class="ti ti-messages"></i>
      Twoje doświadczenie
    </p>

    <header class="hero">
      <h1 class="title">
        A jak to wygląda <span class="highlight">u Ciebie?</span>
      </h1>
      <p class="lead">
        Stosujesz komunikację asynchroniczną w swoich projektach?
      </p>
    </header>

    <section class="questions" aria-label="Pytania do widza">
      <article class="question question--1">
        <span class="question-number">01</span>
        <div class="question-icon"><i class="ti ti-circle-check"></i></div>
        <p>Co działa dobrze?</p>
      </article>

      <article class="question question--2">
        <span class="question-number">02</span>
        <div class="question-icon"><i class="ti ti-alert-triangle"></i></div>
        <p>Co sprawia najwięcej problemów?</p>
      </article>

      <article class="question question--3">
        <span class="question-number">03</span>
        <div class="question-icon"><i class="ti ti-bulb"></i></div>
        <p>Jakie wyzwania Cię zaskoczyły?</p>
      </article>
    </section>

    <section class="closing-row" aria-label="Wezwanie do komentarza i końcowa myśl">
      <div class="comment-cta">
        <i class="ti ti-message-circle"></i>
        <span>Daj znać w komentarzu</span>
      </div>

      <blockquote class="takeaway">
        <i class="ti ti-quote"></i>
        <p>
          Asynchroniczność nie usuwa złożoności. Ona zmienia miejsce, w którym trzeba ją świadomie obsłużyć.
        </p>
      </blockquote>
    </section>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1660px;
    padding: 64px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    margin: 0 0 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.10);
    border: 1px solid rgba(34, 211, 238, 0.36);
    color: var(--cyan-400);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .eyebrow i {
    font-size: 22px;
  }

  .hero {
    max-width: 1320px;
    margin: 0 auto 34px;
  }

  .title {
    font-size: 88px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.04;
    margin: 0;
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.3s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lead {
    max-width: 1080px;
    margin: 24px auto 0;
    color: rgba(226, 232, 240, 0.9);
    font-size: 34px;
    font-weight: 400;
    line-height: 1.28;
    letter-spacing: 0;
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.48s forwards;
  }

  .questions {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 30px;
  }

  .question {
    position: relative;
    min-height: 230px;
    padding: 30px 28px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    text-align: left;
    background: rgba(17, 24, 39, 0.62);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 18px;
    box-shadow: 0 22px 56px rgba(2, 6, 23, 0.30);
    overflow: hidden;
    opacity: 0;
    transform: translateY(24px);
    animation: fadeUp 0.85s ease-out forwards;
  }

  .question::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.13), transparent 56%);
    opacity: 0.75;
  }

  .question--1 { animation-delay: 0.68s; }
  .question--2 {
    animation-delay: 0.82s;
    border-color: rgba(251, 191, 36, 0.38);
    background:
      radial-gradient(circle at 88% 18%, rgba(251, 191, 36, 0.16), transparent 34%),
      rgba(17, 24, 39, 0.62);
  }
  .question--3 { animation-delay: 0.96s; }

  .question-number {
    position: absolute;
    top: 22px;
    right: 24px;
    color: rgba(148, 163, 184, 0.52);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 3px;
    font-feature-settings: "tnum";
  }

  .question-icon {
    position: relative;
    z-index: 1;
    width: 68px;
    height: 68px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 36px;
  }

  .question--2 .question-icon {
    background: rgba(251, 191, 36, 0.14);
    border-color: rgba(251, 191, 36, 0.48);
    color: #fbbf24;
  }

  .question p {
    position: relative;
    z-index: 1;
    max-width: 430px;
    margin: 0;
    color: #f8fafc;
    font-size: 32px;
    font-weight: 800;
    line-height: 1.16;
    letter-spacing: 0;
  }

  .closing-row {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.45fr);
    gap: 22px;
    align-items: stretch;
  }

  .comment-cta,
  .takeaway {
    opacity: 0;
    animation: fadeUp 0.85s ease-out 1.14s forwards;
  }

  .comment-cta {
    min-height: 130px;
    padding: 26px 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.28), rgba(17, 24, 39, 0.72));
    border: 1px solid rgba(34, 211, 238, 0.52);
    box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.05), 0 20px 52px rgba(8, 145, 178, 0.20);
  }

  .comment-cta i {
    width: 58px;
    height: 58px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 15px;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.48);
    color: var(--cyan-400);
    font-size: 32px;
  }

  .comment-cta span {
    color: #f8fafc;
    font-size: 31px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0;
  }

  .takeaway {
    position: relative;
    min-height: 130px;
    margin: 0;
    padding: 24px 34px 24px 74px;
    display: flex;
    align-items: center;
    border-radius: 16px;
    background:
      radial-gradient(circle at 8% 50%, rgba(251, 191, 36, 0.14), transparent 42%),
      rgba(15, 23, 42, 0.66);
    border: 1px solid rgba(251, 191, 36, 0.38);
    border-left: 3px solid #fbbf24;
    text-align: left;
  }

  .takeaway i {
    position: absolute;
    top: 26px;
    left: 28px;
    color: #fbbf24;
    font-size: 30px;
    opacity: 0.9;
  }

  .takeaway p {
    margin: 0;
    color: #fff7ed;
    font-size: 26px;
    font-weight: 500;
    font-style: italic;
    line-height: 1.36;
    letter-spacing: 0;
  }

  @media (max-width: 1300px) {
    .content {
      padding-top: 40px;
    }

    .title {
      font-size: 62px;
    }

    .lead {
      font-size: 26px;
    }

    .questions,
    .closing-row {
      grid-template-columns: 1fr;
    }

    .question {
      min-height: 150px;
    }

    .question p {
      font-size: 26px;
    }
  }

  @media (max-width: 700px) {
    .content {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }

    .eyebrow {
      font-size: 14px;
      letter-spacing: 2px;
    }

    .title {
      font-size: 44px;
    }

    .lead,
    .comment-cta span,
    .takeaway p {
      font-size: 20px;
    }

    .question {
      padding: 22px;
    }

    .question p {
      font-size: 23px;
    }
  }
</style>
