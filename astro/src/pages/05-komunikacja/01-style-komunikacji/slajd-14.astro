---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 14 - Kolejność zdarzeń płatności"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.90))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="evGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="evGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.16"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#evGrid)"/>
    <circle cx="960" cy="540" r="520" fill="url(#evGlow)"/>
  </svg>

  <div class="content">
    <p class="eyebrow">Przykład domenowy</p>

    <h1 class="title">
      Kolejność zdarzeń <span class="highlight">płatności</span>
    </h1>

    <section class="events" aria-label="Zdarzenia domenowe">
      <span class="event-pill"><i class="ti ti-play"></i>PaymentInitialized</span>
      <span class="event-pill"><i class="ti ti-credit-card"></i>PaymentPaid</span>
      <span class="event-pill"><i class="ti ti-receipt-refund"></i>PaymentRefunded</span>
    </section>

    <section class="timelines" aria-label="Porównanie kolejności">
      <article class="tl tl--good">
        <header class="tl-head">
          <span class="tl-tag tl-tag--good"><i class="ti ti-check"></i>Oczekiwana kolejność</span>
          <span class="tl-meta">domena</span>
        </header>
        <ol class="tl-axis tl-axis--good">
          <li><span class="tl-dot"></span><span class="tl-step">Initialized</span></li>
          <li><span class="tl-dot"></span><span class="tl-step">Paid</span></li>
          <li><span class="tl-dot"></span><span class="tl-step">Refunded</span></li>
        </ol>
      </article>

      <article class="tl tl--bad">
        <header class="tl-head">
          <span class="tl-tag tl-tag--bad"><i class="ti ti-x"></i>Możliwy scenariusz</span>
          <span class="tl-meta">async out-of-order</span>
        </header>
        <ol class="tl-axis tl-axis--bad">
          <li><span class="tl-dot"></span><span class="tl-step">Refunded</span></li>
          <li><span class="tl-dot"></span><span class="tl-step">Paid</span></li>
          <li><span class="tl-dot"></span><span class="tl-step">Initialized</span></li>
        </ol>
      </article>
    </section>

    <aside class="notes" aria-label="Adnotacja">
      <div class="note note--logic">
        <i class="ti ti-bulb"></i>
        <p>To <strong>sekwencja logiczna</strong> z punktu widzenia domeny</p>
      </div>
      <div class="note note--warn">
        <i class="ti ti-alert-triangle"></i>
        <p>System asynchroniczny <strong>nie gwarantuje automatycznie</strong>, że tak zostanie przetworzona</p>
      </div>
    </aside>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 36px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 14px;
    font-size: 20px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 6px;
    color: rgba(34, 211, 238, 0.78);
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .title {
    font-size: 76px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 36px;
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.35s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .events {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 36px;
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.55s forwards;
  }

  .event-pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 22px;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.20), rgba(17, 24, 39, 0.62));
    border: 1px solid rgba(34, 211, 238, 0.50);
    color: #e2f6ff;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.2px;
    box-shadow: 0 12px 28px rgba(8, 145, 178, 0.18);
  }

  .event-pill i {
    font-size: 22px;
    color: var(--cyan-400);
  }

  .timelines {
    width: 100%;
    max-width: 1500px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    margin-bottom: 28px;
  }

  .tl {
    padding: 22px 28px;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 18px;
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.30);
    text-align: left;
    opacity: 0;
    animation: fadeUp 0.85s ease-out forwards;
  }

  .timelines > .tl:nth-child(1) { animation-delay: 0.75s; }
  .timelines > .tl:nth-child(2) { animation-delay: 1.0s; }

  .tl--good {
    border-color: rgba(34, 197, 94, 0.45);
    background: linear-gradient(135deg, rgba(20, 83, 45, 0.20), rgba(17, 24, 39, 0.6));
  }

  .tl--bad {
    border-color: rgba(248, 113, 113, 0.45);
    background: linear-gradient(135deg, rgba(127, 29, 29, 0.20), rgba(17, 24, 39, 0.6));
  }

  .tl-head {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 18px;
  }

  .tl-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .tl-tag i {
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 16px;
    font-weight: 800;
  }

  .tl-tag--good {
    background: rgba(34, 197, 94, 0.16);
    border: 1px solid rgba(34, 197, 94, 0.55);
    color: #d1fae5;
  }

  .tl-tag--good i {
    background: #4ade80;
    color: #052e16;
  }

  .tl-tag--bad {
    background: rgba(248, 113, 113, 0.18);
    border: 1px solid rgba(248, 113, 113, 0.55);
    color: #fecaca;
  }

  .tl-tag--bad i {
    background: #f87171;
    color: #450a0a;
  }

  .tl-meta {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(148, 163, 184, 0.75);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }

  .tl-axis {
    list-style: none;
    margin: 0;
    padding: 16px 12px 8px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    position: relative;
  }

  .tl-axis::before {
    content: '';
    position: absolute;
    top: 28px;
    left: 6%;
    right: 6%;
    height: 2px;
    border-radius: 2px;
    z-index: 0;
  }

  .tl-axis--good::before {
    background: linear-gradient(90deg, rgba(34, 197, 94, 0.30), rgba(34, 197, 94, 0.85));
  }

  .tl-axis--bad::before {
    background: linear-gradient(90deg, rgba(248, 113, 113, 0.85), rgba(248, 113, 113, 0.30));
  }

  .tl-axis li {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .tl-dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(10, 14, 23, 0.9);
  }

  .tl-axis--good .tl-dot {
    background: #4ade80;
    border: 3px solid rgba(34, 197, 94, 0.30);
  }

  .tl-axis--bad .tl-dot {
    background: #f87171;
    border: 3px solid rgba(248, 113, 113, 0.30);
  }

  .tl-step {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 22px;
    font-weight: 800;
    color: #f0f4f8;
    letter-spacing: -0.2px;
  }

  .tl-axis--good .tl-step {
    color: #d1fae5;
  }

  .tl-axis--bad .tl-step {
    color: #fecaca;
  }

  .notes {
    width: 100%;
    max-width: 1500px;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 18px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.25s forwards;
  }

  .note {
    display: grid;
    grid-template-columns: 56px 1fr;
    align-items: center;
    gap: 18px;
    padding: 18px 24px;
    border-radius: 16px;
    text-align: left;
  }

  .note > i {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
  }

  .note p {
    margin: 0;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.2px;
  }

  .note--logic {
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.18), rgba(17, 24, 39, 0.62));
    border: 1px solid rgba(34, 211, 238, 0.45);
  }

  .note--logic > i {
    background: rgba(34, 211, 238, 0.16);
    border: 1px solid rgba(34, 211, 238, 0.55);
    color: var(--cyan-400);
  }

  .note--logic p {
    color: #e2f6ff;
  }

  .note--logic p strong {
    color: var(--cyan-400);
    font-weight: 800;
  }

  .note--warn {
    background: linear-gradient(135deg, rgba(180, 83, 9, 0.22), rgba(17, 24, 39, 0.62));
    border: 1px solid rgba(251, 191, 36, 0.45);
  }

  .note--warn > i {
    background: rgba(251, 191, 36, 0.16);
    border: 1px solid rgba(251, 191, 36, 0.55);
    color: #fbbf24;
  }

  .note--warn p {
    color: #fff7ed;
  }

  .note--warn p strong {
    color: #fbbf24;
    font-weight: 800;
  }

  @media (max-width: 1300px) {
    .title {
      font-size: 56px;
    }

    .event-pill {
      font-size: 20px;
      padding: 12px 18px;
    }

    .tl-axis {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .tl-axis::before {
      display: none;
    }

    .tl-axis li {
      flex-direction: row;
      justify-content: flex-start;
      gap: 14px;
    }

    .tl-step {
      font-size: 20px;
    }

    .notes {
      grid-template-columns: 1fr;
    }

    .note p {
      font-size: 20px;
    }
  }

  @media (max-width: 700px) {
    .content {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }

    .title {
      font-size: 40px;
    }

    .eyebrow {
      font-size: 16px;
      letter-spacing: 4px;
    }

    .event-pill {
      font-size: 16px;
      padding: 10px 14px;
    }

    .tl-step {
      font-size: 18px;
    }

    .note {
      grid-template-columns: 44px 1fr;
      gap: 14px;
      padding: 14px 18px;
    }

    .note > i {
      width: 40px;
      height: 40px;
      font-size: 22px;
    }

    .note p {
      font-size: 18px;
    }
  }
</style>
