---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 21 - Outbox Pattern"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.82), rgba(10,14,23,0.92))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="outboxGrid21" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="outboxGlow21" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="66%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#outboxGrid21)"/>
    <circle cx="960" cy="540" r="540" fill="url(#outboxGlow21)"/>
  </svg>

  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-mailbox"></i>Rozwiązanie #1 · Outbox</span>
      <h1 class="title">
        Outbox <span class="highlight">Pattern</span>
      </h1>
    </div>

    <section class="flow" aria-label="Diagram sekwencji Outbox Pattern">
      <article class="node node--handler">
        <div class="node-ic"><i class="ti ti-cpu"></i></div>
        <h3>Handler</h3>
      </article>

      <div class="conn" aria-hidden="true"><i class="ti ti-arrow-right"></i></div>

      <article class="node node--tx">
        <header class="tx-head">
          <i class="ti ti-lock"></i>
          <span>jedna transakcja</span>
        </header>
        <div class="tx-tables">
          <div class="tx-table">
            <i class="ti ti-table"></i>
            <span>Business table</span>
          </div>
          <span class="tx-plus">+</span>
          <div class="tx-table tx-table--outbox">
            <i class="ti ti-mailbox"></i>
            <span>Outbox table</span>
          </div>
        </div>
        <footer class="tx-foot">
          <i class="ti ti-git-commit"></i>
          <span>commit razem</span>
        </footer>
      </article>

      <div class="conn" aria-hidden="true"><i class="ti ti-arrow-right"></i></div>

      <article class="node node--publisher">
        <div class="node-ic"><i class="ti ti-send"></i></div>
        <h3>Outbox Publisher</h3>
        <span class="retry-badge"><i class="ti ti-refresh"></i>retry publikacji</span>
      </article>

      <div class="conn" aria-hidden="true"><i class="ti ti-arrow-right"></i></div>

      <article class="node node--broker">
        <div class="node-ic"><i class="ti ti-rss"></i></div>
        <h3>Broker</h3>
      </article>
    </section>

    <ul class="points" aria-label="Zasady Outbox Pattern">
      <li>
        <i class="ti ti-mailbox"></i>
        <span>Event zapisywany do tabeli <code>Outbox</code></span>
      </li>
      <li>
        <i class="ti ti-lock-check"></i>
        <span>W <strong>tej samej transakcji</strong> co zmiana biznesowa</span>
      </li>
      <li>
        <i class="ti ti-router"></i>
        <span><strong>Osobny proces</strong> publikuje eventy do brokera</span>
      </li>
      <li>
        <i class="ti ti-refresh"></i>
        <span>Publikacja jest <strong>ponawiana aż do skutku</strong></span>
      </li>
    </ul>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1700px;
    padding: 36px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 26px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 14px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 78px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 8px;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .flow {
    width: 100%;
    max-width: 1640px;
    display: grid;
    grid-template-columns: 0.85fr auto 1.5fr auto 1.1fr auto 0.85fr;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
    padding: 26px 22px;
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.32);
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.55s forwards;
  }

  .node {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 18px 14px;
    min-height: 240px;
    background: rgba(17, 24, 39, 0.5);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 16px;
  }

  .node-ic {
    width: 72px;
    height: 72px;
    border-radius: 18px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .node-ic i {
    font-size: 36px;
    color: var(--cyan-400);
  }

  .node h3 {
    margin: 0;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.3px;
    line-height: 1.1;
    color: #f0f4f8;
    text-align: center;
  }

  .node--handler {
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.18), rgba(17, 24, 39, 0.55));
    border-color: rgba(34, 211, 238, 0.42);
  }

  .node--publisher {
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.16), rgba(17, 24, 39, 0.55));
    border-color: rgba(168, 85, 247, 0.45);
  }

  .node--publisher .node-ic {
    background: rgba(168, 85, 247, 0.14);
    border-color: rgba(168, 85, 247, 0.5);
  }

  .node--publisher .node-ic i { color: #c4b5fd; }

  .retry-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(168, 85, 247, 0.16);
    border: 1px dashed rgba(168, 85, 247, 0.55);
    color: #ddd6fe;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .retry-badge i {
    font-size: 14px;
    animation: spinRetry 3s linear infinite;
  }

  @keyframes spinRetry {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .node--broker {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.16), rgba(17, 24, 39, 0.55));
    border-color: rgba(34, 197, 94, 0.45);
  }

  .node--broker .node-ic {
    background: rgba(34, 197, 94, 0.14);
    border-color: rgba(74, 222, 128, 0.55);
  }

  .node--broker .node-ic i { color: #4ade80; }

  .node--tx {
    min-height: 240px;
    padding: 16px 18px;
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.22), rgba(17, 24, 39, 0.62));
    border-color: rgba(34, 211, 238, 0.55);
    box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.05), 0 18px 48px rgba(8, 145, 178, 0.22);
    gap: 12px;
  }

  .tx-head {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.16);
    border: 1px solid rgba(34, 211, 238, 0.5);
    color: var(--cyan-400);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .tx-head i { font-size: 16px; }

  .tx-tables {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 14px;
    background: rgba(2, 6, 23, 0.55);
    border: 1px dashed rgba(34, 211, 238, 0.5);
    width: 100%;
    justify-content: center;
  }

  .tx-table {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
    border-radius: 12px;
    background: rgba(17, 24, 39, 0.85);
    border: 1px solid rgba(148, 163, 184, 0.3);
    min-width: 130px;
  }

  .tx-table i {
    font-size: 26px;
    color: var(--cyan-400);
  }

  .tx-table span {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 14px;
    font-weight: 800;
    color: #e5e7eb;
    letter-spacing: 0.3px;
  }

  .tx-table--outbox {
    border-color: rgba(34, 211, 238, 0.55);
    background: rgba(8, 145, 178, 0.22);
  }

  .tx-plus {
    font-size: 24px;
    font-weight: 900;
    color: var(--cyan-400);
  }

  .tx-foot {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: 999px;
    background: rgba(34, 197, 94, 0.16);
    border: 1px solid rgba(34, 197, 94, 0.5);
    color: #d1fae5;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .tx-foot i { font-size: 16px; color: #4ade80; }

  .conn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
  }

  .conn i {
    font-size: 28px;
    color: rgba(34, 211, 238, 0.7);
  }

  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 1560px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px 18px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.05s forwards;
  }

  .points li {
    display: grid;
    grid-template-columns: 52px 1fr;
    align-items: center;
    gap: 18px;
    padding: 16px 22px;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 14px;
    text-align: left;
  }

  .points li > i {
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 24px;
  }

  .points li span {
    font-size: 21px;
    font-weight: 500;
    line-height: 1.3;
    color: #e2e8f0;
    letter-spacing: -0.2px;
  }

  .points li code {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 19px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 8px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
  }

  .points li strong {
    color: #fff;
    font-weight: 800;
  }

  @media (max-width: 1300px) {
    .title {
      font-size: 54px;
    }

    .flow {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .conn {
      width: 100%;
      transform: rotate(90deg);
    }

    .points {
      grid-template-columns: 1fr;
    }

    .points li span {
      font-size: 18px;
    }
  }

  @media (max-width: 700px) {
    .content {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }

    .title {
      font-size: 40px;
    }

    .node h3 {
      font-size: 18px;
    }

    .tx-table {
      min-width: 100px;
    }

    .tx-table span {
      font-size: 12px;
    }

    .points li {
      grid-template-columns: 40px 1fr;
      gap: 14px;
      padding: 14px 16px;
    }

    .points li > i {
      width: 40px;
      height: 40px;
      font-size: 22px;
    }

    .points li span {
      font-size: 17px;
    }
  }
</style>
</content>
</invoke>