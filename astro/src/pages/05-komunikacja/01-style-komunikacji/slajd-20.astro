---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 20 - Problem dwóch zapisów"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.84), rgba(10,14,23,0.94))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="dwGrid20" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(248,113,113,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="dwGlow20" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#f87171" stop-opacity="0.16"/>
        <stop offset="66%" stop-color="#f87171" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#f87171" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#dwGrid20)"/>
    <circle cx="960" cy="540" r="540" fill="url(#dwGlow20)"/>
  </svg>

  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-alert-triangle"></i>Trzecie Wyzwanie</span>
      <h1 class="title">
        Problem <span class="highlight">dwóch zapisów</span>
      </h1>
    </div>

    <section class="dualwrite" aria-label="Handler zapisuje do bazy i publikuje event">
      <article class="dw-handler">
        <div class="dw-ic"><i class="ti ti-cpu"></i></div>
        <h3>Handler</h3>
      </article>

      <div class="dw-fork" aria-hidden="true">
        <span class="fork fork--up"></span>
        <span class="fork fork--down"></span>
      </div>

      <div class="dw-branches">
        <article class="dw-branch dw-branch--db">
          <header class="dw-branch-head">
            <i class="ti ti-database"></i>
            <h4>Database</h4>
          </header>
          <div class="dw-fail">
            <span class="fail-icon"><i class="ti ti-bolt-off"></i></span>
            <div class="fail-body">
              <span class="fail-label">Punkt awarii</span>
              <p>DB <strong>zapisany</strong>, event <strong>niewysłany</strong></p>
            </div>
          </div>
        </article>

        <article class="dw-branch dw-branch--broker">
          <header class="dw-branch-head">
            <i class="ti ti-rss"></i>
            <h4>Broker</h4>
          </header>
          <div class="dw-fail">
            <span class="fail-icon"><i class="ti ti-bolt-off"></i></span>
            <div class="fail-body">
              <span class="fail-label">Punkt awarii</span>
              <p>Event <strong>wysłany</strong>, DB <strong>niezaktualizowana</strong></p>
            </div>
          </div>
        </article>
      </div>
    </section>

    <ul class="points" aria-label="Konsekwencje dwóch zapisów">
      <li>
        <i class="ti ti-database-edit"></i>
        <span><strong>Zapis stanu</strong> w bazie danych</span>
      </li>
      <li>
        <i class="ti ti-send"></i>
        <span><strong>Publikacja eventu</strong> do brokera</span>
      </li>
      <li>
        <i class="ti ti-plug-off"></i>
        <span>Awaria jednego z kroków <strong>= niespójność</strong></span>
      </li>
      <li class="points-impact">
        <i class="ti ti-alert-octagon"></i>
        <span><strong>Ryzyko:</strong> proces biznesowy utknie albo pójdzie błędną ścieżką</span>
      </li>
    </ul>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1660px;
    padding: 36px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 26px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(248, 113, 113, 0.12);
    border: 1px solid rgba(248, 113, 113, 0.42);
    color: #fecaca;
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 14px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 82px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 8px;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .dualwrite {
    width: 100%;
    max-width: 1560px;
    display: grid;
    grid-template-columns: 260px 70px 1fr;
    align-items: center;
    gap: 18px;
    margin-bottom: 28px;
    padding: 26px 26px;
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.32);
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.55s forwards;
  }

  .dw-handler {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 22px 16px;
    min-height: 220px;
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.20), rgba(17, 24, 39, 0.55));
    border: 1px solid rgba(34, 211, 238, 0.5);
    border-radius: 16px;
    box-shadow: 0 0 28px rgba(34, 211, 238, 0.14);
  }

  .dw-ic {
    width: 72px;
    height: 72px;
    border-radius: 18px;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dw-ic i {
    font-size: 38px;
    color: var(--cyan-400);
  }

  .dw-handler h3 {
    margin: 0;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.3px;
    color: #f0f4f8;
  }

  .dw-fork {
    position: relative;
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fork {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: rgba(248, 113, 113, 0.6);
    transform-origin: left center;
  }

  .fork--up {
    top: 28%;
    transform: rotate(-12deg);
    box-shadow: 0 0 10px rgba(248, 113, 113, 0.5);
  }

  .fork--down {
    bottom: 28%;
    transform: rotate(12deg);
    box-shadow: 0 0 10px rgba(248, 113, 113, 0.5);
  }

  .dw-branches {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 14px;
  }

  .dw-branch {
    display: grid;
    grid-template-columns: minmax(180px, 0.7fr) 1fr;
    align-items: center;
    gap: 18px;
    padding: 14px 18px;
    border-radius: 14px;
    background: rgba(17, 24, 39, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.22);
    text-align: left;
  }

  .dw-branch--db {
    border-color: rgba(248, 113, 113, 0.45);
    background: linear-gradient(135deg, rgba(127, 29, 29, 0.16), rgba(17, 24, 39, 0.55));
  }

  .dw-branch--broker {
    border-color: rgba(248, 113, 113, 0.45);
    background: linear-gradient(135deg, rgba(127, 29, 29, 0.16), rgba(17, 24, 39, 0.55));
  }

  .dw-branch-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .dw-branch-head i {
    width: 56px;
    height: 56px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: rgba(148, 163, 184, 0.12);
    border: 1px solid rgba(148, 163, 184, 0.34);
    color: #e2e8f0;
    font-size: 28px;
    flex-shrink: 0;
  }

  .dw-branch--db .dw-branch-head i {
    background: rgba(34, 211, 238, 0.12);
    border-color: rgba(34, 211, 238, 0.45);
    color: var(--cyan-400);
  }

  .dw-branch--broker .dw-branch-head i {
    background: rgba(168, 85, 247, 0.12);
    border-color: rgba(168, 85, 247, 0.5);
    color: #c4b5fd;
  }

  .dw-branch-head h4 {
    margin: 0;
    font-size: 24px;
    font-weight: 800;
    color: #f0f4f8;
    letter-spacing: -0.3px;
  }

  .dw-fail {
    display: grid;
    grid-template-columns: 48px 1fr;
    align-items: center;
    gap: 14px;
    padding: 10px 14px;
    border-radius: 12px;
    background: rgba(2, 6, 23, 0.48);
    border: 1px dashed rgba(248, 113, 113, 0.55);
  }

  .fail-icon {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(248, 113, 113, 0.16);
    border: 1px solid rgba(248, 113, 113, 0.55);
    color: #f87171;
    font-size: 22px;
  }

  .fail-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .fail-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(252, 165, 165, 0.95);
  }

  .fail-body p {
    margin: 0;
    font-size: 19px;
    font-weight: 600;
    color: #fff5f5;
    line-height: 1.25;
  }

  .fail-body strong {
    color: #fecaca;
    font-weight: 900;
  }

  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 1560px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px 18px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.05s forwards;
  }

  .points li {
    display: grid;
    grid-template-columns: 52px 1fr;
    align-items: center;
    gap: 18px;
    padding: 16px 22px;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 14px;
    text-align: left;
  }

  .points li > i {
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 24px;
  }

  .points li span {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
    color: #e2e8f0;
    letter-spacing: -0.2px;
  }

  .points li strong {
    color: #fff;
    font-weight: 800;
  }

  .points-impact {
    border-color: rgba(248, 113, 113, 0.5);
    background: linear-gradient(135deg, rgba(127, 29, 29, 0.22), rgba(17, 24, 39, 0.6));
  }

  .points-impact > i {
    background: rgba(248, 113, 113, 0.16);
    border-color: rgba(248, 113, 113, 0.55);
    color: #f87171;
  }

  .points-impact span {
    color: #fff5f5;
  }

  .points-impact strong {
    color: #fecaca;
  }

  @media (max-width: 1300px) {
    .title {
      font-size: 54px;
    }

    .dualwrite {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .dw-fork { display: none; }

    .dw-branch {
      grid-template-columns: 1fr;
    }

    .points {
      grid-template-columns: 1fr;
    }

    .points li span {
      font-size: 18px;
    }
  }

  @media (max-width: 700px) {
    .content {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }

    .title {
      font-size: 40px;
    }

    .dw-handler h3 {
      font-size: 22px;
    }

    .fail-body p {
      font-size: 17px;
    }

    .points li {
      grid-template-columns: 40px 1fr;
      gap: 14px;
      padding: 14px 16px;
    }

    .points li > i {
      width: 40px;
      height: 40px;
      font-size: 22px;
    }

    .points li span {
      font-size: 17px;
    }
  }
</style>
</content>
</invoke>