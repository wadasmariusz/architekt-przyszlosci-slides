---
const slideFiles = {
  ...import.meta.glob('./06-wizualizacja-architektury/**/slajd-*.astro'),
  ...import.meta.glob('./07-Decyzje architektoniczne/**/slajd-*.astro'),
};

type SectionConfig = {
  basePath: string;
  slug: string;
  number: string;
  title: string;
  subtitle: string;
  labels: Record<string, string>;
