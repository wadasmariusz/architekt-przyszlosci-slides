  },
  {
    basePath: '06-wizualizacja-architektury',
    slug: '03-containers',
    number: '03',
    title: 'Diagram kontenerów (C4, poziom 2)',
    subtitle: 'Techniczny kształt systemu — aplikacje, bazy, kolejki, integracje.',
    labels: {
      '01': 'C4 Container — techniczny kształt systemu',
      '02': 'Poziomy przybliżenia w C4',
      '03': 'Container w C4 — definicja',
      '04': 'Przykład — system sprzedażowy',
      '05': 'Co powinien zawierać opis kontenera?',
      '06': 'Ogólny vs. konkretny opis kontenera',
      '07': 'Komunikacja między kontenerami',
      '08': 'Dla kogo jest Container Diagram?',
      '09': 'Container Diagram a styl architektoniczny',
      '10': 'Granica systemu',
      '11': 'Anty-wzorzec: przeładowany diagram',
      '12': 'Test jednego zdania',
      '13': 'Czy diagram spełnia swoją rolę?',
      '14': 'Podsumowanie — C4 Container Level',
    },
  },
  {
    basePath: '06-wizualizacja-architektury',
    slug: '04-componnets',
    number: '04',
    title: 'Diagram komponentów (C4, poziom 3)',
    subtitle: 'Wnętrze kontenera — odpowiedzialności, zależności, granice.',
    labels: {
      '01': 'C4 Component — wnętrze jednego kontenera',
      '02': 'Otwieramy czarną skrzynkę',
      '03': 'Czym jest komponent?',
      '04': 'Komponent jako jednostka odpowiedzialności',
      '05': 'Poziom abstrakcji komponentu',
      '06': 'Przykład: Internet Banking System',
      '07': 'Cel diagramu komponentów',
      '08': 'Struktura API Application',
      '09': 'Techniczny, ale nadal architektoniczny',
      '10': 'Wartość dla zespołu technicznego',
      '11': 'Relacje między komponentami',
