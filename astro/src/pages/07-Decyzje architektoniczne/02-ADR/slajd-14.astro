---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 14 - Pamięć architektoniczna projektu"
  bgImage="/images/background-5.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.92))"
>
  <div class="content">
    <p class="eyebrow">Podsumowanie</p>
    <h1 class="title">
      Cechy dobrego <span class="highlight">ADR</span>
    </h1>

    <div class="traits" aria-label="Cztery cechy dobrego ADR">
      <article class="trait trait--1">
        <div class="trait-icon"><i class="ti ti-file-text"></i></div>
        <h3>Krótki</h3>
        <span class="divider"></span>
        <p>Mieści się na jednej kartce. Czyta się w kilka minut, wraca się do niego bez wysiłku.</p>
      </article>

      <article class="trait trait--2">
        <div class="trait-icon"><i class="ti ti-target-arrow"></i></div>
        <h3>Konkretny</h3>
        <span class="divider"></span>
        <p>Opisuje jeden rozstrzygnięty wybór architektoniczny, sformułowany konkretnie i jasno.</p>
      </article>

      <article class="trait trait--3">
        <div class="trait-icon"><i class="ti ti-map-pin"></i></div>
        <h3>Osadzony w kontekście</h3>
        <span class="divider"></span>
        <p>Pokazuje ograniczenia, wymagania i sytuację zespołu w chwili, gdy decyzja zapadła.</p>
      </article>

      <article class="trait trait--4">
        <div class="trait-icon"><i class="ti ti-scale"></i></div>
        <h3>Pokazuje konsekwencje</h3>
        <span class="divider"></span>
        <p>Nazywa zarówno zyski, jak i koszty. Świadomie przyjmuje to, czego decyzja nie rozwiązuje.</p>
      </article>
    </div>

    <blockquote class="closing">
      <i class="ti ti-quote"></i>
      <p>
        Architektura dzięki ADR staje się <strong>historią świadomych wyborów i kompromisów</strong>.
      </p>
    </blockquote>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1680px;
    padding: 70px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .eyebrow {
    font-size: 22px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 5px;
    color: var(--cyan-400);
    margin-bottom: 18px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .title {
    font-size: 76px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.06;
    margin-bottom: 20px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.32s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lead {
    max-width: 1240px;
    font-size: 26px;
    font-weight: 300;
    line-height: 1.42;
    color: #cbd5e1;
    margin: 0 0 40px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.5s forwards;
  }

  .lead strong {
    color: #f1f5f9;
    font-weight: 600;
  }

  .traits {
    width: 100%;
    max-width: 1520px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
  }

  .trait {
    position: relative;
    background: rgba(15, 23, 42, 0.66);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 22px;
    padding: 30px 26px 28px;
    backdrop-filter: blur(10px);
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    opacity: 0;
    transform: translateY(22px);
    animation: fadeUp 0.85s ease-out forwards;
    overflow: hidden;
  }

  .trait::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--cyan-500), transparent);
    opacity: 0.85;
  }

  .trait--1 { animation-delay: 0.65s; }
  .trait--2 { animation-delay: 0.8s; }
  .trait--3 { animation-delay: 0.95s; }
  .trait--4 { animation-delay: 1.1s; }

  .trait-num {
    position: absolute;
    top: 22px;
    right: 24px;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 3px;
    color: rgba(148, 163, 184, 0.55);
    font-feature-settings: 'tnum';
  }

  .trait-icon {
    width: 62px;
    height: 62px;
    margin-bottom: 18px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at center, rgba(34, 211, 238, 0.22), rgba(34, 211, 238, 0.04) 72%);
    border: 1px solid rgba(34, 211, 238, 0.4);
  }

  .trait-icon i {
    font-size: 32px;
    color: var(--cyan-400);
  }

  .trait h3 {
    font-size: 26px;
    font-weight: 700;
    color: #f1f5f9;
    line-height: 1.18;
    margin: 0 0 10px;
    letter-spacing: -0.3px;
  }

  .divider {
    display: block;
    width: 40px;
    height: 2px;
    margin: 0 0 14px;
    background: linear-gradient(90deg, var(--cyan-500), transparent);
    opacity: 0.85;
  }

  .trait p {
    font-size: 18px;
    font-weight: 300;
    line-height: 1.46;
    color: #cbd5e1;
    margin: 0;
  }

  .closing {
    position: relative;
    margin: 44px 0 0;
    max-width: 1320px;
    padding: 26px 36px 26px 72px;
    background:
      radial-gradient(circle at 12% 50%, rgba(34, 211, 238, 0.12), transparent 45%),
      rgba(15, 23, 42, 0.62);
    border: 1px solid rgba(34, 211, 238, 0.32);
    border-left: 3px solid var(--cyan-400);
    border-radius: 14px;
    text-align: left;
    opacity: 0;
    animation: fadeUp 0.85s ease-out 1.3s forwards;
  }

  .closing i {
    position: absolute;
    top: 24px;
    left: 28px;
    font-size: 30px;
    color: var(--cyan-400);
    opacity: 0.85;
  }

  .closing p {
    font-size: 24px;
    font-weight: 300;
    font-style: italic;
    line-height: 1.5;
    color: #e2e8f0;
    margin: 0;
  }

  .closing strong {
    color: #f1f5f9;
    font-weight: 700;
    font-style: normal;
  }
</style>
