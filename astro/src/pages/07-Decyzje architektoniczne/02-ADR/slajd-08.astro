---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 08 - Monolit modułowy vs mikroserwisy"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-scale"></i> Trade-offy w praktyce</span>
      <h1 class="title">
        Monolit modułowy <span class="highlight">vs</span> mikroserwisy
      </h1>
      <p class="lead">
        Dwie poprawne decyzje, dwa różne zestawy kosztów</strong>.
      </p>
    </div>

    <div class="compare">
      <article class="col mono">
        <header>
          <div class="badge">Monolit modułowy</div>
          <h2>Prosty operacyjnie, szybki dla małego zespołu</h2>
        </header>

        <div class="lane lane--pro">
          <div class="lane-head">
            <i class="ti ti-trending-up"></i>
            <span>Zyskujemy</span>
          </div>
          <ul>
            <li><strong>Prostszy deployment</strong>: jedna aplikacja, jeden pipeline</li>
            <li><strong>Mniej infrastruktury do utrzymania</strong></li>
            <li><strong>Szybka praca małego zespołu</strong></li>
          </ul>
        </div>

        <div class="lane lane--con">
          <div class="lane-head">
            <i class="ti ti-trending-down"></i>
            <span>Akceptujemy</span>
          </div>
          <ul>
            <li>Ograniczone <strong>niezależne skalowanie</strong> modułów</li>
            <li>Wspólny cykl wydawniczy dla całej aplikacji</li>
          </ul>
        </div>
      </article>

      <div class="vs"><span>vs</span></div>

      <article class="col micro">
        <header>
          <div class="badge">Mikroserwisy</div>
          <h2>Zyskujemy niezależność zespołów kosztem złożoności</h2>
        </header>

        <div class="lane lane--pro">
          <div class="lane-head">
            <i class="ti ti-trending-up"></i>
            <span>Zyskujemy</span>
          </div>
          <ul>
            <li><strong>Niezależność zespołów</strong> i własne tempo wdrożeń</li>
            <li><strong>Niezależne skalowanie</strong> komponentów</li>
            <li>Swoboda w doborze technologii per serwis</li>
          </ul>
        </div>

        <div class="lane lane--con">
          <div class="lane-head">
            <i class="ti ti-trending-down"></i>
            <span>Akceptujemy</span>
          </div>
          <ul>
            <li>Złożoność <strong>komunikacji i monitoringu</strong></li>
            <li>Trudniejsze testowanie i większy narzut infrastruktury</li>
          </ul>
        </div>
      </article>
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1440px;
    padding: 56px 3rem 0;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    text-align: center;
    margin-bottom: 28px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 18px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 64px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 18px;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lead {
    max-width: 1100px;
    font-size: 24px;
    font-weight: 300;
    line-height: 1.4;
    color: #cbd5e1;
    margin: 0 auto;
  }

  .lead strong {
    color: #f1f5f9;
    font-weight: 600;
  }

  .compare {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 24px;
    width: 100%;
    align-items: stretch;
  }

  .col {
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 22px;
    padding: 24px 26px 26px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 16px;
    opacity: 0;
    transform: translateY(28px);
    animation: fadeUp 0.85s ease-out forwards;
  }

  .col.mono {
    animation-delay: 0.45s;
    background:
      radial-gradient(circle at 18% 18%, rgba(34, 211, 238, 0.16), transparent 34%),
      linear-gradient(145deg, rgba(8, 145, 178, 0.16), rgba(17, 24, 39, 0.58) 52%),
      rgba(17, 24, 39, 0.55);
    box-shadow: inset 0 1px 28px rgba(34, 211, 238, 0.08), 0 4px 30px rgba(34, 211, 238, 0.06);
  }

  .col.micro {
    animation-delay: 0.6s;
    border-color: rgba(148, 163, 184, 0.28);
  }

  .col header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
  }

  .badge {
    align-self: flex-start;
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .col.mono .badge {
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.24), rgba(8, 145, 178, 0.16));
    color: #a5f3fc;
    box-shadow: inset 0 0 18px rgba(34, 211, 238, 0.08);
  }

  .col.micro .badge {
    background: rgba(148, 163, 184, 0.15);
    color: #cbd5e1;
    border: 1px solid rgba(148, 163, 184, 0.35);
  }

  .col h2 {
    font-size: 26px;
    font-weight: 700;
    color: #f1f5f9;
    margin: 0;
    letter-spacing: -0.2px;
    line-height: 1.25;
  }

  .lane {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .lane-head {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .lane-head i {
    font-size: 20px;
  }

  .lane--pro .lane-head { color: #22d3ee; }
  .lane--pro .lane-head i { color: #22d3ee; }

  .lane--con .lane-head { color: #f59e0b; }
  .lane--con .lane-head i { color: #f59e0b; }

  .lane ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .lane li {
    position: relative;
    padding: 8px 12px 8px 26px;
    border-radius: 12px;
    font-size: 20px;
    font-weight: 300;
    line-height: 1.4;
    color: #e2e8f0;
  }

  .lane li::before {
    content: '';
    position: absolute;
    left: 12px;
    top: 17px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .lane--pro li {
    background: linear-gradient(120deg, rgba(34, 211, 238, 0.08), rgba(14, 116, 144, 0.04));
  }

  .lane--pro li::before {
    background: #22d3ee;
    box-shadow: 0 0 8px rgba(34, 211, 238, 0.55);
  }

  .lane--con li {
    background: linear-gradient(120deg, rgba(245, 158, 11, 0.07), rgba(120, 53, 15, 0.03));
  }

  .lane--con li::before {
    background: #f59e0b;
    box-shadow: 0 0 8px rgba(245, 158, 11, 0.55);
  }

  .lane li strong {
    font-weight: 600;
    color: #f1f5f9;
  }

  .vs {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.55s forwards;
  }

  .vs span {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(10, 14, 23, 0.8);
    border: 1px solid rgba(148, 163, 184, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
</style>
