---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 13 - ADR jako narzędzie myślenia"
  bgImage="/images/background-4.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.74), rgba(10,14,23,0.88))"
>
  <div class="content">
    <p class="eyebrow">Praktyka decyzyjna</p>
    <h1 class="title">ADR jako <span class="highlight">narzędzie myślenia</span></h1>

    <div class="grid" aria-label="Sześć wartości praktyki ADR">
      <article class="card card--1">
        <div class="icon-wrap"><i class="ti ti-target-arrow"></i></div>
        <h3>Doprecyzowanie problemu</h3>
        <span class="divider"></span>
      </article>

      <article class="card card--2">
        <div class="icon-wrap"><i class="ti ti-brackets-contain"></i></div>
        <h3>Nazwanie ograniczeń</h3>
        <span class="divider"></span>
      </article>

      <article class="card card--3">
        <div class="icon-wrap"><i class="ti ti-arrows-shuffle"></i></div>
        <h3>Porównanie opcji</h3>
        <span class="divider"></span>
      </article>

      <article class="card card--4">
        <div class="icon-wrap"><i class="ti ti-scale"></i></div>
        <h3>Zapisanie konsekwencji</h3>
        <span class="divider"></span>
      </article>

      <article class="card card--5">
        <div class="icon-wrap"><i class="ti ti-hand-stop"></i></div>
        <h3>Ograniczenie impulsywnych decyzji</h3>
        <span class="divider"></span>
      </article>

      <article class="card card--6">
        <div class="icon-wrap"><i class="ti ti-messages"></i></div>
        <h3>Łatwiejsza komunikacja</h3>
        <span class="divider"></span>
      </article>
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1680px;
    padding: 88px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .eyebrow {
    font-size: 23px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 5px;
    color: var(--cyan-400);
    margin-bottom: 22px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .title {
    font-size: 82px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.08;
    margin-bottom: 22px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.32s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lead {
    max-width: 1240px;
    font-size: 28px;
    font-weight: 300;
    line-height: 1.42;
    color: #cbd5e1;
    margin-bottom: 0;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.5s forwards;
  }

  .lead strong {
    color: #f1f5f9;
    font-weight: 600;
  }

  .grid {
    width: 100%;
    max-width: 1480px;
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: minmax(0, 1fr);
    gap: 18px;
  }

  .card {
    position: relative;
    background: rgba(15, 23, 42, 0.62);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 20px;
    padding: 22px 26px 24px;
    backdrop-filter: blur(10px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    transform: translateY(22px);
    animation: fadeUp 0.8s ease-out forwards;
  }

  .card--1 { animation-delay: 0.66s; }
  .card--2 { animation-delay: 0.8s; }
  .card--3 { animation-delay: 0.94s; }
  .card--4 { animation-delay: 1.08s; }
  .card--5 { animation-delay: 1.22s; }
  .card--6 { animation-delay: 1.36s; }

  .icon-wrap {
    width: 64px;
    height: 64px;
    margin: 0 0 12px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at center, rgba(34, 211, 238, 0.2), rgba(34, 211, 238, 0.04) 70%);
    border: 1px solid rgba(34, 211, 238, 0.32);
  }

  .icon-wrap i {
    font-size: 34px;
    color: var(--cyan-400);
  }

  .card h3 {
    font-size: 24px;
    font-weight: 700;
    color: #f1f5f9;
    line-height: 1.18;
    margin-bottom: 10px;
    letter-spacing: -0.3px;
  }

  .divider {
    display: block;
    width: 36px;
    height: 2px;
    margin: 0 auto 12px;
    background: linear-gradient(90deg, transparent, var(--cyan-500), transparent);
    opacity: 0.75;
  }

  .card p {
    font-size: 17px;
    font-weight: 300;
    line-height: 1.42;
    color: #cbd5e1;
    margin: 0;
  }
</style>
