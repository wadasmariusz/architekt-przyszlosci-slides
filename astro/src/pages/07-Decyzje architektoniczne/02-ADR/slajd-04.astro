---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 04 - Jedna decyzja na ADR"
  bgImage="/images/background-4.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.74), rgba(10,14,23,0.88))"
>
  <div class="content">
    <h1 class="title">Jedna decyzja na <span class="highlight">ADR</span></h1>
    <p class="lead">
    </p>

    <div class="compare-zone" aria-label="Porównanie dobrego i złego ADR">
      <article class="card card--good">
        <div class="card-head">
          <i class="ti ti-circle-check"></i>
          <span>Dobry ADR</span>
        </div>
        <p class="rule">Jedna konkretna decyzja</p>

        <ul class="examples">
          <li>Wybór bazy danych: PostgreSQL</li>
          <li>Styl komunikacji: event-driven</li>
          <li>Strategia autentykacji: OAuth 2.1 + JWT</li>
        </ul>
      </article>
    </div>

    <div class="takeaway">
      <i class="ti ti-arrow-big-right-lines"></i>
      <p><strong>1 ADR = 1 decyzja</strong></p>
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1680px;
    padding: 104px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .eyebrow {
    font-size: 23px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 5px;
    color: var(--cyan-400);
    margin-bottom: 20px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .title {
    font-size: 84px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.08;
    margin-bottom: 20px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.3s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lead {
    max-width: 1260px;
    font-size: 30px;
    font-weight: 300;
    line-height: 1.42;
    color: #cbd5e1;
    margin-bottom: 38px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.48s forwards;
  }

  .compare-zone {
    width: 100%;
    max-width: 1560px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(560px, 760px));
    justify-content: center;
    gap: 28px;
    margin-bottom: 28px;
  }

  .card {
    background: rgba(15, 23, 42, 0.64);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 24px;
    padding: 28px 28px 30px;
    text-align: left;
    backdrop-filter: blur(10px);
    opacity: 0;
    transform: translateY(22px);
    animation: fadeUp 0.8s ease-out forwards;
  }

  .card--good { animation-delay: 0.68s; }
  .card--bad { animation-delay: 0.86s; }

  .card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .card-head i {
    font-size: 32px;
  }

  .card-head span {
    font-size: 34px;
    font-weight: 700;
    letter-spacing: -0.3px;
    color: #f1f5f9;
  }

  .rule {
    font-size: 24px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 18px;
  }

  .card--good {
    border-color: rgba(45, 212, 191, 0.38);
    background: linear-gradient(180deg, rgba(15, 118, 110, 0.2), rgba(15, 23, 42, 0.74));
  }

  .card--good .card-head i,
  .card--good .rule {
    color: #2dd4bf;
  }

  .examples {
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }

  .examples li {
    font-size: 26px;
    font-weight: 500;
    color: #e2e8f0;
    padding: 12px 16px;
    border-radius: 10px;
    background: rgba(15, 23, 42, 0.58);
    border: 1px solid rgba(45, 212, 191, 0.6);
  }

  .card--bad {
    border-color: rgba(248, 113, 113, 0.45);
    background: linear-gradient(180deg, rgba(127, 29, 29, 0.24), rgba(15, 23, 42, 0.76));
  }

  .card--bad .card-head i,
  .card--bad .rule {
    color: #f87171;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 18px;
  }

  .tag-cloud span {
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(127, 29, 29, 0.35);
    border: 1px solid rgba(248, 113, 113, 0.4);
    color: #fee2e2;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: 0.2px;
  }

  .impact {
    font-size: 22px;
    font-weight: 300;
    line-height: 1.45;
    color: #d6deea;
    margin: 0;
  }

  .takeaway {
    width: fit-content;
    max-width: 980px;
    margin: 0 auto;
    padding: 16px 20px;
    border-radius: 16px;
    border: 1px solid rgba(34, 211, 238, 0.34);
    background: rgba(8, 47, 73, 0.38);
    display: flex;
    align-items: center;
    gap: 14px;
    text-align: left;
    opacity: 0;
    animation: fadeUp 0.75s ease-out 1.02s forwards;
  }

  .takeaway i {
    font-size: 34px;
    color: var(--cyan-400);
    flex: 0 0 auto;
  }

  .takeaway p {
    margin: 0;
    font-size: 26px;
    font-weight: 300;
    line-height: 1.34;
    color: #e2e8f0;
  }

  .takeaway strong {
    font-weight: 700;
    color: #f8fbff;
  }
</style>
