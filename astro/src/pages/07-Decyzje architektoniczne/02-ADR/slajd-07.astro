---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 07 - Konsekwencje i trade-offy"
  bgImage="/images/background-5.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.74), rgba(10,14,23,0.88))"
>
  <div class="content">
    <h1 class="title">
      Konsekwencje i <span class="highlight">trade-offy</span>
    </h1>

    <div class="scale" aria-label="Waga konsekwencji: zyskujemy vs tracimy">
      <div class="pan pan--gain">
        <header class="pan-head">
          <i class="ti ti-trending-up"></i>
          <div class="pan-title">
            <span class="pan-label">Korzyści decyzji</span>
          </div>
          <span class="pan-sign pan-sign--gain">+</span>
        </header>
        <ul class="pan-list">
          <li><i class="ti ti-check"></i><span>Spelnione wymaganie jakosciowe</span></li>
          <li><i class="ti ti-check"></i><span>Prostsza dalsza ewolucja systemu</span></li>
          <li><i class="ti ti-check"></i><span>Mniejsze ryzyko w krytycznym obszarze</span></li>
          <li><i class="ti ti-check"></i><span>Lepsze dopasowanie do zespolu</span></li>
        </ul>
      </div>

      <div class="fulcrum" aria-hidden="true">
        <div class="beam"></div>
        <div class="pivot"><i class="ti ti-scale"></i></div>
        <div class="base"></div>
      </div>

      <div class="pan pan--cost">
        <header class="pan-head">
          <i class="ti ti-trending-down"></i>
          <div class="pan-title">
            <span class="pan-label">Koszty i ograniczenia</span>
          </div>
          <span class="pan-sign pan-sign--cost">−</span>
        </header>
        <ul class="pan-list">
          <li><i class="ti ti-minus"></i><span>Wieksza zlozonosc operacyjna</span></li>
          <li><i class="ti ti-minus"></i><span>Trudniejszy onboarding nowych osob</span></li>
          <li><i class="ti ti-minus"></i><span>Wyzszy koszt utrzymania</span></li>
          <li><i class="ti ti-minus"></i><span>Czesc opcji zamknieta na przyszlosc</span></li>
        </ul>
      </div>
    </div>
    
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1680px;
    padding: 92px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .eyebrow {
    font-size: 23px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 5px;
    color: var(--cyan-400);
    margin-bottom: 22px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .title {
    font-size: 84px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.08;
    margin-bottom: 22px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.32s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lead {
    max-width: 1240px;
    font-size: 28px;
    font-weight: 300;
    line-height: 1.42;
    color: #cbd5e1;
    margin-bottom: 56px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.5s forwards;
  }

  .lead strong {
    color: #f1f5f9;
    font-weight: 600;
  }

  .scale {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 200px minmax(0, 1fr);
    gap: 36px;
    align-items: stretch;
  }

  .pan {
    background: rgba(15, 23, 42, 0.62);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 22px;
    padding: 30px 34px 32px;
    backdrop-filter: blur(10px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.32);
    text-align: left;
    opacity: 0;
    transform: translateY(24px);
    animation: fadeUp 0.9s ease-out forwards;
  }

  .pan--gain {
    border-color: rgba(34, 197, 94, 0.45);
    background: linear-gradient(180deg, rgba(20, 83, 45, 0.28), rgba(15, 23, 42, 0.74));
    animation-delay: 0.7s;
  }

  .pan--cost {
    border-color: rgba(248, 113, 113, 0.45);
    background: linear-gradient(180deg, rgba(127, 29, 29, 0.26), rgba(15, 23, 42, 0.74));
    animation-delay: 0.85s;
  }

  .pan-head {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    padding-bottom: 18px;
    border-bottom: 1px dashed rgba(148, 163, 184, 0.28);
    margin-bottom: 22px;
  }

  .pan-head > i {
    font-size: 44px;
    width: 64px;
    height: 64px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
  }

  .pan--gain .pan-head > i {
    color: #4ade80;
    background: rgba(34, 197, 94, 0.14);
  }

  .pan--cost .pan-head > i {
    color: #f87171;
    background: rgba(248, 113, 113, 0.14);
  }

  .pan-title {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .pan-label {
    font-size: 32px;
    font-weight: 700;
    color: #f1f5f9;
    letter-spacing: -0.3px;
  }

  .pan-sub {
    margin-top: 4px;
    font-size: 15px;
    font-weight: 500;
    color: #94a3b8;
    letter-spacing: 0.6px;
    text-transform: uppercase;
  }

  .pan-sign {
    font-size: 42px;
    font-weight: 800;
    line-height: 1;
    opacity: 0.6;
  }

  .pan-sign--gain { color: #4ade80; }
  .pan-sign--cost { color: #f87171; }

  .pan-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .pan-list li {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr);
    align-items: start;
    gap: 12px;
    font-size: 22px;
    font-weight: 400;
    line-height: 1.4;
    color: #e2e8f0;
    padding: 12px 16px;
    border-radius: 10px;
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.28);
  }

  .pan--gain .pan-list li {
    border: 2px solid rgba(74, 222, 128, 0.6);
  }

  .pan--cost .pan-list li {
    border: 2px solid rgba(248, 113, 113, 0.6);
  }

  .pan-list i {
    font-size: 22px;
    margin-top: 2px;
  }

  .pan--gain .pan-list i { color: #4ade80; }
  .pan--cost .pan-list i { color: #f87171; }

  .fulcrum {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.55s forwards;
  }

  .fulcrum .beam {
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, rgba(74, 222, 128, 0.5), rgba(34, 211, 238, 0.7), rgba(248, 113, 113, 0.5));
    border-radius: 4px;
    box-shadow: 0 0 18px rgba(34, 211, 238, 0.25);
  }

  .fulcrum .pivot {
    width: 110px;
    height: 110px;
    margin-top: -57px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at center, rgba(34, 211, 238, 0.28), rgba(15, 23, 42, 0.92) 72%);
    border: 1px solid rgba(34, 211, 238, 0.55);
    box-shadow: 0 0 28px rgba(34, 211, 238, 0.25);
    z-index: 1;
  }

  .fulcrum .pivot i {
    font-size: 64px;
    line-height: 1;
    color: var(--cyan-400);
    display: block;
  }

  .fulcrum .base {
    width: 110px;
    height: 6px;
    margin-top: 8px;
    border-radius: 3px;
    background: rgba(148, 163, 184, 0.35);
  }

  .motto {
    position: relative;
    margin: 44px 0 0;
    max-width: 1180px;
    padding: 20px 28px 20px 56px;
    background: rgba(17, 24, 39, 0.55);
    border-left: 3px solid var(--cyan-400);
    border-radius: 10px;
    text-align: left;
    font-size: 22px;
    font-weight: 300;
    font-style: italic;
    line-height: 1.5;
    color: #e2e8f0;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 1.1s forwards;
  }

  .motto i {
    position: absolute;
    top: 18px;
    left: 18px;
    font-size: 26px;
    color: var(--cyan-400);
  }

  .motto strong {
    color: #f1f5f9;
    font-weight: 700;
    font-style: normal;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
</style>
