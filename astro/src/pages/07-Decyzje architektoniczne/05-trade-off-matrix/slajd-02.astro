---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 02 - Czym jest trade-off?"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.91))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="tradeGrid" width="88" height="88" patternUnits="userSpaceOnUse">
        <path d="M 88 0 L 0 0 0 88" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="tradeGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.05"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#tradeGrid)"/>
    <circle cx="960" cy="510" r="410" fill="url(#tradeGlow)"/>
    <g stroke="rgba(34,211,238,0.12)" stroke-width="2" fill="none">
      <path d="M 170 250 C 430 170, 650 260, 920 220 S 1390 130, 1740 250"/>
      <path d="M 170 760 C 430 680, 650 770, 920 730 S 1390 640, 1740 760"/>
    </g>
  </svg>

  <div class="content">
    <header class="header">
      <span class="level-chip"><i class="ti ti-arrows-exchange"></i> Trade-off oznacza</span>
      <h1 class="title">
        Czym jest <span class="highlight">trade-off?</span>
      </h1>
    </header>

    <section class="definition" aria-label="Definicja trade-off">
      <span>wybierając jedną korzyść</span>
      <i class="ti ti-arrow-right"></i>
      <strong>akceptujemy pewien koszt</strong>
    </section>

    <section class="examples" aria-label="Przykłady trade-offów">
      <article class="example example--services">
        <div class="example-icon"><i class="ti ti-sitemap"></i></div>
        <h2>mikroserwisy</h2>
        <div class="equation">
          <span class="gain">niezależność</span>
          <span class="plus">+</span>
          <span class="cost">złożoność</span>
        </div>
      </article>

      <article class="example example--monolith">
        <div class="example-icon"><i class="ti ti-box"></i></div>
        <h2>monolit</h2>
        <div class="equation">
          <span class="gain">szybkość</span>
          <span class="plus">+</span>
          <span class="cost">ryzyko sprzężenia</span>
        </div>
      </article>
    </section>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
    align-items: center;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: min(1500px, calc(100% - 150px));
    max-width: none;
    padding: 62px 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    max-width: 1180px;
    margin: 0 auto 28px;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 20px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 20px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip i {
    font-size: 22px;
  }

  .title {
    font-size: 82px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.32s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .definition {
    width: min(1280px, 100%);
    min-height: 132px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 86px minmax(0, 1fr);
    align-items: center;
    gap: 22px;
    margin-bottom: 34px;
    padding: 26px 34px;
    border-radius: 18px;
    background:
      radial-gradient(circle at 50% 0%, rgba(34, 211, 238, 0.18), transparent 62%),
      rgba(17, 24, 39, 0.62);
    border: 1px solid rgba(34, 211, 238, 0.40);
    box-shadow: 0 22px 58px rgba(2, 6, 23, 0.30);
    backdrop-filter: blur(10px);
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.52s forwards;
  }

  .definition span,
  .definition strong {
    font-size: 32px;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .definition span {
    color: rgba(240, 244, 248, 0.82);
    font-weight: 500;
    text-align: right;
  }

  .definition strong {
    color: #f8fafc;
    font-weight: 800;
    text-align: left;
  }

  .definition i {
    width: 66px;
    height: 66px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    justify-self: center;
    background: var(--cyan-400);
    color: #0a0e17;
    font-size: 34px;
    box-shadow: 0 0 0 8px rgba(34, 211, 238, 0.11), 0 0 34px rgba(34, 211, 238, 0.42);
  }

  .examples {
    width: min(1320px, 100%);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-bottom: 34px;
  }

  .example {
    position: relative;
    min-height: 290px;
    padding: 34px 36px 36px;
    border-radius: 16px;
    background: rgba(17, 24, 39, 0.62);
    border: 1px solid rgba(148, 163, 184, 0.20);
    box-shadow: 0 18px 46px rgba(2, 6, 23, 0.26);
    backdrop-filter: blur(10px);
    overflow: hidden;
    text-align: left;
    opacity: 0;
    animation: fadeUp 0.85s ease-out forwards;
  }

  .example::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.12), transparent 58%);
  }

  .example--services {
    animation-delay: 0.74s;
    border-color: rgba(34, 211, 238, 0.46);
  }

  .example--monolith {
    animation-delay: 0.90s;
  }

  .example-icon {
    position: relative;
    z-index: 1;
    width: 66px;
    height: 66px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.38);
    color: var(--cyan-400);
    font-size: 36px;
  }

  .example h2 {
    position: relative;
    z-index: 1;
    margin: 0 0 26px;
    color: #f8fafc;
    font-size: 44px;
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: 0;
  }

  .equation {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 44px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
  }

  .equation span {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 13px;
    padding: 14px 16px;
    font-size: 25px;
    font-weight: 700;
    line-height: 1.12;
    text-align: center;
  }

  .gain {
    color: #ecfeff;
    background: rgba(8, 145, 178, 0.24);
    border: 1px solid rgba(34, 211, 238, 0.44);
  }

  .cost {
    color: #e2e8f0;
    background: rgba(15, 23, 42, 0.78);
    border: 1px solid rgba(148, 163, 184, 0.28);
  }

  .equation .plus {
    min-height: 44px;
    width: 44px;
    padding: 0;
    border-radius: 50%;
    justify-self: center;
    color: var(--cyan-400);
    background: rgba(34, 211, 238, 0.10);
    border: 1px solid rgba(34, 211, 238, 0.34);
    font-size: 28px;
    font-weight: 800;
  }
</style>
