---
import SlideLayout from '../../../layouts/SlideLayout.astro';
import { Image } from 'astro:assets';
import commentsImg from './images/trade-off-matrix-commnets.png';
---
<SlideLayout
  title="Slajd 15 - Komentarze wyjaśniają liczby"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.92))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="commentGridSlide15" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <linearGradient id="commentSweepSlide15" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0"/>
        <stop offset="48%" stop-color="#22d3ee" stop-opacity="0.16"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </linearGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#commentGridSlide15)"/>
    <path d="M 188 244 C 478 166, 722 280, 988 216 S 1444 154, 1720 272" fill="none" stroke="rgba(34,211,238,0.12)" stroke-width="1.5"/>
    <path d="M 196 836 C 506 708, 756 858, 1036 764 S 1460 662, 1724 804" fill="none" stroke="rgba(34,211,238,0.12)" stroke-width="1.5"/>
    <path d="M 286 586 H 1470" fill="none" stroke="url(#commentSweepSlide15)" stroke-width="104" stroke-linecap="round"/>
  </svg>

  <div class="content">
    <header class="header">
      <span class="level-chip">
        <i class="ti ti-message-2-plus"></i>
        TRADE-OFF MATRIX
      </span>
      <h1 class="title">
        Liczby wymagają <span class="highlight">uzasadnienia</span>
      </h1>
    </header>

    <section class="story-board" aria-label="Komentarze wyjaśniają liczby">
      <figure class="visual-card" aria-label="Trade-off matrix z komentarzami">
        <Image
          class="comments-img"
          src={commentsImg}
          alt="Trade-off matrix z komentarzami wyjaśniającymi oceny"
          loading="eager"
        />
      </figure>
    </section>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
    align-items: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: min(1560px, calc(100% - 150px));
    max-width: none;
    margin: 0 auto;
    padding: 38px 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    max-width: 1320px;
    margin: 0 auto 22px;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 20px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0;
    margin-bottom: 18px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip i {
    font-size: 22px;
  }

  .title {
    max-width: 1320px;
    font-size: 82px;
    font-weight: 800;
    letter-spacing: 0;
    margin-bottom: 32px;
    line-height: 1.05;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.32s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .story-board {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
  }

  .visual-card {
    position: relative;
    width: min(1240px, 100%);
    padding: 14px;
    border-radius: 18px;
    background:
      radial-gradient(circle at 18% 12%, rgba(34, 211, 238, 0.18), transparent 38%),
      linear-gradient(180deg, rgba(8, 145, 178, 0.14), rgba(17, 24, 39, 0.68));
    border: 1px solid rgba(34, 211, 238, 0.40);
    box-shadow: 0 24px 68px rgba(2, 6, 23, 0.32);
    backdrop-filter: blur(10px);
    overflow: hidden;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.54s forwards;
  }

  .visual-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.11), transparent 62%);
  }

  .comments-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
    border-radius: 12px;
    border: 1px solid rgba(148, 163, 184, 0.22);
    box-shadow: 0 18px 48px rgba(2, 6, 23, 0.42);
  }
</style>
