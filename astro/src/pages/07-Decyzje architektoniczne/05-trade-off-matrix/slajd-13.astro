---
import SlideLayout from '../../../layouts/SlideLayout.astro';
import { Image } from 'astro:assets';
import discussionImg from './images/trade-off-matrix-rozmowa.png';
---
<SlideLayout
  title="Slajd 13 - Punkty nie zastępują rozmowy"
  bgImage="/images/background-4.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.93))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="discussionGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <linearGradient id="discussionSweep" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0"/>
        <stop offset="48%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </linearGradient>
      <radialGradient id="discussionGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="70%" stop-color="#22d3ee" stop-opacity="0.05"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#discussionGrid)"/>
    <circle cx="960" cy="560" r="440" fill="url(#discussionGlow)"/>
    <path d="M 178 286 C 500 190, 744 312, 1018 250 S 1452 168, 1728 302" fill="none" stroke="rgba(34,211,238,0.12)" stroke-width="1.5"/>
    <path d="M 196 824 C 488 710, 726 854, 1026 760 S 1458 658, 1718 800" fill="none" stroke="rgba(34,211,238,0.12)" stroke-width="1.5"/>
    <path d="M 304 604 C 592 482, 1274 486, 1580 602" fill="none" stroke="url(#discussionSweep)" stroke-width="118" stroke-linecap="round"/>
    <g fill="none" stroke="rgba(34,211,238,0.16)" stroke-width="1.5" stroke-dasharray="9 13">
      <path d="M 300 420 H 1620"/>
      <path d="M 300 730 H 1620"/>
      <path d="M 486 344 V 814"/>
      <path d="M 1434 344 V 814"/>
    </g>
  </svg>

  <div class="content">
    <header class="header">
      <span class="level-chip">
        <i class="ti ti-messages"></i>
        TRADE-OFF MATRIX
      </span>

      <h1 class="title">
        Macierz porządkuje <span class="highlight">rozmowę</span>
      </h1>
    </header>

    <section class="story-board" aria-label="Macierz jako podstawa rozmowy">
      <figure class="visual-card" aria-label="Zespół omawia trade-off matrix">
        <Image
          class="discussion-img"
          src={discussionImg}
          alt="Zespół omawia wyniki trade-off matrix i pyta, dlaczego rozwiązania oceniono w taki sposób"
          loading="eager"
        />
      </figure>
    </section>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
    align-items: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: min(1560px, calc(100% - 150px));
    max-width: none;
    margin: 0 auto;
    padding: 38px 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    max-width: 1320px;
    margin: 0 auto 22px;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 19px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0;
    margin-bottom: 16px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip i {
    font-size: 21px;
  }

  .title {
    max-width: 1320px;
    font-size: 78px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.03;
    margin: 0;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.32s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .visual-card {
    position: relative;
    border-radius: 18px;
    background: rgba(17, 24, 39, 0.62);
    border: 1px solid rgba(148, 163, 184, 0.20);
    box-shadow: 0 24px 68px rgba(2, 6, 23, 0.32);
    backdrop-filter: blur(10px);
    overflow: hidden;
  }

  .visual-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.11), transparent 62%);
  }

  .story-board {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
  }

  .visual-card {
    width: min(1240px, 100%);
    padding: 14px;
    background:
      radial-gradient(circle at 18% 12%, rgba(34, 211, 238, 0.18), transparent 38%),
      linear-gradient(180deg, rgba(8, 145, 178, 0.14), rgba(17, 24, 39, 0.68));
    border-color: rgba(34, 211, 238, 0.40);
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.54s forwards;
  }

  .discussion-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
    border-radius: 12px;
    border: 1px solid rgba(148, 163, 184, 0.22);
    box-shadow: 0 18px 48px rgba(2, 6, 23, 0.42);
  }

</style>
