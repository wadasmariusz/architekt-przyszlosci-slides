---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 08 - Opcja 3: podejście ewolucyjne"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.92))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="evolutionGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <linearGradient id="evolutionSweep" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0"/>
        <stop offset="48%" stop-color="#22d3ee" stop-opacity="0.16"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </linearGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#evolutionGrid)"/>
    <path d="M 190 250 C 485 170, 730 275, 980 220 S 1430 150, 1725 280" fill="none" stroke="rgba(34,211,238,0.12)" stroke-width="1.5"/>
    <path d="M 195 815 C 520 700, 760 845, 1040 755 S 1485 650, 1735 810" fill="none" stroke="rgba(34,211,238,0.12)" stroke-width="1.5"/>
    <path d="M 470 574 C 700 468, 965 468, 1195 574" fill="none" stroke="url(#evolutionSweep)" stroke-width="96" stroke-linecap="round"/>
    <g fill="none" stroke="rgba(34,211,238,0.16)" stroke-width="1.5" stroke-dasharray="9 13">
      <path d="M 515 570 C 715 428, 980 428, 1190 570"/>
      <path d="M 515 620 C 735 765, 1000 765, 1190 620"/>
    </g>
  </svg>

  <div class="content">
    <header class="header">
      <span class="level-chip">
        <i class="ti ti-timeline-event-plus"></i>
        OPCJA 3
      </span>
      <h1 class="title">
        Podejście<span class="highlight"> ewolucyjne</span>
      </h1>
    </header>

    <section class="evolution-board" aria-label="Opcja 3: podejście ewolucyjne">
      <article class="state-panel state-panel--monolith">
        <h2>MODULARNY MONOLIT</h2>
        <div class="monolith-shell" aria-hidden="true">
          <span class="module-cell module-cell--selected"><i class="ti ti-calendar-event"></i></span>
          <span class="module-cell"><i class="ti ti-credit-card"></i></span>
          <span class="module-cell"><i class="ti ti-car"></i></span>
          <span class="module-cell module-cell--selected"><i class="ti ti-users"></i></span>
        </div>
      </article>

      <div class="transition" aria-hidden="true">
        <span class="moving-module moving-module--top"><i class="ti ti-calendar-event"></i></span>
        <span class="moving-module moving-module--bottom"><i class="ti ti-users"></i></span>
        <span class="transition-line"></span>
        <span class="transition-icon"><i class="ti ti-arrow-narrow-right"></i></span>
      </div>

      <article class="state-panel state-panel--services">
        <h2>MIKROSERWISY</h2>
        <div class="services-shell" aria-hidden="true">
          <span class="service-node service-node--1"><i class="ti ti-calendar-event"></i></span>
          <span class="service-node service-node--2"><i class="ti ti-users"></i></span>
          <span class="service-node service-node--3"><i class="ti ti-box"></i></span>
          <span class="service-link service-link--1"></span>
          <span class="service-link service-link--2"></span>
        </div>
      </article>
    </section>

    <div class="animation-caption">
      Monolit modularny → wybrane moduły jako mikroserwisy.
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
    align-items: center;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: min(1520px, calc(100% - 140px));
    max-width: none;
    padding: 54px 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    max-width: 1320px;
    margin: 0 auto 22px;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 20px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0;
    margin-bottom: 18px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip i {
    font-size: 22px;
  }

  .title {
    font-size: 82px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.32s forwards;
    margin-bottom: 32px;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lede {
    width: min(1120px, 100%);
    margin: 0 0 24px;
    color: rgba(240, 244, 248, 0.82);
    font-size: 28px;
    font-weight: 300;
    line-height: 1.34;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.48s forwards;
  }

  .evolution-board {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px minmax(0, 1fr);
    gap: 28px;
    align-items: stretch;
  }

  .state-panel {
    position: relative;
    min-height: 430px;
    padding: 30px;
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgba(8, 145, 178, 0.16), rgba(17, 24, 39, 0.64));
    border: 1px solid rgba(34, 211, 238, 0.34);
    box-shadow: 0 24px 68px rgba(2, 6, 23, 0.32);
    backdrop-filter: blur(10px);
    overflow: hidden;
    opacity: 0;
    animation: fadeUp 0.9s ease-out forwards;
  }

  .state-panel::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.11), transparent 58%);
  }

  .state-panel--monolith {
    animation-delay: 0.68s;
  }

  .state-panel--services {
    animation-delay: 1.08s;
    border-color: rgba(74, 222, 128, 0.36);
    background:
      linear-gradient(180deg, rgba(22, 163, 74, 0.13), rgba(17, 24, 39, 0.64));
  }

  .state-panel h2 {
    position: relative;
    z-index: 1;
    margin: 0 0 28px;
    color: #f8fafc;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: 0;
  }

  .monolith-shell {
    position: relative;
    z-index: 1;
    width: min(390px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    padding: 28px;
    border-radius: 24px;
    background: rgba(2, 6, 23, 0.36);
    border: 1px solid rgba(34, 211, 238, 0.30);
    box-shadow: inset 0 0 38px rgba(34, 211, 238, 0.09);
  }

  .monolith-shell::before,
  .monolith-shell::after {
    content: "";
    position: absolute;
    z-index: 0;
    background: rgba(34, 211, 238, 0.24);
    border-radius: 999px;
  }

  .monolith-shell::before {
    left: 50%;
    top: 20px;
    bottom: 20px;
    width: 2px;
    transform: translateX(-50%);
  }

  .monolith-shell::after {
    left: 20px;
    right: 20px;
    top: 50%;
    height: 2px;
    transform: translateY(-50%);
  }

  .module-cell {
    position: relative;
    z-index: 1;
    min-height: 112px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.78);
    border: 1px solid rgba(148, 163, 184, 0.22);
    color: #cbd5e1;
    font-size: 42px;
  }

  .module-cell--selected {
    color: var(--cyan-400);
    border-color: rgba(34, 211, 238, 0.55);
    background: rgba(8, 145, 178, 0.22);
    box-shadow: 0 0 34px rgba(34, 211, 238, 0.18);
    animation: selectedPulse 2.8s ease-in-out 1.2s infinite;
  }

  .transition {
    position: relative;
    min-height: 430px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.86s forwards;
  }

  .transition-line {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 50%;
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(34, 211, 238, 0.12), rgba(34, 211, 238, 0.72), rgba(74, 222, 128, 0.46));
    transform: translateY(-50%);
    box-shadow: 0 0 24px rgba(34, 211, 238, 0.18);
  }

  .transition-icon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 74px;
    height: 74px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.84);
    border: 1px solid rgba(34, 211, 238, 0.46);
    color: var(--cyan-400);
    font-size: 48px;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 36px rgba(34, 211, 238, 0.18);
  }

  .moving-module {
    position: absolute;
    left: 8px;
    width: 62px;
    height: 62px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(8, 145, 178, 0.28);
    border: 1px solid rgba(34, 211, 238, 0.52);
    color: var(--cyan-400);
    font-size: 32px;
    box-shadow: 0 0 30px rgba(34, 211, 238, 0.20);
    animation: moduleMove 3.6s ease-in-out 1.1s infinite;
  }

  .moving-module--top {
    top: 148px;
  }

  .moving-module--bottom {
    top: 222px;
    animation-delay: 1.34s;
  }

  .services-shell {
    position: relative;
    z-index: 1;
    width: min(430px, 100%);
    height: 250px;
    margin: 18px auto 0;
  }

  .service-node {
    position: absolute;
    z-index: 2;
    width: 92px;
    height: 92px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.84);
    border: 1px solid rgba(74, 222, 128, 0.46);
    color: #86efac;
    font-size: 44px;
    box-shadow: 0 0 34px rgba(74, 222, 128, 0.14);
  }

  .service-node--1 {
    left: 50%;
    top: 0;
    animation: serviceAppearTop 0.65s ease-out 1.44s both;
  }

  .service-node--2 {
    right: 18px;
    bottom: 0;
    animation: serviceAppear 0.65s ease-out 1.66s both;
  }

  .service-node--3 {
    left: 18px;
    bottom: 0;
    border-color: rgba(34, 211, 238, 0.34);
    color: var(--cyan-400);
    animation: serviceAppear 0.65s ease-out 1.2s both;
  }

  .service-link {
    position: absolute;
    left: 50%;
    top: 92px;
    width: 170px;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, rgba(74, 222, 128, 0.58), transparent);
    transform-origin: left center;
  }

  .service-link--1 {
    transform: rotate(38deg);
  }

  .service-link--2 {
    transform: rotate(142deg);
  }

  .animation-caption {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 22px;
    padding: 12px 24px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.13);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: rgba(240, 244, 248, 0.88);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
    opacity: 0;
    animation: fadeUp 0.85s ease-out 1.26s forwards;
  }

  @keyframes selectedPulse {
    0%, 100% {
      box-shadow: 0 0 28px rgba(34, 211, 238, 0.14);
    }
    50% {
      box-shadow: 0 0 42px rgba(34, 211, 238, 0.30);
    }
  }

  @keyframes moduleMove {
    0% {
      opacity: 0;
      transform: translateX(0) scale(0.92);
    }
    14% {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
    72% {
      opacity: 1;
      transform: translateX(142px) scale(1);
    }
    100% {
      opacity: 0;
      transform: translateX(142px) scale(0.92);
    }
  }

  @keyframes serviceAppear {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes serviceAppearTop {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(16px) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) translateY(0) scale(1);
    }
  }
</style>
