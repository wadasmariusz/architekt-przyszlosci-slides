---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 04 - Trade-off matrix"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.92))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="matrixGridSlide4" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="matrixGlowSlide4" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.05"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#matrixGridSlide4)"/>
    <circle cx="1040" cy="560" r="430" fill="url(#matrixGlowSlide4)"/>
    <g stroke="rgba(34,211,238,0.12)" stroke-width="1.5" fill="none">
      <path d="M 240 220 C 520 160, 720 260, 980 210 S 1410 150, 1680 260"/>
      <path d="M 260 850 C 560 720, 760 880, 1040 770 S 1450 680, 1700 810"/>
      <circle cx="1040" cy="560" r="315" stroke-dasharray="8 12"/>
    </g>
  </svg>

  <div class="content">
    <header class="header">
      <h1 class="title">
        Trade-off <span class="highlight">matrix</span>
      </h1>
    </header>

    <section class="matrix-board" aria-label="opcje po jednej osi, kryteria po drugiej">
      <div class="axis axis--criteria">
        <i class="ti ti-ruler-measure"></i>
        <span>kryteria</span>
      </div>

      <div class="axis axis--options">
        <i class="ti ti-git-branch"></i>
        <span>opcje</span>
      </div>

      <div class="matrix">
        <div class="corner-cell"></div>
        <div class="header-cell"><span></span></div>
        <div class="header-cell"><span></span></div>
        <div class="header-cell"><span></span></div>
        <div class="header-cell"><span></span></div>

        <div class="side-cell"><span></span></div>
        <div class="matrix-cell cell--strong"></div>
        <div class="matrix-cell cell--soft"></div>
        <div class="matrix-cell cell--risk"></div>
        <div class="matrix-cell cell--soft"></div>

        <div class="side-cell"><span></span></div>
        <div class="matrix-cell cell--soft"></div>
        <div class="matrix-cell cell--strong"></div>
        <div class="matrix-cell cell--soft"></div>
        <div class="matrix-cell cell--risk"></div>

        <div class="side-cell"><span></span></div>
        <div class="matrix-cell cell--risk"></div>
        <div class="matrix-cell cell--soft"></div>
        <div class="matrix-cell cell--strong"></div>
        <div class="matrix-cell cell--soft"></div>
      </div>
    </section>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
    align-items: center;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: min(1500px, calc(100% - 150px));
    max-width: none;
    padding: 58px 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    max-width: 1260px;
    margin: 0 auto 28px;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 20px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0;
    margin-bottom: 20px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip i {
    font-size: 22px;
  }

  .title {
    font-size: 82px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.32s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .matrix-board {
    position: relative;
    width: min(1260px, 100%);
    min-height: 520px;
    padding: 74px 74px 54px 118px;
    border-radius: 18px;
    background:
      radial-gradient(circle at 78% 16%, rgba(34, 211, 238, 0.17), transparent 40%),
      rgba(17, 24, 39, 0.62);
    border: 1px solid rgba(34, 211, 238, 0.30);
    box-shadow: 0 24px 68px rgba(2, 6, 23, 0.32);
    backdrop-filter: blur(10px);
    margin-bottom: 24px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.52s forwards;
  }

  .matrix-board::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.10), transparent 58%);
  }

  .axis {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--cyan-400);
    font-size: 24px;
    font-weight: 800;
    letter-spacing: 0;
  }

  .axis i {
    width: 48px;
    height: 48px;
    border-radius: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.38);
    font-size: 26px;
  }

  .axis--criteria {
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
  }

  .axis--options {
    left: 24px;
    top: 50%;
    transform: translateY(-50%) rotate(-90deg);
    transform-origin: center;
  }

  .matrix {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 120px repeat(4, minmax(0, 1fr));
    grid-template-rows: 84px repeat(3, 112px);
    gap: 12px;
    margin-top: 18px;
  }

  .corner-cell,
  .header-cell,
  .side-cell,
  .matrix-cell {
    border-radius: 14px;
    border: 1px solid rgba(148, 163, 184, 0.20);
    background: rgba(15, 23, 42, 0.66);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .header-cell,
  .side-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    border-color: rgba(34, 211, 238, 0.24);
    background: rgba(8, 145, 178, 0.16);
  }

  .header-cell span,
  .side-cell span {
    width: 42px;
    height: 12px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.46);
    box-shadow: 0 0 24px rgba(34, 211, 238, 0.18);
  }

  .side-cell span {
    width: 12px;
    height: 42px;
  }

  .matrix-cell {
    position: relative;
    overflow: hidden;
  }

  .matrix-cell::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .cell--strong {
    border-color: rgba(34, 211, 238, 0.46);
    background: rgba(8, 145, 178, 0.20);
  }

  .cell--strong::before {
    background: var(--cyan-400);
    box-shadow: 0 0 0 9px rgba(34, 211, 238, 0.11), 0 0 34px rgba(34, 211, 238, 0.34);
  }

  .cell--soft::before {
    width: 28px;
    height: 28px;
    background: rgba(226, 232, 240, 0.40);
  }

  .cell--risk {
    border-color: rgba(248, 113, 113, 0.30);
    background: rgba(220, 38, 38, 0.10);
  }

  .cell--risk::before {
    width: 34px;
    height: 34px;
    background: rgba(248, 113, 113, 0.72);
    box-shadow: 0 0 26px rgba(220, 38, 38, 0.20);
  }

  .principle {
    width: min(1120px, 100%);
    min-height: 104px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 24px 34px;
    border-radius: 16px;
    background:
      linear-gradient(90deg, rgba(8, 145, 178, 0.22), rgba(17, 24, 39, 0.66));
    border: 1px solid rgba(34, 211, 238, 0.42);
    box-shadow: 0 18px 46px rgba(2, 6, 23, 0.25);
    backdrop-filter: blur(10px);
    color: #f8fafc;
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.82s forwards;
  }

  .principle i {
    width: 58px;
    height: 58px;
    border-radius: 15px;
    flex: 0 0 58px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.38);
    color: var(--cyan-400);
    font-size: 31px;
  }

  .principle span {
    font-size: 31px;
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: 0;
  }
</style>
