---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 06 - Opcja 1: modularny monolit"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.92))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="modularGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="modularGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.05"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#modularGrid)"/>
    <circle cx="960" cy="560" r="430" fill="url(#modularGlow)"/>
    <g stroke="rgba(34,211,238,0.12)" stroke-width="1.5" fill="none">
      <path d="M 220 250 C 520 160, 760 260, 1030 210 S 1460 150, 1710 270"/>
      <path d="M 240 830 C 540 710, 760 850, 1030 760 S 1470 660, 1720 800"/>
      <circle cx="960" cy="560" r="330" stroke-dasharray="8 12"/>
    </g>
  </svg>

  <div class="content">
    <header class="header">
      <span class="level-chip"><i class="ti ti-message-circle"></i>Opcja 1</span>
      <h1 class="title">
        <span class="highlight">Modularny </span>Monolit
      </h1>
    </header>

    <section class="services-board" aria-label="Opcja 1: modularny monolit">
      <div class="monolith-diagram" aria-hidden="true">
        <div class="monolith-heading">
          <i class="ti ti-box"></i>
          <span>Modularny Monolit</span>
        </div>

        <div class="module-shell">
          <div class="module-tile module-tile--primary"><i class="ti ti-calendar-event"></i></div>
          <div class="module-tile"><i class="ti ti-credit-card"></i></div>
          <div class="module-tile"><i class="ti ti-car"></i></div>
          <div class="module-tile"><i class="ti ti-users"></i></div>
        </div>
      </div>

      <article class="panel panel--gain">
        <h2>Zalety</h2>
        <ul>
          <li><i class="ti ti-rocket"></i><span>Szybsze dostarczanie</span></li>
          <li><i class="ti ti-flask"></i><span>Prostsze testy lokalne</span></li>
          <li><i class="ti ti-database"></i><span>Łatwiejsze transakcje</span></li>
          <li><i class="ti ti-network-off"></i><span>Brak komunikacji sieciowej między usługami</span></li>
        </ul>
      </article>

      <article class="panel panel--cost">
        <h2>Koszt</h2>
        <ul>
          <li><i class="ti ti-alert-triangle"></i><span>Ryzyko sprzężenia</span></li>
          <li><i class="ti ti-alert-triangle"></i><span>Trudniejsze skalowanie</span></li>
          <li><i class="ti ti-alert-triangle"></i><span>Wspólny deployment</span></li>
        </ul>
      </article>
    </section>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
    align-items: center;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: min(1500px, calc(100% - 150px));
    max-width: none;
    padding: 58px 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    max-width: 1260px;
    margin: 0 auto 32px;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 20px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0;
    margin-bottom: 20px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip i {
    font-size: 22px;
  }

  .title {
    font-size: 82px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.32s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .services-board {
    width: min(1360px, 100%);
    display: grid;
    grid-template-columns: 1fr 390px 1fr;
    gap: 26px;
    align-items: stretch;
  }

  .monolith-diagram,
  .panel {
    min-height: 500px;
    border-radius: 18px;
    background:
      radial-gradient(circle at 50% 12%, rgba(34, 211, 238, 0.17), transparent 42%),
      rgba(17, 24, 39, 0.62);
    border: 1px solid rgba(34, 211, 238, 0.30);
    box-shadow: 0 24px 68px rgba(2, 6, 23, 0.32);
    backdrop-filter: blur(10px);
    opacity: 0;
    animation: fadeUp 0.9s ease-out forwards;
  }

  .monolith-diagram {
    position: relative;
    order: 2;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    animation-delay: 0.62s;
  }

  .monolith-diagram::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.10), transparent 58%);
  }

  .monolith-heading {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 30px;
    color: #f8fafc;
    font-size: 31px;
    font-weight: 800;
    line-height: 1.08;
    text-align: left;
  }

  .monolith-heading i {
    width: 60px;
    height: 60px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.38);
    color: var(--cyan-400);
    font-size: 33px;
    flex: 0 0 60px;
  }

  .module-shell {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    padding: 22px;
    border-radius: 20px;
    background: rgba(2, 6, 23, 0.32);
    border: 1px solid rgba(34, 211, 238, 0.28);
    box-shadow: inset 0 0 34px rgba(34, 211, 238, 0.08);
  }

  .module-shell::before,
  .module-shell::after {
    content: "";
    position: absolute;
    background: rgba(34, 211, 238, 0.25);
    border-radius: 999px;
  }

  .module-shell::before {
    left: 50%;
    top: 18px;
    bottom: 18px;
    width: 2px;
    transform: translateX(-50%);
  }

  .module-shell::after {
    left: 18px;
    right: 18px;
    top: 50%;
    height: 2px;
    transform: translateY(-50%);
  }

  .module-tile {
    min-height: 108px;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.78);
    border: 1px solid rgba(148, 163, 184, 0.20);
    color: #cbd5e1;
    font-size: 36px;
  }

  .module-tile--primary {
    border-color: rgba(34, 211, 238, 0.48);
    background: rgba(8, 145, 178, 0.22);
    color: var(--cyan-400);
    box-shadow: 0 0 32px rgba(34, 211, 238, 0.16);
  }

  .panel {
    position: relative;
    padding: 34px 32px 36px;
    text-align: left;
    overflow: hidden;
  }

  .panel::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.10), transparent 58%);
  }

  .panel--gain {
    order: 1;
    animation-delay: 0.76s;
    border-color: rgba(74, 222, 128, 0.34);
  }

  .panel--cost {
    order: 3;
    animation-delay: 0.90s;
    border-color: rgba(248, 113, 113, 0.34);
  }

  .panel h2 {
    position: relative;
    z-index: 1;
    margin: 0 0 26px;
    color: #f8fafc;
    font-size: 42px;
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: 0;
  }

  .panel--gain h2 {
    color: #dcfce7;
  }

  .panel--cost h2 {
    color: #fee2e2;
  }

  .panel ul {
    position: relative;
    z-index: 1;
    list-style: none;
    display: grid;
    gap: 16px;
  }

  .panel li {
    min-height: 78px;
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 16px;
    align-items: center;
    padding: 15px 18px;
    border-radius: 14px;
    background: rgba(15, 23, 42, 0.70);
    border: 1px solid rgba(148, 163, 184, 0.20);
  }

  .panel--gain li {
    background: rgba(22, 163, 74, 0.12);
    border-color: rgba(74, 222, 128, 0.30);
  }

  .panel--cost li {
    background: rgba(220, 38, 38, 0.10);
    border-color: rgba(248, 113, 113, 0.30);
  }

  .panel li i {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.34);
    color: var(--cyan-400);
    font-size: 28px;
  }

  .panel--gain li i {
    background: rgba(22, 163, 74, 0.18);
    border-color: rgba(74, 222, 128, 0.38);
    color: #86efac;
  }

  .panel--cost li i {
    background: rgba(220, 38, 38, 0.16);
    border-color: rgba(248, 113, 113, 0.38);
    color: #fca5a5;
  }

  .panel li span {
    color: #f8fafc;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0;
  }

</style>
