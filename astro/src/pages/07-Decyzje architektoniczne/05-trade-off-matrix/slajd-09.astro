---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 09 - Jak budować macierz?"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.92))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="buildMatrixGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="buildMatrixGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.05"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#buildMatrixGrid)"/>
    <circle cx="760" cy="570" r="430" fill="url(#buildMatrixGlow)"/>
    <g stroke="rgba(34,211,238,0.12)" stroke-width="1.5" fill="none">
      <path d="M 150 245 C 440 165, 705 275, 970 220 S 1425 155, 1745 275"/>
      <path d="M 165 790 C 475 690, 700 855, 990 742 S 1445 660, 1735 805"/>
      <circle cx="760" cy="570" r="302" stroke-dasharray="8 12"/>
    </g>
  </svg>

  <div class="content">
    <header class="header">
      <h1 class="title">
        Jak budować <span class="highlight">macierz?</span>
      </h1>
    </header>

    <section class="build-board" aria-label="Jak budować macierz?">
      <section class="steps-panel" aria-label="Kroki">
        <div class="steps-label">
          <i class="ti ti-route"></i>
          <span>Kroki:</span>
        </div>

        <ol class="step-list">
          <li class="step-card step-card--variants">
            <i class="ti ti-git-branch"></i>
            <h2>Warianty</h2>
          </li>

          <li class="step-card step-card--criteria">
            <i class="ti ti-ruler-measure"></i>
            <h2>Kryteria</h2>
          </li>

          <li class="step-card step-card--weights">
            <i class="ti ti-scale"></i>
            <h2>Wagi</h2>
          </li>

          <li class="step-card step-card--score">
            <i class="ti ti-chart-bar"></i>
            <h2>Ocena</h2>
          </li>

          <li class="step-card step-card--risk">
            <i class="ti ti-message-report"></i>
            <h2>Komentarze i ryzyka</h2>
          </li>
        </ol>
      </section>

      <article class="matrix-card" aria-hidden="true">
        <div class="matrix-shell">
          <div class="matrix-grid">
            <span class="matrix-cell matrix-cell--head"></span>
            <span class="matrix-cell matrix-cell--head"></span>
            <span class="matrix-cell matrix-cell--head"></span>
            <span class="matrix-cell matrix-cell--head"></span>
            <span class="matrix-cell matrix-cell--side"></span>
            <span class="matrix-cell matrix-cell--soft"></span>
            <span class="matrix-cell matrix-cell--strong"></span>
            <span class="matrix-cell matrix-cell--soft"></span>
            <span class="matrix-cell matrix-cell--side"></span>
            <span class="matrix-cell matrix-cell--strong"></span>
            <span class="matrix-cell matrix-cell--soft"></span>
            <span class="matrix-cell matrix-cell--risk"></span>
            <span class="matrix-cell matrix-cell--side"></span>
            <span class="matrix-cell matrix-cell--soft"></span>
            <span class="matrix-cell matrix-cell--risk"></span>
            <span class="matrix-cell matrix-cell--strong"></span>
          </div>

          <span class="step-dot step-dot--1">1</span>
          <span class="step-dot step-dot--2">2</span>
          <span class="step-dot step-dot--3">3</span>
          <span class="step-dot step-dot--4">4</span>
          <span class="step-dot step-dot--5">5</span>
        </div>
      </article>
    </section>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
    align-items: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: none;
    padding: 54px 0 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .header {
    width: 100%;
    max-width: none;
    margin: 0 0 26px;
    text-align: center;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 20px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0;
    margin-bottom: 18px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip i {
    font-size: 22px;
  }

  .title {
    max-width: none;
    font-size: 82px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.32s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .build-board {
    width: min(1340px, calc(100% - 580px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 480px;
    gap: 26px;
    align-items: stretch;
  }

  .matrix-card,
  .steps-panel,
  .step-card {
    border-radius: 16px;
    background: rgba(17, 24, 39, 0.62);
    border: 1px solid rgba(148, 163, 184, 0.20);
    box-shadow: 0 18px 46px rgba(2, 6, 23, 0.26);
    backdrop-filter: blur(10px);
    overflow: hidden;
  }

  .matrix-card {
    min-height: 630px;
    padding: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 50% 18%, rgba(34, 211, 238, 0.22), transparent 48%),
      linear-gradient(180deg, rgba(8, 145, 178, 0.20), rgba(17, 24, 39, 0.66));
    border-color: rgba(34, 211, 238, 0.40);
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.52s forwards;
  }

  .matrix-shell {
    position: relative;
    width: 100%;
    min-height: 520px;
    border-radius: 22px;
    background: rgba(2, 6, 23, 0.30);
    border: 1px solid rgba(34, 211, 238, 0.24);
    box-shadow: inset 0 0 40px rgba(34, 211, 238, 0.09);
    padding: 42px;
  }

  .matrix-shell::before,
  .matrix-shell::after {
    content: "";
    position: absolute;
    border-radius: 999px;
    pointer-events: none;
  }

  .matrix-shell::before {
    inset: 26px;
    border: 1px dashed rgba(34, 211, 238, 0.26);
  }

  .matrix-shell::after {
    left: 50%;
    top: 50%;
    width: 280px;
    height: 280px;
    background: radial-gradient(circle, rgba(34, 211, 238, 0.16), transparent 68%);
    transform: translate(-50%, -50%);
  }

  .matrix-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .matrix-cell {
    aspect-ratio: 1;
    border-radius: 14px;
    border: 1px solid rgba(148, 163, 184, 0.20);
    background: rgba(15, 23, 42, 0.74);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .matrix-cell--head,
  .matrix-cell--side {
    background: rgba(8, 145, 178, 0.18);
    border-color: rgba(34, 211, 238, 0.28);
  }

  .matrix-cell--strong {
    background: linear-gradient(135deg, rgba(22, 163, 74, 0.36), rgba(15, 23, 42, 0.72));
    border-color: rgba(74, 222, 128, 0.40);
  }

  .matrix-cell--soft {
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.18), rgba(15, 23, 42, 0.72));
    border-color: rgba(34, 211, 238, 0.28);
  }

  .matrix-cell--risk {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.30), rgba(15, 23, 42, 0.72));
    border-color: rgba(251, 191, 36, 0.38);
  }

  .step-dot {
    position: absolute;
    z-index: 2;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--cyan-400);
    border: 1px solid rgba(255, 255, 255, 0.42);
    color: #0a0e17;
    font-size: 23px;
    font-weight: 800;
    box-shadow: 0 0 34px rgba(34, 211, 238, 0.28);
  }

  .step-dot--1 { left: 38px; top: 42px; }
  .step-dot--2 { right: 42px; top: 42px; }
  .step-dot--3 { left: 50%; top: 50%; transform: translate(-50%, -50%); background: #f59e0b; }
  .step-dot--4 { left: 56px; top: 312px; background: #86efac; }
  .step-dot--5 { right: 56px; top: 312px; background: #c4b5fd; }

  .steps-panel {
    min-height: 630px;
    padding: 24px;
    background:
      linear-gradient(180deg, rgba(15, 23, 42, 0.72), rgba(17, 24, 39, 0.58));
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.64s forwards;
  }

  .steps-label {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0;
    margin-bottom: 16px;
  }

  .steps-label i {
    font-size: 24px;
  }

  .step-list {
    list-style: none;
    display: grid;
    gap: 14px;
  }

  .step-card {
    position: relative;
    min-height: 98px;
    display: grid;
    grid-template-columns: 58px 60px minmax(0, 1fr);
    gap: 18px;
    align-items: center;
    padding: 18px 22px;
    opacity: 0;
    animation: fadeUp 0.78s ease-out forwards;
  }

  .step-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.12), transparent 58%);
  }

  .step-card:nth-child(1) { animation-delay: 0.78s; }
  .step-card:nth-child(2) { animation-delay: 0.90s; }
  .step-card:nth-child(3) { animation-delay: 1.02s; }
  .step-card:nth-child(4) { animation-delay: 1.14s; }
  .step-card:nth-child(5) { animation-delay: 1.26s; }

  .step-number,
  .step-card i,
  .step-card h2 {
    position: relative;
    z-index: 1;
  }

  .step-number {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.40);
    color: var(--cyan-400);
    font-size: 22px;
    font-weight: 800;
  }

  .step-card i {
    width: 58px;
    height: 58px;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.38);
    color: var(--cyan-400);
    font-size: 31px;
  }

  .step-card h2 {
    margin: 0;
    color: #f8fafc;
    font-size: 34px;
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: 0;
  }

  .step-card--weights {
    border-color: rgba(251, 191, 36, 0.36);
  }

  .step-card--weights::before {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.16), transparent 58%);
  }

  .step-card--weights .step-number,
  .step-card--weights i {
    background: rgba(245, 158, 11, 0.14);
    border-color: rgba(251, 191, 36, 0.40);
    color: #fbbf24;
  }

  .step-card--score {
    border-color: rgba(74, 222, 128, 0.36);
  }

  .step-card--score::before {
    background: linear-gradient(135deg, rgba(22, 163, 74, 0.14), transparent 58%);
  }

  .step-card--score .step-number,
  .step-card--score i {
    background: rgba(22, 163, 74, 0.16);
    border-color: rgba(74, 222, 128, 0.42);
    color: #86efac;
  }

  .step-card--risk {
    border-color: rgba(167, 139, 250, 0.38);
  }

  .step-card--risk::before {
    background: linear-gradient(135deg, rgba(76, 29, 149, 0.18), transparent 58%);
  }

  .step-card--risk .step-number,
  .step-card--risk i {
    background: rgba(167, 139, 250, 0.12);
    border-color: rgba(167, 139, 250, 0.34);
    color: #c4b5fd;
  }

  .step-card--risk h2 {
    font-size: 32px;
    white-space: nowrap;
  }
</style>
