---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 16 - Od macierzy do ADR"
  bgImage="/images/background-5.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.92))"
>
  <div class="content">
    <header class="header">
      <span class="level-chip">
        <i class="ti ti-arrow-guide"></i>
        gdy łączymy trade-off matrix z ADR-em
      </span>
      <h1 class="title">
        Od macierzy do <span class="highlight">ADR</span>
      </h1>
    </header>

    <section class="adr-flow" aria-label="prosty przepływ z trade-off matrix do ADR">
      <article class="endpoint endpoint--matrix">
        <div class="endpoint-icon"><i class="ti ti-table-options"></i></div>
        <h2>trade-off matrix</h2>
        <div class="matrix-mini" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span class="matrix-soft"></span>
          <span class="matrix-strong"></span>
          <span></span>
          <span class="matrix-strong"></span>
          <span class="matrix-soft"></span>
        </div>
      </article>

      <div class="flow-core">
        <span class="flow-line" aria-hidden="true"></span>

        <article class="flow-step flow-step--context">
          <span class="step-icon"><i class="ti ti-world-search"></i></span>
          <h2>kontekst</h2>
        </article>

        <article class="flow-step flow-step--options">
          <span class="step-icon"><i class="ti ti-git-branch"></i></span>
          <h2>opcje</h2>
        </article>

        <article class="flow-step flow-step--criteria">
          <span class="step-icon"><i class="ti ti-list-check"></i></span>
          <h2>kryteria</h2>
        </article>

        <article class="flow-step flow-step--decision">
          <span class="step-icon"><i class="ti ti-file-check"></i></span>
          <h2>decyzja</h2>
        </article>

        <article class="flow-step flow-step--consequences">
          <span class="step-icon"><i class="ti ti-route"></i></span>
          <h2>konsekwencje</h2>
        </article>
      </div>

      <article class="endpoint endpoint--adr">
        <div class="endpoint-icon"><i class="ti ti-file-description"></i></div>
        <h2>ADR</h2>
        <div class="adr-mini" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>
      </article>
    </section>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: center;
    align-items: center;
  }

  .content {
    position: relative;
    z-index: 5;
    width: min(1540px, calc(100% - 128px));
    max-width: none;
    margin: 0 auto;
    padding: 0 0 38px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    transform: translateY(-64px);
  }

  .header {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto 34px;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 20px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0;
    margin-bottom: 18px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip i {
    font-size: 22px;
  }

  .title {
    max-width: 1260px;
    font-size: 78px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0 auto;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.32s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .adr-flow {
    position: relative;
    width: 100%;
    min-height: 420px;
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr) 250px;
    gap: 22px;
    align-items: center;
    justify-content: center;
  }

  .adr-flow::before {
    content: "";
    position: absolute;
    left: 178px;
    right: 178px;
    top: 50%;
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(34, 211, 238, 0.12), rgba(34, 211, 238, 0.70), rgba(245, 158, 11, 0.42));
    box-shadow: 0 0 34px rgba(34, 211, 238, 0.18);
    transform: translateY(-50%);
    opacity: 0;
    animation: fadeIn 0.9s ease-out 0.66s forwards;
  }

  .endpoint,
  .flow-step {
    position: relative;
    z-index: 1;
    background: rgba(17, 24, 39, 0.62);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 18px;
    box-shadow: 0 24px 68px rgba(2, 6, 23, 0.32);
    backdrop-filter: blur(10px);
    overflow: hidden;
  }

  .endpoint::before,
  .flow-step::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.11), transparent 60%);
  }

  .endpoint {
    min-height: 330px;
    padding: 30px 26px 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    animation: fadeUp 0.9s ease-out forwards;
  }

  .endpoint--matrix {
    animation-delay: 0.52s;
  }

  .endpoint--adr {
    background:
      linear-gradient(180deg, rgba(8, 145, 178, 0.24), rgba(17, 24, 39, 0.66));
    border-color: rgba(34, 211, 238, 0.46);
    box-shadow: 0 24px 68px rgba(8, 145, 178, 0.18);
    animation-delay: 1.12s;
  }

  .endpoint-icon,
  .step-icon {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cyan-400);
  }

  .endpoint-icon {
    width: 76px;
    height: 76px;
    margin-bottom: 20px;
    border-radius: 20px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.38);
    font-size: 42px;
    box-shadow: 0 0 34px rgba(34, 211, 238, 0.16);
  }

  .endpoint h2 {
    position: relative;
    z-index: 1;
    color: #f8fafc;
    font-size: 29px;
    font-weight: 800;
    line-height: 1.1;
    margin: 0 0 24px;
  }

  .matrix-mini {
    position: relative;
    z-index: 1;
    width: 158px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .matrix-mini span {
    height: 34px;
    border-radius: 9px;
    background: rgba(15, 23, 42, 0.86);
    border: 1px solid rgba(148, 163, 184, 0.26);
  }

  .matrix-mini .matrix-soft {
    background: rgba(34, 211, 238, 0.15);
    border-color: rgba(34, 211, 238, 0.35);
  }

  .matrix-mini .matrix-strong {
    background: rgba(34, 211, 238, 0.34);
    border-color: rgba(34, 211, 238, 0.58);
    box-shadow: inset 0 0 20px rgba(34, 211, 238, 0.12);
  }

  .adr-mini {
    position: relative;
    z-index: 1;
    width: 150px;
    padding: 18px 18px 20px;
    border-radius: 18px;
    background: rgba(2, 6, 23, 0.36);
    border: 1px solid rgba(34, 211, 238, 0.24);
  }

  .adr-mini span {
    display: block;
    height: 10px;
    border-radius: 999px;
    background: rgba(203, 213, 225, 0.42);
    margin-bottom: 12px;
  }

  .adr-mini span:nth-child(1) {
    width: 64px;
    background: rgba(34, 211, 238, 0.76);
  }

  .adr-mini span:nth-child(2) {
    width: 112px;
  }

  .adr-mini span:nth-child(3) {
    width: 94px;
  }

  .adr-mini span:nth-child(4) {
    width: 120px;
    margin-bottom: 0;
  }

  .flow-core {
    position: relative;
    min-height: 330px;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
    align-items: center;
  }

  .flow-line {
    position: absolute;
    z-index: 0;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(34, 211, 238, 0.16), rgba(34, 211, 238, 0.52), rgba(245, 158, 11, 0.38));
    transform: translateY(-50%);
  }

  .flow-step {
    min-height: 178px;
    padding: 22px 14px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-color: rgba(34, 211, 238, 0.30);
    opacity: 0;
    transform: translateY(18px);
    animation: fadeUp 0.85s ease-out forwards;
  }

  .flow-step--context { animation-delay: 0.66s; }
  .flow-step--options { animation-delay: 0.78s; }
  .flow-step--criteria { animation-delay: 0.90s; }
  .flow-step--decision {
    animation-delay: 1.02s;
    background:
      linear-gradient(180deg, rgba(8, 145, 178, 0.24), rgba(17, 24, 39, 0.66));
    border-color: rgba(34, 211, 238, 0.46);
    box-shadow: 0 20px 56px rgba(8, 145, 178, 0.17);
  }
  .flow-step--consequences {
    animation-delay: 1.14s;
    border-color: rgba(245, 158, 11, 0.38);
  }

  .flow-step--consequences::before {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.12), transparent 62%);
  }

  .step-icon {
    width: 58px;
    height: 58px;
    margin-bottom: 18px;
    border-radius: 16px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.36);
    font-size: 32px;
  }

  .flow-step--consequences .step-icon {
    color: #fbbf24;
    background: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.36);
  }

  .flow-step h2 {
    position: relative;
    z-index: 1;
    color: #f8fafc;
    font-size: 24px;
    font-weight: 800;
    line-height: 1.08;
    margin: 0;
  }
</style>
