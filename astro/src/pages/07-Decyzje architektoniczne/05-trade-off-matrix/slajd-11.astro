---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 11 - Wagi zmieniają decyzję"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.92))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="weightsGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="weightsGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.05"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
      <linearGradient id="weightsSweep" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0"/>
        <stop offset="48%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </linearGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#weightsGrid)"/>
    <circle cx="960" cy="540" r="430" fill="url(#weightsGlow)"/>
    <path d="M 330 560 C 610 455, 1290 455, 1570 560" fill="none" stroke="url(#weightsSweep)" stroke-width="108" stroke-linecap="round"/>
    <g stroke="rgba(34,211,238,0.12)" stroke-width="1.5" fill="none">
      <path d="M 230 220 C 520 150, 720 265, 980 210 S 1420 150, 1700 265"/>
      <path d="M 250 840 C 560 720, 760 880, 1040 770 S 1460 675, 1710 810"/>
      <circle cx="960" cy="560" r="328" stroke-dasharray="8 12"/>
    </g>
  </svg>

  <div class="content">
    <header class="header">
      <span class="level-chip">
        <i class="ti ti-adjustments-alt"></i>
        Kolejnym krokiem jest nadanie wag
      </span>
      <h1 class="title">
        Wagi zmieniają <span class="highlight">decyzję</span>
      </h1>
    </header>

    <section class="weight-board" aria-label="Wagi zmieniają decyzję">
      <article class="context-card context-card--mvp">
        <div class="context-icon"><i class="ti ti-rocket"></i></div>
        <h2>MVP</h2>
        <p>większa waga prostoty i <span class="nowrap">time-to-market</span></p>

        <div class="weight-list" aria-hidden="true">
          <span class="weight-pill weight-pill--strong">prostoty</span>
          <span class="weight-pill weight-pill--strong">time-to-market</span>
        </div>
      </article>

      <div class="weight-shift" aria-hidden="true">
        <div class="scale">
          <span class="scale-pan scale-pan--left"></span>
          <span class="scale-beam"></span>
          <span class="scale-pan scale-pan--right"></span>
          <span class="scale-pivot">
            <i class="ti ti-scale"></i>
          </span>
        </div>
        <div class="shift-arrow">
          <i class="ti ti-arrows-exchange"></i>
        </div>
      </div>

      <article class="context-card context-card--finance">
        <div class="context-icon"><i class="ti ti-shield-lock"></i></div>
        <h2>system finansowy</h2>
        <p>większa waga spójności, bezpieczeństwa i niezawodności.</p>

        <div class="weight-list" aria-hidden="true">
          <span class="weight-pill weight-pill--strong">spójności</span>
          <span class="weight-pill weight-pill--strong">bezpieczeństwa</span>
          <span class="weight-pill weight-pill--strong">niezawodności</span>
        </div>
      </article>
    </section>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
    align-items: center;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: min(1540px, calc(100% - 150px));
    max-width: none;
    padding: 58px 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    max-width: 1260px;
    margin: 0 auto 34px;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 20px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0;
    margin-bottom: 20px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip i {
    font-size: 22px;
  }

  .title {
    font-size: 78px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.32s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .weight-board {
    position: relative;
    width: min(1480px, 100%);
    min-height: 500px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px minmax(0, 1fr);
    gap: 30px;
    align-items: stretch;
  }

  .context-card,
  .weight-shift {
    position: relative;
    border-radius: 18px;
    background: rgba(17, 24, 39, 0.62);
    border: 1px solid rgba(148, 163, 184, 0.20);
    box-shadow: 0 24px 68px rgba(2, 6, 23, 0.32);
    backdrop-filter: blur(10px);
    overflow: hidden;
  }

  .context-card {
    min-height: 500px;
    padding: 42px 40px 38px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    text-align: left;
    opacity: 0;
    animation: fadeUp 0.9s ease-out forwards;
  }

  .context-card::before,
  .weight-shift::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.12), transparent 58%);
  }

  .context-card--mvp {
    animation-delay: 0.54s;
    border-color: rgba(34, 211, 238, 0.40);
    background:
      radial-gradient(circle at 18% 14%, rgba(34, 211, 238, 0.16), transparent 42%),
      rgba(17, 24, 39, 0.62);
  }

  .context-card--finance {
    animation-delay: 0.86s;
    border-color: rgba(74, 222, 128, 0.38);
    background:
      radial-gradient(circle at 18% 14%, rgba(74, 222, 128, 0.14), transparent 42%),
      rgba(17, 24, 39, 0.62);
  }

  .context-icon {
    position: relative;
    z-index: 1;
    width: 76px;
    height: 76px;
    margin-bottom: 26px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.38);
    color: var(--cyan-400);
    font-size: 40px;
  }

  .context-card--finance .context-icon {
    background: rgba(22, 163, 74, 0.16);
    border-color: rgba(74, 222, 128, 0.42);
    color: #86efac;
  }

  .context-card h2,
  .context-card p,
  .weight-list {
    position: relative;
    z-index: 1;
  }

  .context-card h2 {
    margin: 0 0 20px;
    color: #f8fafc;
    font-size: 56px;
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: 0;
  }

  .context-card p {
    max-width: 540px;
    color: rgba(240, 244, 248, 0.84);
    font-size: 33px;
    font-weight: 300;
    line-height: 1.24;
    margin: 0 0 34px;
  }

  .nowrap {
    white-space: nowrap;
  }

  .weight-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .weight-pill {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.72);
    border: 1px solid rgba(34, 211, 238, 0.34);
    color: #dffbff;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0;
  }

  .context-card--finance .weight-pill {
    border-color: rgba(74, 222, 128, 0.34);
    color: #dcfce7;
  }

  .weight-pill--strong::before {
    content: "";
    width: 10px;
    height: 10px;
    margin-right: 10px;
    border-radius: 50%;
    background: var(--cyan-400);
    box-shadow: 0 0 18px rgba(34, 211, 238, 0.62);
  }

  .context-card--finance .weight-pill--strong::before {
    background: #86efac;
    box-shadow: 0 0 18px rgba(74, 222, 128, 0.56);
  }

  .weight-shift {
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.70s forwards;
    border-color: rgba(34, 211, 238, 0.30);
    background:
      radial-gradient(circle at 50% 18%, rgba(34, 211, 238, 0.18), transparent 46%),
      rgba(17, 24, 39, 0.56);
  }

  .scale {
    position: relative;
    z-index: 1;
    width: 214px;
    height: 310px;
  }

  .scale-beam {
    position: absolute;
    left: 26px;
    right: 26px;
    top: 116px;
    height: 8px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(34, 211, 238, 0.46), #e2e8f0, rgba(74, 222, 128, 0.46));
    box-shadow: 0 0 30px rgba(34, 211, 238, 0.22);
    transform: rotate(-8deg);
    transform-origin: 50% 50%;
  }

  .scale-pivot {
    position: absolute;
    left: 50%;
    top: 96px;
    width: 82px;
    height: 82px;
    border-radius: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(2, 6, 23, 0.76);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 44px;
    box-shadow: 0 0 34px rgba(34, 211, 238, 0.20);
  }

  .scale-pivot::after {
    content: "";
    position: absolute;
    top: 82px;
    left: 50%;
    width: 4px;
    height: 150px;
    transform: translateX(-50%);
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(34, 211, 238, 0.65), rgba(34, 211, 238, 0.10));
  }

  .scale-pan {
    position: absolute;
    top: 158px;
    width: 74px;
    height: 44px;
    border-radius: 0 0 46px 46px;
    border: 2px solid rgba(34, 211, 238, 0.42);
    border-top: 0;
    background: rgba(15, 23, 42, 0.70);
    box-shadow: inset 0 -18px 28px rgba(34, 211, 238, 0.08);
  }

  .scale-pan::before {
    content: "";
    position: absolute;
    left: 10px;
    right: 10px;
    top: -36px;
    height: 38px;
    border-left: 2px solid rgba(34, 211, 238, 0.36);
    border-right: 2px solid rgba(34, 211, 238, 0.36);
    transform: skewX(-14deg);
  }

  .scale-pan--left {
    left: 8px;
    transform: translateY(12px);
  }

  .scale-pan--right {
    right: 8px;
    transform: translateY(-12px);
    border-color: rgba(74, 222, 128, 0.42);
    box-shadow: inset 0 -18px 28px rgba(74, 222, 128, 0.08);
  }

  .scale-pan--right::before {
    border-color: rgba(74, 222, 128, 0.36);
  }

  .shift-arrow {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 78px;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--cyan-400);
    color: #0a0e17;
    font-size: 34px;
    box-shadow: 0 0 0 8px rgba(34, 211, 238, 0.11), 0 0 34px rgba(34, 211, 238, 0.42);
  }

  @media (max-width: 1200px) {
    .content {
      width: min(1540px, calc(100% - 96px));
    }
  }
</style>
