---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 11 - Wagi kryteriów zależą od kontekstu"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.92))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="criteriaGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <linearGradient id="criteriaSweep" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0"/>
        <stop offset="46%" stop-color="#22d3ee" stop-opacity="0.16"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </linearGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#criteriaGrid)"/>
    <path d="M 230 220 C 520 150, 720 265, 980 210 S 1420 150, 1700 265" fill="none" stroke="rgba(34,211,238,0.12)" stroke-width="1.5"/>
    <path d="M 250 840 C 560 720, 760 880, 1040 770 S 1460 675, 1710 810" fill="none" stroke="rgba(34,211,238,0.12)" stroke-width="1.5"/>
    <path d="M 250 560 C 595 450, 1325 450, 1670 560" fill="none" stroke="url(#criteriaSweep)" stroke-width="96" stroke-linecap="round"/>
    <g stroke="rgba(34,211,238,0.13)" stroke-width="1.5" fill="none" stroke-dasharray="8 12">
      <path d="M 520 300 C 675 220, 845 220, 960 320 S 1240 440, 1430 325"/>
      <path d="M 520 760 C 675 840, 845 840, 960 740 S 1240 620, 1430 735"/>
    </g>
  </svg>

  <div class="content">
    <header class="header">
      <span class="level-chip">
        <i class="ti ti-adjustments-alt"></i>
        TRADE-OFF MATRIX
      </span>
      <h1 class="title">
        Wagi zależą od <span class="highlight">kontekstu</span>
      </h1>
    </header>

    <section class="criteria-board" aria-label="Dwie małe tabele obok siebie: MVP vs system finansowy">
      <article class="criteria-card criteria-card--mvp">
        <header class="card-head">
          <div class="context-icon"><i class="ti ti-rocket"></i></div>
          <div>
            <p class="example-label">Przykład 1</p>
            <h2>MVP wynajmu pojazdów</h2>
          </div>
        </header>

        <div class="criteria-table" role="table" aria-label="MVP platformy wynajmu pojazdów">
          <div class="table-head" role="row">
            <span role="columnheader">Kryterium</span>
            <span role="columnheader">Waga</span>
          </div>

          <div class="criterion-row is-top" style="--bar: 100%" role="row">
            <span role="cell">Time-to-market</span>
            <div class="weight-cell" role="cell"><span class="bar"></span><strong>30%</strong></div>
          </div>

          <div class="criterion-row is-top" style="--bar: 83%" role="row">
            <span role="cell">Prostota implementacji</span>
            <div class="weight-cell" role="cell"><span class="bar"></span><strong>25%</strong></div>
          </div>

          <div class="criterion-row" style="--bar: 67%" role="row">
            <span role="cell">Dopasowanie do kompetencji zespołu</span>
            <div class="weight-cell" role="cell"><span class="bar"></span><strong>20%</strong></div>
          </div>

          <div class="criterion-row" style="--bar: 50%" role="row">
            <span role="cell">Koszt operacyjny</span>
            <div class="weight-cell" role="cell"><span class="bar"></span><strong>15%</strong></div>
          </div>

          <div class="criterion-row" style="--bar: 33%" role="row">
            <span role="cell">Skalowalność długoterminowa</span>
            <div class="weight-cell" role="cell"><span class="bar"></span><strong>10%</strong></div>
          </div>
        </div>
        
      </article>

      <article class="criteria-card criteria-card--finance">
        <header class="card-head">
          <div class="context-icon"><i class="ti ti-shield-lock"></i></div>
          <div>
            <p class="example-label">Przykład 2</p>
            <h2>System finansowy</h2>
          </div>
        </header>

        <div class="criteria-table" role="table" aria-label="system finansowy">
          <div class="table-head" role="row">
            <span role="columnheader">Kryterium</span>
            <span role="columnheader">Waga</span>
          </div>

          <div class="criterion-row is-top" style="--bar: 100%" role="row">
            <span role="cell">Spójność danych</span>
            <div class="weight-cell" role="cell"><span class="bar"></span><strong>25%</strong></div>
          </div>

          <div class="criterion-row is-top" style="--bar: 100%" role="row">
            <span role="cell">Bezpieczeństwo</span>
            <div class="weight-cell" role="cell"><span class="bar"></span><strong>25%</strong></div>
          </div>

          <div class="criterion-row" style="--bar: 80%" role="row">
            <span role="cell">Niezawodność</span>
            <div class="weight-cell" role="cell"><span class="bar"></span><strong>20%</strong></div>
          </div>

          <div class="criterion-row" style="--bar: 60%" role="row">
            <span role="cell">Zgodność regulacyjna / audytowalność</span>
            <div class="weight-cell" role="cell"><span class="bar"></span><strong>15%</strong></div>
          </div>

          <div class="criterion-row" style="--bar: 40%" role="row">
            <span role="cell">Koszt operacyjny</span>
            <div class="weight-cell" role="cell"><span class="bar"></span><strong>10%</strong></div>
          </div>

          <div class="criterion-row" style="--bar: 20%" role="row">
            <span role="cell">Time-to-market</span>
            <div class="weight-cell" role="cell"><span class="bar"></span><strong>5%</strong></div>
          </div>
        </div>
        
      </article>
    </section>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
    align-items: center;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: min(1500px, calc(100% - 170px));
    max-width: none;
    padding: 46px 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    max-width: 1320px;
    margin: 0 auto 22px;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 20px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0;
    margin-bottom: 16px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip i {
    font-size: 22px;
  }

  .title {
    font-size: 82px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.04;
    margin: 0;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.32s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .criteria-board {
    width: min(1480px, 100%);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    align-items: stretch;
  }

  .criteria-card {
    position: relative;
    min-height: 506px;
    padding: 24px 26px 22px;
    border-radius: 18px;
    background: rgba(17, 24, 39, 0.62);
    border: 1px solid rgba(148, 163, 184, 0.20);
    box-shadow: 0 24px 68px rgba(2, 6, 23, 0.32);
    backdrop-filter: blur(10px);
    overflow: hidden;
    text-align: left;
    opacity: 0;
    animation: fadeUp 0.9s ease-out forwards;
  }

  .criteria-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.12), transparent 58%);
  }

  .criteria-card--mvp {
    animation-delay: 0.52s;
    border-color: rgba(34, 211, 238, 0.40);
    background:
      radial-gradient(circle at 18% 10%, rgba(34, 211, 238, 0.16), transparent 42%),
      rgba(17, 24, 39, 0.62);
  }

  .criteria-card--finance {
    animation-delay: 0.72s;
    border-color: rgba(74, 222, 128, 0.38);
    background:
      radial-gradient(circle at 18% 10%, rgba(74, 222, 128, 0.14), transparent 42%),
      rgba(17, 24, 39, 0.62);
  }

  .card-head,
  .criteria-table,
  .annotation {
    position: relative;
    z-index: 1;
  }

  .card-head {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 16px;
    align-items: center;
    margin-bottom: 16px;
  }

  .context-icon {
    width: 60px;
    height: 60px;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.38);
    color: var(--cyan-400);
    font-size: 32px;
  }

  .criteria-card--finance .context-icon {
    background: rgba(22, 163, 74, 0.16);
    border-color: rgba(74, 222, 128, 0.42);
    color: #86efac;
  }

  .example-label {
    margin: 0 0 5px;
    color: var(--cyan-400);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .criteria-card--finance .example-label {
    color: #86efac;
  }

  .card-head h2 {
    margin: 0;
    color: #f8fafc;
    font-size: 48px;
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: 0;
  }

  .criteria-table {
    display: grid;
    gap: 7px;
    margin-bottom: 14px;
  }

  .table-head,
  .criterion-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 188px;
    gap: 32px;
    align-items: center;
  }

  .table-head {
    padding: 0 12px 2px;
    color: #94a3b8;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .table-head span:last-child {
    text-align: right;
  }

  .criterion-row {
    min-height: 34px;
    padding: 7px 12px;
    border-radius: 12px;
    background: rgba(15, 23, 42, 0.62);
    border: 1px solid rgba(148, 163, 184, 0.16);
  }

  .criterion-row > span {
    color: #e2e8f0;
    font-size: 20px;
    font-weight: 650;
    line-height: 1.12;
  }

  .criterion-row.is-top {
    border-color: rgba(34, 211, 238, 0.44);
    background:
      linear-gradient(90deg, rgba(34, 211, 238, 0.16), rgba(15, 23, 42, 0.62));
  }

  .criteria-card--finance .criterion-row.is-top {
    border-color: rgba(74, 222, 128, 0.44);
    background:
      linear-gradient(90deg, rgba(74, 222, 128, 0.14), rgba(15, 23, 42, 0.62));
  }

  .weight-cell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 48px;
    gap: 10px;
    align-items: center;
  }

  .bar {
    position: relative;
    height: 9px;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.16);
    overflow: hidden;
  }

  .bar::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--bar);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--cyan-400), var(--cyan-600));
    box-shadow: 0 0 18px rgba(34, 211, 238, 0.34);
  }

  .criteria-card--finance .bar::before {
    background: linear-gradient(90deg, #86efac, #22c55e);
    box-shadow: 0 0 18px rgba(74, 222, 128, 0.30);
  }

  .weight-cell strong {
    color: #f8fafc;
    font-size: 17px;
    font-weight: 800;
    text-align: right;
  }

  .annotation {
    min-height: 88px;
    padding: 13px 15px;
    border-radius: 14px;
    background: rgba(2, 6, 23, 0.34);
    border: 1px solid rgba(148, 163, 184, 0.16);
    color: rgba(226, 232, 240, 0.84);
    font-size: 16px;
    font-weight: 350;
    line-height: 1.28;
  }

  @media (max-width: 1200px) {
    .content {
      width: min(1500px, calc(100% - 96px));
    }
  }
</style>
