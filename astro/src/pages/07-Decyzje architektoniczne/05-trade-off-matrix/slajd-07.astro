---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 07 - Opcja 2: mikroserwisy"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.92))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="servicesGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="servicesGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.05"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#servicesGrid)"/>
    <circle cx="960" cy="560" r="430" fill="url(#servicesGlow)"/>
    <g stroke="rgba(34,211,238,0.12)" stroke-width="1.5" fill="none">
      <path d="M 220 250 C 520 160, 760 260, 1030 210 S 1460 150, 1710 270"/>
      <path d="M 240 830 C 540 710, 760 850, 1030 760 S 1470 660, 1720 800"/>
      <circle cx="960" cy="560" r="330" stroke-dasharray="8 12"/>
    </g>
  </svg>

  <div class="content">
    <header class="header">
      <span class="level-chip"><i class="ti ti-sitemap"></i>Opcja 2</span>
      <h1 class="title">
        Mikroserwisy<span class="highlight"></span>
      </h1>
    </header>

    <section class="services-board" aria-label="mikroserwisy">
      <div class="network" aria-hidden="true">
        <span class="service service--1"><i class="ti ti-calendar-event"></i></span>
        <span class="service service--2"><i class="ti ti-credit-card"></i></span>
        <span class="service service--3"><i class="ti ti-car"></i></span>
        <span class="service service--4"><i class="ti ti-user"></i></span>
        <span class="service service--5"><i class="ti ti-bell"></i></span>
        <span class="network-line network-line--1"></span>
        <span class="network-line network-line--2"></span>
        <span class="network-line network-line--3"></span>
        <span class="network-line network-line--4"></span>
      </div>

      <article class="panel panel--gain">
        <h2>Zalety</h2>
        <ul>
          <li><i class="ti ti-rocket"></i><span>Niezależne wdrażanie</span></li>
          <li><i class="ti ti-chart-arrows-vertical"></i><span>Osobne skalowanie</span></li>
          <li><i class="ti ti-building-community"></i><span>Autonomiczne obszary biznesowe</span></li>
        </ul>
      </article>

      <article class="panel panel--cost">
        <h2>Koszt</h2>
        <ul>
          <li><i class="ti ti-settings-cog"></i><span>Złożoność operacyjna</span></li>
          <li><i class="ti ti-bug"></i><span>Debugowanie</span></li>
          <li><i class="ti ti-arrows-transfer-down"></i><span>Komunikacja sieciowa</span></li>
          <li><i class="ti ti-activity"></i><span>Obserwowalność</span></li>
        </ul>
      </article>
    </section>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
    align-items: center;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: min(1500px, calc(100% - 150px));
    max-width: none;
    padding: 58px 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    max-width: 1260px;
    margin: 0 auto 32px;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 20px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0;
    margin-bottom: 20px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip i {
    font-size: 22px;
  }

  .title {
    font-size: 82px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.32s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .services-board {
    width: min(1360px, 100%);
    display: grid;
    grid-template-columns: 1fr 390px 1fr;
    gap: 26px;
    align-items: stretch;
  }

  .network,
  .panel {
    min-height: 500px;
    border-radius: 18px;
    background:
      radial-gradient(circle at 50% 12%, rgba(34, 211, 238, 0.17), transparent 42%),
      rgba(17, 24, 39, 0.62);
    border: 1px solid rgba(34, 211, 238, 0.30);
    box-shadow: 0 24px 68px rgba(2, 6, 23, 0.32);
    backdrop-filter: blur(10px);
    opacity: 0;
    animation: fadeUp 0.9s ease-out forwards;
  }

  .network {
    position: relative;
    order: 2;
    overflow: hidden;
    animation-delay: 0.62s;
  }

  .network::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.10), transparent 58%);
  }

  .service {
    position: absolute;
    z-index: 2;
    width: 88px;
    height: 88px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.84);
    border: 1px solid rgba(34, 211, 238, 0.48);
    color: var(--cyan-400);
    font-size: 44px;
    box-shadow: 0 0 34px rgba(34, 211, 238, 0.18);
  }

  .service--1 { left: 50%; top: 54px; transform: translateX(-50%); }
  .service--2 { right: 54px; top: 180px; }
  .service--3 { left: 50%; bottom: 54px; transform: translateX(-50%); }
  .service--4 { left: 54px; top: 180px; }
  .service--5 {
    left: 50%;
    top: 50%;
    width: 104px;
    height: 104px;
    border-radius: 24px;
    background: linear-gradient(180deg, rgba(8, 145, 178, 0.35), rgba(15, 23, 42, 0.84));
    transform: translate(-50%, -50%);
  }

  .network-line {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 210px;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(34, 211, 238, 0.58), transparent);
    transform-origin: left center;
  }

  .network-line--1 { transform: rotate(-92deg); }
  .network-line--2 { transform: rotate(-28deg); }
  .network-line--3 { transform: rotate(92deg); }
  .network-line--4 { transform: rotate(208deg); }

  .panel {
    position: relative;
    padding: 34px 32px 36px;
    text-align: left;
    overflow: hidden;
  }

  .panel::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.10), transparent 58%);
  }

  .panel--gain {
    order: 1;
    animation-delay: 0.76s;
    border-color: rgba(74, 222, 128, 0.34);
  }

  .panel--cost {
    order: 3;
    animation-delay: 0.90s;
    border-color: rgba(248, 113, 113, 0.34);
  }

  .panel h2 {
    position: relative;
    z-index: 1;
    margin: 0 0 26px;
    color: #f8fafc;
    font-size: 42px;
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: 0;
  }

  .panel--gain h2 {
    color: #dcfce7;
  }

  .panel--cost h2 {
    color: #fee2e2;
  }

  .panel ul {
    position: relative;
    z-index: 1;
    list-style: none;
    display: grid;
    gap: 16px;
  }

  .panel li {
    min-height: 78px;
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 16px;
    align-items: center;
    padding: 15px 18px;
    border-radius: 14px;
    background: rgba(15, 23, 42, 0.70);
    border: 1px solid rgba(148, 163, 184, 0.20);
  }

  .panel--gain li {
    background: rgba(22, 163, 74, 0.12);
    border-color: rgba(74, 222, 128, 0.30);
  }

  .panel--cost li {
    background: rgba(220, 38, 38, 0.10);
    border-color: rgba(248, 113, 113, 0.30);
  }

  .panel li i {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.34);
    color: var(--cyan-400);
    font-size: 28px;
  }

  .panel--gain li i {
    background: rgba(22, 163, 74, 0.18);
    border-color: rgba(74, 222, 128, 0.38);
    color: #86efac;
  }

  .panel--cost li i {
    background: rgba(220, 38, 38, 0.16);
    border-color: rgba(248, 113, 113, 0.38);
    color: #fca5a5;
  }

  .panel li span {
    color: #f8fafc;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0;
  }
</style>
