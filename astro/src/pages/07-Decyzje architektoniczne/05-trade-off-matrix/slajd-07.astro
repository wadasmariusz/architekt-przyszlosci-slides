---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 07 - Opcja 2: mikroserwisy"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.92))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="servicesGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="servicesGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.05"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#servicesGrid)"/>
    <circle cx="960" cy="560" r="430" fill="url(#servicesGlow)"/>
    <g stroke="rgba(34,211,238,0.12)" stroke-width="1.5" fill="none">
      <path d="M 220 250 C 520 160, 760 260, 1030 210 S 1460 150, 1710 270"/>
      <path d="M 240 830 C 540 710, 760 850, 1030 760 S 1470 660, 1720 800"/>
      <circle cx="960" cy="560" r="330" stroke-dasharray="8 12"/>
    </g>
  </svg>

  <div class="content">
    <header class="header">
      <span class="level-chip"><i class="ti ti-sitemap"></i>Ktoś inny proponuje mikroserwisy</span>
      <h1 class="title">
        Opcja 2: <span class="highlight">mikroserwisy</span>
      </h1>
    </header>

    <section class="option-board" aria-label="Opcja 2: mikroserwisy">
      <article class="diagram-card">
        <div class="network" aria-hidden="true">
          <span class="service service--1"><i class="ti ti-calendar-event"></i></span>
          <span class="service service--2"><i class="ti ti-credit-card"></i></span>
          <span class="service service--3"><i class="ti ti-car"></i></span>
          <span class="service service--4"><i class="ti ti-user"></i></span>
          <span class="service service--5"><i class="ti ti-bell"></i></span>
          <span class="network-line network-line--1"></span>
          <span class="network-line network-line--2"></span>
          <span class="network-line network-line--3"></span>
          <span class="network-line network-line--4"></span>
        </div>
      </article>

      <section class="benefit-grid" aria-label="zalety">
        <article class="benefit-card">
          <i class="ti ti-rocket"></i>
          <p>zalety</p>
          <h2>niezależne wdrażanie</h2>
        </article>

        <article class="benefit-card">
          <i class="ti ti-chart-arrows-vertical"></i>
          <p>zalety</p>
          <h2>osobne skalowanie</h2>
        </article>

        <article class="benefit-card benefit-card--wide">
          <i class="ti ti-building-community"></i>
          <p>zalety</p>
          <h2>autonomiczne obszary biznesowe</h2>
        </article>
      </section>

      <article class="cost-card">
        <i class="ti ti-alert-triangle"></i>
        <div>
          <p>koszt</p>
          <ul>
            <li>złożoność operacyjna</li>
            <li>debugowanie</li>
            <li>komunikacja sieciowa</li>
            <li>obserwowalność</li>
          </ul>
        </div>
      </article>
    </section>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
    align-items: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: min(1340px, calc(100% - 580px));
    max-width: none;
    padding: 54px 0 0 3rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .header {
    max-width: 1320px;
    margin: 0 0 24px;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 20px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0;
    margin-bottom: 18px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip i {
    font-size: 22px;
  }

  .title {
    max-width: 1300px;
    font-size: 72px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.32s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .option-board {
    width: 100%;
    display: grid;
    grid-template-columns: 420px minmax(0, 1fr);
    grid-template-rows: 430px 154px;
    gap: 22px;
  }

  .diagram-card,
  .benefit-card,
  .cost-card {
    border-radius: 18px;
    background: rgba(17, 24, 39, 0.62);
    border: 1px solid rgba(148, 163, 184, 0.20);
    box-shadow: 0 18px 46px rgba(2, 6, 23, 0.26);
    backdrop-filter: blur(10px);
    overflow: hidden;
  }

  .diagram-card {
    position: relative;
    padding: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 50% 18%, rgba(34, 211, 238, 0.20), transparent 48%),
      linear-gradient(180deg, rgba(8, 145, 178, 0.18), rgba(17, 24, 39, 0.64));
    border-color: rgba(34, 211, 238, 0.40);
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.52s forwards;
  }

  .network {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 340px;
    border-radius: 22px;
    border: 1px solid rgba(34, 211, 238, 0.24);
    background: rgba(2, 6, 23, 0.24);
    box-shadow: inset 0 0 36px rgba(34, 211, 238, 0.08);
  }

  .network::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.10), transparent 58%);
  }

  .service {
    position: absolute;
    z-index: 2;
    width: 78px;
    height: 78px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.84);
    border: 1px solid rgba(34, 211, 238, 0.48);
    color: var(--cyan-400);
    font-size: 38px;
    box-shadow: 0 0 34px rgba(34, 211, 238, 0.18);
  }

  .service--1 { left: 50%; top: 38px; transform: translateX(-50%); }
  .service--2 { right: 38px; top: 148px; }
  .service--3 { left: 50%; bottom: 38px; transform: translateX(-50%); }
  .service--4 { left: 38px; top: 148px; }
  .service--5 {
    left: 50%;
    top: 50%;
    width: 96px;
    height: 96px;
    border-radius: 22px;
    background: linear-gradient(180deg, rgba(8, 145, 178, 0.35), rgba(15, 23, 42, 0.84));
    transform: translate(-50%, -50%);
  }

  .network-line {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 170px;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(34, 211, 238, 0.58), transparent);
    transform-origin: left center;
  }

  .network-line--1 { transform: rotate(-92deg); }
  .network-line--2 { transform: rotate(-28deg); }
  .network-line--3 { transform: rotate(92deg); }
  .network-line--4 { transform: rotate(208deg); }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .benefit-card {
    position: relative;
    min-height: 206px;
    padding: 22px 24px 20px;
    border-color: rgba(74, 222, 128, 0.36);
    opacity: 0;
    animation: fadeUp 0.85s ease-out forwards;
  }

  .benefit-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(22, 163, 74, 0.14), transparent 58%);
  }

  .benefit-card:nth-child(1) { animation-delay: 0.66s; }
  .benefit-card:nth-child(2) { animation-delay: 0.78s; }
  .benefit-card:nth-child(3) { animation-delay: 0.90s; }

  .benefit-card--wide {
    grid-column: 1 / -1;
  }

  .benefit-card i {
    position: relative;
    z-index: 1;
    width: 50px;
    height: 50px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    background: rgba(22, 163, 74, 0.16);
    border: 1px solid rgba(74, 222, 128, 0.42);
    color: #86efac;
    font-size: 28px;
  }

  .benefit-card p,
  .cost-card p {
    position: relative;
    z-index: 1;
    margin: 0 0 8px;
    color: #86efac;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .benefit-card h2 {
    position: relative;
    z-index: 1;
    margin: 0;
    color: #f8fafc;
    font-size: 27px;
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: 0;
  }

  .benefit-card--wide h2 {
    font-size: 31px;
  }

  .cost-card {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 20px;
    align-items: center;
    padding: 22px 28px;
    background:
      linear-gradient(90deg, rgba(220, 38, 38, 0.18), rgba(17, 24, 39, 0.68));
    border-color: rgba(248, 113, 113, 0.44);
    opacity: 0;
    animation: fadeUp 0.85s ease-out 1.04s forwards;
  }

  .cost-card > i {
    width: 72px;
    height: 72px;
    border-radius: 17px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(220, 38, 38, 0.16);
    border: 1px solid rgba(248, 113, 113, 0.44);
    color: #fca5a5;
    font-size: 38px;
  }

  .cost-card p {
    color: #fca5a5;
  }

  .cost-card ul {
    position: relative;
    z-index: 1;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .cost-card li {
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 14px;
    border-radius: 13px;
    background: rgba(220, 38, 38, 0.14);
    border: 1px solid rgba(248, 113, 113, 0.34);
    color: #fee2e2;
    font-size: 21px;
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: 0;
    text-align: center;
  }
</style>
