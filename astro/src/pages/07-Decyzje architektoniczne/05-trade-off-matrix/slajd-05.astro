---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 05 - Przykład: platforma wynajmu pojazdów"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.92))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="rentalGrid" width="84" height="84" patternUnits="userSpaceOnUse">
        <path d="M 84 0 L 0 0 0 84" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="rentalGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.19"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.05"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#rentalGrid)"/>
    <circle cx="1130" cy="575" r="470" fill="url(#rentalGlow)"/>
    <g stroke="rgba(34,211,238,0.12)" stroke-width="1.5" fill="none">
      <circle cx="1130" cy="575" r="300" stroke-dasharray="8 12"/>
      <circle cx="1130" cy="575" r="445" stroke-dasharray="10 14"/>
      <path d="M 225 235 C 505 165, 720 285, 970 230 S 1430 175, 1690 285"/>
      <path d="M 260 855 C 560 725, 790 880, 1060 775 S 1460 690, 1710 820"/>
    </g>
  </svg>

  <div class="content">
    <header class="header">
      <span class="level-chip"><i class="ti ti-compass"></i>PRZYKłAD</span>
      <h1 class="title">
        Platforma wynajmu <span class="highlight">pojazdów</span>
      </h1>
    </header>

    <section class="rental-example" aria-label="Przykład: platforma wynajmu pojazdów">
      <div class="decision-context" aria-label="Kontekst decyzji">
        <div class="context-label">
          <i class="ti ti-map-2"></i>
          <span>kontekst decyzji</span>
        </div>

        <div class="context-grid">
          <article class="context-pill">
            <i class="ti ti-rocket"></i>
            <span>szybkie MVP</span>
          </article>

          <article class="context-pill">
            <i class="ti ti-trending-up"></i>
            <span>przyszły wzrost</span>
          </article>

          <article class="context-pill">
            <i class="ti ti-map-pin-plus"></i>
            <span>nowe lokalizacje</span>
          </article>

          <article class="context-pill">
            <i class="ti ti-credit-card"></i>
            <span>płatności</span>
          </article>

          <article class="context-pill">
            <i class="ti ti-car"></i>
            <span>flota</span>
          </article>

          <article class="context-pill">
            <i class="ti ti-building-store"></i>
            <span>partnerzy</span>
          </article>
        </div>
      </div>

      <div class="domain-diagram" aria-label="Uproszczony schemat domen">
        <svg class="domain-lines" viewBox="0 0 720 560" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <g fill="none" stroke="rgba(34,211,238,0.44)" stroke-width="3" stroke-linecap="round" stroke-dasharray="9 12">
            <path d="M 360 280 L 360 68"/>
            <path d="M 360 280 L 105 262"/>
            <path d="M 360 280 L 615 262"/>
            <path d="M 360 280 L 185 500"/>
            <path d="M 360 280 L 535 500"/>
          </g>
        </svg>

        <div class="domain-core">
          <i class="ti ti-car-suv"></i>
          <h2>platforma wynajmu pojazdów</h2>
        </div>

        <article class="domain-node domain--bookings">
          <i class="ti ti-calendar-check"></i>
          <h2>rezerwacje</h2>
        </article>

        <article class="domain-node domain--payments">
          <i class="ti ti-credit-card"></i>
          <h2>płatności</h2>
        </article>

        <article class="domain-node domain--fleet">
          <i class="ti ti-car"></i>
          <h2>flota</h2>
        </article>

        <article class="domain-node domain--users">
          <i class="ti ti-users"></i>
          <h2>użytkownicy</h2>
        </article>

        <article class="domain-node domain--notifications">
          <i class="ti ti-bell-ringing"></i>
          <h2>powiadomienia</h2>
        </article>
      </div>
    </section>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
    align-items: center;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: min(1560px, calc(100% - 140px));
    max-width: none;
    padding: 56px 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    max-width: 1320px;
    margin: 0 auto 34px;
  }

  .title {
    font-size: 72px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.06;
    margin: 0;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.28s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 20px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 20px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip i {
    font-size: 22px;
  }

  .rental-example {
    --panel-height: 560px;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    gap: 46px;
    align-items: stretch;
  }

  .decision-context,
  .domain-diagram {
    position: relative;
    border-radius: 18px;
    background:
      radial-gradient(circle at 76% 12%, rgba(34, 211, 238, 0.16), transparent 42%),
      rgba(17, 24, 39, 0.62);
    border: 1px solid rgba(34, 211, 238, 0.30);
    box-shadow: 0 24px 68px rgba(2, 6, 23, 0.32);
    backdrop-filter: blur(10px);
    box-sizing: border-box;
    opacity: 0;
    animation: fadeUp 0.9s ease-out forwards;
  }

  .decision-context::before,
  .domain-diagram::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.10), transparent 58%);
  }

  .decision-context {
    height: var(--panel-height);
    padding: 32px;
    display: flex;
    flex-direction: column;
    animation-delay: 0.48s;
  }

  .context-label {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 11px 20px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .context-label i {
    font-size: 24px;
  }

  .context-grid {
    position: relative;
    z-index: 1;
    flex: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .context-pill {
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px;
    border-radius: 16px;
    background: rgba(15, 23, 42, 0.64);
    border: 1px solid rgba(148, 163, 184, 0.20);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .context-pill i {
    width: 48px;
    height: 48px;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.36);
    color: var(--cyan-400);
    font-size: 28px;
  }

  .context-pill span {
    color: #f8fafc;
    font-size: 20px;
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .domain-diagram {
    height: var(--panel-height);
    overflow: hidden;
    animation-delay: 0.62s;
  }

  .domain-lines {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    opacity: 0;
    animation: fadeIn 0.8s ease-out 0.95s forwards;
  }

  .domain-core,
  .domain-node {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    border-radius: 16px;
    backdrop-filter: blur(10px);
  }

  .domain-core {
    left: 50%;
    top: 50%;
    width: 250px;
    min-height: 150px;
    transform: translate(-50%, -50%);
    padding: 22px 20px;
    gap: 16px;
    background:
      radial-gradient(circle at 70% 20%, rgba(34, 211, 238, 0.28), transparent 48%),
      rgba(8, 145, 178, 0.24);
    border: 1px solid rgba(34, 211, 238, 0.58);
    box-shadow: 0 0 44px rgba(34, 211, 238, 0.18);
  }

  .domain-core i {
    width: 62px;
    height: 62px;
    border-radius: 17px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 34px;
  }

  .domain-core h2,
  .domain-node h2 {
    margin: 0;
    color: #f8fafc;
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .domain-core h2 {
    font-size: 22px;
  }

  .domain-node {
    width: 210px;
    min-height: 120px;
    gap: 12px;
    padding: 18px 16px;
    background: rgba(15, 23, 42, 0.72);
    border: 1px solid rgba(34, 211, 238, 0.30);
    box-shadow: 0 18px 46px rgba(2, 6, 23, 0.24);
  }

  .domain-node i {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
  }

  .domain-node h2 {
    font-size: 20px;
  }

  .domain--bookings {
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
  }

  .domain--payments {
    left: 18px;
    top: 202px;
  }

  .domain--fleet {
    right: 18px;
    top: 202px;
  }

  .domain--users {
    left: 84px;
    bottom: 18px;
  }

  .domain--notifications {
    right: 84px;
    bottom: 18px;
  }

  .domain--bookings i {
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.38);
    color: var(--cyan-400);
  }

  .domain--payments {
    border-color: rgba(74, 222, 128, 0.34);
  }

  .domain--payments i {
    background: rgba(22, 163, 74, 0.16);
    border: 1px solid rgba(74, 222, 128, 0.42);
    color: #86efac;
  }

  .domain--fleet {
    border-color: rgba(251, 191, 36, 0.34);
  }

  .domain--fleet i {
    background: rgba(217, 119, 6, 0.16);
    border: 1px solid rgba(251, 191, 36, 0.40);
    color: #fde68a;
  }

  .domain--users {
    border-color: rgba(147, 197, 253, 0.34);
  }

  .domain--users i {
    background: rgba(37, 99, 235, 0.14);
    border: 1px solid rgba(147, 197, 253, 0.40);
    color: #bfdbfe;
  }

  .domain--notifications {
    border-color: rgba(248, 113, 113, 0.34);
  }

  .domain--notifications i {
    background: rgba(220, 38, 38, 0.14);
    border: 1px solid rgba(248, 113, 113, 0.40);
    color: #fca5a5;
  }
</style>
