---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 16 - Przykład: wybór bazy danych"
  bgImage="/images/background-5.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.92))"
>
  <div class="content">
    <div class="phase-badge">
      <span class="phase-letter">OODA</span>
      <span class="phase-name">Case study</span>
    </div>

    <h1 class="title">
      Wybór <span class="highlight"> bazy danych</span>
    </h1>

    <section class="ooda-table" aria-label="Czterokolumnowa tabela OODA dla wyboru bazy danych">
      <article class="ooda-card ooda-card--observe">
        <header>
          <div class="card-icon"><i class="ti ti-radar-2"></i></div>
          <div>
            <p class="card-step">Observe</p>
            <h2>Co widzimy?</h2>
          </div>
        </header>
        <ul>
          <li>50 tys. zapisów/s</li>
          <li>dane częściowo relacyjne</li>
          <li>budżet i compliance</li>
          <li>SLA dla ścieżek krytycznych</li>
        </ul>
      </article>

      <article class="ooda-card ooda-card--orient">
        <header>
          <div class="card-icon"><i class="ti ti-compass"></i></div>
          <div>
            <p class="card-step">Orient</p>
            <h2>Co to znaczy?</h2>
          </div>
        </header>
        <ul>
          <li>zespół zna PostgreSQL</li>
          <li>brak praktyki z Cassandrą</li>
          <li>szyfrowanie at rest</li>
          <li>utrzymanie przez obecny zespół</li>
        </ul>
      </article>

      <article class="ooda-card ooda-card--decide">
        <header>
          <div class="card-icon"><i class="ti ti-file-check"></i></div>
          <div>
            <p class="card-step">Decide</p>
            <h2>Co wybieramy?</h2>
          </div>
        </header>
        <div class="decision-box">
          <p class="decision-label">ADR-0012</p>
          <p>PostgreSQL z partycjonowaniem i read replicas zamiast Cassandry.</p>
        </div>
      </article>

      <article class="ooda-card ooda-card--act">
        <header>
          <div class="card-icon"><i class="ti ti-flask"></i></div>
          <div>
            <p class="card-step">Act</p>
            <h2>Jak sprawdzamy?</h2>
          </div>
        </header>
        <ul>
          <li>dwutygodniowy PoC</li>
          <li>benchmark na realnym modelu danych</li>
          <li>test kosztu operacyjnego</li>
          <li>kryteria rollbacku</li>
        </ul>
      </article>
    </section>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
    align-items: center;
  }

  .content {
    position: relative;
    z-index: 5;
    width: min(1460px, calc(100% - 128px));
    max-width: none;
    padding: 58px 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .phase-badge {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 10px 22px 10px 14px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.45);
    margin-bottom: 16px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .phase-letter {
    min-width: 46px;
    height: 38px;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--cyan-400);
    color: #0a0e17;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0;
  }

  .phase-name {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--cyan-400);
  }

  .title {
    max-width: 1260px;
    font-size: 72px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0 auto 14px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.3s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lede {
    max-width: 1160px;
    font-size: 24px;
    font-weight: 300;
    line-height: 1.42;
    color: rgba(240, 244, 248, 0.78);
    margin-bottom: 26px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.45s forwards;
  }

  .lede-accent {
    color: var(--cyan-400);
    font-weight: 600;
  }

  .ooda-table {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    align-items: stretch;
    margin-bottom: 22px;
  }

  .ooda-card {
    position: relative;
    min-height: 462px;
    padding: 24px 20px 22px;
    text-align: left;
    background: rgba(17, 24, 39, 0.60);
    border: 1px solid rgba(34, 211, 238, 0.32);
    border-radius: 16px;
    backdrop-filter: blur(10px);
    box-shadow:
      inset 0 0 0 1px rgba(34, 211, 238, 0.08),
      0 18px 46px rgba(0, 0, 0, 0.24);
    overflow: hidden;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.85s ease-out forwards;
  }

  .ooda-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      135deg,
      rgba(34, 211, 238, 0.82),
      rgba(34, 211, 238, 0.16) 42%,
      rgba(148, 163, 184, 0.14) 70%,
      rgba(34, 211, 238, 0.46)
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .ooda-card--observe { animation-delay: 0.62s; }
  .ooda-card--orient { animation-delay: 0.78s; }
  .ooda-card--decide {
    animation-delay: 0.94s;
    background:
      radial-gradient(circle at 82% 14%, rgba(34, 211, 238, 0.18), transparent 38%),
      linear-gradient(180deg, rgba(8, 145, 178, 0.24), rgba(17, 24, 39, 0.64));
    border-color: rgba(34, 211, 238, 0.48);
    box-shadow: 0 20px 56px rgba(8, 145, 178, 0.18);
  }

  .ooda-card--decide::before {
    background: linear-gradient(
      135deg,
      rgba(34, 211, 238, 0.96),
      rgba(34, 211, 238, 0.26) 42%,
      rgba(148, 163, 184, 0.16) 70%,
      rgba(34, 211, 238, 0.62)
    );
  }

  .ooda-card--act {
    animation-delay: 1.10s;
    border-color: rgba(167, 139, 250, 0.34);
  }

  .ooda-card--act::before {
    background: linear-gradient(
      135deg,
      rgba(196, 181, 253, 0.82),
      rgba(196, 181, 253, 0.18) 42%,
      rgba(148, 163, 184, 0.14) 70%,
      rgba(196, 181, 253, 0.50)
    );
  }

  .ooda-card header {
    display: grid;
    grid-template-columns: 58px 1fr;
    gap: 14px;
    align-items: center;
    text-align: left;
    margin-bottom: 22px;
  }

  .card-icon {
    width: 58px;
    height: 58px;
    border-radius: 14px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.36);
    color: var(--cyan-400);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
  }

  .ooda-card--act .card-icon {
    background: rgba(167, 139, 250, 0.12);
    border-color: rgba(167, 139, 250, 0.34);
    color: #c4b5fd;
  }

  .card-step {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--cyan-400);
    margin-bottom: 8px;
  }

  .ooda-card--act .card-step {
    color: #c4b5fd;
  }

  .ooda-card h2 {
    font-size: 29px;
    font-weight: 800;
    line-height: 1.12;
    color: #f8fafc;
    margin: 0;
  }

  .ooda-card ul {
    list-style: none;
    display: grid;
    gap: 13px;
    margin: 0;
    padding: 0;
  }

  .ooda-card li {
    position: relative;
    min-height: 58px;
    display: flex;
    align-items: center;
    padding: 13px 14px 13px 38px;
    border-radius: 12px;
    background: rgba(2, 6, 23, 0.34);
    border: 1px solid rgba(148, 163, 184, 0.18);
    color: #dbeafe;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.26;
    text-align: left;
  }

  .ooda-card li::before {
    content: "";
    position: absolute;
    left: 15px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--cyan-400);
    box-shadow: 0 0 12px rgba(34, 211, 238, 0.55);
  }

  .ooda-card--act li::before {
    background: #c4b5fd;
    box-shadow: 0 0 12px rgba(196, 181, 253, 0.55);
  }

  .decision-box {
    min-height: 300px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 28px 24px;
    border-radius: 15px;
    background: rgba(2, 6, 23, 0.44);
    border: 1px solid rgba(34, 211, 238, 0.36);
    box-shadow: inset 0 1px 28px rgba(34, 211, 238, 0.08);
  }

  .decision-label {
    width: fit-content;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.36);
    color: var(--cyan-400);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .decision-box p:last-child {
    font-size: 27px;
    font-weight: 800;
    line-height: 1.22;
    color: #f8fafc;
    margin: 0;
  }

  .takeaway {
    width: 100%;
    min-height: 112px;
    display: grid;
    grid-template-columns: 62px 1fr;
    gap: 18px;
    align-items: center;
    margin: 0;
    padding: 20px 26px;
    border-radius: 15px;
    background:
      radial-gradient(circle at 8% 50%, rgba(34, 211, 238, 0.13), transparent 38%),
      rgba(15, 23, 42, 0.64);
    border: 1px solid rgba(34, 211, 238, 0.34);
    border-left: 3px solid var(--cyan-400);
    backdrop-filter: blur(10px);
    opacity: 0;
    animation: fadeUp 0.85s ease-out 1.28s forwards;
  }

  .takeaway i {
    width: 62px;
    height: 62px;
    border-radius: 15px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.34);
    color: var(--cyan-400);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 33px;
  }

  .takeaway p {
    font-size: 24px;
    font-weight: 300;
    font-style: italic;
    line-height: 1.36;
    color: #e2e8f0;
    margin: 0;
  }
</style>
