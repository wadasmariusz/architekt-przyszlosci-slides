---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 08 - Metryka bez kontekstu nie wystarcza"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.90))"
>
  <div class="content">
    <p class="eyebrow">Przykład Faza Orient</p>
    <h1 class="title">
      Kontekst ścieżki  <span class="highlight">krytycznej</span>
    </h1>

    <div class="equation">
      <div class="term term--metric">
        <header class="term-head">
          <span class="term-label">Metryka</span>
          <span class="term-tag">surowy sygnał</span>
        </header>
        <div class="metric-card">
          <i class="ti ti-database"></i>
          <div>
            <div class="metric-name">Redis</div>
            <div class="metric-prop">p99 latency</div>
          </div>
        </div>
        <div class="metric-value">
          <span class="num">20</span>
          <span class="unit">ms</span>
        </div>
        <div class="verdict verdict--unknown">
          <i class="ti ti-help-circle"></i>
          <span>Brak jednoznacznego wniosku</span>
        </div>
      </div>

      <div class="op" aria-hidden="true">+</div>

      <div class="term term--context">
        <header class="term-head">
          <span class="term-label">Kontekst</span>
          <span class="term-tag">co system obiecuje i robi</span>
        </header>

        <div class="ctx-row">
          <div class="ctx-ic"><i class="ti ti-target-arrow"></i></div>
          <div>
            <div class="ctx-name">SLA</div>
            <div class="ctx-val">latency p99 <strong>&lt; 10 ms</strong></div>
          </div>
        </div>

        <div class="ctx-row">
          <div class="ctx-ic"><i class="ti ti-route"></i></div>
          <div>
            <div class="ctx-name">Ścieżka krytyczna</div>
            <div class="ctx-val">Redis w hot path logowania użytkownika</div>
          </div>
        </div>

        <div class="verdict verdict--note">
          <i class="ti ti-bulb"></i>
          <span>Liczba w kontekście</span>
        </div>
      </div>

      <div class="op" aria-hidden="true">=</div>

      <div class="term term--conclusion">
        <header class="term-head">
          <span class="term-label">Wniosek</span>
          <span class="term-tag"></span>
        </header>
        <div class="conclusion-card">
          <i class="ti ti-alert-octagon"></i>
          <div>
            <div class="conclusion-title">Możliwe wąskie gardło</div>
            <div class="conclusion-desc">
            </div>
          </div>
        </div>
        <div class="next-steps">
          <span class="step-chip">→ pogłęb obserwację</span>
          <span class="step-chip">→ sformułuj hipotezę</span>
          <span class="step-chip">→ zaplanuj eksperyment</span>
        </div>
      </div>
    </div>
    
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 60px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .eyebrow {
    font-size: 20px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 5px;
    color: var(--cyan-400);
    margin-bottom: 14px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .title {
    font-size: 82px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.06;
    margin-bottom: 54px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.3s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lede {
    max-width: 1180px;
    font-size: 21px;
    font-weight: 300;
    line-height: 1.45;
    color: rgba(240, 244, 248, 0.78);
    margin-bottom: 28px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.45s forwards;
  }

  .lede-accent {
    color: var(--cyan-400);
    font-weight: 600;
  }

  .equation {
    display: grid;
    grid-template-columns: 1fr 56px 1fr 56px 1fr;
    gap: 14px;
    align-items: stretch;
    width: 100%;
    max-width: 1420px;
    text-align: left;
    margin-bottom: 24px;
  }

  .term {
    display: flex;
    flex-direction: column;
    padding: 20px 22px 18px;
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 16px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out forwards;
  }

  .term--metric { animation-delay: 0.55s; }
  .term--context {
    animation-delay: 0.75s;
    border-color: rgba(167, 139, 250, 0.4);
    background: linear-gradient(180deg, rgba(76, 29, 149, 0.16), rgba(17, 24, 39, 0.55));
  }
  .term--conclusion {
    animation-delay: 0.95s;
    border-color: rgba(34, 211, 238, 0.55);
    background: linear-gradient(180deg, rgba(8, 145, 178, 0.22), rgba(17, 24, 39, 0.55));
    box-shadow: 0 18px 50px rgba(8, 145, 178, 0.15);
  }

  .term-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding-bottom: 12px;
    margin-bottom: 14px;
    border-bottom: 1px dashed rgba(148, 163, 184, 0.22);
  }

  .term-label {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #cbd5e1;
  }

  .term--context .term-label { color: #a78bfa; }
  .term--conclusion .term-label { color: var(--cyan-400); }

  .term-tag {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.5px;
    color: #64748b;
    text-transform: lowercase;
  }

  .metric-card,
  .conclusion-card {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 14px;
    align-items: center;
    padding: 12px 14px;
    background: rgba(2, 6, 23, 0.45);
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 12px;
    margin-bottom: 14px;
  }

  .metric-card i,
  .conclusion-card i {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: var(--cyan-400);
  }

  .metric-name,
  .conclusion-title {
    font-size: 18px;
    font-weight: 700;
    color: #f0f4f8;
    line-height: 1.15;
  }

  .metric-prop {
    margin-top: 2px;
    font-size: 13px;
    font-weight: 400;
    color: #94a3b8;
    letter-spacing: 0.4px;
  }

  .metric-value {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 8px;
    padding: 16px 0 18px;
    background: rgba(2, 6, 23, 0.3);
    border-radius: 12px;
    margin-bottom: 14px;
  }

  .metric-value .num {
    font-size: 72px;
    font-weight: 800;
    letter-spacing: -2px;
    line-height: 1;
    color: var(--cyan-400);
    font-feature-settings: 'tnum';
  }

  .metric-value .unit {
    font-size: 26px;
    font-weight: 600;
    color: #cbd5e1;
  }

  .verdict {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.35;
    margin-top: auto;
  }

  .verdict i {
    font-size: 18px;
    flex-shrink: 0;
  }

  .verdict--unknown {
    background: rgba(148, 163, 184, 0.10);
    border: 1px solid rgba(148, 163, 184, 0.25);
    color: #cbd5e1;
  }

  .verdict--unknown i { color: #94a3b8; }

  .verdict--note {
    background: rgba(167, 139, 250, 0.12);
    border: 1px solid rgba(167, 139, 250, 0.35);
    color: #ede9fe;
  }

  .verdict--note i { color: #a78bfa; }

  .ctx-row {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 12px;
    align-items: flex-start;
    padding: 10px 0;
  }

  .ctx-row + .ctx-row {
    border-top: 1px solid rgba(148, 163, 184, 0.10);
  }

  .ctx-ic {
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: rgba(167, 139, 250, 0.14);
    border: 1px solid rgba(167, 139, 250, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: #a78bfa;
  }

  .ctx-name {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #ede9fe;
    margin-bottom: 2px;
  }

  .ctx-val {
    font-size: 15px;
    font-weight: 300;
    line-height: 1.35;
    color: #cbd5e1;
  }

  .ctx-val strong {
    color: #f0f4f8;
    font-weight: 700;
  }

  .conclusion-card {
    background: rgba(8, 145, 178, 0.18);
    border-color: rgba(34, 211, 238, 0.45);
    align-items: flex-start;
    padding: 14px 16px;
  }

  .conclusion-card i {
    background: rgba(34, 211, 238, 0.2);
    border-color: rgba(34, 211, 238, 0.6);
  }

  .conclusion-title {
    font-size: 19px;
    color: #ecfeff;
    margin-bottom: 4px;
  }

  .conclusion-desc {
    font-size: 14px;
    font-weight: 300;
    line-height: 1.4;
    color: #cbd5e1;
  }

  .next-steps {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: auto;
  }

  .step-chip {
    padding: 8px 12px;
    background: rgba(34, 211, 238, 0.08);
    border: 1px solid rgba(34, 211, 238, 0.22);
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 500;
    color: #ecfeff;
    letter-spacing: 0.2px;
  }

  .op {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 56px;
    font-weight: 300;
    color: rgba(34, 211, 238, 0.55);
    opacity: 0;
    animation: fadeIn 0.8s ease-out 0.85s forwards;
  }

  .footnote {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    max-width: 1280px;
    padding: 14px 22px;
    background: rgba(34, 211, 238, 0.08);
    border: 1px solid rgba(34, 211, 238, 0.32);
    border-radius: 12px;
    font-size: 18px;
    font-weight: 300;
    line-height: 1.4;
    color: #ecfeff;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.1s forwards;
  }

  .footnote i {
    font-size: 24px;
    color: var(--cyan-400);
    flex-shrink: 0;
  }

  .footnote strong {
    color: #f0f4f8;
    font-weight: 700;
  }
</style>
