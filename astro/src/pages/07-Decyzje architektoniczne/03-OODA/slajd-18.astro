---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 18 - Najważniejsza lekcja"
  bgImage="/images/background-5.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.93))"
>
  <div class="content">
    <div class="lesson-badge">
      <span class="badge-icon"><i class="ti ti-repeat"></i></span>
      <span class="badge-text">OODA</span>
    </div>

    <header class="hero">
      <h1 class="title">
        Podsumowanie <span class="highlight"></span>
      </h1>
    </header>

    <section class="principles" aria-label="Najważniejsze lekcje OODA w architekturze">
      <article class="principle principle--1">
        <span class="principle-number">01</span>
        <i class="ti ti-world-question"></i>
        <p>Nie wybieraj technologii bez kontekstu</p>
      </article>

      <article class="principle principle--2">
        <span class="principle-number">02</span>
        <i class="ti ti-compass"></i>
        <p>Najpierw zrozum sytuację</p>
      </article>

      <article class="principle principle--3">
        <span class="principle-number">03</span>
        <i class="ti ti-flask"></i>
        <p>Decyzję traktuj jak hipotezę</p>
      </article>

      <article class="principle principle--4">
        <span class="principle-number">04</span>
        <i class="ti ti-activity-heartbeat"></i>
        <p>Sprawdź konsekwencje w praktyce</p>
      </article>

      <article class="principle principle--5">
        <span class="principle-number">05</span>
        <i class="ti ti-bolt"></i>
        <p>Waliduj i ucz się szybciej</p>
      </article>
    </section>
    
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
    align-items: center;
  }

  .content {
    position: relative;
    z-index: 5;
    width: min(1460px, calc(100% - 128px));
    max-width: none;
    padding: 58px 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .lesson-badge {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 10px 22px 10px 14px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.45);
    margin-bottom: 18px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .badge-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--cyan-400);
    color: #0a0e17;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: 800;
  }

  .badge-text {
    color: var(--cyan-400);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .hero {
    max-width: 1160px;
    margin: 0 auto 34px;
  }

  .title {
    max-width: 1180px;
    font-size: 82px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.04;
    margin: 0;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.3s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lede {
    max-width: 1160px;
    color: rgba(240, 244, 248, 0.80);
    font-size: 27px;
    font-weight: 300;
    line-height: 1.4;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.45s forwards;
  }

  .principles {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }

  .principle {
    position: relative;
    min-height: 128px;
    display: grid;
    grid-template-columns: 68px 1fr;
    gap: 18px;
    align-items: center;
    text-align: left;
    padding: 24px 26px;
    background: rgba(17, 24, 39, 0.62);
    border: 1px solid rgba(34, 211, 238, 0.34);
    border-radius: 16px;
    backdrop-filter: blur(10px);
    box-shadow: 0 18px 46px rgba(0, 0, 0, 0.24);
    overflow: hidden;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.85s ease-out forwards;
  }

  .principle::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.10), transparent 58%);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .principle--1 { animation-delay: 0.62s; }
  .principle--2 { animation-delay: 0.74s; }
  .principle--3 {
    animation-delay: 0.86s;
    background:
      radial-gradient(circle at 88% 20%, rgba(34, 211, 238, 0.19), transparent 36%),
      linear-gradient(180deg, rgba(8, 145, 178, 0.22), rgba(17, 24, 39, 0.64));
    border-color: rgba(34, 211, 238, 0.48);
    box-shadow: 0 20px 56px rgba(8, 145, 178, 0.18);
  }
  .principle--4 { animation-delay: 0.98s; }
  .principle--5 {
    grid-column: 1 / -1;
    min-height: 120px;
    animation-delay: 1.1s;
    border-color: rgba(34, 211, 238, 0.38);
  }

  .principle-number {
    position: absolute;
    top: 18px;
    right: 22px;
    color: rgba(148, 163, 184, 0.45);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 3px;
    font-feature-settings: "tnum";
  }

  .principle i {
    position: relative;
    z-index: 1;
    width: 68px;
    height: 68px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.38);
    color: var(--cyan-400);
    font-size: 36px;
  }

  .principle p {
    position: relative;
    z-index: 1;
    max-width: 500px;
    color: #f8fafc;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.18;
    margin: 0;
  }

  .principle--5 p {
    max-width: 920px;
    font-size: 31px;
  }

</style>
