---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 06 - O — Observe: zobacz sytuację"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.90))"
>
  <div class="content">
    <div class="phase-badge">
      <span class="phase-letter">O</span>
      <span class="phase-name">Observe</span>
    </div>

    <h1 class="title">
      Zobacz <span class="highlight">sytuację</span>
    </h1>

    <p class="lede">
      Observe to etap zbierania sygnałów z otoczenia,
      <span class="lede-accent">zanim zaczniemy je oceniać</span>.
    </p>

    <div class="flow" aria-label="Od rzeczywistości do uporządkowanych sygnałów">
      <article class="flow-step">
        <div class="flow-icon"><i class="ti ti-world"></i></div>
        <h2>Rzeczywistość</h2>
        <p>To, co faktycznie dzieje się wokół nas.</p>
      </article>

      <div class="arrow"><i class="ti ti-arrow-right"></i></div>

      <article class="flow-step flow-step--active">
        <div class="flow-icon"><i class="ti ti-eye"></i></div>
        <h2>Obserwacje</h2>
        <p>Uczciwe uchwycenie tego, co widzimy.</p>
      </article>

      <div class="arrow"><i class="ti ti-arrow-right"></i></div>

      <article class="flow-step">
        <div class="flow-icon"><i class="ti ti-list-check"></i></div>
        <h2>Uporządkowane sygnały</h2>
        <p>Materiał do interpretacji w kolejnej fazie.</p>
      </article>
    </div>

    <div class="signal-grid">
      <article class="signal-card">
        <div class="card-icon"><i class="ti ti-clipboard-text"></i></div>
        <div>
          <p class="card-label">Fakty</p>
          <h2>Co realnie się wydarzyło?</h2>
        </div>
      </article>

      <article class="signal-card">
        <div class="card-icon"><i class="ti ti-activity"></i></div>
        <div>
          <p class="card-label">Sygnały</p>
          <h2>Jakie dane, objawy lub zdarzenia są widoczne?</h2>
        </div>
      </article>

      <article class="signal-card">
        <div class="card-icon"><i class="ti ti-adjustments"></i></div>
        <div>
          <p class="card-label">Ograniczenia</p>
          <h2>Jakie warunki wpływają na sytuację?</h2>
        </div>
      </article>
    </div>
    
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 62px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .phase-badge {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 10px 22px 10px 14px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.45);
    margin-bottom: 22px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .phase-letter {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--cyan-400);
    color: #0a0e17;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: 800;
  }

  .phase-name {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--cyan-400);
  }

  .title {
    font-size: 76px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.05;
    margin-bottom: 18px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.3s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lede {
    max-width: 1120px;
    font-size: 25px;
    font-weight: 300;
    line-height: 1.42;
    color: rgba(240, 244, 248, 0.78);
    margin-bottom: 38px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.45s forwards;
  }

  .lede-accent {
    color: var(--cyan-400);
    font-weight: 600;
  }

  .flow {
    width: 100%;
    max-width: 1400px;
    display: grid;
    grid-template-columns: 1fr 86px 1fr 86px 1fr;
    align-items: stretch;
    gap: 0;
    margin-bottom: 34px;
  }

  .flow-step {
    min-height: 168px;
    padding: 24px 26px 22px;
    background: rgba(17, 24, 39, 0.58);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 16px;
    text-align: left;
    opacity: 0;
    animation: fadeUp 0.9s ease-out forwards;
  }

  .flow-step:nth-of-type(1) { animation-delay: 0.6s; }
  .flow-step:nth-of-type(2) { animation-delay: 0.75s; }
  .flow-step:nth-of-type(3) { animation-delay: 0.9s; }

  .flow-step--active {
    background: linear-gradient(180deg, rgba(8, 145, 178, 0.28), rgba(17, 24, 39, 0.62));
    border-color: rgba(34, 211, 238, 0.56);
    box-shadow: 0 20px 60px rgba(8, 145, 178, 0.24);
  }

  .flow-icon {
    width: 48px;
    height: 48px;
    margin-bottom: 16px;
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.38);
    color: var(--cyan-400);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 25px;
  }

  .flow-step h2 {
    font-size: 28px;
    font-weight: 800;
    letter-spacing: 0;
    color: #f0f4f8;
    line-height: 1.12;
    margin-bottom: 8px;
  }

  .flow-step p {
    font-size: 18px;
    font-weight: 300;
    line-height: 1.4;
    color: #aebbd0;
  }

  .arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cyan-400);
    font-size: 42px;
    opacity: 0;
    animation: fadeIn 0.8s ease-out 0.82s forwards;
  }

  .signal-grid {
    width: 100%;
    max-width: 1400px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 30px;
  }

  .signal-card {
    display: grid;
    grid-template-columns: 58px 1fr;
    gap: 16px;
    align-items: flex-start;
    min-height: 130px;
    padding: 22px 24px;
    border-radius: 14px;
    background: rgba(15, 23, 42, 0.64);
    border: 1px solid rgba(148, 163, 184, 0.20);
    text-align: left;
    opacity: 0;
    animation: fadeUp 0.9s ease-out forwards;
  }

  .signal-card:nth-child(1) { animation-delay: 1s; }
  .signal-card:nth-child(2) { animation-delay: 1.1s; }
  .signal-card:nth-child(3) { animation-delay: 1.2s; }

  .card-icon {
    width: 58px;
    height: 58px;
    border-radius: 14px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.38);
    color: var(--cyan-400);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 29px;
  }

  .card-label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--cyan-400);
    margin-bottom: 8px;
  }

  .signal-card h2 {
    font-size: 25px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.2;
    color: #f0f4f8;
  }

  .principle {
    width: 100%;
    max-width: 1180px;
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    align-items: center;
    gap: 24px;
    padding: 18px 28px;
    border-radius: 14px;
    background: rgba(34, 211, 238, 0.08);
    border: 1px solid rgba(34, 211, 238, 0.30);
    color: #d9f9ff;
    font-size: 24px;
    line-height: 1.25;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.35s forwards;
  }

  .principle-left,
  .principle-right {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .principle i {
    font-size: 28px;
    color: var(--cyan-400);
    flex-shrink: 0;
  }

  .principle-right i {
    color: #facc15;
  }

  .principle-divider {
    width: 1px;
    height: 42px;
    background: rgba(148, 163, 184, 0.30);
  }

  .principle strong {
    color: #f0f4f8;
    font-weight: 800;
  }
</style>
