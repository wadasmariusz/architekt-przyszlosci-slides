---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 11 - ADR: zapis decyzji architektonicznej"
  bgImage="/images/background-5.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.92))"
>
  <div class="content">
    <div class="phase-badge">
      <span class="phase-letter">D</span>
      <span class="phase-name">Decide</span>
    </div>

    <h1 class="title">
      ADR: zapis <span class="highlight">decyzji architektonicznej</span>
    </h1>

    <div class="adr-stage" aria-label="ADR jako narzedzie wspierajace faze Decide">
      <article class="adr-card">
        <header class="file-head">
          <div class="file-dots" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <p class="file-name">docs/adr/0012-payment-events.md</p>
          <span class="file-type">ADR</span>
        </header>

        <div class="adr-body">
          <section class="adr-section adr-section--context">
            <div class="section-icon"><i class="ti ti-map-search"></i></div>
            <div>
              <h2>Kontekst</h2>
              <p>Dlaczego ta decyzja jest teraz potrzebna?</p>
            </div>
          </section>

          <section class="adr-section adr-section--decision">
            <div class="section-icon"><i class="ti ti-route-alt-left"></i></div>
            <div>
              <h2>Decyzja</h2>
              <p>Jaki kierunek działania wybieramy?</p>
            </div>
          </section>

          <section class="adr-section">
            <div class="section-icon"><i class="ti ti-git-compare"></i></div>
            <div>
              <h2>Rozważane alternatywy</h2>
              <p>Co odrzuciliśmy i z jakiego powodu?</p>
            </div>
          </section>

          <section class="adr-section">
            <div class="section-icon"><i class="ti ti-ripple"></i></div>
            <div>
              <h2>Konsekwencje</h2>
              <p>Jakie trade-offy i ryzyka akceptujemy?</p>
            </div>
          </section>

          <section class="adr-section">
            <div class="section-icon"><i class="ti ti-progress-check"></i></div>
            <div>
              <h2>Status decyzji</h2>
              <p>Czy jest proponowana, zaakceptowana, czy zastąpiona?</p>
            </div>
          </section>
        </div>
      </article>

      <aside class="ooda-link">
        <p class="link-label">Rola w OODA</p>
        <h2>Decyzja jako hipoteza</h2>
        <div class="link-flow">
          <span>Orient</span>
          <i class="ti ti-arrow-right"></i>
          <strong>ADR</strong>
          <i class="ti ti-arrow-right"></i>
          <span>Act</span>
        </div>
      </aside>
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: center;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1480px;
    padding: 0 3rem 270px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .phase-badge {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 10px 22px 10px 14px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.45);
    margin-bottom: 18px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .phase-letter {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--cyan-400);
    color: #0a0e17;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: 800;
  }

  .phase-name {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--cyan-400);
  }

  .title {
    width: min(1280px, 100%);
    font-size: 74px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.06;
    margin-bottom: 24px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.3s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .adr-stage {
    width: min(1280px, 100%);
    display: grid;
    grid-template-columns: minmax(760px, 1.25fr) minmax(360px, 0.75fr);
    gap: 26px;
    align-items: center;
  }

  .adr-card,
  .ooda-link,
  .memory-note {
    background: rgba(17, 24, 39, 0.62);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 16px;
    backdrop-filter: blur(10px);
    box-shadow: 0 18px 46px rgba(0, 0, 0, 0.28);
  }

  .adr-card {
    overflow: hidden;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.55s forwards;
  }

  .file-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 15px 18px;
    background: rgba(2, 6, 23, 0.72);
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
  }

  .file-dots {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .file-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .file-dots span:nth-child(1) { background: #f87171; }
  .file-dots span:nth-child(2) { background: #facc15; }
  .file-dots span:nth-child(3) { background: #4ade80; }

  .file-name {
    font-size: 18px;
    font-weight: 500;
    color: #dbeafe;
    letter-spacing: 0.2px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .file-type {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--cyan-400);
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid rgba(34, 211, 238, 0.35);
    background: rgba(34, 211, 238, 0.1);
  }

  .adr-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    padding: 22px;
  }

  .adr-section {
    min-height: 126px;
    display: grid;
    grid-template-columns: 58px 1fr;
    gap: 16px;
    align-items: center;
    padding: 18px;
    border-radius: 14px;
    background: rgba(2, 6, 23, 0.32);
    border: 1px solid rgba(148, 163, 184, 0.16);
    text-align: left;
  }

  .adr-section--context,
  .adr-section--decision {
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.20), rgba(2, 6, 23, 0.34));
    border-color: rgba(34, 211, 238, 0.34);
  }

  .adr-section:last-child {
    grid-column: 1 / -1;
    min-height: 110px;
  }

  .section-icon {
    width: 58px;
    height: 58px;
    border-radius: 14px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.34);
    color: var(--cyan-400);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
  }

  .adr-section h2 {
    font-size: 28px;
    font-weight: 800;
    line-height: 1.12;
    color: #f8fafc;
    margin-bottom: 8px;
  }

  .adr-section p {
    font-size: 18px;
    font-weight: 300;
    line-height: 1.34;
    color: #b6c4d8;
  }

  .ooda-link {
    min-height: 310px;
    padding: 30px 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.78s forwards;
    background:
      radial-gradient(circle at 82% 16%, rgba(34, 211, 238, 0.18), transparent 38%),
      linear-gradient(180deg, rgba(8, 145, 178, 0.18), rgba(17, 24, 39, 0.62));
    border-color: rgba(34, 211, 238, 0.38);
  }

  .link-label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--cyan-400);
    margin-bottom: 12px;
  }

  .ooda-link h2 {
    font-size: 36px;
    font-weight: 800;
    line-height: 1.12;
    color: #f8fafc;
    margin-bottom: 22px;
  }

  .link-flow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .link-flow span,
  .link-flow strong {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 15px;
    border-radius: 999px;
    background: rgba(2, 6, 23, 0.36);
    border: 1px solid rgba(148, 163, 184, 0.20);
    color: #dbeafe;
    font-size: 17px;
    font-weight: 700;
  }

  .link-flow strong {
    background: rgba(34, 211, 238, 0.16);
    border-color: rgba(34, 211, 238, 0.44);
    color: #a5f3fc;
  }

  .link-flow i {
    color: var(--cyan-400);
    font-size: 26px;
  }

  .ooda-link > p:last-child {
    font-size: 22px;
    font-weight: 300;
    line-height: 1.42;
    color: #cbd5e1;
  }

  .memory-note {
    width: min(1050px, calc(100% - 610px));
    min-height: 106px;
    margin-top: 26px;
    display: grid;
    grid-template-columns: 62px 1fr;
    gap: 18px;
    align-items: center;
    padding: 18px 24px;
    background: linear-gradient(90deg, rgba(8, 145, 178, 0.22), rgba(15, 23, 42, 0.64));
    border-color: rgba(34, 211, 238, 0.42);
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.02s forwards;
  }

  .memory-note i {
    width: 62px;
    height: 62px;
    border-radius: 15px;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.34);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cyan-400);
    font-size: 32px;
  }

  .memory-note p {
    font-size: 22px;
    font-weight: 300;
    line-height: 1.36;
    color: #dbeafe;
  }

  .memory-note strong {
    font-weight: 800;
    color: #f8fafc;
  }
</style>
