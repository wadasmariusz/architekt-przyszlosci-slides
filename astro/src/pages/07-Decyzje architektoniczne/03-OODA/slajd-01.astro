---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 01 - OODA Loop w decyzjach architektonicznych"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.88))"
>
  <div class="content">
    <div class="hero">
      <h1 class="title">
        <span class="title-main">OODA Loop</span>
        <span class="title-sub">w decyzjach architektonicznych</span>
      </h1>

      <ul class="phases" aria-hidden="true">
        <li><span>O</span>bserve</li>
        <li class="sep">→</li>
        <li><span>O</span>rient</li>
        <li class="sep">→</li>
        <li><span>D</span>ecide</li>
        <li class="sep">→</li>
        <li><span>A</span>ct</li>
      </ul>
    </div>

  </div>
</SlideLayout>

<style is:global>
  .content {
    position: relative;
    width: 100%;
    max-width: 1620px;
    padding: 0 110px;
    display: block;
    text-align: left;
  }

  .hero {
    max-width: 1140px;
    padding-top: 40px;
  }

  .eyebrow {
    font-size: 22px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 6px;
    color: var(--cyan-400);
    margin-bottom: 40px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .title {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 56px;
  }

  .title-main {
    display: block;
    font-size: 168px;
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -3px;
    background: linear-gradient(135deg, var(--cyan-400) 0%, var(--cyan-600) 60%, #f0f4f8 110%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.4s forwards;
  }

  .title-sub {
    display: block;
    font-size: 56px;
    font-weight: 400;
    color: rgba(240, 244, 248, 0.86);
    letter-spacing: -0.5px;
    line-height: 1.1;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.65s forwards;
  }

  .tagline {
    display: flex;
    align-items: flex-start;
    gap: 26px;
    max-width: 1080px;
    margin-bottom: 56px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.9s forwards;
  }

  .tagline-bar {
    flex: 0 0 4px;
    width: 4px;
    align-self: stretch;
    background: linear-gradient(180deg, var(--cyan-400), rgba(34, 211, 238, 0));
    border-radius: 2px;
    margin-top: 6px;
  }

  .tagline p {
    font-size: 32px;
    line-height: 1.45;
    font-weight: 300;
    color: rgba(240, 244, 248, 0.82);
    letter-spacing: -0.2px;
  }

  .tagline .accent {
    color: #f0f4f8;
    font-weight: 600;
  }

  .phases {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding: 18px 32px;
    border: 1px solid rgba(34, 211, 238, 0.28);
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.08);
    backdrop-filter: blur(6px);
    font-size: 22px;
    font-weight: 500;
    color: rgba(240, 244, 248, 0.78);
    letter-spacing: 0.5px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.15s forwards;
  }

  .phases li {
    display: inline-flex;
    align-items: baseline;
  }

  .phases li span {
    font-size: 26px;
    font-weight: 800;
    color: var(--cyan-400);
    margin-right: 2px;
  }

  .phases .sep {
    color: rgba(34, 211, 238, 0.55);
    font-weight: 400;
    font-size: 22px;
  }

  .loop-mark {
    position: absolute;
    top: 60px;
    right: 80px;
    width: 320px;
    height: 320px;
    opacity: 0;
    animation: fadeUp 1.2s ease-out 0.5s forwards, slowSpin 60s linear 1.5s infinite;
    transform-origin: center;
  }

  .loop-mark svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  @keyframes slowSpin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
</style>
