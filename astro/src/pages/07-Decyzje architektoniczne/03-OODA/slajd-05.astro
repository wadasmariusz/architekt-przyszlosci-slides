---
import SlideLayout from '../../../layouts/SlideLayout.astro';
import { Image } from 'astro:assets';
import oodaLoopImg from './images/ooda-loop-dark.png';
---
<SlideLayout
  title="Slajd 05 - Pętla OODA"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.90))"
>
  <div class="content">
    <header class="head">
      <h1 class="title">
        Pętla <span class="highlight">OODA</span>
      </h1>
    </header>

    <div class="loop" aria-label="Pętla OODA">
      <Image
        class="loop-img"
        src={oodaLoopImg}
        alt="Pętla OODA — Observe, Orient, Decide, Act"
        loading="eager"
      />
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 62px 3rem 0;
    text-align: center;
  }

  .head {
    width: 100%;
    margin-bottom: 28px;
  }

  .title {
    font-size: 88px;
    font-weight: 800;
    letter-spacing: -1.5px;
    line-height: 1.02;
    color: #f0f4f8;
    margin-bottom: 0;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.3s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .loop {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .loop-img {
    width: auto;
    height: 760px;
    max-width: 100%;
    object-fit: contain;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.5s forwards;
  }
</style>
