---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 17 - Utrzymywalność ponad atrakcyjność diagramu"
  bgImage="/images/background-5.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.92))"
>
  <div class="content">
    <header class="header">
      <span class="level-chip"><i class="ti ti-tools"></i> Konsekwencje decyzji</span>
      <h1 class="title">
        Utrzymywalność ponad <span class="highlight">atrakcyjność diagramu</span>
      </h1>
      <p class="lead">
        Najlepsza technicznie decyzja może być słaba, jeśli organizacja nie jest w stanie jej utrzymać.
      </p>
    </header>

    <section class="comparison" aria-label="Porownanie ladnego diagramu i systemu utrzymywalnego przez zespol">
      <article class="side side--diagram">
        <div class="side-head">
          <div class="side-icon"><i class="ti ti-vector-triangle"></i></div>
          <div>
            <p class="side-kicker">Ładny diagram</p>
            <h2>Wygląda poprawnie na papierze</h2>
          </div>
        </div>

        <div class="diagram-preview" aria-hidden="true">
          <span class="node node--top">API</span>
          <span class="node node--left">Service</span>
          <span class="node node--right">Cassandra</span>
          <span class="line line--a"></span>
          <span class="line line--b"></span>
        </div>

        <ul class="signals">
          <li><i class="ti ti-alert-triangle"></i><span>Nie pokazuje kosztu operacyjnego</span></li>
          <li><i class="ti ti-user-question"></i><span>Pomija realne kompetencje zespołu</span></li>
          <li><i class="ti ti-eye-off"></i><span>Ukrywa konsekwencje po wdrożeniu</span></li>
        </ul>
      </article>

      <div class="bridge" aria-hidden="true">
        <span>zamiast</span>
      </div>

      <article class="side side--maintainable">
        <div class="side-head">
          <div class="side-icon"><i class="ti ti-users-group"></i></div>
          <div>
            <p class="side-kicker">System utrzymywalny</p>
            <h2>Działa w realnej organizacji</h2>
          </div>
        </div>

        <div class="adr-card" aria-label="ADR osadzony w kontekście zespołu">
          <p class="adr-label">ADR-0012</p>
          <p class="adr-decision">PostgreSQL z partycjonowaniem i read replicas</p>
          <div class="adr-context">
            <span><i class="ti ti-map-pin"></i> kontekst zespołu</span>
            <span><i class="ti ti-scale"></i> znane trade-offy</span>
          </div>
        </div>

        <ul class="signals">
          <li><i class="ti ti-brain"></i><span>Kompetencje zespołu są częścią architektury</span></li>
          <li><i class="ti ti-settings-check"></i><span>Technologia pasuje do sposobu utrzymania</span></li>
          <li><i class="ti ti-flask"></i><span>Założenia sprawdzamy PoC-em i benchmarkiem</span></li>
        </ul>
      </article>
    </section>

  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
    align-items: center;
  }

  .content {
    position: relative;
    z-index: 5;
    width: min(1460px, calc(100% - 128px));
    max-width: none;
    margin: 0 auto;
    padding: 32px 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    max-width: 1240px;
    margin: 0 auto 22px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 14px;
  }

  .level-chip i {
    font-size: 20px;
  }

  .title {
    max-width: 1240px;
    font-size: 62px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lead {
    max-width: 1040px;
    margin: 16px auto 0;
    color: #cbd5e1;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.32;
  }

  .comparison {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 86px minmax(0, 1fr);
    gap: 18px;
    align-items: stretch;
    justify-content: center;
    margin: 0 auto;
  }

  .side {
    position: relative;
    min-height: 418px;
    padding: 20px 22px 18px;
    border-radius: 18px;
    background: rgba(17, 24, 39, 0.62);
    border: 1px solid rgba(148, 163, 184, 0.22);
    backdrop-filter: blur(10px);
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.24);
    overflow: hidden;
    opacity: 0;
    transform: translateY(24px);
    animation: fadeUp 0.85s ease-out forwards;
  }

  .side::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, rgba(148, 163, 184, 0.72), transparent);
  }

  .side--diagram {
    animation-delay: 0.45s;
  }

  .side--maintainable {
    animation-delay: 0.62s;
    background:
      radial-gradient(circle at 86% 14%, rgba(34, 211, 238, 0.18), transparent 36%),
      linear-gradient(180deg, rgba(8, 145, 178, 0.18), rgba(17, 24, 39, 0.62));
    border-color: rgba(34, 211, 238, 0.42);
    box-shadow: 0 20px 56px rgba(8, 145, 178, 0.18);
  }

  .side--maintainable::before {
    background: linear-gradient(90deg, var(--cyan-500), transparent);
  }

  .side-head {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 15px;
    align-items: center;
    text-align: left;
    padding-bottom: 14px;
    margin-bottom: 14px;
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
  }

  .side-icon {
    width: 60px;
    height: 60px;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(148, 163, 184, 0.1);
    border: 1px solid rgba(148, 163, 184, 0.3);
    color: #cbd5e1;
    font-size: 32px;
  }

  .side--maintainable .side-icon {
    background: rgba(34, 211, 238, 0.12);
    border-color: rgba(34, 211, 238, 0.36);
    color: var(--cyan-400);
  }

  .side-kicker {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #94a3b8;
    margin-bottom: 6px;
  }

  .side--maintainable .side-kicker {
    color: var(--cyan-400);
  }

  .side h2 {
    font-size: 28px;
    font-weight: 800;
    line-height: 1.12;
    color: #f8fafc;
    margin: 0;
  }

  .diagram-preview,
  .adr-card {
    height: 132px;
    margin-bottom: 12px;
    border-radius: 16px;
    background: rgba(2, 6, 23, 0.42);
    border: 1px solid rgba(148, 163, 184, 0.18);
  }

  .diagram-preview {
    position: relative;
    overflow: hidden;
  }

  .diagram-preview::after {
    content: "";
    position: absolute;
    inset: 16px;
    border: 1px dashed rgba(148, 163, 184, 0.34);
    border-radius: 14px;
  }

  .node {
    position: absolute;
    z-index: 2;
    min-width: 112px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(15, 23, 42, 0.86);
    border: 1px solid rgba(148, 163, 184, 0.34);
    color: #e2e8f0;
    font-size: 16px;
    font-weight: 700;
  }

  .node--top {
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
  }

  .node--left {
    bottom: 18px;
    left: 64px;
  }

  .node--right {
    right: 64px;
    bottom: 18px;
  }

  .line {
    position: absolute;
    z-index: 1;
    width: 170px;
    height: 2px;
    top: 72px;
    background: linear-gradient(90deg, transparent, rgba(148, 163, 184, 0.78), transparent);
    transform-origin: center;
  }

  .line--a {
    left: 146px;
    transform: rotate(28deg);
  }

  .line--b {
    right: 146px;
    transform: rotate(-28deg);
  }

  .adr-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    text-align: left;
    padding: 18px 20px;
    border-color: rgba(34, 211, 238, 0.32);
    box-shadow: inset 0 1px 28px rgba(34, 211, 238, 0.08);
  }

  .adr-label {
    width: fit-content;
    padding: 7px 12px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.36);
    color: var(--cyan-400);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .adr-decision {
    font-size: 22px;
    font-weight: 800;
    line-height: 1.18;
    color: #f8fafc;
    margin: 0 0 12px;
  }

  .adr-context {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .adr-context span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.24);
    color: #dbeafe;
    font-size: 14px;
    font-weight: 700;
  }

  .adr-context i {
    color: var(--cyan-400);
    font-size: 18px;
  }

  .signals {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
  }

  .signals li {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 12px;
    align-items: center;
    min-height: 54px;
    padding: 8px 12px;
    border-radius: 14px;
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.16);
    text-align: left;
  }

  .signals i {
    width: 42px;
    height: 42px;
    border-radius: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(148, 163, 184, 0.1);
    border: 1px solid rgba(148, 163, 184, 0.22);
    color: #cbd5e1;
    font-size: 23px;
  }

  .side--maintainable .signals i {
    background: rgba(34, 211, 238, 0.1);
    border-color: rgba(34, 211, 238, 0.28);
    color: var(--cyan-400);
  }

  .signals span {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.25;
    color: #e2e8f0;
  }

  .bridge {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    animation: fadeIn 0.8s ease-out 0.54s forwards;
  }

  .bridge span {
    width: 78px;
    height: 78px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(2, 6, 23, 0.78);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: var(--cyan-400);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    box-shadow: 0 0 34px rgba(34, 211, 238, 0.18);
  }

</style>
