---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 14 - Tempo decyzji ma znaczenie"
  bgImage="/images/background-5.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.92))"
>
  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-player-track-next"></i> Tempo OODA</span>
      <h1 class="title">
        Tempo decyzji <span class="highlight">ma znaczenie</span>
      </h1>
    </div>

    <p class="lede">
      Przewaga przez szybkie podejmowanie rozsądnych,
      <span class="lede-accent">odwracalnych decyzji</span> i ich walidowanie.
    </p>

    <div class="tempo-board" aria-label="Porownanie szybkiej i wolnej petli decyzyjnej">
      <article class="timeline timeline--fast">
        <header class="timeline-head">
          <div class="head-icon"><i class="ti ti-bolt"></i></div>
          <div>
            <p class="timeline-label">Szybka pętla</p>
          </div>
        </header>

        <div class="flow" aria-hidden="true">
          <span class="flow-line"></span>
          <span class="flow-dot flow-dot--1"></span>
          <span class="flow-dot flow-dot--2"></span>
          <span class="flow-dot flow-dot--3"></span>
        </div>

        <div class="steps">
          <section class="step step--active">
            <span class="step-time">1-2 dni</span>
            <h3>Decyzja</h3>
            <p>Kierunek jest wystarczająco dobry, żeby go sprawdzić.</p>
          </section>

          <section class="step">
            <span class="step-time">1 tydzień</span>
            <h3>Eksperyment</h3>
            <p>PoC, spike albo canary na kontrolowanym fragmencie.</p>
          </section>

          <section class="step">
            <span class="step-time">Dane</span>
            <h3>Korekta</h3>
            <p>Wracamy do obserwacji i poprawiamy decyzję.</p>
          </section>
        </div>
      </article>
      
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
    align-items: center;
  }

  .content {
    position: relative;
    z-index: 5;
    width: min(1460px, calc(100% - 128px));
    max-width: none;
    padding: 58px 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .header {
    max-width: 1160px;
    margin: 0 auto 22px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 18px;
  }

  .level-chip i {
    font-size: 20px;
  }

  .title {
    max-width: 1180px;
    font-size: 72px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lede {
    max-width: 1060px;
    font-size: 27px;
    font-weight: 300;
    line-height: 1.38;
    color: rgba(240, 244, 248, 0.78);
    margin-bottom: 26px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.32s forwards;
  }

  .lede-accent {
    color: var(--cyan-400);
    font-weight: 600;
  }

  .tempo-board {
    width: min(1120px, 100%);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 22px;
    margin-bottom: 24px;
  }

  .timeline,
  .takeaway {
    background: rgba(17, 24, 39, 0.60);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 16px;
    backdrop-filter: blur(10px);
    box-shadow: 0 18px 46px rgba(0, 0, 0, 0.24);
  }

  .timeline {
    position: relative;
    min-height: 330px;
    padding: 24px 28px 26px;
    overflow: hidden;
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.5s forwards;
  }

  .timeline::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.9;
  }

  .timeline--fast {
    animation-delay: 0.65s;
    border-color: rgba(34, 211, 238, 0.42);
    background:
      radial-gradient(circle at 18% 16%, rgba(34, 211, 238, 0.20), transparent 38%),
      linear-gradient(180deg, rgba(8, 145, 178, 0.18), rgba(17, 24, 39, 0.62));
  }

  .timeline--fast::before {
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.12), transparent 52%);
  }

  .timeline--slow {
    animation-delay: 0.86s;
    background:
      radial-gradient(circle at 82% 16%, rgba(245, 158, 11, 0.16), transparent 38%),
      rgba(17, 24, 39, 0.60);
  }

  .timeline--slow::before {
    background: linear-gradient(135deg, rgba(148, 163, 184, 0.10), transparent 58%);
  }

  .timeline-head {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin-bottom: 16px;
  }

  .head-icon {
    width: 54px;
    height: 54px;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.38);
    color: var(--cyan-400);
    font-size: 28px;
  }

  .timeline--slow .head-icon {
    background: rgba(245, 158, 11, 0.10);
    border-color: rgba(245, 158, 11, 0.34);
    color: #fbbf24;
  }

  .timeline-label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--cyan-400);
    margin-bottom: 10px;
  }

  .timeline--slow .timeline-label {
    color: #fbbf24;
  }

  .timeline-head h2 {
    font-size: 34px;
    font-weight: 800;
    line-height: 1.12;
    color: #f8fafc;
  }

  .flow {
    position: relative;
    z-index: 1;
    height: 30px;
    margin: 0 26px 12px;
  }

  .flow-line {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 14px;
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--cyan-400), var(--cyan-600));
    box-shadow: 0 0 24px rgba(34, 211, 238, 0.22);
  }

  .flow--muted .flow-line {
    background: linear-gradient(90deg, rgba(148, 163, 184, 0.55), #f59e0b);
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.12);
  }

  .flow-dot {
    position: absolute;
    top: 5px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #0a0e17;
    border: 4px solid var(--cyan-400);
    box-shadow: 0 0 0 5px rgba(34, 211, 238, 0.12);
  }

  .flow--muted .flow-dot {
    border-color: #f59e0b;
    box-shadow: 0 0 0 5px rgba(245, 158, 11, 0.10);
  }

  .flow-dot--1 { left: 16px; }
  .flow-dot--2 { left: calc(50% - 10px); }
  .flow-dot--3 { right: 16px; }

  .steps {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .step {
    min-height: 154px;
    padding: 16px 16px 15px;
    border-radius: 14px;
    background: rgba(2, 6, 23, 0.34);
    border: 1px solid rgba(148, 163, 184, 0.16);
    text-align: center;
  }

  .step--active {
    border-color: rgba(34, 211, 238, 0.38);
    background: rgba(8, 145, 178, 0.16);
  }

  .step--warning {
    border-color: rgba(245, 158, 11, 0.38);
    background: rgba(245, 158, 11, 0.10);
  }

  .step-time {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 28px;
    padding: 5px 11px;
    margin-bottom: 12px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.28);
    color: #a5f3fc;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }

  .timeline--slow .step-time {
    background: rgba(245, 158, 11, 0.10);
    border-color: rgba(245, 158, 11, 0.28);
    color: #fde68a;
  }

  .step h3 {
    font-size: 24px;
    font-weight: 800;
    line-height: 1.14;
    color: #f8fafc;
    margin-bottom: 8px;
  }

  .step p {
    font-size: 17px;
    font-weight: 300;
    line-height: 1.34;
    color: #b6c4d8;
  }

  .takeaway {
    width: 100%;
    min-height: 104px;
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 18px;
    align-items: center;
    margin: 0;
    padding: 20px 26px;
    background:
      radial-gradient(circle at 8% 50%, rgba(34, 211, 238, 0.14), transparent 38%),
      rgba(15, 23, 42, 0.64);
    border-color: rgba(34, 211, 238, 0.34);
    border-left: 3px solid var(--cyan-400);
    opacity: 0;
    animation: fadeUp 0.85s ease-out 1.12s forwards;
  }

  .takeaway i {
    width: 60px;
    height: 60px;
    border-radius: 15px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.34);
    color: var(--cyan-400);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
  }

  .takeaway p {
    font-size: 24px;
    font-weight: 300;
    font-style: italic;
    line-height: 1.36;
    color: #e2e8f0;
  }
</style>
