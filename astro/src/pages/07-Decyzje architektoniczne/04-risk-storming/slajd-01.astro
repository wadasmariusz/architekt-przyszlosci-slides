---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 01 - Risk storming"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.88))"
>
  <div class="content">
    <h1 class="title">
      RISK <span class="highlight">STORMING</span>
    </h1>

    <section class="flow" aria-label="Przepływ techniki risk storming">
      <div class="flow-node">
        <div class="node-ic"><i class="ti ti-layout-grid"></i></div>
        <span class="node-label">Design</span>
      </div>

      <div class="flow-arrow" aria-hidden="true">
        <i class="ti ti-arrow-narrow-right"></i>
      </div>

      <div class="flow-node">
        <div class="node-ic"><i class="ti ti-alert-triangle"></i></div>
        <span class="node-label">Ryzyka</span>
      </div>

      <div class="flow-arrow" aria-hidden="true">
        <i class="ti ti-arrow-narrow-right"></i>
      </div>

      <div class="flow-node">
        <div class="node-ic"><i class="ti ti-scale"></i></div>
        <span class="node-label">Ocena</span>
      </div>

      <div class="flow-arrow" aria-hidden="true">
        <i class="ti ti-arrow-narrow-right"></i>
      </div>

      <div class="flow-node flow-node--final">
        <div class="node-ic"><i class="ti ti-check"></i></div>
        <span class="node-label">Decyzja</span>
      </div>
    </section>
  </div>
</SlideLayout>

<style is:global>
  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 64px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .title {
    font-size: 88px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .flow {
    width: 100%;
    max-width: 1480px;
    margin-top: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    opacity: 0;
    animation: fadeIn 1.1s ease-out 0.6s forwards;
  }

  .flow-node {
    flex: 0 0 auto;
    width: 260px;
    min-height: 240px;
    padding: 32px 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    border-radius: 22px;
    background: linear-gradient(145deg, rgba(14, 116, 144, 0.22), rgba(8, 145, 178, 0.06));
    border: 2px solid rgba(34, 211, 238, 0.42);
    box-shadow:
      0 0 0 2px rgba(34, 211, 238, 0.10),
      inset 0 0 50px rgba(3, 7, 18, 0.42),
      0 20px 60px rgba(8, 145, 178, 0.22);
    opacity: 0;
    animation: fadeUp 0.8s ease-out forwards;
  }

  .flow-node:nth-of-type(1) { animation-delay: 0.7s; }
  .flow-node:nth-of-type(3) { animation-delay: 0.95s; }
  .flow-node:nth-of-type(5) { animation-delay: 1.2s; }
  .flow-node:nth-of-type(7) { animation-delay: 1.45s; }

  .flow-node--final {
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.55), rgba(14, 116, 144, 0.45));
    border-color: var(--cyan-400);
    box-shadow:
      0 0 0 2px rgba(34, 211, 238, 0.20),
      inset 0 0 40px rgba(3, 7, 18, 0.35),
      0 22px 60px rgba(8, 145, 178, 0.40);
  }

  .node-ic {
    width: 92px;
    height: 92px;
    border-radius: 22px;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.42);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .node-ic i {
    font-size: 50px;
    color: var(--cyan-400);
  }

  .flow-node--final .node-ic {
    background: rgba(34, 211, 238, 0.22);
    border-color: rgba(34, 211, 238, 0.7);
  }

  .flow-node--final .node-ic i {
    color: #f0f4f8;
  }

  .node-label {
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -0.2px;
    color: #f0f4f8;
  }

  .flow-arrow {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    animation: fadeIn 0.6s ease-out forwards;
  }

  .flow-arrow:nth-of-type(2) { animation-delay: 0.85s; }
  .flow-arrow:nth-of-type(4) { animation-delay: 1.10s; }
  .flow-arrow:nth-of-type(6) { animation-delay: 1.35s; }

  .flow-arrow i {
    font-size: 56px;
    color: rgba(34, 211, 238, 0.65);
  }

  @media (max-width: 1500px) {
    .flow-node {
      width: 220px;
      min-height: 220px;
    }

    .node-label {
      font-size: 30px;
    }

    .flow-arrow i {
      font-size: 46px;
    }
  }

  @media (max-width: 1100px) {
    .title {
      font-size: 64px;
    }

    .flow {
      flex-wrap: wrap;
      gap: 18px;
      margin-top: 60px;
    }

    .flow-node {
      width: 180px;
      min-height: 180px;
      padding: 22px 14px;
    }

    .node-ic {
      width: 70px;
      height: 70px;
    }

    .node-ic i {
      font-size: 38px;
    }

    .node-label {
      font-size: 24px;
    }
  }
</style>
