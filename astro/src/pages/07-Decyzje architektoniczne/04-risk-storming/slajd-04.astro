---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 04 - Ocena ryzyka"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.90))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="severityGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="severityGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#severityGrid)"/>
    <circle cx="960" cy="600" r="500" fill="url(#severityGlow)"/>
  </svg>

  <div class="content">
    <h1 class="title">
      Ocena <span class="highlight">ryzyka</span>
    </h1>

    <section class="formula" aria-label="Wzór na severity">
      <article class="factor-card">
        <span class="factor-label">Prawdopodobieństwo</span>
        <div class="scale" aria-hidden="true">
          <span class="scale-num">1</span>
          <div class="scale-bar"><div class="scale-fill scale-fill--prob"></div></div>
          <span class="scale-num">10</span>
        </div>
        <span class="factor-range">1 – 10</span>
      </article>

      <div class="op op--times" aria-hidden="true">×</div>

      <article class="factor-card">
        <span class="factor-label">Wpływ</span>
        <div class="scale" aria-hidden="true">
          <span class="scale-num">1</span>
          <div class="scale-bar"><div class="scale-fill scale-fill--impact"></div></div>
          <span class="scale-num">10</span>
        </div>
        <span class="factor-range">1 – 10</span>
      </article>

      <div class="op op--equals" aria-hidden="true">=</div>

      <article class="factor-card factor-card--result">
        <span class="factor-label">Severity</span>
        <div class="severity-display" aria-hidden="true">
          <i class="ti ti-flame"></i>
        </div>
      </article>
    </section>
    
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 72px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .title {
    font-size: 88px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 72px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.3s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .formula {
    width: 100%;
    max-width: 1560px;
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 22px;
    margin-bottom: 64px;
  }

  .factor-card {
    flex: 1 1 0;
    min-width: 0;
    padding: 32px 26px;
    background: rgba(17, 24, 39, 0.62);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.30);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out forwards;
  }

  .factor-card:nth-of-type(1) { animation-delay: 0.55s; }
  .factor-card:nth-of-type(2) { animation-delay: 0.75s; }
  .factor-card:nth-of-type(3) { animation-delay: 0.95s; }

  .factor-card--result {
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.36), rgba(14, 116, 144, 0.16));
    border-color: rgba(34, 211, 238, 0.55);
    box-shadow:
      0 0 0 6px rgba(34, 211, 238, 0.06),
      0 28px 70px rgba(8, 145, 178, 0.32);
  }

  .factor-label {
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.2px;
    color: #f0f4f8;
  }

  .factor-range {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: rgba(226, 246, 255, 0.78);
  }

  .factor-card--result .factor-range {
    font-size: 18px;
    color: rgba(226, 246, 255, 0.72);
    text-transform: lowercase;
  }

  .scale {
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
  }

  .scale-num {
    font-size: 24px;
    font-weight: 800;
    color: var(--cyan-400);
    font-variant-numeric: tabular-nums;
  }

  .scale-bar {
    height: 18px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.18);
    border: 1px solid rgba(34, 211, 238, 0.3);
    overflow: hidden;
    position: relative;
  }

  .scale-fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #22d3ee 0%, #f59e0b 60%, #ef4444 100%);
  }

  .scale-fill--prob { width: 100%; }
  .scale-fill--impact { width: 100%; }

  .severity-display {
    width: 100%;
    min-height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .severity-display i {
    font-size: 72px;
    color: #fbbf24;
    filter: drop-shadow(0 6px 16px rgba(251, 191, 36, 0.45));
  }

  .op {
    flex: 0 0 auto;
    align-self: center;
    font-size: 64px;
    font-weight: 800;
    color: rgba(34, 211, 238, 0.85);
    line-height: 1;
    opacity: 0;
    animation: fadeIn 0.5s ease-out forwards;
  }

  .op--times { animation-delay: 0.7s; }
  .op--equals { animation-delay: 0.9s; }

  .goal-note {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding: 24px 36px;
    border-radius: 16px;
    border: 1px solid rgba(251, 191, 36, 0.45);
    background: linear-gradient(135deg, rgba(180, 83, 9, 0.22), rgba(217, 119, 6, 0.08));
    box-shadow: 0 18px 48px rgba(180, 83, 9, 0.20);
    opacity: 0;
    animation: fadeUp 0.85s ease-out 1.15s forwards;
  }

  .goal-note i {
    width: 60px;
    height: 60px;
    border-radius: 14px;
    background: rgba(251, 191, 36, 0.16);
    border: 1px solid rgba(251, 191, 36, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    color: #fbbf24;
    flex-shrink: 0;
  }

  .goal-note p {
    margin: 0;
    text-align: left;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.25;
    color: #ffedd5;
    letter-spacing: -0.2px;
  }

  .goal-note .strike {
    text-decoration: line-through;
    text-decoration-color: rgba(251, 191, 36, 0.7);
    text-decoration-thickness: 2px;
    color: rgba(255, 237, 213, 0.55);
    font-weight: 600;
  }

  .goal-note .accent {
    color: #fde68a;
    font-weight: 800;
  }

  @media (max-width: 1200px) {
    .title {
      font-size: 64px;
      margin-bottom: 40px;
    }

    .formula {
      flex-direction: column;
      gap: 18px;
    }

    .op {
      align-self: center;
      font-size: 44px;
    }

    .factor-label {
      font-size: 24px;
    }

    .goal-note p {
      font-size: 24px;
    }
  }
</style>
