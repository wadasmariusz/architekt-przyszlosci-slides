---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 14 - Świadomy trade-off"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.90))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="tradeoffGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="tradeoffGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#tradeoffGrid)"/>
    <circle cx="960" cy="540" r="500" fill="url(#tradeoffGlow)"/>
  </svg>

  <div class="content">
    <h1 class="title">
      Świadomy <span class="highlight">trade-off</span>
    </h1>

    <section class="path" aria-label="Ścieżka: ryzyko → konsekwencja → akceptacja">
      <article class="step step--tech">
        <div class="step-ic"><i class="ti ti-cpu"></i></div>
        <h2>Ryzyko techniczne</h2>
        <span class="step-tag">tech</span>
      </article>

      <i class="ti ti-arrow-narrow-right path-arrow" aria-hidden="true"></i>

      <article class="step step--biz">
        <div class="step-ic"><i class="ti ti-chart-line"></i></div>
        <h2>Konsekwencja biznesowa</h2>
        <span class="step-tag">biznes</span>
      </article>

      <i class="ti ti-arrow-narrow-right path-arrow" aria-hidden="true"></i>

      <article class="step step--accept">
        <div class="step-ic"><i class="ti ti-circle-check"></i></div>
        <h2>Akceptacja trade-offu</h2>
        <span class="step-tag">decyzja</span>
      </article>
    </section>

    <aside class="closing">
      <i class="ti ti-bulb" aria-hidden="true"></i>
      <p><span class="accent">Świadoma</span> decyzja</p>
    </aside>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 72px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .title {
    font-size: 88px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 72px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.3s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .path {
    width: 100%;
    max-width: 1560px;
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 26px;
    margin-bottom: 64px;
  }

  .step {
    flex: 1 1 0;
    min-width: 0;
    padding: 36px 24px 28px;
    border-radius: 22px;
    background: rgba(17, 24, 39, 0.62);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.32);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    position: relative;
    opacity: 0;
    animation: fadeUp 0.9s ease-out forwards;
  }

  .step--tech   { animation-delay: 0.5s; }
  .step--biz    { animation-delay: 0.8s; }
  .step--accept {
    animation-delay: 1.1s;
    border-color: rgba(34, 211, 238, 0.55);
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.30), rgba(17, 24, 39, 0.7));
    box-shadow:
      0 0 0 6px rgba(34, 211, 238, 0.06),
      0 28px 70px rgba(8, 145, 178, 0.28);
  }

  .step-num {
    position: absolute;
    top: 14px;
    right: 18px;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 4px;
    color: rgba(148, 163, 184, 0.55);
    font-variant-numeric: tabular-nums;
  }

  .step--accept .step-num {
    color: rgba(103, 232, 249, 0.85);
  }

  .step-ic {
    width: 96px;
    height: 96px;
    border-radius: 22px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .step-ic i {
    font-size: 50px;
    color: var(--cyan-400);
  }

  .step--accept .step-ic {
    background: rgba(34, 211, 238, 0.20);
    border-color: rgba(34, 211, 238, 0.65);
  }

  .step--accept .step-ic i {
    color: #ecfeff;
  }

  .step h2 {
    margin: 0;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.3px;
    line-height: 1.2;
    color: #f0f4f8;
    text-align: center;
  }

  .step-tag {
    padding: 6px 16px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.42);
    color: #cffafe;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .path-arrow {
    align-self: center;
    font-size: 56px;
    color: rgba(34, 211, 238, 0.7);
    opacity: 0;
    animation: fadeIn 0.5s ease-out forwards;
  }

  .path-arrow:nth-of-type(2) { animation-delay: 0.7s; }
  .path-arrow:nth-of-type(4) { animation-delay: 1.0s; }

  .closing {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding: 26px 42px;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.26), rgba(17, 24, 39, 0.62));
    border: 1px solid rgba(34, 211, 238, 0.5);
    box-shadow: 0 18px 48px rgba(8, 145, 178, 0.24);
    opacity: 0;
    animation: fadeUp 0.85s ease-out 1.3s forwards;
  }

  .closing i {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    background: rgba(34, 211, 238, 0.18);
    border: 1px solid rgba(34, 211, 238, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 34px;
    color: var(--cyan-400);
    flex-shrink: 0;
  }

  .closing p {
    margin: 0;
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -0.3px;
    line-height: 1.2;
    color: #ecfeff;
  }

  .closing .accent {
    color: #67e8f9;
    font-weight: 800;
  }

  .closing .strike {
    text-decoration: line-through;
    text-decoration-color: rgba(148, 163, 184, 0.85);
    text-decoration-thickness: 2px;
    color: rgba(203, 213, 225, 0.6);
    font-weight: 600;
  }

  @media (max-width: 1300px) {
    .title {
      font-size: 60px;
      margin-bottom: 40px;
    }

    .path {
      flex-direction: column;
    }

    .path-arrow {
      transform: rotate(90deg);
    }

    .closing p {
      font-size: 26px;
    }
  }
</style>
