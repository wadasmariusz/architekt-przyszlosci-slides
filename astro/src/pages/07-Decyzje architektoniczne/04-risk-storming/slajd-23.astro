---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 23 - Spór bez wspólnego języka"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.90))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="conflictGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="conflictGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.16"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#conflictGrid)"/>
    <circle cx="960" cy="540" r="500" fill="url(#conflictGlow)"/>
  </svg>

  <div class="content">
    <h1 class="title">
      Spór bez <span class="highlight">wspólnego języka</span>
    </h1>

    <section class="argument" aria-label="Trzy perspektywy ryzyka przy tym samym designie">

      <div class="perspectives">
        <article class="person person--perf">
          <div class="person-head">
            <div class="person-avatar"><i class="ti ti-user"></i></div>
            <span class="person-role">Senior 1</span>
          </div>
          <div class="person-risk"><i class="ti ti-gauge"></i></div>
          <span class="person-tag">wydajność</span>
          <p class="person-quote">skalowanie</p>
        </article>

        <article class="person person--time">
          <div class="person-head">
            <div class="person-avatar"><i class="ti ti-user"></i></div>
            <span class="person-role">Senior 2</span>
          </div>
          <div class="person-risk"><i class="ti ti-hourglass"></i></div>
          <span class="person-tag">czas</span>
          <p class="person-quote">prostota i punktualność</p>
        </article>

        <article class="person person--biz">
          <div class="person-head">
            <div class="person-avatar"><i class="ti ti-user"></i></div>
            <span class="person-role">CTO</span>
          </div>
          <div class="person-risk"><i class="ti ti-briefcase"></i></div>
          <span class="person-tag">biznes</span>
          <p class="person-quote">deadline</p>
        </article>
      </div>
    </section>

    <aside class="punch">
      <i class="ti ti-message-2-question" aria-hidden="true"></i>
      <p>Każdy widzi <span class="accent">inne ryzyko</span></p>
    </aside>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 48px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .title {
    font-size: 88px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 62px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.3s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .argument {
    width: 100%;
    max-width: 1500px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    margin-bottom: 36px;
  }

  .shared-design {
    padding: 18px 26px;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.30), rgba(14, 116, 144, 0.12));
    border: 2px solid rgba(34, 211, 238, 0.55);
    box-shadow:
      0 0 0 6px rgba(34, 211, 238, 0.06),
      0 24px 60px rgba(8, 145, 178, 0.25);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.5s forwards;
  }

  .design-eyebrow {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--cyan-400);
  }

  .design-svg {
    width: 240px;
    height: auto;
  }

  .perspectives {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px;
    position: relative;
  }

  .perspectives::before {
    content: '';
    position: absolute;
    top: -14px;
    left: 16.66%;
    right: 16.66%;
    height: 14px;
    border-top: 1px dashed rgba(148, 163, 184, 0.35);
    border-left: 1px dashed rgba(148, 163, 184, 0.35);
    border-right: 1px dashed rgba(148, 163, 184, 0.35);
    border-radius: 14px 14px 0 0;
    pointer-events: none;
  }

  .person {
    padding: 24px 22px;
    border-radius: 18px;
    background: rgba(17, 24, 39, 0.62);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.22);
    box-shadow: 0 22px 56px rgba(2, 6, 23, 0.30);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    opacity: 0;
    animation: fadeUp 0.85s ease-out forwards;
  }

  .person--perf {
    border-color: rgba(239, 68, 68, 0.55);
    background: linear-gradient(135deg, rgba(127, 29, 29, 0.32), rgba(17, 24, 39, 0.7));
    box-shadow:
      0 0 0 4px rgba(239, 68, 68, 0.06),
      0 22px 56px rgba(239, 68, 68, 0.18);
    animation-delay: 0.75s;
  }

  .person--time {
    border-color: rgba(251, 191, 36, 0.55);
    background: linear-gradient(135deg, rgba(180, 83, 9, 0.30), rgba(17, 24, 39, 0.7));
    box-shadow:
      0 0 0 4px rgba(251, 191, 36, 0.06),
      0 22px 56px rgba(180, 83, 9, 0.18);
    animation-delay: 0.92s;
  }

  .person--biz {
    border-color: rgba(167, 139, 250, 0.55);
    background: linear-gradient(135deg, rgba(76, 29, 149, 0.32), rgba(17, 24, 39, 0.7));
    box-shadow:
      0 0 0 4px rgba(167, 139, 250, 0.06),
      0 22px 56px rgba(124, 58, 237, 0.20);
    animation-delay: 1.09s;
  }

  .person-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .person-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .person--perf .person-avatar { background: rgba(239, 68, 68, 0.16); border: 1px solid rgba(239, 68, 68, 0.5); color: #fca5a5; }
  .person--time .person-avatar { background: rgba(251, 191, 36, 0.16); border: 1px solid rgba(251, 191, 36, 0.55); color: #fde68a; }
  .person--biz  .person-avatar { background: rgba(167, 139, 250, 0.18); border: 1px solid rgba(167, 139, 250, 0.55); color: #ddd6fe; }

  .person-avatar i {
    font-size: 30px;
  }

  .person-role {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.2px;
    color: #f0f4f8;
  }

  .person-risk {
    width: 76px;
    height: 76px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .person--perf .person-risk { background: rgba(239, 68, 68, 0.18); border: 1px solid rgba(239, 68, 68, 0.55); }
  .person--time .person-risk { background: rgba(251, 191, 36, 0.18); border: 1px solid rgba(251, 191, 36, 0.55); }
  .person--biz  .person-risk { background: rgba(167, 139, 250, 0.20); border: 1px solid rgba(167, 139, 250, 0.55); }

  .person-risk i {
    font-size: 40px;
  }

  .person--perf .person-risk i { color: #fca5a5; }
  .person--time .person-risk i { color: #fde68a; }
  .person--biz  .person-risk i { color: #ddd6fe; }

  .person-tag {
    padding: 5px 14px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .person--perf .person-tag { background: rgba(239, 68, 68, 0.16); border: 1px solid rgba(239, 68, 68, 0.5); color: #fecaca; }
  .person--time .person-tag { background: rgba(251, 191, 36, 0.16); border: 1px solid rgba(251, 191, 36, 0.5); color: #fef3c7; }
  .person--biz  .person-tag { background: rgba(167, 139, 250, 0.18); border: 1px solid rgba(167, 139, 250, 0.5); color: #ede9fe; }

  .person-quote {
    margin: 0;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.2px;
    line-height: 1.2;
    color: #f0f4f8;
    font-style: italic;
  }

  .punch {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding: 22px 36px;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.26), rgba(17, 24, 39, 0.62));
    border: 1px solid rgba(34, 211, 238, 0.5);
    box-shadow: 0 18px 48px rgba(8, 145, 178, 0.22);
    opacity: 0;
    animation: fadeUp 0.85s ease-out 1.3s forwards;
  }

  .punch i {
    width: 60px;
    height: 60px;
    border-radius: 14px;
    background: rgba(34, 211, 238, 0.18);
    border: 1px solid rgba(34, 211, 238, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    color: var(--cyan-400);
    flex-shrink: 0;
  }

  .punch p {
    margin: 0;
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.3px;
    line-height: 1.2;
    color: #ecfeff;
  }

  .punch .accent {
    color: #67e8f9;
  }

  @media (max-width: 1200px) {
    .title {
      font-size: 56px;
    }

    .perspectives {
      grid-template-columns: 1fr;
    }

    .perspectives::before {
      display: none;
    }

    .person-quote {
      font-size: 22px;
    }

    .punch p {
      font-size: 22px;
    }
  }
</style>
