---
import SlideLayout from '../../../layouts/SlideLayout.astro';
import { Image } from 'astro:assets';
import perspektywaImg from './images/perspektywa-zespolu.png';
---
<SlideLayout
  title="Slajd 09 - Perspektywa zespołu"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.90))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="perspGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="perspGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#perspGrid)"/>
    <circle cx="960" cy="600" r="500" fill="url(#perspGlow)"/>
  </svg>

  <div class="content">
    <h1 class="title">
      Perspektywa <span class="highlight">zespołu</span>
    </h1>

    <figure class="perspective-figure" aria-label="Cztery perspektywy patrzące na jeden system">
      <Image
        class="perspective-img"
        src={perspektywaImg}
        alt="Architekt, Developer, DevOps i Biznes patrzący na jeden system"
        loading="eager"
      />
    </figure>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 60px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .title {
    font-size: 84px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 56px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.3s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .perspective-figure {
    width: 100%;
    max-width: 1280px;
    margin: 0;
    padding: 20px;
    border-radius: 22px;
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(34, 211, 238, 0.32);
    box-shadow:
      0 0 0 6px rgba(34, 211, 238, 0.06),
      0 28px 70px rgba(8, 145, 178, 0.22);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.5s forwards;
  }

  .perspective-img {
    width: 100%;
    height: auto;
    max-height: 720px;
    object-fit: contain;
    border-radius: 12px;
    display: block;
  }

  @media (max-width: 1200px) {
    .title {
      font-size: 56px;
    }

    .perspective-img {
      max-height: 480px;
    }
  }
</style>
