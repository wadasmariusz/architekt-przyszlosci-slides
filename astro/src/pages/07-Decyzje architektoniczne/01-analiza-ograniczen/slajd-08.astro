---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 08 - Compliance jako ograniczenie"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.90))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="complianceGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="complianceGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.16"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#complianceGrid)"/>
    <circle cx="960" cy="540" r="460" fill="url(#complianceGlow)"/>
  </svg>

  <div class="content">
    <h1 class="title">
      Zgodność z <span class="highlight">przepisami</span>
    </h1>

    <section class="compliance-grid" aria-label="Przykłady ograniczeń compliance">
      <article class="comp-card">
        <div class="ic"><i class="ti ti-shield-lock"></i></div>
        <h3>Prywatność</h3>
      </article>

      <article class="comp-card">
        <div class="ic"><i class="ti ti-shield-check"></i></div>
        <h3>Bezpieczeństwo</h3>
      </article>

      <article class="comp-card">
        <div class="ic"><i class="ti ti-file-search"></i></div>
        <h3>Audytowalność</h3>
      </article>

      <article class="comp-card">
        <div class="ic"><i class="ti ti-database-cog"></i></div>
        <h3>Retencja danych</h3>
      </article>

      <article class="comp-card">
        <div class="ic"><i class="ti ti-certificate"></i></div>
        <h3>Certyfikacja</h3>
      </article>

      <article class="comp-card">
        <div class="ic"><i class="ti ti-world-pin"></i></div>
        <h3>Lokalizacja danych</h3>
      </article>
    </section>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 72px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .title {
    font-size: 88px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 56px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.3s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .compliance-grid {
    width: 100%;
    max-width: 1440px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px;
    margin-bottom: 48px;
  }

  .comp-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    padding: 36px 22px;
    min-height: 220px;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 18px;
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.30);
    text-align: center;
    opacity: 0;
    animation: fadeUp 0.9s ease-out forwards;
  }

  .comp-card:nth-child(1) { animation-delay: 0.45s; }
  .comp-card:nth-child(2) { animation-delay: 0.55s; }
  .comp-card:nth-child(3) { animation-delay: 0.65s; }
  .comp-card:nth-child(4) { animation-delay: 0.75s; }
  .comp-card:nth-child(5) { animation-delay: 0.85s; }
  .comp-card:nth-child(6) { animation-delay: 0.95s; }

  .comp-card .ic {
    width: 82px;
    height: 82px;
    border-radius: 20px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.38);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .comp-card .ic i {
    font-size: 42px;
    color: var(--cyan-400);
  }

  .comp-card h3 {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.2px;
    line-height: 1.2;
    color: #f0f4f8;
    margin: 0;
  }

  .note {
    width: auto;
    max-width: 1280px;
    display: inline-flex;
    gap: 22px;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    padding: 26px 34px;
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.22), rgba(14, 116, 144, 0.10));
    border: 1px solid rgba(34, 211, 238, 0.45);
    border-radius: 16px;
    box-shadow: 0 18px 48px rgba(8, 145, 178, 0.18);
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.05s forwards;
  }

  .note i {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.40);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    color: var(--cyan-400);
    flex-shrink: 0;
  }

  .note p {
    margin: 0;
    text-align: left;
    font-size: 28px;
    font-weight: 500;
    line-height: 1.35;
    color: #ecfeff;
  }

  .note p .accent {
    color: var(--cyan-400);
    font-weight: 700;
  }
</style>
