---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 02 - Kontekst zawęża wybór"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.90))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="contextGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="contextGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.16"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#contextGrid)"/>
    <circle cx="960" cy="620" r="460" fill="url(#contextGlow)"/>
  </svg>

  <div class="content">
    <h1 class="title">
      Zawsze pracujemy w jakimś <span class="highlight">kontekście</span>
    </h1>

    <section class="context-grid" aria-label="Elementy kontekstu architektonicznego">
      <article class="ctx-card">
        <div class="ic"><i class="ti ti-target-arrow"></i></div>
        <h3>Cele biznesowe</h3>
      </article>

      <article class="ctx-card">
        <div class="ic"><i class="ti ti-server-2"></i></div>
        <h3>Istniejące systemy</h3>
      </article>

      <article class="ctx-card">
        <div class="ic"><i class="ti ti-users-group"></i></div>
        <h3>kompetencje zespołu</h3>
      </article>

      <article class="ctx-card">
        <div class="ic"><i class="ti ti-coin"></i></div>
        <h3>Budżet</h3>
      </article>

      <article class="ctx-card">
        <div class="ic"><i class="ti ti-gavel"></i></div>
        <h3>Regulacje</h3>
      </article>

      <article class="ctx-card">
        <div class="ic"><i class="ti ti-clock-hour-4"></i></div>
        <h3>Terminy</h3>
      </article>

      <article class="ctx-card">
        <div class="ic"><i class="ti ti-alert-triangle"></i></div>
        <h3>Ryzyka</h3>
      </article>

      <article class="ctx-card">
        <div class="ic"><i class="ti ti-history"></i></div>
        <h3>Wcześniejsze decyzje</h3>
      </article>
    </section>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 72px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .title {
    font-size: 88px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 64px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.3s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .context-grid {
    width: 100%;
    max-width: 1420px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 26px;
    justify-items: stretch;
  }

  .ctx-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    padding: 36px 22px;
    min-height: 220px;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 18px;
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.30);
    text-align: center;
    opacity: 0;
    animation: fadeUp 0.9s ease-out forwards;
  }

  .ctx-card:nth-child(1) { animation-delay: 0.45s; }
  .ctx-card:nth-child(2) { animation-delay: 0.55s; }
  .ctx-card:nth-child(3) { animation-delay: 0.65s; }
  .ctx-card:nth-child(4) { animation-delay: 0.75s; }
  .ctx-card:nth-child(5) { animation-delay: 0.85s; }
  .ctx-card:nth-child(6) { animation-delay: 0.95s; }
  .ctx-card:nth-child(7) { animation-delay: 1.05s; }
  .ctx-card:nth-child(8) { animation-delay: 1.15s; }

  .ctx-card .ic {
    width: 78px;
    height: 78px;
    border-radius: 18px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.38);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ctx-card .ic i {
    font-size: 40px;
    color: var(--cyan-400);
  }

  .ctx-card h3 {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.2px;
    line-height: 1.2;
    color: #f0f4f8;
    margin: 0;
  }
</style>
