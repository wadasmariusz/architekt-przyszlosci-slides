---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 13 - Realne czy założone?"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.90))"
>
  <svg class="bg-deco" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="realGrid" width="86" height="86" patternUnits="userSpaceOnUse">
        <path d="M 86 0 L 0 0 0 86" fill="none" stroke="rgba(34,211,238,0.07)" stroke-width="1"/>
      </pattern>
      <radialGradient id="realGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.16"/>
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="1920" height="1080" fill="url(#realGrid)"/>
    <circle cx="960" cy="600" r="480" fill="url(#realGlow)"/>
  </svg>

  <div class="content">
    <h1 class="title">
      Ograniczenia Realne czy <span class="highlight">założone?</span>
    </h1>

    <section class="split" aria-label="Realne i założone ograniczenia">
      <article class="column column--real">
        <header class="col-head">
          <div class="ic"><i class="ti ti-shield-check"></i></div>
          <h2>Realne</h2>
        </header>
        <ul class="item-list">
          <li><i class="ti ti-source-code"></i><span>Źródło</span></li>
          <li><i class="ti ti-user-check"></i><span>Właściciel</span></li>
          <li><i class="ti ti-alert-octagon"></i><span>Konsekwencje</span></li>
        </ul>
      </article>

      <article class="column column--assumed">
        <header class="col-head">
          <div class="ic"><i class="ti ti-message-circle"></i></div>
          <h2>Założone</h2>
        </header>
        <ul class="item-list">
          <li><i class="ti ti-bubble"></i><span>Opinia</span></li>
          <li><i class="ti ti-zoom-question"></i><span>Interpretacja</span></li>
          <li><i class="ti ti-repeat"></i><span>Nawyk</span></li>
          <li><i class="ti ti-heart"></i><span>Preferencja</span></li>
        </ul>
      </article>
    </section>
    
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .bg-deco {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 0.2s forwards;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 72px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .title {
    font-size: 88px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 48px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.3s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .split {
    width: 100%;
    max-width: 1440px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin-bottom: 36px;
  }

  .column {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 30px 30px 28px;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.20);
    border-radius: 18px;
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.30);
    text-align: left;
    opacity: 0;
    animation: fadeUp 0.9s ease-out forwards;
  }

  .column--real {
    animation-delay: 0.5s;
    background:
      linear-gradient(180deg, rgba(8, 145, 178, 0.22), rgba(17, 24, 39, 0.66));
    border-color: rgba(34, 211, 238, 0.50);
    box-shadow:
      0 0 0 6px rgba(34, 211, 238, 0.06),
      0 24px 60px rgba(8, 145, 178, 0.22);
  }

  .column--assumed {
    animation-delay: 0.7s;
  }

  .col-head {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 18px;
    align-items: center;
  }

  .col-head .ic {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.38);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .col-head .ic i {
    font-size: 34px;
    color: var(--cyan-400);
  }

  .col-head h2 {
    font-size: 38px;
    font-weight: 800;
    letter-spacing: -0.3px;
    color: #f0f4f8;
    margin: 0;
    line-height: 1.1;
  }

  .item-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .item-list li {
    display: grid;
    grid-template-columns: 36px 1fr;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    background: rgba(17, 24, 39, 0.5);
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 12px;
  }

  .item-list li i {
    font-size: 22px;
    color: var(--cyan-400);
    justify-self: center;
  }

  .item-list li span {
    font-size: 28px;
    font-weight: 600;
    color: #e2e8f0;
    line-height: 1.25;
  }

  .examples {
    width: 100%;
    max-width: 1440px;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 28px;
    align-items: center;
    padding: 22px 30px;
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.18), rgba(14, 116, 144, 0.08));
    border: 1px solid rgba(34, 211, 238, 0.40);
    border-radius: 16px;
    box-shadow: 0 18px 48px rgba(8, 145, 178, 0.18);
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.0s forwards;
  }

  .examples-label {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--cyan-400);
  }

  .examples-label i {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.40);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
  }

  .examples-label span {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .example-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: flex-end;
  }

  .example-chips li {
    padding: 12px 22px;
    border-radius: 999px;
    background: rgba(2, 6, 23, 0.55);
    border: 1px solid rgba(34, 211, 238, 0.45);
    color: #ecfeff;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.2px;
  }
</style>
