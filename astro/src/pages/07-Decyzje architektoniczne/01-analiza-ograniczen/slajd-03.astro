---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 03 - Czym jest ograniczenie?"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.80), rgba(10,14,23,0.90))"
>
  <div class="content">
    <h1 class="title">
      <span class="title-main">Czym jest</span>
      <span class="title-sub"><span class="highlight">ograniczenie?</span></span>
    </h1>
    <p class="definition">
      Ograniczenie = warunek, którego decyzja musi przestrzegać
    </p>

    <section class="examples" aria-label="Przykłady ograniczeń">
      <h2 class="examples-title">Przykłady</h2>
      <ul class="examples-list">
        <li>Dane w konkretnym regionie</li>
        <li>Regulacje prawne</li>
        <li>3 miesiące na MVP</li>
      </ul>
    </section>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: center;
  }

  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .title {
    font-size: 88px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 30px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .title-main,
  .title-sub {
    display: block;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .opening {
    max-width: 1200px;
    font-size: 34px;
    line-height: 1.35;
    color: rgba(240, 244, 248, 0.84);
    margin: 0 0 30px;
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.45s forwards;
  }

  .definition {
    width: min(1120px, 100%);
    padding: 24px 28px;
    margin-bottom: 36px;
    border-radius: 16px;
    border: 1px solid rgba(34, 211, 238, 0.46);
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.24), rgba(17, 24, 39, 0.78));
    font-size: 38px;
    font-weight: 700;
    color: #e2f6ff;
    letter-spacing: -0.4px;
    line-height: 1.22;
    box-shadow: 0 22px 45px rgba(8, 145, 178, 0.28);
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.64s forwards;
  }

  .divider {
    max-width: 760px;
    width: 100%;
    margin-bottom: 26px;
    position: relative;
    overflow: hidden;
    color: var(--cyan-300);
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 4px;
    font-size: 16px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.8s forwards;
  }

  .divider::before,
  .divider::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 280px;
    height: 1px;
    background: rgba(34, 211, 238, 0.34);
  }

  .divider::before {
    left: 0;
    transform: translateX(-100%);
  }

  .divider::after {
    right: 0;
    transform: translateX(100%);
  }

  .distinctions {
    width: min(1140px, 100%);
    display: grid;
    grid-template-columns: repeat(3, minmax(220px, 1fr));
    gap: 20px;
    margin-bottom: 36px;
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.95s forwards;
  }

  .dist-card {
    min-height: 106px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 14px;
    border-radius: 14px;
    background: rgba(17, 24, 39, 0.62);
    border: 1px solid rgba(148, 163, 184, 0.24);
    backdrop-filter: blur(6px);
  }

  .dist-label {
    margin: 0;
    color: #e2f6ff;
    font-size: 33px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.2px;
  }

  .examples {
    width: min(1100px, 100%);
    border-radius: 18px;
    padding: 24px 26px;
    border: 1px solid rgba(34, 211, 238, 0.28);
    background: rgba(8, 145, 178, 0.08);
    backdrop-filter: blur(4px);
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.1s forwards;
  }

  .examples-title {
    margin: 0 0 18px;
    font-size: 28px;
    letter-spacing: -0.2px;
    font-weight: 800;
    color: #f0f4f8;
  }

  .examples-list {
    margin: 0 0 26px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    list-style: none;
  }

  .examples-list li {
    padding: 14px 16px;
    border-radius: 12px;
    background: rgba(17, 24, 39, 0.72);
    border: 1px solid rgba(148, 163, 184, 0.22);
    font-size: 30px;
    font-weight: 500;
    color: #dbeafe;
    line-height: 1.3;
    text-align: center;
  }

  .verify-highlight {
    display: inline-flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
    justify-content: center;
    padding: 18px 20px;
    border-radius: 12px;
    border: 1px solid rgba(251, 191, 36, 0.42);
    background: linear-gradient(135deg, rgba(180, 83, 9, 0.2), rgba(217, 119, 6, 0.08));
    max-width: 480px;
    margin: 0 auto;
  }

  .verify-label {
    margin: 0;
    color: #fed7aa;
    text-transform: uppercase;
    font-size: 13px;
    letter-spacing: 2px;
    font-weight: 600;
  }

  .verify-text {
    margin: 0;
    color: #ffedd5;
    font-size: 32px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.2px;
  }

  @media (max-width: 1100px) {
    .title {
      font-size: 64px;
    }

    .opening {
      font-size: 28px;
    }

    .definition {
      font-size: 30px;
      padding: 20px 20px;
    }

    .dist-label {
      font-size: 28px;
    }

    .distinctions,
    .examples-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .content {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }

    .title {
      font-size: 48px;
    }

    .opening {
      font-size: 22px;
    }

    .definition {
      font-size: 25px;
    }

    .verify-text {
      font-size: 27px;
    }
  }
</style>
