---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slajd 01 - Analiza ograniczeń"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.88))"
>
  <div class="content">
    <h1 class="title">
      <span class="title-main">Analiza</span>
      <span class="title-sub"><span class="highlight">ograniczeń</span></span>
    </h1>

    <section class="constraint-map" aria-label="Decyzja architektoniczna w obrębie ograniczeń">
      <div class="frame">
        <div class="frame-ring"></div>
        <div class="frame-core">
          <p>Decyzja</p>
          <strong>architektoniczna</strong>
        </div>

        <div class="constraint-tag top">biznes</div>
        <div class="constraint-tag left-top">technologia</div>
        <div class="constraint-tag right-top">zespół</div>
        <div class="constraint-tag left-mid">prawo</div>
        <div class="constraint-tag right-mid">czas</div>
        <div class="constraint-tag bottom">budżet</div>
      </div>
    </section>
  </div>
</SlideLayout>

<style is:global>
  .content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1640px;
    padding: 64px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .title {
    font-size: 88px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.2s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .title-main,
  .title-sub {
    display: block;
  }

  .constraint-map {
    width: 100%;
    max-width: 1180px;
    margin-top: 56px;
    display: flex;
    justify-content: center;
    opacity: 0;
    animation: fadeIn 1.1s ease-out 0.6s forwards;
  }

  .frame {
    position: relative;
    width: 760px;
    height: 430px;
  }

  .frame::before {
    content: '';
    position: absolute;
    inset: 22px;
    border: 2px solid rgba(34, 211, 238, 0.42);
    border-radius: 24px;
    background: linear-gradient(145deg, rgba(14, 116, 144, 0.18), rgba(8, 145, 178, 0.02));
    box-shadow:
      0 0 0 2px rgba(34, 211, 238, 0.12),
      inset 0 0 60px rgba(3, 7, 18, 0.45),
      0 24px 80px rgba(8, 145, 178, 0.24);
  }

  .frame-ring {
    position: absolute;
    inset: 110px;
    border: 2px dashed rgba(34, 211, 238, 0.24);
    border-radius: 18px;
    opacity: 0.7;
  }

  .frame-core {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    min-width: 270px;
    padding: 18px 24px;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.66), rgba(14, 116, 144, 0.56));
    border: 2px solid var(--cyan-400);
    box-shadow: 0 16px 40px rgba(8, 145, 178, 0.35);
  }

  .frame-core p {
    font-size: 22px;
    color: rgba(240, 244, 248, 0.8);
    font-weight: 400;
    margin-bottom: 4px;
  }

  .frame-core strong {
    font-size: 38px;
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.3px;
    color: #f8fafc;
  }

  .constraint-tag {
    position: absolute;
    padding: 12px 18px;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.18);
    border: 1px solid rgba(34, 211, 238, 0.5);
    color: #f8fafc;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: 0.2px;
    backdrop-filter: blur(6px);
    text-transform: lowercase;
  }

  .constraint-tag::before {
    content: '';
    position: absolute;
    width: 46px;
    height: 1px;
    background: rgba(34, 211, 238, 0.55);
    top: 50%;
    pointer-events: none;
  }

  .top {
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
  }

  .left-top {
    left: 0;
    top: 102px;
    transform: translate(-52%, 0);
  }

  .right-top {
    right: 0;
    top: 102px;
    transform: translate(52%, 0);
  }

  .left-mid {
    left: 2px;
    top: 50%;
    transform: translate(-58%, -50%);
  }

  .right-mid {
    right: 2px;
    top: 50%;
    transform: translate(58%, -50%);
  }

  .bottom {
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
  }

  .top::before {
    left: 50%;
    transform: translateX(-50%);
    top: 100%;
    width: 76px;
  }

  .left-top::before {
    right: 100%;
    top: 50%;
    transform: translateY(-50%);
  }

  .right-top::before {
    left: 100%;
    top: 50%;
    transform: translateY(-50%);
  }

  .left-mid::before {
    right: 100%;
    top: 50%;
    transform: translateY(-50%);
  }

  .right-mid::before {
    left: 100%;
    top: 50%;
    transform: translateY(-50%);
  }

  .bottom::before {
    left: 50%;
    transform: translateX(-50%);
    top: 0;
    width: 76px;
  }
</style>
