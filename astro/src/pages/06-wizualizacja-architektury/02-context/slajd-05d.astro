---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 05d - Internet Banking System — pełny diagram"
  bgImage="/images/background-2.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-world-search"></i> Context · Level 1</span>
      <h1 class="title">
         <span class="highlight">Relacje</span>
      </h1>
    </div>

    <div class="diagram" aria-hidden="true">
      <svg viewBox="0 0 1500 680" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="sys-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#1d4ed8"/>
            <stop offset="100%" stop-color="#1e3a8a"/>
          </linearGradient>
          <linearGradient id="actor-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#0e7490"/>
            <stop offset="100%" stop-color="#155e75"/>
          </linearGradient>
          <linearGradient id="ext-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#475569"/>
            <stop offset="100%" stop-color="#334155"/>
          </linearGradient>
          <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(148,163,184,0.06)" stroke-width="1"/>
          </pattern>
          <marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="#22d3ee"/>
          </marker>
          <marker id="ah-soft" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="#94a3b8"/>
          </marker>
        </defs>

        <rect x="0" y="0" width="1500" height="680" fill="url(#grid)"/>

        <g class="actor">
          <circle cx="170" cy="260" r="44" fill="url(#actor-grad)" stroke="#22d3ee" stroke-width="2.5"/>
          <path d="M 102 430 Q 102 320, 170 320 Q 238 320, 238 430 Z" fill="url(#actor-grad)" stroke="#22d3ee" stroke-width="2.5"/>
          <text x="170" y="478" text-anchor="middle" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="22" font-weight="800">Personal Banking</text>
          <text x="170" y="504" text-anchor="middle" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="22" font-weight="800">Customer</text>
          <text x="170" y="528" text-anchor="middle" fill="#94a3b8" font-family="Inter, sans-serif" font-size="14" font-weight="500" letter-spacing="3">[ AKTOR · ROLA ]</text>
        </g>

        <g class="arrow rel-customer">
          <path d="M 244 340 L 502 340" stroke="#22d3ee" stroke-width="3" fill="none" marker-end="url(#ah)"/>
          <rect x="250" y="298" width="248" height="32" rx="16" fill="rgba(10,14,23,0.92)" stroke="rgba(34,211,238,0.55)" stroke-width="1.5"/>
          <text x="374" y="320" text-anchor="middle" fill="#dbeafe" font-family="Inter, sans-serif" font-size="14" font-weight="600">sprawdza saldo i robi przelewy w</text>
        </g>

        <g class="system">
          <rect x="510" y="220" width="480" height="240" rx="18" fill="url(#sys-grad)" stroke="#3b82f6" stroke-width="3"/>
          <text x="750" y="290" text-anchor="middle" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="34" font-weight="800">Internet Banking System</text>
          <text x="750" y="320" text-anchor="middle" fill="#bfdbfe" font-family="Inter, sans-serif" font-size="15" font-weight="500" letter-spacing="3">[ SYSTEM ]</text>

          <line x1="600" y1="345" x2="900" y2="345" stroke="rgba(191,219,254,0.25)" stroke-width="1"/>

          <foreignObject x="540" y="360" width="420" height="100">
            <div xmlns="http://www.w3.org/1999/xhtml" style="font-family: Inter, sans-serif; font-size: 18px; font-weight: 300; line-height: 1.4; color: #dbeafe; text-align: center;">
              Pozwala klientom banku sprawdzać saldo,
              wykonywać przelewy i zarządzać podstawowymi
              usługami bankowymi online.
            </div>
          </foreignObject>
        </g>

        <g class="ext ext-top">
          <rect x="1170" y="120" width="280" height="150" rx="14" fill="url(#ext-grad)" stroke="#94a3b8" stroke-width="2.5"/>
          <text x="1310" y="178" text-anchor="middle" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="24" font-weight="800">E-mail System</text>
          <text x="1310" y="206" text-anchor="middle" fill="#cbd5e1" font-family="Inter, sans-serif" font-size="14" font-weight="500" letter-spacing="3">[ SYSTEM ZEWNĘTRZNY ]</text>
          <text x="1310" y="240" text-anchor="middle" fill="#cbd5e1" font-family="Inter, sans-serif" font-size="14" font-weight="300" font-style="italic">np. Microsoft Exchange</text>
        </g>

        <g class="ext ext-bottom">
          <rect x="1170" y="410" width="280" height="150" rx="14" fill="url(#ext-grad)" stroke="#94a3b8" stroke-width="2.5"/>
          <text x="1310" y="464" text-anchor="middle" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="22" font-weight="800">Mainframe Banking</text>
          <text x="1310" y="492" text-anchor="middle" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="22" font-weight="800">System</text>
          <text x="1310" y="518" text-anchor="middle" fill="#cbd5e1" font-family="Inter, sans-serif" font-size="14" font-weight="500" letter-spacing="3">[ SYSTEM ZEWNĘTRZNY ]</text>
        </g>

        <g class="arrow rel-email">
          <path d="M 998 260 L 1166 220" stroke="#22d3ee" stroke-width="3" fill="none" marker-end="url(#ah)"/>
          <rect x="983" y="184" width="210" height="32" rx="16" fill="rgba(10,14,23,0.92)" stroke="rgba(34,211,238,0.55)" stroke-width="1.5"/>
          <text x="1089" y="206" text-anchor="middle" fill="#dbeafe" font-family="Inter, sans-serif" font-size="14" font-weight="600">wysyła powiadomienia przez</text>
        </g>

        <g class="arrow rel-mainframe">
          <path d="M 998 420 L 1166 460" stroke="#22d3ee" stroke-width="3" fill="none" marker-end="url(#ah)"/>
          <rect x="996" y="464" width="188" height="32" rx="16" fill="rgba(10,14,23,0.92)" stroke="rgba(34,211,238,0.55)" stroke-width="1.5"/>
          <text x="1090" y="486" text-anchor="middle" fill="#dbeafe" font-family="Inter, sans-serif" font-size="14" font-weight="600">pobiera dane konta z</text>
        </g>

        <g class="arrow rel-email-customer">
          <path d="M 1170 195 Q 700 70, 200 200" stroke="#94a3b8" stroke-width="2.5" stroke-dasharray="6 6" fill="none" marker-end="url(#ah-soft)"/>
          <rect x="612" y="58" width="200" height="30" rx="15" fill="rgba(10,14,23,0.92)" stroke="rgba(148,163,184,0.5)" stroke-width="1.5"/>
          <text x="712" y="79" text-anchor="middle" fill="#cbd5e1" font-family="Inter, sans-serif" font-size="14" font-weight="500">wysyła e-maile do</text>
        </g>
      </svg>
    </div>

    <div class="progress" aria-hidden="true">
      <span class="dot dot-done">System</span>
      <span class="dash dash-done"></span>
      <span class="dot dot-done">Aktor</span>
      <span class="dash dash-done"></span>
      <span class="dot dot-done">Systemy zewnętrzne</span>
      <span class="dash dash-done"></span>
      <span class="dot dot-active">Relacje</span>
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1700px;
    padding: 48px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 24px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 72px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 10px;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lede {
    font-size: 20px;
    font-weight: 300;
    color: #cbd5e1;
    margin: 0;
  }

  .lede strong {
    font-weight: 700;
    color: #f1f5f9;
  }

  .diagram {
    width: 100%;
    background: rgba(17, 24, 39, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 22px;
    padding: 12px;
    margin-bottom: 22px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.9s ease-out 0.4s forwards;
  }

  .diagram svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram .actor,
  .diagram .system,
  .diagram .ext,
  .diagram .rel-customer {
    opacity: 1;
  }

  .diagram .arrow.rel-email,
  .diagram .arrow.rel-mainframe,
  .diagram .arrow.rel-email-customer {
    opacity: 0;
    transform: scale(0.96);
    transform-origin: center;
    animation: popIn 0.6s ease-out forwards;
  }

  .diagram .rel-email { animation-delay: 0.85s; }
  .diagram .rel-mainframe { animation-delay: 1.1s; }
  .diagram .rel-email-customer { animation-delay: 1.35s; }

  @keyframes popIn {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .progress {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 26px;
    background: rgba(17, 24, 39, 0.5);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 999px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 1.7s forwards;
  }

  .dot {
    font-size: 14px;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 2px;
    padding: 4px 12px;
    border-radius: 999px;
  }

  .dot-active {
    color: var(--cyan-400);
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.35);
  }

  .dot-done {
    color: #94a3b8;
    background: rgba(148, 163, 184, 0.08);
    border: 1px solid rgba(148, 163, 184, 0.25);
  }

  .dash {
    width: 22px;
    height: 2px;
    background: rgba(148, 163, 184, 0.3);
    border-radius: 999px;
  }

  .dash-done {
    background: rgba(34, 211, 238, 0.4);
  }
</style>
