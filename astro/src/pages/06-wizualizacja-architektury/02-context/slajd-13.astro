---
import SlideLayout from '../../../layouts/SlideLayout.astro';

const perspectives = [
  {
    key: 'dev',
    name: 'Deweloper',
    icon: 'ti-code',
    color: '#38bdf8',
    scope: 'Frontend, backend, baza danych.',
  },
  {
    key: 'ops',
    name: 'DevOps / platforma',
    icon: 'ti-server-cog',
    color: '#a78bfa',
    scope: '+ batch, cache, kolejki.',
  },
  {
    key: 'biz',
    name: 'Osoba biznesowa',
    icon: 'ti-briefcase',
    color: '#fbbf24',
    scope: 'Cała usługa kliencka łącznie z elementami innych zespołów.',
  },
  {
    key: 'arch',
    name: 'Architekt',
    icon: 'ti-sitemap',
    color: '#f472b6',
    scope: 'Warstwa platformowa bez UI, ale z integracjami.',
  },
];
---
<SlideLayout
  title="Slide 13 - Jedno pytanie, różne odpowiedzi"
  bgImage="/images/background-2.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.82), rgba(10,14,23,0.92))"
>
  <div class="content">
    <div class="header">
      <h1 class="title">
        Gdzie postawić <span class="highlight">granicę?</span>
      </h1>
    </div>

    <div class="board">
      <div class="diagram" aria-hidden="true">
        <svg viewBox="0 0 1200 620" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="grid-13" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(148,163,184,0.05)" stroke-width="1"/>
            </pattern>
          </defs>

          <rect x="0" y="0" width="1200" height="620" fill="url(#grid-13)"/>

          <g class="components">
            <g class="cmp">
              <rect x="190" y="70" width="170" height="70" rx="10"/>
              <text x="275" y="105" text-anchor="middle">Mobile App</text>
              <text x="275" y="124" text-anchor="middle" class="cmp-sub">[ klient ]</text>
            </g>
            <g class="cmp">
              <rect x="400" y="70" width="170" height="70" rx="10"/>
              <text x="485" y="105" text-anchor="middle">Frontend Web</text>
              <text x="485" y="124" text-anchor="middle" class="cmp-sub">[ klient ]</text>
            </g>

            <g class="cmp">
              <rect x="60" y="230" width="160" height="70" rx="10"/>
              <text x="140" y="265" text-anchor="middle">Batch Jobs</text>
              <text x="140" y="284" text-anchor="middle" class="cmp-sub">[ procesy ]</text>
            </g>
            <g class="cmp">
              <rect x="260" y="230" width="280" height="70" rx="10"/>
              <text x="400" y="265" text-anchor="middle">Backend API</text>
              <text x="400" y="284" text-anchor="middle" class="cmp-sub">[ usługa ]</text>
            </g>
            <g class="cmp">
              <rect x="580" y="230" width="180" height="70" rx="10"/>
              <text x="670" y="265" text-anchor="middle">Cache / Kolejka</text>
              <text x="670" y="284" text-anchor="middle" class="cmp-sub">[ platforma ]</text>
            </g>

            <g class="cmp">
              <rect x="260" y="390" width="280" height="70" rx="10"/>
              <text x="400" y="425" text-anchor="middle">Baza danych</text>
              <text x="400" y="444" text-anchor="middle" class="cmp-sub">[ stan ]</text>
            </g>

            <g class="cmp cmp-ext">
              <rect x="820" y="120" width="220" height="70" rx="10"/>
              <text x="930" y="155" text-anchor="middle">Notyfikacje</text>
              <text x="930" y="174" text-anchor="middle" class="cmp-sub">[ inny zespół ]</text>
            </g>
            <g class="cmp cmp-ext">
              <rect x="820" y="280" width="220" height="70" rx="10"/>
              <text x="930" y="315" text-anchor="middle">Płatności</text>
              <text x="930" y="334" text-anchor="middle" class="cmp-sub">[ inny zespół ]</text>
            </g>
            <g class="cmp cmp-ext">
              <rect x="820" y="440" width="220" height="70" rx="10"/>
              <text x="930" y="475" text-anchor="middle">Analityka</text>
              <text x="930" y="494" text-anchor="middle" class="cmp-sub">[ inny zespół ]</text>
            </g>
          </g>

          <g class="boundaries" fill="none" stroke-width="3" stroke-linejoin="round">
            <rect class="b b-dev" x="172" y="52" width="408" height="430" rx="26"
                  stroke="#38bdf8"/>
            <text class="b-label b-label-dev" x="186" y="42" fill="#38bdf8">DEWELOPER</text>

            <rect class="b b-ops" x="42" y="32" width="740" height="470" rx="34"
                  stroke="#a78bfa" stroke-dasharray="10 6"/>
            <text class="b-label b-label-ops" x="56" y="22" fill="#a78bfa">DEVOPS · PLATFORMA</text>

            <rect class="b b-biz" x="172" y="12" width="888" height="510" rx="44"
                  stroke="#fbbf24" stroke-dasharray="2 8"/>
            <text class="b-label b-label-biz" x="900" y="2" fill="#fbbf24">BIZNES</text>

            <rect class="b b-arch" x="244" y="212" width="816" height="156" rx="34"
                  stroke="#f472b6" stroke-dasharray="14 4 2 4"/>
            <text class="b-label b-label-arch" x="900" y="202" fill="#f472b6">ARCHITEKT</text>
          </g>
        </svg>
      </div>

      <aside class="roles">
        <h3 class="roles-title">Cztery różne granice</h3>
        <ul>
          {perspectives.map((p) => (
            <li class={`role role-${p.key}`} style={`--role-color: ${p.color};`}>
              <span class="role-icon"><i class={`ti ${p.icon}`}></i></span>
              <div>
                <strong>{p.name}</strong>
                <span>{p.scope}</span>
              </div>
            </li>
          ))}
        </ul>
      </aside>
    </div>
    
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1740px;
    padding: 36px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 28px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 72px;
    font-size: 72px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 10px;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lede {
    font-size: 20px;
    font-weight: 300;
    color: #cbd5e1;
    margin: 0;
  }

  .lede strong {
    font-weight: 700;
    color: #f1f5f9;
  }

  .board {
    display: grid;
    grid-template-columns: 1.45fr 0.55fr;
    gap: 32px;
    width: 100%;
    align-items: stretch;
    margin-bottom: 22px;
  }

  .diagram {
    background: rgba(17, 24, 39, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 22px;
    padding: 30px 18px 18px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.9s ease-out 0.35s forwards;
  }

  .diagram svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .cmp rect {
    fill: rgba(30, 41, 59, 0.85);
    stroke: rgba(148, 163, 184, 0.35);
    stroke-width: 1.5;
  }

  .cmp-ext rect {
    fill: rgba(51, 65, 85, 0.55);
    stroke: rgba(148, 163, 184, 0.28);
    stroke-dasharray: 4 4;
  }

  .cmp text {
    fill: #f1f5f9;
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 700;
    pointer-events: none;
  }

  .cmp .cmp-sub {
    fill: #94a3b8;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
  }

  .b {
    opacity: 0;
    animation: drawIn 0.7s ease-out forwards;
  }

  .b-dev { animation-delay: 0.7s; }
  .b-ops { animation-delay: 1.0s; }
  .b-biz { animation-delay: 1.3s; }
  .b-arch { animation-delay: 1.6s; }

  @keyframes drawIn {
    from { opacity: 0; transform: scale(0.985); transform-origin: center; }
    to { opacity: 1; transform: scale(1); }
  }

  .b-label {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 4px;
    paint-order: stroke;
    stroke: rgba(10, 14, 23, 0.95);
    stroke-width: 4px;
    stroke-linejoin: round;
    opacity: 0;
  }

  .b-label-dev { animation: fadeOnly 0.5s ease-out 1.1s forwards; }
  .b-label-ops { animation: fadeOnly 0.5s ease-out 1.4s forwards; }
  .b-label-biz { animation: fadeOnly 0.5s ease-out 1.7s forwards; }
  .b-label-arch { animation: fadeOnly 0.5s ease-out 2.0s forwards; }

  @keyframes fadeOnly {
    to { opacity: 1; }
  }

  .roles {
    background: rgba(17, 24, 39, 0.6);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 22px;
    padding: 24px 26px;
    text-align: left;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.9s ease-out 0.55s forwards;
  }

  .roles-title {
    margin: 0 0 18px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--cyan-400);
  }

  .roles ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .role {
    display: grid;
    grid-template-columns: 46px 1fr;
    align-items: start;
    gap: 14px;
    padding: 10px 12px;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--role-color) 35%, transparent);
    background: color-mix(in srgb, var(--role-color) 8%, rgba(17, 24, 39, 0.4));
  }

  .role-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--role-color) 16%, rgba(10, 14, 23, 0.4));
    border: 1.5px solid color-mix(in srgb, var(--role-color) 60%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--role-color);
    flex-shrink: 0;
  }

  .role-icon i { font-size: 22px; }

  .role > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .role strong {
    font-size: 16px;
    font-weight: 700;
    color: #f1f5f9;
  }

  .role span {
    font-size: 13px;
    font-weight: 300;
    color: #cbd5e1;
    line-height: 1.4;
  }

  .footnote {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 26px;
    background: rgba(17, 24, 39, 0.6);
    border: 1px solid rgba(34, 211, 238, 0.3);
    border-radius: 999px;
    font-size: 17px;
    font-weight: 400;
    color: #cbd5e1;
    margin: 0;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 2.2s forwards;
  }

  .footnote strong {
    color: #f1f5f9;
    font-weight: 700;
  }

  .footnote i {
    font-size: 22px;
    color: var(--cyan-400);
  }
</style>
