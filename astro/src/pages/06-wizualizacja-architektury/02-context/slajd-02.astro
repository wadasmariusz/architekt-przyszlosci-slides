---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 02 - Metafora: C4 jak Google Maps"
  bgImage="/images/background-2.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-map-2"></i> Metafora</span>
      <h1 class="title">
        C4 jak <span class="highlight">Google Maps</span>
      </h1>
      <p class="lede">Zoom z orbity do pojedynczego budynku.</p>
    </div>

    <div class="board">
      <div class="col col-left">
        <span class="col-label"><i class="ti ti-zoom-in-area"></i> Mapa</span>

        <div class="row row-1">
          <div class="row-icon"><i class="ti ti-world"></i></div>
          <div class="row-body">
            <h3>Kraj</h3>
            <p>widok z satelity</p>
          </div>
        </div>

        <div class="row row-2">
          <div class="row-icon"><i class="ti ti-building-skyscraper"></i></div>
          <div class="row-body">
            <h3>Miasto</h3>
            <p>dzielnice, główne arterie</p>
          </div>
        </div>

        <div class="row row-3">
          <div class="row-icon"><i class="ti ti-map-pin"></i></div>
          <div class="row-body">
            <h3>Ulica</h3>
            <p>konkretne miejsca</p>
          </div>
        </div>

        <div class="row row-4">
          <div class="row-icon"><i class="ti ti-home"></i></div>
          <div class="row-body">
            <h3>Budynek</h3>
            <p>plan pomieszczeń</p>
          </div>
        </div>
      </div>

      <svg class="connectors" viewBox="0 0 220 720" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <marker id="cap-c" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="#22d3ee"/>
          </marker>
          <marker id="cap-g" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="#94a3b8"/>
          </marker>
        </defs>
        <path class="link link-active" d="M 0 90 C 110 90, 110 90, 220 90" stroke="#22d3ee" marker-end="url(#cap-c)" />
        <path class="link" d="M 0 270 C 110 270, 110 270, 220 270" stroke="#94a3b8" marker-end="url(#cap-g)" stroke-dasharray="6 6" />
        <path class="link" d="M 0 450 C 110 450, 110 450, 220 450" stroke="#94a3b8" marker-end="url(#cap-g)" stroke-dasharray="6 6" />
        <path class="link" d="M 0 630 C 110 630, 110 630, 220 630" stroke="#94a3b8" marker-end="url(#cap-g)" stroke-dasharray="6 6" />
      </svg>

      <div class="col col-right">
        <span class="col-label col-label-c4"><i class="ti ti-stack-2"></i> Model C4</span>

        <div class="row row-1 active">
          <div class="row-index">L1</div>
          <div class="row-body">
            <h3>Context</h3>
            <p>system w otoczeniu świata</p>
          </div>
          <span class="active-tag">ta lekcja</span>
        </div>

        <div class="row row-2">
          <div class="row-index">L2</div>
          <div class="row-body">
            <h3>Containers</h3>
            <p>główne części systemu</p>
          </div>
        </div>

        <div class="row row-3">
          <div class="row-index">L3</div>
          <div class="row-body">
            <h3>Components</h3>
            <p>wnętrze kontenera</p>
          </div>
        </div>

        <div class="row row-4">
          <div class="row-index">L4</div>
          <div class="row-body">
            <h3>Code</h3>
            <p>implementacja</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1640px;
    padding: 64px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 40px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 76px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 14px;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lede {
    font-size: 22px;
    font-weight: 300;
    color: #cbd5e1;
    margin: 0;
  }

  .board {
    display: grid;
    grid-template-columns: 1fr 220px 1fr;
    gap: 0;
    width: 100%;
    align-items: stretch;
    position: relative;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .col-label {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.1);
    border: 1px solid rgba(148, 163, 184, 0.3);
    color: #94a3b8;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 6px;
  }

  .col-label-c4 {
    background: rgba(34, 211, 238, 0.1);
    border-color: rgba(34, 211, 238, 0.3);
    color: var(--cyan-400);
  }

  .col-label i { font-size: 14px; }

  .row {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    align-items: center;
    gap: 18px;
    padding: 18px 22px;
    background: rgba(17, 24, 39, 0.5);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 16px;
    text-align: left;
    height: 140px;
    box-sizing: border-box;
    opacity: 0;
    transform: translateY(16px);
    animation: fadeUp 0.7s ease-out forwards;
    position: relative;
  }

  .col-left .row { animation-delay: 0.45s; }
  .col-left .row.row-2 { animation-delay: 0.6s; }
  .col-left .row.row-3 { animation-delay: 0.75s; }
  .col-left .row.row-4 { animation-delay: 0.9s; }

  .col-right .row { animation-delay: 0.55s; }
  .col-right .row.row-2 { animation-delay: 0.7s; }
  .col-right .row.row-3 { animation-delay: 0.85s; }
  .col-right .row.row-4 { animation-delay: 1s; }

  .row.active {
    background: rgba(17, 24, 39, 0.78);
    border-color: rgba(34, 211, 238, 0.5);
    box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.18), 0 10px 30px rgba(8, 145, 178, 0.18);
  }

  .row-icon {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    background: rgba(148, 163, 184, 0.08);
    border: 1px solid rgba(148, 163, 184, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .row-icon i {
    font-size: 32px;
    color: #cbd5e1;
  }

  .col-left .row.row-1 .row-icon {
    background: rgba(34, 211, 238, 0.12);
    border-color: rgba(34, 211, 238, 0.4);
  }
  .col-left .row.row-1 .row-icon i {
    color: var(--cyan-400);
  }

  .row-index {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    background: rgba(148, 163, 184, 0.08);
    border: 1px solid rgba(148, 163, 184, 0.25);
    color: #94a3b8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .row.active .row-index {
    background: rgba(34, 211, 238, 0.15);
    border-color: rgba(34, 211, 238, 0.45);
    color: var(--cyan-400);
  }

  .row-body h3 {
    margin: 0 0 4px;
    font-size: 24px;
    font-weight: 700;
    color: #e2e8f0;
    letter-spacing: -0.3px;
  }

  .row.active .row-body h3 {
    color: #f1f5f9;
  }

  .row-body p {
    margin: 0;
    font-size: 16px;
    font-weight: 300;
    line-height: 1.35;
    color: #94a3b8;
  }

  .row.active .row-body p {
    color: #cbd5e1;
  }

  .active-tag {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--cyan-400);
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.35);
    padding: 5px 10px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .connectors {
    width: 100%;
    height: 100%;
    align-self: stretch;
    margin-top: 36px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.1s forwards;
  }

  .connectors .link {
    fill: none;
    stroke-width: 2.2;
    opacity: 0.7;
  }

  .connectors .link-active {
    stroke-width: 3;
    opacity: 1;
  }
</style>
