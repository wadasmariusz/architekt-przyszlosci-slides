---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 04 - Anatomia diagramu kontekstowego"
  bgImage="/images/background-2.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-world-search"></i> Context · Level 1</span>
      <h1 class="title">
        <span class="highlight">Anatomia</span> diagramu
      </h1>
    </div>

    <div class="board">
      <div class="diagram" aria-hidden="true">
        <svg viewBox="0 0 1180 620" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M 0 0 L 10 5 L 0 10 z" fill="#cbd5e1"/>
            </marker>
            <linearGradient id="sys-grad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#1d4ed8"/>
              <stop offset="100%" stop-color="#1e40af"/>
            </linearGradient>
            <linearGradient id="actor-grad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#0e7490"/>
              <stop offset="100%" stop-color="#155e75"/>
            </linearGradient>
          </defs>

          <g class="rels" font-family="Inter, sans-serif" font-size="18" font-weight="800" fill="#f8fafc">
            <path d="M 240 175 C 360 200, 420 240, 470 280" stroke="#cbd5e1" stroke-width="2" fill="none" marker-end="url(#ah)"/>
            <g class="rel-label">
              <rect x="242" y="146" width="156" height="34" rx="17"/>
              <text x="320" y="169" text-anchor="middle">używa systemu</text>
            </g>

            <path d="M 240 445 C 360 425, 420 380, 470 340" stroke="#cbd5e1" stroke-width="2" fill="none" marker-end="url(#ah)"/>
            <g class="rel-label">
              <rect x="265" y="394" width="110" height="34" rx="17"/>
              <text x="320" y="417" text-anchor="middle">zarządza</text>
            </g>

            <path d="M 710 280 C 800 240, 860 200, 940 175" stroke="#cbd5e1" stroke-width="2" fill="none" marker-end="url(#ah)"/>
            <g class="rel-label">
              <rect x="755" y="146" width="140" height="34" rx="17"/>
              <text x="825" y="169" text-anchor="middle">pobiera dane</text>
            </g>

            <path d="M 710 340 C 800 380, 860 425, 940 450" stroke="#cbd5e1" stroke-width="2" fill="none" marker-end="url(#ah)"/>
            <g class="rel-label">
              <rect x="746" y="380" width="218" height="34" rx="17"/>
              <text x="855" y="403" text-anchor="middle">wysyła powiadomienia</text>
            </g>
          </g>

          <g class="actor">
            <circle cx="150" cy="120" r="28" fill="url(#actor-grad)" stroke="#22d3ee" stroke-width="2"/>
            <path d="M 122 200 Q 122 160, 150 160 Q 178 160, 178 200 Z" fill="url(#actor-grad)" stroke="#22d3ee" stroke-width="2"/>
            <text x="150" y="232" text-anchor="middle" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="20" font-weight="700">Aktor</text>
            <text x="150" y="256" text-anchor="middle" fill="#94a3b8" font-family="Inter, sans-serif" font-size="14" font-weight="400">[rola]</text>
          </g>

          <g class="actor">
            <circle cx="150" cy="380" r="28" fill="url(#actor-grad)" stroke="#22d3ee" stroke-width="2"/>
            <path d="M 122 460 Q 122 420, 150 420 Q 178 420, 178 460 Z" fill="url(#actor-grad)" stroke="#22d3ee" stroke-width="2"/>
            <text x="150" y="492" text-anchor="middle" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="20" font-weight="700">Aktor</text>
            <text x="150" y="516" text-anchor="middle" fill="#94a3b8" font-family="Inter, sans-serif" font-size="14" font-weight="400">[rola]</text>
          </g>

          <g class="system">
            <rect x="470" y="240" width="240" height="140" rx="14" fill="url(#sys-grad)" stroke="#3b82f6" stroke-width="2.5"/>
            <text x="590" y="290" text-anchor="middle" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="24" font-weight="800">Nasz system</text>
            <text x="590" y="320" text-anchor="middle" fill="#dbeafe" font-family="Inter, sans-serif" font-size="14" font-weight="400">[czarna skrzynka]</text>
            <text x="590" y="352" text-anchor="middle" fill="#bfdbfe" font-family="Inter, sans-serif" font-size="13" font-weight="300" font-style="italic">krótki opis odpowiedzialności</text>
          </g>

          <g class="ext">
            <rect x="900" y="80" width="200" height="120" rx="10" fill="#475569" stroke="#94a3b8" stroke-width="2" stroke-dasharray="0"/>
            <text x="1000" y="128" text-anchor="middle" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="20" font-weight="700">System</text>
            <text x="1000" y="154" text-anchor="middle" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="20" font-weight="700">zewnętrzny</text>
            <text x="1000" y="180" text-anchor="middle" fill="#cbd5e1" font-family="Inter, sans-serif" font-size="13" font-weight="400">[poza naszą granicą]</text>
          </g>

          <g class="ext">
            <rect x="900" y="420" width="200" height="120" rx="10" fill="#475569" stroke="#94a3b8" stroke-width="2"/>
            <text x="1000" y="468" text-anchor="middle" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="20" font-weight="700">System</text>
            <text x="1000" y="494" text-anchor="middle" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="20" font-weight="700">zewnętrzny</text>
            <text x="1000" y="520" text-anchor="middle" fill="#cbd5e1" font-family="Inter, sans-serif" font-size="13" font-weight="400">[poza naszą granicą]</text>
          </g>
        </svg>
      </div>

      <aside class="legend">
        <h3 class="legend-title">Legenda</h3>
        <ul>
          <li>
            <span class="swatch swatch-actor">
              <i class="ti ti-user"></i>
            </span>
            <div>
              <strong>Aktor / rola</strong>
              <span>użytkownik systemu</span>
            </div>
          </li>
          <li>
            <span class="swatch swatch-system"></span>
            <div>
              <strong>Nasz system</strong>
              <span>to opisujemy</span>
            </div>
          </li>
          <li>
            <span class="swatch swatch-ext"></span>
            <div>
              <strong>System zewnętrzny</strong>
              <span>integrujemy się z ...</span>
            </div>
          </li>
          <li>
            <span class="swatch swatch-rel">
              <svg viewBox="0 0 40 12">
                <path d="M 2 6 L 34 6" stroke="#cbd5e1" stroke-width="2" fill="none" marker-end="url(#leg-ah)"/>
                <defs>
                  <marker id="leg-ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                    <path d="M 0 0 L 10 5 L 0 10 z" fill="#cbd5e1"/>
                  </marker>
                </defs>
              </svg>
            </span>
            <div>
              <strong>Relacja</strong>
              <span>strzałka z opisem intencji biznesowej</span>
            </div>
          </li>
        </ul>
      </aside>
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1700px;
    padding: 56px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 32px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 72px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .board {
    display: grid;
    grid-template-columns: 1.55fr 0.45fr;
    gap: 40px;
    width: 100%;
    align-items: stretch;
  }

  .diagram {
    background: rgba(17, 24, 39, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 22px;
    padding: 24px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.9s ease-out 0.4s forwards;
  }

  .diagram svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .rels .rel-label rect {
    fill: rgba(15, 23, 42, 0.92);
    stroke: rgba(34, 211, 238, 0.58);
    stroke-width: 1.5;
  }

  .rels .rel-label text {
    fill: #f8fafc;
    paint-order: stroke;
    stroke: rgba(15, 23, 42, 0.85);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .legend {
    background: rgba(17, 24, 39, 0.6);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 22px;
    padding: 26px 28px;
    text-align: left;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.9s ease-out 0.6s forwards;
  }

  .legend-title {
    margin: 0 0 22px;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--cyan-400);
  }

  .legend ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .legend li {
    display: grid;
    grid-template-columns: 56px 1fr;
    align-items: center;
    gap: 16px;
  }

  .swatch {
    width: 56px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .swatch-actor {
    background: linear-gradient(180deg, #0e7490, #155e75);
    border: 2px solid #22d3ee;
    border-radius: 14px;
    color: #f1f5f9;
  }

  .swatch-actor i { font-size: 24px; }

  .swatch-system {
    background: linear-gradient(180deg, #1d4ed8, #1e40af);
    border: 2px solid #3b82f6;
    border-radius: 8px;
  }

  .swatch-ext {
    background: #475569;
    border: 2px solid #94a3b8;
    border-radius: 8px;
  }

  .swatch-rel {
    background: transparent;
  }

  .swatch-rel svg {
    width: 100%;
    height: 12px;
  }

  .legend li > div {
    display: flex;
    flex-direction: column;
  }

  .legend strong {
    font-size: 18px;
    font-weight: 700;
    color: #f1f5f9;
    margin-bottom: 2px;
  }

  .legend span {
    font-size: 14px;
    font-weight: 300;
    color: #94a3b8;
    line-height: 1.35;
  }
</style>
