---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 05a - Internet Banking System — system"
  bgImage="/images/background-2.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-world-search"></i> Context · Level 1</span>
      <h1 class="title">
        Nasz <span class="highlight">system w centrum</span>
      </h1>
    </div>

    <div class="diagram" aria-hidden="true">
      <svg viewBox="0 0 1500 680" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="sys-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#1d4ed8"/>
            <stop offset="100%" stop-color="#1e3a8a"/>
          </linearGradient>
          <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(148,163,184,0.06)" stroke-width="1"/>
          </pattern>
        </defs>

        <rect x="0" y="0" width="1500" height="680" fill="url(#grid)"/>

        <g class="ghost" opacity="0.12">
          <ellipse cx="170" cy="340" rx="58" ry="28" fill="none" stroke="#94a3b8" stroke-width="2" stroke-dasharray="6 6"/>
          <rect x="115" y="370" width="110" height="80" rx="40" fill="none" stroke="#94a3b8" stroke-width="2" stroke-dasharray="6 6"/>
          <rect x="1170" y="120" width="240" height="130" rx="10" fill="none" stroke="#94a3b8" stroke-width="2" stroke-dasharray="6 6"/>
          <rect x="1170" y="430" width="240" height="130" rx="10" fill="none" stroke="#94a3b8" stroke-width="2" stroke-dasharray="6 6"/>
        </g>

        <g class="system" filter="">
          <rect x="510" y="220" width="480" height="240" rx="18" fill="url(#sys-grad)" stroke="#3b82f6" stroke-width="3"/>
          <text x="750" y="290" text-anchor="middle" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="34" font-weight="800">Internet Banking System</text>
          <text x="750" y="320" text-anchor="middle" fill="#bfdbfe" font-family="Inter, sans-serif" font-size="15" font-weight="500" letter-spacing="3">[ SYSTEM ]</text>

          <line x1="600" y1="345" x2="900" y2="345" stroke="rgba(191,219,254,0.25)" stroke-width="1"/>

          <foreignObject x="540" y="360" width="420" height="100">
            <div xmlns="http://www.w3.org/1999/xhtml" style="font-family: Inter, sans-serif; font-size: 18px; font-weight: 300; line-height: 1.4; color: #dbeafe; text-align: center;">
              Pozwala klientom banku sprawdzać saldo,
              wykonywać przelewy i zarządzać podstawowymi
              usługami bankowymi online.
            </div>
          </foreignObject>
        </g>

      </svg>
    </div>

    <div class="progress" aria-hidden="true">
      <span class="dot dot-active">System</span>
      <span class="dash"></span>
      <span class="dot">Aktor</span>
      <span class="dash"></span>
      <span class="dot">Systemy zewnętrzne</span>
      <span class="dash"></span>
      <span class="dot">Relacje</span>
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1700px;
    padding: 48px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 24px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 64px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 10px;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lede {
    font-size: 20px;
    font-weight: 300;
    color: #cbd5e1;
    margin: 0;
  }

  .diagram {
    width: 100%;
    background: rgba(17, 24, 39, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 22px;
    padding: 12px;
    margin-bottom: 22px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.9s ease-out 0.4s forwards;
  }

  .diagram svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram .system {
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.8s forwards;
    transform-origin: 750px 340px;
  }

  .progress {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 26px;
    background: rgba(17, 24, 39, 0.5);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 999px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 1.2s forwards;
  }

  .dot {
    font-size: 14px;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 2px;
    padding: 4px 12px;
    border-radius: 999px;
  }

  .dot-active {
    color: var(--cyan-400);
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.35);
  }

  .dash {
    width: 22px;
    height: 2px;
    background: rgba(148, 163, 184, 0.3);
    border-radius: 999px;
  }
</style>
