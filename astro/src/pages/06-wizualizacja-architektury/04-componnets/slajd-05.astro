---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 05 - Poziom abstrakcji komponentu"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="header">
      <span class="eyebrow"><i class="ti ti-adjustments-horizontal"></i>Component · Level 3</span>
      <h1 class="title">
        Poziom abstrakcji <span class="highlight">komponentu</span>
      </h1>
    </div>

    <div class="focus">
      <section class="panel panel-good" style="--delay: 0.38s;">
        <ul class="points">
          <li><i class="ti ti-check"></i><span>Ma jasno określoną odpowiedzialność</span></li>
          <li><i class="ti ti-check"></i><span>Jest istotny dla zrozumienia kontenera</span></li>
          <li><i class="ti ti-check"></i><span>Pokazuje organizację aplikacji ponad kodem</span></li>
        </ul>
      </section>
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1760px;
    padding: 52px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 34px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 18px;
  }

  .eyebrow i { font-size: 18px; }

  .title {
    font-size: 74px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 16px;
    color: #f8fafc;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    font-size: 22px;
    font-weight: 300;
    color: #cbd5e1;
    margin: 0 auto;
    line-height: 1.42;
    max-width: 1180px;
  }

  .focus {
    width: 100%;
    max-width: 1480px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 34px;
  }

  .panel {
    background: rgba(17, 24, 39, 0.66);
    backdrop-filter: blur(8px);
    border-radius: 20px;
    padding: 32px;
    text-align: left;
    opacity: 0;
    transform: translateY(18px);
    animation: fadeUp 0.8s ease-out forwards;
    animation-delay: var(--delay, 0.35s);
  }

  .panel-good {
    border: 1px solid rgba(34, 211, 238, 0.45);
    box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.12), 0 12px 34px rgba(8, 145, 178, 0.18);
  }

  .panel-head {
    margin-bottom: 20px;
  }

  .head-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .head-tag i { font-size: 18px; }

  .head-tag.good {
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.45);
    color: var(--cyan-400);
  }

  .points {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .points li {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    padding: 24px 22px;
    border-radius: 14px;
    border: 1px solid rgba(34, 211, 238, 0.25);
    background: rgba(15, 23, 42, 0.65);
  }

  .points li i {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    font-size: 22px;
    margin-top: 2px;
  }

  .panel-good .points li i {
    color: var(--cyan-400);
    background: rgba(34, 211, 238, 0.16);
    border: 1px solid rgba(34, 211, 238, 0.4);
  }

  .points li span {
    font-size: 32px;
    font-weight: 500;
    color: #e2e8f0;
    line-height: 1.28;
  }

  .quality {
    background: rgba(15, 23, 42, 0.62);
    border: 1px solid rgba(148, 163, 184, 0.24);
    border-radius: 16px;
    padding: 20px 24px;
    text-align: left;
    opacity: 0;
    transform: translateY(16px);
    animation: fadeUp 0.75s ease-out forwards;
    animation-delay: var(--delay, 0.55s);
  }

  .quality h3 {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
    color: #f1f5f9;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.3px;
  }

  .quality h3 i {
    color: var(--cyan-400);
    font-size: 24px;
  }

  .quality ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .quality li {
    font-size: 19px;
    line-height: 1.4;
    color: #cbd5e1;
    padding-left: 20px;
    position: relative;
  }

  .quality li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 11px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(34, 211, 238, 0.9);
  }

  .note {
    margin: 0;
    padding: 14px 22px;
    border-radius: 14px;
    background: rgba(17, 24, 39, 0.52);
    border: 1px solid rgba(148, 163, 184, 0.22);
    font-size: 18px;
    font-weight: 300;
    color: #cbd5e1;
    line-height: 1.4;
    max-width: 1500px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.85s forwards;
  }

  @media (max-width: 1500px) {
    .points li span { font-size: 26px; }

    .title { font-size: 62px; }
  }
</style>
