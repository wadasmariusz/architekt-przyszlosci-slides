---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 01 - C4 Component — wnętrze jednego kontenera"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="left">
      <span class="eyebrow"><i class="ti ti-stack-2"></i> C4 · Poziom 3</span>
      <h1 class="title">
        Diagram <span class="highlight">komponentów</span>
      </h1>
      <p class="subtitle">
        Od technicznej budowy systemu do <strong>wnętrza jednego kontenera</strong>.
      </p>
    </div>

    <div class="pyramid" aria-hidden="true">
      <div class="step step-1">
        <div class="step-index">L1</div>
        <div class="step-body">
          <h3>Context</h3>
          <p>Czym jest system i jak pasuje do otoczenia?</p>
        </div>
      </div>

      <div class="step step-2">
        <div class="step-index">L2</div>
        <div class="step-body">
          <h3>Containers</h3>
          <p>Z jakich głównych części się składa?</p>
        </div>
      </div>

      <div class="step step-3 active">
        <div class="step-index">L3</div>
        <div class="step-body">
          <h3>Components</h3>
          <p>Co jest wewnątrz kontenera?</p>
        </div>
      </div>

      <div class="step step-4">
        <div class="step-index">L4</div>
        <div class="step-body">
          <h3>Code</h3>
          <p>Jak wygląda implementacja?</p>
        </div>
      </div>
    </div>
  </div>
</SlideLayout>

<style is:global>
  .content {
    max-width: 1640px;
    padding: 0 3rem;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 80px;
    align-items: center;
  }

  .left {
    text-align: left;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 20px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 18px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 4px;
    margin-bottom: 32px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .eyebrow i { font-size: 20px; }

  .title {
    font-size: 104px;
    font-weight: 800;
    letter-spacing: -1.5px;
    line-height: 1.02;
    margin: 0 0 28px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.35s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    font-size: 32px;
    font-weight: 300;
    line-height: 1.4;
    color: #cbd5e1;
    margin: 0;
    max-width: 540px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.55s forwards;
  }

  .subtitle strong {
    font-weight: 600;
    color: #f1f5f9;
  }

  .pyramid {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  .step {
    display: grid;
    grid-template-columns: 88px 1fr auto;
    align-items: center;
    gap: 22px;
    padding: 22px 28px;
    background: rgba(17, 24, 39, 0.45);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 18px;
    text-align: left;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.7s ease-out forwards;
    position: relative;
    filter: grayscale(0.6);
  }

  .step::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
    border-radius: 18px 0 0 18px;
    background: rgba(148, 163, 184, 0.35);
  }

  .step-1 { animation-delay: 0.75s; margin-left: 0; }
  .step-2 { animation-delay: 0.9s; margin-left: 36px; }
  .step-3 { animation-delay: 1.05s; margin-left: 72px; }
  .step-4 { animation-delay: 1.2s; margin-left: 108px; }

  .step.active {
    background: rgba(17, 24, 39, 0.75);
    border-color: rgba(34, 211, 238, 0.55);
    box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.2), 0 12px 40px rgba(8, 145, 178, 0.18);
    filter: none;
  }

  .step.active::before {
    background: linear-gradient(180deg, var(--cyan-400), var(--cyan-600));
    width: 5px;
  }

  .step-index {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    background: rgba(148, 163, 184, 0.08);
    border: 1px solid rgba(148, 163, 184, 0.25);
    color: #94a3b8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .step.active .step-index {
    background: rgba(34, 211, 238, 0.15);
    border-color: rgba(34, 211, 238, 0.45);
    color: var(--cyan-400);
  }

  .step-body h3 {
    margin: 0 0 4px;
    font-size: 26px;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: -0.3px;
  }

  .step.active .step-body h3 {
    color: #f1f5f9;
  }

  .step-body p {
    margin: 0;
    font-size: 17px;
    font-weight: 300;
    line-height: 1.4;
    color: #64748b;
  }

  .step.active .step-body p {
    color: #cbd5e1;
  }

  .active-tag {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--cyan-400);
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.35);
    padding: 6px 12px;
    border-radius: 999px;
    white-space: nowrap;
  }
</style>

