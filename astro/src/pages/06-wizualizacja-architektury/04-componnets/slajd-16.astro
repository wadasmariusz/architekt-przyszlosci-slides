---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 16 - Architektura wnętrza aplikacji"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="header">
      <span class="eyebrow"><i class="ti ti-layout-dashboard"></i>Component · Level 3</span>
      <h1 class="title">
        Architektura <span class="highlight">wnętrza aplikacji</span>
      </h1>
    </div>

    <div class="map">
      <div class="map-frame">
        <span class="frame-label"><i class="ti ti-box"></i> Container · API Application</span>

        <div class="zones">
          <div class="zone z-business">
            <header>
              <div class="z-icon"><i class="ti ti-briefcase"></i></div>
              <span class="z-tag">Business Logic</span>
            </header>
            <h3>Logika biznesowa</h3>
            <p>Reguły, polityki i kluczowe decyzje domeny.</p>
          </div>

          <div class="zone z-services">
            <header>
              <div class="z-icon"><i class="ti ti-layout-grid"></i></div>
              <span class="z-tag">Application Services</span>
            </header>
            <h3>Warstwa aplikacyjna</h3>
            <p>Orkiestracja przypadków użycia i koordynacja komponentów.</p>
          </div>

          <div class="zone z-integrations">
            <header>
              <div class="z-icon"><i class="ti ti-plug-connected"></i></div>
              <span class="z-tag">Integrations</span>
            </header>
            <h3>Integracje &amp; fasady</h3>
            <p>Adaptery i fasady izolujące systemy zewnętrzne.</p>
          </div>

          <div class="zone z-data">
            <header>
              <div class="z-icon"><i class="ti ti-database"></i></div>
              <span class="z-tag">Data Access</span>
            </header>
            <h3>Dostęp do danych</h3>
            <p>Repozytoria i kontrakty wymiany danych.</p>
          </div>

          <div class="zone z-notifications">
            <header>
              <div class="z-icon"><i class="ti ti-bell-ringing"></i></div>
              <span class="z-tag">Notifications</span>
            </header>
            <h3>Komunikacja</h3>
            <p>Powiadomienia, e-maile i kanały wyjścia.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1840px;
    padding: 44px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 30px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 16px;
  }

  .eyebrow i { font-size: 18px; }

  .title {
    font-size: 74px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 14px;
    color: #f8fafc;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    font-size: 22px;
    font-weight: 300;
    color: #cbd5e1;
    margin: 0 auto;
    line-height: 1.4;
    max-width: 1240px;
  }

  .map {
    width: 100%;
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.4s forwards;
  }

  .map-frame {
    position: relative;
    padding: 38px 32px 28px;
    border: 1.5px solid rgba(34, 211, 238, 0.45);
    border-radius: 22px;
    background: rgba(8, 47, 73, 0.18);
    box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.1), 0 18px 56px rgba(8, 145, 178, 0.16);
  }

  .frame-label {
    position: absolute;
    top: -14px;
    left: 32px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px;
    border-radius: 999px;
    background: #0a0e17;
    border: 1px solid rgba(34, 211, 238, 0.45);
    color: var(--cyan-400);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2.5px;
  }

  .frame-label i { font-size: 15px; }

  .zones {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 24px;
    margin-bottom: 22px;
  }

  .zone {
    grid-column: span 2;
    position: relative;
    padding: 28px 24px;
    border-radius: 16px;
    background: rgba(17, 24, 39, 0.7);
    border: 1px solid rgba(34, 211, 238, 0.28);
    text-align: left;
    opacity: 0;
    transform: translateY(16px);
    animation: fadeUp 0.7s ease-out forwards;
    overflow: hidden;
  }

  .zone::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--cyan-400), transparent);
  }

  .zone:nth-child(1) { animation-delay: 0.55s; }
  .zone:nth-child(2) { animation-delay: 0.65s; }
  .zone:nth-child(3) { animation-delay: 0.75s; }
  .zone:nth-child(4) {
    grid-column: 2 / span 2;
    animation-delay: 0.85s;
  }
  .zone:nth-child(5) {
    grid-column: 4 / span 2;
    animation-delay: 0.95s;
  }

  .zone header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 16px;
  }

  .z-icon {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.45);
    color: var(--cyan-400);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 27px;
  }

  .z-tag {
    font-size: 14px;
    font-weight: 700;
    color: var(--cyan-400);
    text-transform: uppercase;
    letter-spacing: 2.2px;
  }

  .zone h3 {
    margin: 0 0 10px;
    font-size: 30px;
    font-weight: 700;
    color: #f1f5f9;
    letter-spacing: -0.2px;
    line-height: 1.25;
  }

  .zone p {
    margin: 0;
    font-size: 22px;
    font-weight: 400;
    color: #cbd5e1;
    line-height: 1.45;
  }

  .collaboration {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 14px 22px;
    background: rgba(15, 23, 42, 0.6);
    border: 1px dashed rgba(34, 211, 238, 0.45);
    border-radius: 14px;
    opacity: 0;
    animation: fadeUp 0.85s ease-out 1.15s forwards;
  }

  .collaboration i {
    flex: 0 0 auto;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.45);
    color: var(--cyan-400);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
  }

  .collaboration span {
    font-size: 17px;
    font-weight: 400;
    color: #e2e8f0;
    line-height: 1.35;
    text-align: left;
  }

  .collaboration span strong {
    color: #f1f5f9;
    font-weight: 700;
  }

  @media (max-width: 1500px) {
    .title { font-size: 60px; }
  }
</style>
