---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 14 - Odpowiedzialność vs zależność zewnętrzna"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="header">
      <span class="eyebrow"><i class="ti ti-arrows-left-right"></i>Component · Level 3</span>
      <h1 class="title">
        Odpowiedzialność <span class="vs">vs</span> <span class="highlight">zależność zewnętrzna</span>
      </h1>
    </div>
    <div class="questions">
      <div class="q">
        <div class="q-icon"><i class="ti ti-checks"></i></div>
        <p>Co należy do <strong>odpowiedzialności kontenera</strong>?</p>
      </div>
      <div class="q">
        <div class="q-icon"><i class="ti ti-link"></i></div>
        <p>Co jest <strong>zależnością zewnętrzną</strong>?</p>
      </div>
      <div class="q">
        <div class="q-icon"><i class="ti ti-shield-bolt"></i></div>
        <p>Które integracje wpływają na <strong>stabilność rozwiązania</strong>?</p>
      </div>
      <div class="q">
        <div class="q-icon"><i class="ti ti-tools"></i></div>
        <p>Gdzie przebiega <strong>granica zmiany i utrzymania</strong>?</p>
      </div>
    </div>

    <div class="split">
      <div class="side inside">
        <header>
          <h3>Wewnątrz kontenera</h3>
        </header>
        <ul>
          <li><i class="ti ti-code"></i><span>Kod, decyzje projektowe i refaktoryzacje</span></li>
          <li><i class="ti ti-stack-2"></i><span>Strukturę komponentów i ich odpowiedzialności</span></li>
          <li><i class="ti ti-route"></i><span>Wewnętrzne zależności i przepływy</span></li>
          <li><i class="ti ti-test-pipe"></i><span>Testy, jakość i wdrożenia</span></li>
        </ul>
      </div>

      <div class="divider" aria-hidden="true">
        <div class="dline"></div>
        <div class="dchip"><i class="ti ti-border-vertical"></i></div>
        <div class="dline"></div>
      </div>

      <div class="side outside">
        <header>
          <h3>Integrujemy się</h3>
        </header>
        <ul>
          <li><i class="ti ti-api"></i><span>Cudze API i kontrakty komunikacji</span></li>
          <li><i class="ti ti-server"></i><span>Systemy zewnętrzne i legacy</span></li>
          <li><i class="ti ti-database"></i><span>Bazy danych i magazyny współdzielone</span></li>
          <li><i class="ti ti-alert-triangle"></i><span>Ryzyka SLA, awarii i zmian po stronie partnera</span></li>
        </ul>
      </div>
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1760px;
    padding: 44px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 28px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 16px;
  }

  .eyebrow i { font-size: 18px; }

  .title {
    font-size: 78px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 14px;
    color: #f8fafc;
  }

  .title .vs {
    font-size: 50px;
    font-weight: 400;
    color: #64748b;
    margin: 0 6px;
    font-style: italic;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    font-size: 21px;
    font-weight: 300;
    color: #cbd5e1;
    margin: 0 auto;
    line-height: 1.4;
    max-width: 1240px;
  }

  .questions {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    width: 100%;
    margin-bottom: 32px;
  }

  .q {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    background: rgba(17, 24, 39, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 14px;
    text-align: left;
    opacity: 0;
    transform: translateY(14px);
    animation: fadeUp 0.65s ease-out forwards;
  }

  .q:nth-child(1) { animation-delay: 0.3s; }
  .q:nth-child(2) { animation-delay: 0.4s; }
  .q:nth-child(3) { animation-delay: 0.5s; }
  .q:nth-child(4) { animation-delay: 0.6s; }

  .q-icon {
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    border-radius: 11px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.4);
    color: var(--cyan-400);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
  }

  .q p {
    margin: 0;
    font-size: 19px;
    font-weight: 400;
    color: #e2e8f0;
    line-height: 1.35;
  }

  .q p strong {
    color: #f1f5f9;
    font-weight: 700;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 22px;
    width: 100%;
  }

  .side {
    position: relative;
    padding: 26px 28px;
    border-radius: 20px;
    text-align: left;
    overflow: hidden;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.85s ease-out forwards;
  }

  .side.inside {
    background: rgba(8, 47, 73, 0.35);
    border: 1px solid rgba(34, 211, 238, 0.45);
    box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.12), 0 14px 44px rgba(8, 145, 178, 0.16);
    animation-delay: 0.75s;
  }

  .side.outside {
    background: rgba(17, 24, 39, 0.55);
    border: 1.5px dashed rgba(148, 163, 184, 0.45);
    animation-delay: 0.9s;
  }

  .side.inside::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--cyan-400), transparent);
  }

  .side header {
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.45);
    color: var(--cyan-400);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2.5px;
    margin-bottom: 12px;
  }

  .badge.alt {
    background: rgba(148, 163, 184, 0.1);
    border-color: rgba(148, 163, 184, 0.35);
    color: #cbd5e1;
  }

  .side header h3 {
    margin: 0;
    font-size: 38px;
    font-weight: 700;
    color: #f1f5f9;
    letter-spacing: -0.4px;
    line-height: 1.1;
  }

  .side ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .side ul li {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 22px;
    font-weight: 500;
    color: #e2e8f0;
    line-height: 1.35;
  }

  .side ul li i {
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
  }

  .side.outside ul li i {
    border-color: rgba(148, 163, 184, 0.4);
    color: #cbd5e1;
  }

  .divider {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 1.05s forwards;
  }

  .dline {
    flex: 1;
    width: 2px;
    background: linear-gradient(180deg, transparent, rgba(148, 163, 184, 0.55), transparent);
    min-height: 60px;
  }

  .dchip {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(148, 163, 184, 0.45);
    color: #cbd5e1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
  }

  @media (max-width: 1500px) {
    .questions { grid-template-columns: repeat(2, 1fr); }
    .title { font-size: 66px; }
    .title .vs { font-size: 40px; }
  }

  @media (max-width: 1100px) {
    .split { grid-template-columns: 1fr; }
    .divider { flex-direction: row; }
    .divider .dline { width: auto; height: 2px; min-height: 0; background: linear-gradient(90deg, transparent, rgba(148, 163, 184, 0.55), transparent); }
  }
</style>
