---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 12 - Opisuj intencję, nie tylko protokół"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="s12">
    <header class="s12-header">
      <span class="s12-eyebrow"><i class="ti ti-message-2-cog"></i> Component · Level 3</span>
      <h1 class="s12-title">
        Opisuj <span class="s12-title-highlight">intencję</span>, nie tylko protokół
      </h1>
      <p class="s12-subtitle">
        Protokół wyjaśnia jak, ale to intencja wyjaśnia po co istnieje zależność między komponentami.
      </p>
    </header>

    <section class="s12-meter" aria-label="Skala jakości opisu relacji">
      <div class="s12-meter-track">
        <span class="s12-meter-segment s12-meter-weak"><i class="ti ti-x"></i> Sam protokół</span>
        <span class="s12-meter-segment s12-meter-mid"><i class="ti ti-alert-triangle"></i> Protokół + akcja</span>
        <span class="s12-meter-segment s12-meter-good"><i class="ti ti-check"></i> Intencja biznesowa</span>
      </div>
    </section>

    <section class="s12-flow">
      <article class="s12-card s12-card-weak">
        <header class="s12-card-head">
          <span class="s12-badge s12-badge-weak"><i class="ti ti-x"></i> Słabszy opis</span>
          <h2>REST / JSON</h2>
        </header>
        <p class="s12-lead">&quot;Controller wywołuje Facade.&quot;</p>
        <ul class="s12-gaps">
          <li><i class="ti ti-circle-dashed"></i> Nie wiadomo, jaki cel biznesowy</li>
          <li><i class="ti ti-circle-dashed"></i> Brak informacji o wyniku operacji</li>
          <li><i class="ti ti-circle-dashed"></i> Nie wiadomo, kto inicjuje i dlaczego</li>
        </ul>
      </article>

      <div class="s12-refine">
        <div class="s12-refine-icon"><i class="ti ti-arrow-big-right-lines"></i></div>
        <p>Dodaj intencję relacji</p>
      </div>

      <article class="s12-card s12-card-good">
        <header class="s12-card-head">
          <span class="s12-badge s12-badge-good"><i class="ti ti-check"></i> Lepszy opis</span>
          <h2>Pobierz podsumowanie rachunków</h2>
        </header>
        <p class="s12-good-copy">
          Accounts Summary Controller pobiera podsumowanie rachunków klienta
          z Mainframe Facade, aby pokazać saldo i ostatnie operacje w bankowości online.
        </p>
        <div class="s12-tags">
          <span><i class="ti ti-player-play"></i> Kto inicjuje: Controller</span>
          <span><i class="ti ti-target-arrow"></i> Cel: Widok klienta</span>
          <span><i class="ti ti-database-search"></i> Wynik: saldo + operacje</span>
        </div>
      </article>
    </section>

    <aside class="s12-template">
      <div class="s12-template-head">
        <i class="ti ti-template"></i>
        <h3>Szablon opisu relacji</h3>
      </div>
      <div class="s12-chips">
        <span><i class="ti ti-bolt"></i> Czasownik intencji</span>
        <span><i class="ti ti-user"></i> Kto i dla kogo</span>
        <span><i class="ti ti-stack-2"></i> Jaki wynik</span>
        <span><i class="ti ti-plug-connected"></i> Protokół (opcjonalnie)</span>
      </div>
    </aside>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .s12 {
    width: 100%;
    max-width: 1760px;
    padding: 44px 2.4rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .s12-header {
    text-align: center;
    opacity: 0;
    animation: fadeUp 0.75s ease-out 0.15s forwards;
  }

  .s12-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 14px;
  }

  .s12-eyebrow i { font-size: 18px; }

  .s12-title {
    margin: 0 0 10px;
    color: #f8fafc;
    font-size: 68px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
  }

  .s12-title-highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .s12-subtitle {
    margin: 0;
    color: #cbd5e1;
    font-size: 21px;
    font-weight: 300;
    line-height: 1.38;
  }

  .s12-meter {
    width: 100%;
    opacity: 0;
    animation: fadeUp 0.75s ease-out 0.3s forwards;
  }

  .s12-meter-track {
    display: grid;
    grid-template-columns: 1fr 1fr 1.1fr;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, 0.25);
    background: rgba(15, 23, 42, 0.7);
    box-shadow: 0 16px 42px rgba(2, 6, 23, 0.35);
  }

  .s12-meter-segment {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 9px;
    padding: 11px 16px;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.2;
    border-right: 1px solid rgba(148, 163, 184, 0.2);
  }

  .s12-meter-segment:last-child { border-right: 0; }

  .s12-meter-segment i { font-size: 19px; }

  .s12-meter-weak {
    color: #fca5a5;
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.2), rgba(127, 29, 29, 0.1));
  }

  .s12-meter-mid {
    color: #fde68a;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.18), rgba(120, 53, 15, 0.08));
  }

  .s12-meter-good {
    color: #67e8f9;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.16), rgba(8, 145, 178, 0.06));
  }

  .s12-flow {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: stretch;
    gap: 18px;
  }

  .s12-card {
    text-align: left;
    border-radius: 20px;
    padding: 24px 28px 26px;
    background: rgba(17, 24, 39, 0.64);
    backdrop-filter: blur(10px);
    opacity: 0;
    transform: translateY(16px);
    animation: fadeUp 0.72s ease-out forwards;
  }

  .s12-card-weak {
    border: 1px dashed rgba(248, 113, 113, 0.55);
    box-shadow: 0 16px 40px rgba(127, 29, 29, 0.22);
    animation-delay: 0.45s;
  }

  .s12-card-good {
    border: 1px solid rgba(34, 211, 238, 0.48);
    box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.1), 0 16px 40px rgba(8, 145, 178, 0.2);
    animation-delay: 0.62s;
  }

  .s12-card-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 14px;
  }

  .s12-badge {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 1.8px;
    font-size: 12px;
    font-weight: 700;
  }

  .s12-badge i { font-size: 14px; }

  .s12-badge-weak {
    color: #fca5a5;
    border: 1px solid rgba(248, 113, 113, 0.5);
    background: rgba(248, 113, 113, 0.12);
  }

  .s12-badge-good {
    color: var(--cyan-400);
    border: 1px solid rgba(34, 211, 238, 0.5);
    background: rgba(34, 211, 238, 0.14);
  }

  .s12-card h2 {
    margin: 0;
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -0.4px;
    line-height: 1.1;
    color: #f8fafc;
  }

  .s12-card-weak h2 { color: #fca5a5; }

  .s12-lead {
    margin: 0 0 14px;
    color: #fecaca;
    font-size: 26px;
    font-style: italic;
    font-weight: 400;
    line-height: 1.3;
  }

  .s12-gaps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .s12-gaps li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #cbd5e1;
    font-size: 21px;
    line-height: 1.3;
  }

  .s12-gaps li i {
    color: #f87171;
    font-size: 19px;
  }

  .s12-good-copy {
    margin: 0 0 14px;
    color: #e2e8f0;
    font-size: 21px;
    font-weight: 300;
    line-height: 1.4;
  }

  .s12-tags {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .s12-tags span {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 10px 12px;
    border-radius: 10px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.32);
    color: #bae6fd;
    font-size: 18px;
    line-height: 1.2;
  }

  .s12-tags span i {
    color: var(--cyan-400);
    font-size: 18px;
  }

  .s12-refine {
    width: 182px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 10px;
    color: #94a3b8;
    opacity: 0;
    animation: fadeUp 0.72s ease-out 0.54s forwards;
  }

  .s12-refine-icon {
    width: 84px;
    height: 84px;
    border-radius: 20px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.38);
    display: inline-flex;
    justify-content: center;
    align-items: center;
    color: var(--cyan-400);
    box-shadow: 0 14px 32px rgba(8, 145, 178, 0.2);
  }

  .s12-refine-icon i { font-size: 38px; }

  .s12-refine p {
    margin: 0;
    font-size: 19px;
    font-weight: 600;
    text-align: center;
    line-height: 1.25;
  }

  .s12-template {
    width: calc(100% - 520px);
    align-self: flex-start;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px 28px 22px;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.12), rgba(8, 145, 178, 0.08));
    border: 1px solid rgba(34, 211, 238, 0.36);
    box-shadow: 0 16px 42px rgba(8, 145, 178, 0.16);
    opacity: 0;
    animation: fadeUp 0.78s ease-out 0.8s forwards;
  }

  .s12-template-head {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #f0f9ff;
  }

  .s12-template-head i {
    font-size: 26px;
    color: var(--cyan-400);
  }

  .s12-template-head h3 {
    margin: 0;
    font-size: 31px;
    font-weight: 800;
    letter-spacing: -0.3px;
  }

  .s12-chips {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  .s12-chips span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 12px;
    border-radius: 10px;
    background: rgba(15, 23, 42, 0.58);
    border: 1px solid rgba(148, 163, 184, 0.28);
    color: #e2e8f0;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.2;
  }

  .s12-chips span i {
    color: var(--cyan-400);
    font-size: 17px;
  }

  @media (max-width: 1700px) {
    .s12-title { font-size: 62px; }
    .s12-subtitle { font-size: 19px; }
    .s12-template { width: calc(100% - 470px); }
    .s12-refine { width: 146px; }
    .s12-refine-icon {
      width: 74px;
      height: 74px;
    }

    .s12-refine-icon i { font-size: 32px; }
  }

  @media (max-width: 1460px) {
    .s12-title { font-size: 54px; }
    .s12-subtitle { font-size: 18px; }
    .s12-flow {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .s12-template { width: 100%; }

    .s12-refine {
      width: 100%;
      flex-direction: row;
      justify-content: flex-start;
      text-align: left;
      padding: 4px 8px;
    }

    .s12-refine p { text-align: left; }
    .s12-chips { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
