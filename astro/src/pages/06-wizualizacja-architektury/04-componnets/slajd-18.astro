---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 18 - Diagram komponentów: sedno"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="header">
      <span class="eyebrow"><i class="ti ti-users"></i>Component · Level 3</span>
      <h1 class="title">
        Podsumownaie
      </h1>
    </div>

    <div class="checklist">
      <ul>
        <li>
          <div class="check"><i class="ti ti-check"></i></div>
          <div class="text">
            <h3>Najważniejsze logiczne części</h3>
          </div>
        </li>
        <li>
          <div class="check"><i class="ti ti-check"></i></div>
          <div class="text">
            <h3>Odpowiedzialności komponentów</h3>
          </div>
        </li>
        <li>
          <div class="check"><i class="ti ti-check"></i></div>
          <div class="text">
            <h3>Zależności i kierunki współpracy</h3>
          </div>
        </li>
        <li>
          <div class="check"><i class="ti ti-check"></i></div>
          <div class="text">
            <h3>Istotne integracje zewnętrzne</h3>
          </div>
        </li>
        <li class="emphasis">
          <div class="check"><i class="ti ti-target-arrow"></i></div>
          <div class="text">
            <h3>Właściwy poziom szczegółowości</h3>
          </div>
        </li>
      </ul>
    </div>

    <div class="closing">
      <i class="ti ti-quote"></i>
      <p>Diagram komponentów to <strong>mapa wnętrza jednego kontenera</strong></p>
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1700px;
    padding: 44px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 30px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 16px;
  }

  .eyebrow i { font-size: 18px; }

  .title {
    font-size: 78px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 14px;
    color: #f8fafc;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    font-size: 22px;
    font-weight: 300;
    color: #cbd5e1;
    margin: 0 auto;
    line-height: 1.4;
    max-width: 1200px;
  }

  .checklist {
    width: 100%;
    max-width: 1320px;
    margin-bottom: 26px;
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.35s forwards;
  }

  .checklist-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    font-size: 14px;
    font-weight: 700;
    color: var(--cyan-400);
    text-transform: uppercase;
    letter-spacing: 3px;
  }

  .checklist-label i { font-size: 18px; }

  .checklist ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .checklist li {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    padding: 16px 22px;
    background: rgba(17, 24, 39, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 14px;
    text-align: left;
    opacity: 0;
    transform: translateY(14px);
    animation: fadeUp 0.65s ease-out forwards;
  }

  .checklist li:nth-child(1) { animation-delay: 0.5s; }
  .checklist li:nth-child(2) { animation-delay: 0.6s; }
  .checklist li:nth-child(3) { animation-delay: 0.7s; }
  .checklist li:nth-child(4) { animation-delay: 0.8s; }
  .checklist li:nth-child(5) { animation-delay: 0.9s; }

  .checklist li.emphasis {
    background: rgba(8, 47, 73, 0.4);
    border-color: rgba(34, 211, 238, 0.5);
    box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.12), 0 12px 36px rgba(8, 145, 178, 0.16);
  }

  .check {
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    border-radius: 11px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.45);
    color: var(--cyan-400);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
  }

  .checklist .text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .checklist .text h3 {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    color: #f1f5f9;
    letter-spacing: -0.2px;
    line-height: 1.25;
  }

  .checklist .text p {
    margin: 0;
    font-size: 16px;
    font-weight: 300;
    color: #cbd5e1;
    line-height: 1.4;
  }

  .checklist .text p strong {
    color: #f1f5f9;
    font-weight: 700;
  }

  .closing {
    display: flex;
    align-items: center;
    gap: 18px;
    max-width: 1320px;
    width: 100%;
    padding: 20px 26px;
    background: rgba(15, 23, 42, 0.6);
    border: 1px dashed rgba(34, 211, 238, 0.45);
    border-radius: 16px;
    text-align: left;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.1s forwards;
  }

  .closing i {
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.45);
    color: var(--cyan-400);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
  }

  .closing p {
    margin: 0;
    font-size: 20px;
    font-weight: 400;
    color: #e2e8f0;
    line-height: 1.4;
  }

  .closing p strong {
    color: #f1f5f9;
    font-weight: 700;
  }

  @media (max-width: 1500px) {
    .title { font-size: 64px; }
    .checklist .text h3 { font-size: 21px; }
    .checklist .text p { font-size: 15px; }
  }
</style>
