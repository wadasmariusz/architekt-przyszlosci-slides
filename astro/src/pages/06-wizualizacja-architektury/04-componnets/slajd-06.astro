---
import SlideLayout from '../../../layouts/SlideLayout.astro';
import { Image } from 'astro:assets';
import c4ComponentsDarkImg from './images/c4-Components-dark.png';
---
<SlideLayout
  title="Slide 06 - Przykład: Internet Banking System"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="header">
      <span class="eyebrow"><i class="ti ti-building-bank"></i>Component · Level 3</span>
      <h1 class="title">
        <span>Internet Banking System</span>
      </h1>
    </div>

    <div class="diagram-wrap">
      <Image
        class="diagram-img"
        src={c4ComponentsDarkImg}
        format="png"
        alt="Diagram C4 Components dla Internet Banking System"
        loading="eager"
      />
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1760px;
    padding: 46px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 24px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 16px;
  }

  .eyebrow i { font-size: 18px; }

  .title {
    font-size: 68px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.06;
    margin: 0 0 14px;
    color: #f8fafc;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    margin: 0;
    font-size: 22px;
    font-weight: 300;
    color: #cbd5e1;
    line-height: 1.4;
  }

  .facts {
    width: 100%;
    max-width: 1500px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 22px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.35s forwards;
  }

  .fact {
    text-align: left;
    background: rgba(15, 23, 42, 0.62);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 14px;
    padding: 14px 16px;
  }

  .fact-label {
    display: inline-block;
    margin-bottom: 6px;
    color: #94a3b8;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .fact strong {
    display: block;
    color: #f1f5f9;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.2px;
    line-height: 1.3;
  }

  .diagram-wrap {
    width: 100%;
    opacity: 0;
    animation: fadeUp 0.85s ease-out 0.5s forwards;
  }

  .diagram-img {
    width: 100%;
    max-height: 770px;
    object-fit: contain;
    border-radius: 18px;
    background: rgba(17, 24, 39, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.22);
    box-shadow: 0 14px 38px rgba(2, 6, 23, 0.35);
    padding: 14px;
  }

  .boundary {
    position: relative;
    width: 100%;
    height: 470px;
    background: rgba(17, 24, 39, 0.55);
    border: 1px dashed rgba(148, 163, 184, 0.45);
    border-radius: 18px;
    overflow: hidden;
  }

  .boundary-label {
    position: absolute;
    left: 20px;
    top: 14px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.16);
    border: 1px solid rgba(148, 163, 184, 0.35);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #cbd5e1;
  }

  .node {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 14px;
    width: 360px;
    padding: 18px 18px;
    background: rgba(15, 23, 42, 0.86);
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 16px;
    text-align: left;
    box-shadow: 0 10px 28px rgba(2, 6, 23, 0.25);
  }

  .node-icon {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(148, 163, 184, 0.12);
    border: 1px solid rgba(148, 163, 184, 0.3);
    color: #cbd5e1;
    font-size: 28px;
    flex: 0 0 auto;
  }

  .node h3 {
    margin: 0 0 3px;
    font-size: 25px;
    line-height: 1.1;
    letter-spacing: -0.3px;
    color: #f8fafc;
  }

  .node p {
    margin: 0;
    font-size: 16px;
    line-height: 1.35;
    color: #cbd5e1;
  }

  .web { left: 88px; top: 94px; }
  .mobile { left: 88px; top: 278px; }
  .api { left: 640px; top: 186px; }
  .db { left: 1202px; top: 186px; width: 300px; }

  .focus {
    border-color: rgba(34, 211, 238, 0.58);
    box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.18), 0 16px 40px rgba(8, 145, 178, 0.2);
  }

  .focus .node-icon {
    background: rgba(34, 211, 238, 0.15);
    border-color: rgba(34, 211, 238, 0.5);
    color: var(--cyan-400);
  }

  .focus-badge {
    position: absolute;
    left: 16px;
    top: -17px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.55);
    color: var(--cyan-400);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }

  .focus-badge i { font-size: 14px; }

  .flow {
    position: absolute;
    height: 2px;
    background: linear-gradient(90deg, rgba(34, 211, 238, 0.35), rgba(34, 211, 238, 0.95));
  }

  .flow::after {
    content: '';
    position: absolute;
    right: -2px;
    top: -4px;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    border-left: 9px solid rgba(34, 211, 238, 0.9);
  }

  .flow-a { left: 454px; top: 166px; width: 182px; }
  .flow-b { left: 454px; top: 350px; width: 182px; }
  .flow-c { left: 1011px; top: 258px; width: 186px; }

  .flow-label {
    position: absolute;
    left: 50%;
    top: -28px;
    transform: translateX(-50%);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.4px;
    color: var(--cyan-400);
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.42);
    border-radius: 999px;
    padding: 4px 10px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 1500px) {
    .title { font-size: 58px; }
    .subtitle { font-size: 20px; }
    .facts { grid-template-columns: 1fr; }
  }
</style>
