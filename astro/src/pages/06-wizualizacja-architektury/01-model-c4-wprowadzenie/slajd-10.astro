---
import SlideLayout from '../../../layouts/SlideLayout.astro';

const slidePath = '/slides/06-wizualizacja-architektury/01-model-c4-wprowadzenie';
---
<SlideLayout
  title="Slide 10 - Poziom 4: Code (opcjonalny)"
  bgImage="/images/background-4.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="header">
      <span class="level-chip optional">
        <i class="ti ti-alert-triangle"></i> Poziom 4 · opcjonalny
      </span>
      <h1 class="title">
        Code
      </h1>
    </div>

    <div class="layout">
      <div class="diagram-wrap">
        <img class="diagram-img" src={`${slidePath}/images/c4-code.png`} alt="Diagram C4 poziom 4 — Code" />
      </div>
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1760px;
    padding: 52px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    text-align: center;
    margin-bottom: 24px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  .level-chip.optional {
    background: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.45);
    color: #fcd34d;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 72px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .layout {
    display: flex;
    justify-content: center;
    width: 100%;
    align-items: center;
  }

  .diagram-wrap {
    background: rgba(17, 24, 39, 0.5);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.15);
    border-radius: 22px;
    padding: 18px 22px;
    max-width: 1120px;
    width: 100%;
    margin: 0 auto;
    opacity: 0;
    transform: translateY(22px);
    animation: fadeUp 0.9s ease-out 0.45s forwards;
  }

  .diagram-wrap svg,
  .diagram-wrap .diagram-img {
    max-width: 100%;
    max-height: 760px;
    width: auto;
    height: auto;
    display: block;
    margin: 0 auto;
    object-fit: contain;
  }
</style>
