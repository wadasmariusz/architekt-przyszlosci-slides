---
import SlideLayout from '../../../layouts/SlideLayout.astro';

const slidePath = '/slides/06-wizualizacja-architektury/01-model-c4-wprowadzenie';
---
<SlideLayout
  title="Slide 04 - Metafora Google Maps"
  bgImage="/images/background-4.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.74), rgba(10,14,23,0.86))"
>
  <div class="content">
    <h1 class="title">
      Metafora <span class="highlight">Google Maps</span>
    </h1>

    <div class="zoom-row">
      <div class="zoom-card" style="--delay: 0.45s">
        <div class="map-frame">
          <img class="country-img" src={`${slidePath}/images/country-map.svg`} alt="Mapa kraju" />
          <span class="zoom-tag">1×</span>
        </div>
        <div class="card-meta">
          <div class="map-label">Widok kraju</div>
          <div class="c4-chip">
            <i class="ti ti-world"></i>
            <span>Context</span>
          </div>
        </div>
      </div>

      <div class="arrow" style="--delay: 0.55s"><i class="ti ti-chevron-right"></i></div>

      <div class="zoom-card" style="--delay: 0.65s">
        <div class="map-frame">
          <svg viewBox="0 0 220 140" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="0" y="0" width="220" height="140" fill="#0b1220"/>
            <g stroke="rgba(148,163,184,0.35)" stroke-width="0.7" fill="none">
              <path d="M0 40 L220 40"/>
              <path d="M0 80 L220 80"/>
              <path d="M0 110 L220 110"/>
              <path d="M50 0 L50 140"/>
              <path d="M110 0 L110 140"/>
              <path d="M170 0 L170 140"/>
            </g>
            <g stroke="rgba(34,211,238,0.7)" stroke-width="1.8" fill="none">
              <path d="M0 65 L220 65"/>
              <path d="M85 0 L85 140"/>
            </g>
            <g fill="#1e293b" stroke="rgba(148,163,184,0.25)" stroke-width="0.4">
              <rect x="20" y="15" width="22" height="18" rx="1"/>
              <rect x="58" y="48" width="22" height="18" rx="1"/>
              <rect x="118" y="18" width="22" height="18" rx="1"/>
              <rect x="180" y="48" width="22" height="18" rx="1"/>
              <rect x="20" y="88" width="22" height="18" rx="1"/>
              <rect x="118" y="88" width="22" height="18" rx="1"/>
              <rect x="180" y="115" width="22" height="18" rx="1"/>
              <rect x="58" y="115" width="22" height="18" rx="1"/>
            </g>
            <circle cx="110" cy="70" r="5" fill="#22d3ee"/>
          </svg>
          <span class="zoom-tag">10×</span>
        </div>
        <div class="card-meta">
          <div class="map-label">Widok miasta</div>
          <div class="c4-chip">
            <i class="ti ti-building-skyscraper"></i>
            <span>Containers</span>
          </div>
        </div>
      </div>

      <div class="arrow" style="--delay: 0.75s"><i class="ti ti-chevron-right"></i></div>

      <div class="zoom-card" style="--delay: 0.85s">
        <div class="map-frame">
          <svg viewBox="0 0 220 140" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="0" y="0" width="220" height="140" fill="#0b1220"/>
            <g fill="#111827" stroke="rgba(148,163,184,0.25)" stroke-width="0.4">
              <rect x="10" y="15" width="40" height="28" rx="2"/>
              <rect x="60" y="15" width="55" height="28" rx="2"/>
              <rect x="125" y="15" width="35" height="28" rx="2"/>
              <rect x="170" y="15" width="40" height="28" rx="2"/>
              <rect x="10" y="55" width="55" height="35" rx="2"/>
              <rect x="75" y="55" width="40" height="35" rx="2"/>
              <rect x="125" y="55" width="50" height="35" rx="2"/>
              <rect x="185" y="55" width="25" height="35" rx="2"/>
              <rect x="10" y="100" width="35" height="30" rx="2"/>
              <rect x="55" y="100" width="60" height="30" rx="2"/>
              <rect x="125" y="100" width="40" height="30" rx="2"/>
              <rect x="175" y="100" width="35" height="30" rx="2"/>
            </g>
            <g stroke="rgba(34,211,238,0.6)" stroke-width="2" fill="none">
              <path d="M0 48 L220 48"/>
              <path d="M0 95 L220 95"/>
              <path d="M118 0 L118 140"/>
            </g>
            <circle cx="92" cy="73" r="5" fill="#22d3ee"/>
          </svg>
          <span class="zoom-tag">100×</span>
        </div>
        <div class="card-meta">
          <div class="map-label">Widok dzielnicy</div>
          <div class="c4-chip">
            <i class="ti ti-map-2"></i>
            <span>Components</span>
          </div>
        </div>
      </div>

      <div class="arrow" style="--delay: 0.95s"><i class="ti ti-chevron-right"></i></div>

      <div class="zoom-card" style="--delay: 1.05s">
        <div class="map-frame">
          <svg viewBox="0 0 220 140" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="0" y="0" width="220" height="140" fill="#0b1220"/>
            <g fill="#111827" stroke="rgba(148,163,184,0.25)" stroke-width="0.5">
              <rect x="10" y="20" width="35" height="38" rx="2"/>
              <rect x="50" y="22" width="40" height="36" rx="2"/>
              <rect x="95" y="18" width="38" height="40" rx="2"/>
              <rect x="138" y="22" width="32" height="36" rx="2"/>
              <rect x="175" y="20" width="35" height="38" rx="2"/>
              <rect x="10" y="92" width="42" height="38" rx="2"/>
              <rect x="57" y="95" width="35" height="35" rx="2"/>
              <rect x="97" y="92" width="38" height="38" rx="2"/>
              <rect x="140" y="95" width="32" height="35" rx="2"/>
              <rect x="178" y="92" width="32" height="38" rx="2"/>
            </g>
            <g fill="#0f172a">
              <rect x="14" y="24" width="8" height="6" rx="0.5"/>
              <rect x="28" y="24" width="8" height="6" rx="0.5"/>
              <rect x="100" y="22" width="10" height="8" rx="0.5"/>
              <rect x="180" y="24" width="10" height="6" rx="0.5"/>
            </g>
            <g stroke="rgba(34,211,238,0.75)" stroke-width="3" fill="none">
              <path d="M0 75 L220 75"/>
            </g>
            <g stroke="rgba(255,255,255,0.5)" stroke-width="0.6" stroke-dasharray="4 4" fill="none">
              <path d="M0 75 L220 75"/>
            </g>
            <circle cx="110" cy="75" r="5" fill="#22d3ee"/>
          </svg>
          <span class="zoom-tag">1000×</span>
        </div>
        <div class="card-meta">
          <div class="map-label">Widok ulicy</div>
          <div class="c4-chip optional">
            <i class="ti ti-route"></i>
            <span>Code</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1720px;
    padding: 110px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .title {
    font-size: 80px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.1;
    margin-bottom: 70px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .zoom-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    width: 100%;
    margin-bottom: 70px;
  }

  .zoom-card {
    flex: 1 1 0;
    max-width: 360px;
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(10px);
    border-radius: 18px;
    padding: 22px 22px 26px;
    text-align: center;
    opacity: 0;
    transform: translateY(24px);
    animation: fadeUp 0.8s ease-out forwards;
    animation-delay: var(--delay, 0.45s);
  }

  .map-frame {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, 0.18);
    box-shadow: 0 6px 28px rgba(0, 0, 0, 0.35);
    background: #0b1220;
  }

  .map-frame svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .country-img {
    display: block;
    width: 100%;
    aspect-ratio: 220 / 140;
    object-fit: contain;
    padding: 10px;
    box-sizing: border-box;
    filter: drop-shadow(0 0 6px rgba(34, 211, 238, 0.25));
  }

  .zoom-tag {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(34, 211, 238, 0.3);
    color: var(--cyan-400);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  .card-meta {
    margin-top: 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .map-label {
    font-size: 22px;
    font-weight: 400;
    color: #cbd5e1;
    letter-spacing: -0.2px;
  }

  .c4-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.3px;
  }

  .c4-chip i {
    font-size: 22px;
  }

  .c4-chip.optional {
    background: rgba(148, 163, 184, 0.1);
    border-color: rgba(148, 163, 184, 0.3);
    color: #cbd5e1;
  }

  .arrow {
    color: rgba(34, 211, 238, 0.8);
    font-size: 36px;
    flex: 0 0 auto;
    opacity: 0;
    animation: fadeIn 0.6s ease-out forwards;
    animation-delay: var(--delay, 0.55s);
  }

  .arrow i {
    display: block;
    filter: drop-shadow(0 0 12px rgba(34, 211, 238, 0.4));
  }

  .quote {
    position: relative;
    max-width: 1280px;
    padding: 28px 60px;
    background: rgba(17, 24, 39, 0.45);
    border-left: 3px solid var(--cyan-400);
    border-radius: 10px;
    text-align: left;
    opacity: 0;
    animation: fadeIn 1s ease-out 1.25s forwards;
  }

  .quote i {
    position: absolute;
    top: -18px;
    left: 24px;
    font-size: 38px;
    color: var(--cyan-400);
    background: rgba(10, 14, 23, 0.95);
    padding: 0 8px;
    line-height: 1;
  }

  .quote p {
    margin: 0;
    font-size: 22px;
    font-weight: 300;
    font-style: italic;
    line-height: 1.5;
    color: #e2e8f0;
  }

  .quote p strong {
    font-weight: 600;
    color: var(--cyan-400);
    font-style: normal;
  }

  .quote-author {
    display: block;
    margin-top: 12px;
    font-size: 18px;
    font-weight: 500;
    color: #94a3b8;
    letter-spacing: 0.3px;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
</style>
