---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 08 - Poziom 2: Containers"
  bgImage="/images/background-2.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-zoom-in"></i> Poziom 2</span>
      <h1 class="title">
        Containers — <span class="highlight">zoom in</span>
      </h1>
    </div>

    <div class="layout">
      <div class="diagram-wrap">
        <svg viewBox="0 0 900 620" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <marker id="arr-c2" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M 0 0 L 10 5 L 0 10 z" fill="#94a3b8"/>
            </marker>
            <linearGradient id="cont-grad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#0891b2"/>
              <stop offset="100%" stop-color="#0e7490"/>
            </linearGradient>
            <linearGradient id="api-grad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#0e7490"/>
              <stop offset="100%" stop-color="#155e75"/>
            </linearGradient>
          </defs>

          <g font-family="Inter, sans-serif">
            <g transform="translate(70,15)">
              <circle cx="40" cy="28" r="20" fill="#1e40af" stroke="#60a5fa" stroke-width="2"/>
              <rect x="14" y="50" width="52" height="36" rx="10" fill="#1e40af" stroke="#60a5fa" stroke-width="2"/>
              <text x="40" y="108" text-anchor="middle" font-size="18" font-weight="700" fill="#dbeafe">Klient</text>
              <text x="40" y="128" text-anchor="middle" font-size="12" fill="#93c5fd">[Person]</text>
            </g>

            <g transform="translate(790,15)">
              <circle cx="40" cy="28" r="20" fill="#1e40af" stroke="#60a5fa" stroke-width="2"/>
              <rect x="14" y="50" width="52" height="36" rx="10" fill="#1e40af" stroke="#60a5fa" stroke-width="2"/>
              <text x="40" y="108" text-anchor="middle" font-size="18" font-weight="700" fill="#dbeafe">Operator</text>
              <text x="40" y="128" text-anchor="middle" font-size="12" fill="#93c5fd">[Person]</text>
            </g>

            <g>
              <rect x="20" y="170" width="860" height="350" rx="22"
                    fill="rgba(34,211,238,0.05)"
                    stroke="#22d3ee" stroke-width="2.5"
                    stroke-dasharray="10 6"/>
              <text x="40" y="200" font-size="20" font-weight="700" fill="#22d3ee">Sklep online</text>
              <text x="170" y="200" font-size="13" font-weight="600" fill="#67e8f9" letter-spacing="2">[SOFTWARE SYSTEM]</text>
            </g>

            <g transform="translate(60,225)">
              <rect x="0" y="0" width="200" height="105" rx="14" fill="url(#cont-grad)" stroke="#22d3ee" stroke-width="2"/>
              <text x="100" y="34" text-anchor="middle" font-size="20" font-weight="700" fill="#ffffff">Web App</text>
              <text x="100" y="56" text-anchor="middle" font-size="12" font-weight="600" fill="#a5f3fc" letter-spacing="1.5">[CONTAINER · SPA]</text>
              <text x="100" y="82" text-anchor="middle" font-size="13" font-weight="300" fill="#e0f2fe">React, TypeScript</text>
            </g>

            <g transform="translate(640,225)">
              <rect x="0" y="0" width="200" height="105" rx="14" fill="url(#cont-grad)" stroke="#22d3ee" stroke-width="2"/>
              <text x="100" y="34" text-anchor="middle" font-size="20" font-weight="700" fill="#ffffff">Mobile App</text>
              <text x="100" y="56" text-anchor="middle" font-size="12" font-weight="600" fill="#a5f3fc" letter-spacing="1.5">[CONTAINER · MOBILE]</text>
              <text x="100" y="82" text-anchor="middle" font-size="13" font-weight="300" fill="#e0f2fe">React Native</text>
            </g>

            <g transform="translate(350,225)">
              <rect x="0" y="0" width="200" height="105" rx="14" fill="url(#api-grad)" stroke="#22d3ee" stroke-width="2.5"/>
              <text x="100" y="34" text-anchor="middle" font-size="20" font-weight="700" fill="#ffffff">API Application</text>
              <text x="100" y="56" text-anchor="middle" font-size="12" font-weight="600" fill="#a5f3fc" letter-spacing="1.5">[CONTAINER · API]</text>
              <text x="100" y="82" text-anchor="middle" font-size="13" font-weight="300" fill="#e0f2fe">Spring Boot, Java 21</text>
            </g>

            <g transform="translate(60,390)">
              <path d="M0 18 a100 14 0 0 0 200 0 L200 95 a100 14 0 0 1 -200 0 Z"
                    fill="url(#cont-grad)" stroke="#22d3ee" stroke-width="2"/>
              <ellipse cx="100" cy="18" rx="100" ry="14" fill="#0891b2" stroke="#22d3ee" stroke-width="2"/>
              <text x="100" y="50" text-anchor="middle" font-size="20" font-weight="700" fill="#ffffff">Database</text>
              <text x="100" y="72" text-anchor="middle" font-size="12" font-weight="600" fill="#a5f3fc" letter-spacing="1.5">[CONTAINER · DB]</text>
              <text x="100" y="94" text-anchor="middle" font-size="13" font-weight="300" fill="#e0f2fe">PostgreSQL 16</text>
            </g>

            <g transform="translate(640,390)">
              <rect x="0" y="0" width="200" height="105" rx="14" fill="url(#cont-grad)" stroke="#22d3ee" stroke-width="2"/>
              <text x="100" y="34" text-anchor="middle" font-size="20" font-weight="700" fill="#ffffff">Notification Worker</text>
              <text x="100" y="56" text-anchor="middle" font-size="12" font-weight="600" fill="#a5f3fc" letter-spacing="1.5">[CONTAINER · WORKER]</text>
              <text x="100" y="82" text-anchor="middle" font-size="13" font-weight="300" fill="#e0f2fe">Node.js, RabbitMQ</text>
            </g>

            <g fill="none" stroke="#94a3b8" stroke-width="1.6" opacity="0.9">
              <path d="M110 145 L160 220" marker-end="url(#arr-c2)"/>
              <path d="M830 145 L780 220" marker-end="url(#arr-c2)"/>
              <path d="M260 278 L348 278" marker-end="url(#arr-c2)"/>
              <path d="M640 278 L552 278" marker-end="url(#arr-c2)"/>
              <path d="M420 332 L240 388" marker-end="url(#arr-c2)"/>
              <path d="M480 332 L660 388" marker-end="url(#arr-c2)"/>
            </g>

            <g font-family="Inter, sans-serif" font-size="13" fill="#22d3ee" font-weight="600">
              <rect x="110" y="170" width="60" height="20" rx="4" fill="rgba(10,14,23,0.85)"/>
              <text x="140" y="184" text-anchor="middle">HTTPS</text>

              <rect x="730" y="170" width="60" height="20" rx="4" fill="rgba(10,14,23,0.85)"/>
              <text x="760" y="184" text-anchor="middle">HTTPS</text>

              <rect x="265" y="260" width="80" height="20" rx="4" fill="rgba(10,14,23,0.85)"/>
              <text x="305" y="274" text-anchor="middle">JSON/HTTPS</text>

              <rect x="556" y="260" width="80" height="20" rx="4" fill="rgba(10,14,23,0.85)"/>
              <text x="596" y="274" text-anchor="middle">JSON/HTTPS</text>

              <rect x="290" y="350" width="58" height="20" rx="4" fill="rgba(10,14,23,0.85)"/>
              <text x="319" y="364" text-anchor="middle">JDBC</text>

              <rect x="552" y="350" width="58" height="20" rx="4" fill="rgba(10,14,23,0.85)"/>
              <text x="581" y="364" text-anchor="middle">AMQP</text>
            </g>

            <g transform="translate(35,565)" font-family="Inter, sans-serif">
              <rect x="0" y="0" width="160" height="40" rx="8" fill="#334155" stroke="#94a3b8" stroke-width="1.4"/>
              <text x="80" y="18" text-anchor="middle" font-size="13" font-weight="700" fill="#f1f5f9">Bramka płatności</text>
              <text x="80" y="33" text-anchor="middle" font-size="10" fill="#cbd5e1" letter-spacing="1">[EXT. SYSTEM]</text>
            </g>
            <g transform="translate(370,565)" font-family="Inter, sans-serif">
              <rect x="0" y="0" width="160" height="40" rx="8" fill="#334155" stroke="#94a3b8" stroke-width="1.4"/>
              <text x="80" y="18" text-anchor="middle" font-size="13" font-weight="700" fill="#f1f5f9">Usługa e-mail</text>
              <text x="80" y="33" text-anchor="middle" font-size="10" fill="#cbd5e1" letter-spacing="1">[EXT. SYSTEM]</text>
            </g>
            <g transform="translate(705,565)" font-family="Inter, sans-serif">
              <rect x="0" y="0" width="160" height="40" rx="8" fill="#334155" stroke="#94a3b8" stroke-width="1.4"/>
              <text x="80" y="18" text-anchor="middle" font-size="13" font-weight="700" fill="#f1f5f9">Kurier</text>
              <text x="80" y="33" text-anchor="middle" font-size="10" fill="#cbd5e1" letter-spacing="1">[EXT. SYSTEM]</text>
            </g>

            <g fill="none" stroke="#64748b" stroke-width="1.2" opacity="0.7" stroke-dasharray="4 4">
              <path d="M450 520 L115 562" marker-end="url(#arr-c2)"/>
              <path d="M450 520 L450 562" marker-end="url(#arr-c2)"/>
              <path d="M450 520 L785 562" marker-end="url(#arr-c2)"/>
            </g>
          </g>
        </svg>
      </div>

      <aside class="info-panel">
        <div class="info-row accent">
          <i class="ti ti-zoom-in-area"></i>
          <div>
            <div class="info-label">Zoom in</div>
            <div class="info-text">granica systemu z poziomu 1 staje się <strong>strukturą wewnętrzną</strong></div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1760px;
    padding: 70px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    text-align: center;
    margin-bottom: 32px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 72px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: 48px;
    width: 100%;
    align-items: stretch;
  }

  .diagram-wrap {
    background: rgba(17, 24, 39, 0.5);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.15);
    border-radius: 22px;
    padding: 22px 28px;
    opacity: 0;
    transform: translateY(22px);
    animation: fadeUp 0.9s ease-out 0.45s forwards;
  }

  .diagram-wrap svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .info-panel {
    display: flex;
    flex-direction: column;
    gap: 22px;
    text-align: left;
    padding: 8px 0;
  }

  .question {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 28px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.4);
    border-radius: 18px;
    font-size: 26px;
    font-weight: 400;
    color: #e2e8f0;
    line-height: 1.3;
    opacity: 0;
    animation: fadeUp 0.75s ease-out 0.55s forwards;
  }

  .question i {
    font-size: 36px;
    color: var(--cyan-400);
    flex: 0 0 auto;
  }

  .question strong {
    color: var(--cyan-400);
    font-weight: 700;
  }

  .info-row {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    padding: 20px 24px;
    background: rgba(17, 24, 39, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.12);
    border-radius: 16px;
    opacity: 0;
    transform: translateY(18px);
    animation: fadeUp 0.7s ease-out forwards;
  }

  .info-row:nth-of-type(2) { animation-delay: 0.7s; }
  .info-row:nth-of-type(3) { animation-delay: 0.85s; }
  .info-row:nth-of-type(4) { animation-delay: 1.0s; }

  .info-row i {
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    background: rgba(34, 211, 238, 0.15);
    color: var(--cyan-400);
    border: 1px solid rgba(34, 211, 238, 0.3);
  }

  .info-row.pos i {
    background: rgba(34, 197, 94, 0.14);
    color: #86efac;
    border-color: rgba(34, 197, 94, 0.35);
  }

  .info-row.accent {
    background: linear-gradient(120deg, rgba(34, 211, 238, 0.10), rgba(17, 24, 39, 0.55) 60%);
    border-color: rgba(34, 211, 238, 0.4);
  }

  .info-row strong {
    color: var(--cyan-400);
    font-weight: 700;
  }

  .info-label {
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #94a3b8;
    margin-bottom: 4px;
  }

  .info-text {
    font-size: 22px;
    font-weight: 400;
    line-height: 1.4;
    color: #e2e8f0;
  }
</style>
