---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 07 - Poziom 1: System Context"
  bgImage="/images/background-1.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="header">
      <span class="level-chip"><i class="ti ti-zoom-out"></i> Poziom 1</span>
      <h1 class="title">
        System <span class="highlight">Context</span>
      </h1>
    </div>

    <div class="layout">
      <div class="diagram-wrap">
        <svg viewBox="0 0 900 620" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <marker id="arr-c" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M 0 0 L 10 5 L 0 10 z" fill="#94a3b8"/>
            </marker>
            <linearGradient id="sys-grad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#0891b2"/>
              <stop offset="100%" stop-color="#0e7490"/>
            </linearGradient>
            <filter id="soft-glow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="10" result="blur"/>
              <feMerge>
                <feMergeNode in="blur"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>
          </defs>

          <g font-family="Inter, sans-serif">
            <g transform="translate(90,30)">
              <circle cx="55" cy="40" r="28" fill="#1e40af" stroke="#60a5fa" stroke-width="2"/>
              <rect x="20" y="72" width="70" height="50" rx="14" fill="#1e40af" stroke="#60a5fa" stroke-width="2"/>
              <text x="55" y="148" text-anchor="middle" font-size="22" font-weight="700" fill="#dbeafe">Klient</text>
              <text x="55" y="172" text-anchor="middle" font-size="14" fill="#93c5fd">[Person]</text>
              <text x="55" y="194" text-anchor="middle" font-size="13" fill="#cbd5e1">Przegląda, kupuje</text>
            </g>

            <g transform="translate(720,30)">
              <circle cx="55" cy="40" r="28" fill="#1e40af" stroke="#60a5fa" stroke-width="2"/>
              <rect x="20" y="72" width="70" height="50" rx="14" fill="#1e40af" stroke="#60a5fa" stroke-width="2"/>
              <text x="55" y="148" text-anchor="middle" font-size="22" font-weight="700" fill="#dbeafe">Operator</text>
              <text x="55" y="172" text-anchor="middle" font-size="14" fill="#93c5fd">[Person]</text>
              <text x="55" y="194" text-anchor="middle" font-size="13" fill="#cbd5e1">Zarządza zamówieniami</text>
            </g>

            <g transform="translate(290,250)" filter="url(#soft-glow)">
              <rect x="0" y="0" width="320" height="170" rx="20" fill="url(#sys-grad)" stroke="#22d3ee" stroke-width="2.5"/>
              <text x="160" y="60" text-anchor="middle" font-size="32" font-weight="800" fill="#ffffff" letter-spacing="-0.5">Sklep online</text>
              <text x="160" y="92" text-anchor="middle" font-size="15" fill="#a5f3fc" font-weight="600" letter-spacing="2">[SOFTWARE SYSTEM]</text>
              <text x="160" y="128" text-anchor="middle" font-size="16" font-weight="300" fill="#e0f2fe">Pozwala klientom kupować</text>
              <text x="160" y="148" text-anchor="middle" font-size="16" font-weight="300" fill="#e0f2fe">produkty online</text>
            </g>

            <g transform="translate(40,470)">
              <rect x="0" y="0" width="200" height="120" rx="14" fill="#334155" stroke="#94a3b8" stroke-width="1.8"/>
              <text x="100" y="38" text-anchor="middle" font-size="22" font-weight="700" fill="#f1f5f9">Bramka płatności</text>
              <text x="100" y="62" text-anchor="middle" font-size="13" fill="#cbd5e1" letter-spacing="1.5">[EXTERNAL SYSTEM]</text>
              <text x="100" y="92" text-anchor="middle" font-size="14" font-weight="300" fill="#e2e8f0">Realizuje płatności</text>
              <text x="100" y="110" text-anchor="middle" font-size="14" font-weight="300" fill="#e2e8f0">kartą i BLIK-iem</text>
            </g>

            <g transform="translate(350,470)">
              <rect x="0" y="0" width="200" height="120" rx="14" fill="#334155" stroke="#94a3b8" stroke-width="1.8"/>
              <text x="100" y="38" text-anchor="middle" font-size="22" font-weight="700" fill="#f1f5f9">Usługa e-mail</text>
              <text x="100" y="62" text-anchor="middle" font-size="13" fill="#cbd5e1" letter-spacing="1.5">[EXTERNAL SYSTEM]</text>
              <text x="100" y="92" text-anchor="middle" font-size="14" font-weight="300" fill="#e2e8f0">Wysyła powiadomienia</text>
              <text x="100" y="110" text-anchor="middle" font-size="14" font-weight="300" fill="#e2e8f0">transakcyjne</text>
            </g>

            <g transform="translate(660,470)">
              <rect x="0" y="0" width="200" height="120" rx="14" fill="#334155" stroke="#94a3b8" stroke-width="1.8"/>
              <text x="100" y="38" text-anchor="middle" font-size="22" font-weight="700" fill="#f1f5f9">Kurier</text>
              <text x="100" y="62" text-anchor="middle" font-size="13" fill="#cbd5e1" letter-spacing="1.5">[EXTERNAL SYSTEM]</text>
              <text x="100" y="92" text-anchor="middle" font-size="14" font-weight="300" fill="#e2e8f0">Obsługuje dostawę</text>
              <text x="100" y="110" text-anchor="middle" font-size="14" font-weight="300" fill="#e2e8f0">zamówień</text>
            </g>

            <g fill="none" stroke="#94a3b8" stroke-width="1.6" opacity="0.85">
              <path d="M200 200 C 260 220, 290 240, 320 270" marker-end="url(#arr-c)"/>
              <path d="M720 200 C 660 220, 630 240, 600 270" marker-end="url(#arr-c)"/>
              <path d="M360 425 C 320 460, 260 470, 220 470" marker-end="url(#arr-c)"/>
              <path d="M450 425 L450 465" marker-end="url(#arr-c)"/>
              <path d="M540 425 C 580 460, 640 470, 680 470" marker-end="url(#arr-c)"/>
            </g>

            <g font-family="Inter, sans-serif" font-size="13" fill="#22d3ee" font-weight="600">
              <text x="220" y="247">Używa [HTTPS]</text>
              <text x="635" y="247" text-anchor="end">Używa [HTTPS]</text>
              <text x="270" y="455">Płatność</text>
              <text x="460" y="455" text-anchor="start">Wysyła e-mail</text>
              <text x="600" y="455">Zleca dostawę</text>
            </g>
          </g>
        </svg>
      </div>
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1760px;
    padding: 70px 3rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    text-align: center;
    margin-bottom: 36px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  .level-chip i { font-size: 18px; }

  .title {
    font-size: 72px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: 48px;
    width: 100%;
    align-items: stretch;
  }

  .diagram-wrap {
    background: rgba(17, 24, 39, 0.5);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.15);
    border-radius: 22px;
    padding: 22px 28px;
    opacity: 0;
    transform: translateY(22px);
    animation: fadeUp 0.9s ease-out 0.45s forwards;
  }

  .diagram-wrap svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .info-panel {
    display: flex;
    flex-direction: column;
    gap: 22px;
    text-align: left;
    padding: 8px 0;
  }

  .question {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 28px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.4);
    border-radius: 18px;
    font-size: 26px;
    font-weight: 400;
    color: #e2e8f0;
    line-height: 1.3;
    opacity: 0;
    animation: fadeUp 0.75s ease-out 0.55s forwards;
  }

  .question i {
    font-size: 36px;
    color: var(--cyan-400);
    flex: 0 0 auto;
  }

  .question strong {
    color: var(--cyan-400);
    font-weight: 700;
  }

  .info-row {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    padding: 20px 24px;
    background: rgba(17, 24, 39, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.12);
    border-radius: 16px;
    opacity: 0;
    transform: translateY(18px);
    animation: fadeUp 0.7s ease-out forwards;
  }

  .info-row:nth-of-type(2) { animation-delay: 0.7s; }
  .info-row:nth-of-type(3) { animation-delay: 0.85s; }
  .info-row:nth-of-type(4) { animation-delay: 1.0s; }

  .info-row i {
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    background: rgba(34, 211, 238, 0.15);
    color: var(--cyan-400);
    border: 1px solid rgba(34, 211, 238, 0.3);
  }

  .info-row.neg i {
    background: rgba(239, 68, 68, 0.14);
    color: #fca5a5;
    border-color: rgba(239, 68, 68, 0.35);
  }

  .info-row.pos i {
    background: rgba(34, 197, 94, 0.14);
    color: #86efac;
    border-color: rgba(34, 197, 94, 0.35);
  }

  .info-label {
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #94a3b8;
    margin-bottom: 4px;
  }

  .info-text {
    font-size: 22px;
    font-weight: 400;
    line-height: 1.4;
    color: #e2e8f0;
  }
</style>
