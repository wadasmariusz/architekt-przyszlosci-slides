---
import SlideLayout from '../../../layouts/SlideLayout.astro';
import { Image } from 'astro:assets';
import c4ContainersImg from './images/c4 -contianers.png';
---
<SlideLayout
  title="Slide 04 - Przykład — system sprzedażowy"
  bgImage="/images/background-4.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="header">
      <span class="eyebrow"><i class="ti ti-vocabulary"></i>Container · Level 2</span>
      <h1 class="title">
        Przykład
      </h1>
    </div>

    <div class="diagram">
      <Image
        class="diagram-img"
        src={c4ContainersImg}
        alt="Diagram kontenerów — uproszczony system sprzedażowy"
        loading="eager"
      />
    </div>

  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1740px;
    padding: 50px 2.5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 28px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 16px;
  }

  .eyebrow i { font-size: 18px; }

  .title {
    font-size: 72px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 12px;
    color: #f8fafc;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    font-size: 22px;
    font-weight: 300;
    color: #cbd5e1;
    margin: 0;
  }

  .diagram {
    position: relative;
    width: 100%;
    max-height: 720px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 24px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.4s forwards;
  }

  .diagram-img {
    width: 100%;
    height: auto;
    max-height: 720px;
    object-fit: contain;
    border-radius: 16px;
    background: rgba(17, 24, 39, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.22);
    box-shadow: 0 18px 48px rgba(2, 6, 23, 0.45);
    padding: 18px;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    justify-content: center;
    padding: 14px 28px;
    background: rgba(17, 24, 39, 0.45);
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 14px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 1.5s forwards;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 500;
    color: #cbd5e1;
  }

  .swatch {
    display: inline-block;
    width: 22px;
    height: 22px;
    border-radius: 6px;
  }

  .swatch.internal {
    background: rgba(17, 24, 39, 0.78);
    border: 1px solid rgba(34, 211, 238, 0.55);
  }

  .swatch.external-swatch {
    background: rgba(15, 23, 42, 0.72);
    border: 1px dashed rgba(148, 163, 184, 0.55);
  }

  .line-sample {
    display: inline-block;
    width: 34px;
    height: 2px;
    background: rgba(34, 211, 238, 0.7);
    border-radius: 2px;
  }

  .line-sample.dashed {
    background: transparent;
    border-top: 2px dashed rgba(148, 163, 184, 0.7);
    height: 0;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
</style>
