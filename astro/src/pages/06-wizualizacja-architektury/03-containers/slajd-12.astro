---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 12 - Test jednego zdania"
  bgImage="/images/background-6.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.82), rgba(10,14,23,0.92))"
>
  <div class="content">
    <h1 class="title">Test jednego zdania</h1>

    <main class="statement">
      <p class="example">
        <strong>Orders API</strong> — obsługuje składanie i śledzenie zamówień,
        publikuje zdarzenia domenowe po zmianie statusu, zapisuje dane w bazie
        zamówień.
      </p>

      <p class="note">
        Jeśli nie potrafisz tego napisać — cofnij się i przemyśl podział.
      </p>
    </main>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: center;
  }

  .content {
    width: 100%;
    max-width: 1440px;
    min-height: 820px;
    padding: 76px 4rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .title {
    margin: 0;
    color: #f8fafc;
    font-size: 68px;
    font-weight: 700;
    line-height: 1.08;
  }

  .statement {
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-bottom: 86px;
  }

  .example {
    max-width: 1190px;
    margin: 0;
    color: #f8fafc;
    font-size: 42px;
    font-weight: 300;
    line-height: 1.38;
  }

  .example strong {
    color: var(--cyan-400);
    font-weight: 700;
  }

  .note {
    max-width: 960px;
    margin: 72px 0 0;
    color: #cbd5e1;
    font-size: 30px;
    font-weight: 300;
    line-height: 1.35;
  }
</style>
