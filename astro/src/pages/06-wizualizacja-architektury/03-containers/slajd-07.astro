---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 07 - Komunikacja między kontenerami"
  bgImage="/images/background-1.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="header">
      <span class="eyebrow"><i class="ti ti-vocabulary"></i>Container · Level 2</span>
      <h1 class="title">
        Komunikacja <span class="highlight">między kontenerami</span>
      </h1>
    </div>

    <div class="relations">
      <div class="relation" style="--delay: 0.4s;">
        <div class="rel-flow">
          <div class="box source">
            <i class="ti ti-browser"></i>
            <div>
              <h4>Aplikacja webowa</h4>
              <span class="tech">[React SPA]</span>
            </div>
          </div>
          <div class="connector">
            <span class="protocol">HTTPS / REST</span>
            <div class="arrow-line">
              <span class="line"></span>
              <i class="ti ti-chevron-right tip"></i>
            </div>
            <span class="action">wywołuje API</span>
          </div>
          <div class="box target">
            <i class="ti ti-cloud-cog"></i>
            <div>
              <h4>Backend API</h4>
              <span class="tech">[ASP.NET Core]</span>
            </div>
          </div>
        </div>
      </div>

      <div class="relation" style="--delay: 0.6s;">
        <div class="rel-flow">
          <div class="box source">
            <i class="ti ti-cloud-cog"></i>
            <div>
              <h4>Backend API</h4>
              <span class="tech">[ASP.NET Core]</span>
            </div>
          </div>
          <div class="connector">
            <span class="protocol">Entity Framework Core</span>
            <div class="arrow-line">
              <span class="line"></span>
              <i class="ti ti-chevron-right tip"></i>
            </div>
            <span class="action">zapisuje dane</span>
          </div>
          <div class="box target">
            <i class="ti ti-database"></i>
            <div>
              <h4>Baza danych</h4>
              <span class="tech">[PostgreSQL]</span>
            </div>
          </div>
        </div>
      </div>

      <div class="relation" style="--delay: 0.8s;">
        <div class="rel-flow">
          <div class="box source">
            <i class="ti ti-shopping-cart"></i>
            <div>
              <h4>Serwis zamówień</h4>
              <span class="tech">[.NET Worker]</span>
            </div>
          </div>
          <div class="connector">
            <span class="protocol event">event: OrderPlaced</span>
            <div class="arrow-line">
              <span class="line dashed"></span>
              <i class="ti ti-chevron-right tip"></i>
            </div>
            <span class="action">publikuje zdarzenie</span>
          </div>
          <div class="box target">
            <i class="ti ti-messages"></i>
            <div>
              <h4>Broker wiadomości</h4>
              <span class="tech">[RabbitMQ]</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1740px;
    padding: 60px 2.5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 44px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 22px;
  }

  .eyebrow i { font-size: 18px; }

  .title {
    font-size: 70px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 24px;
    color: #f8fafc;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .principle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 12px 28px;
    background: rgba(17, 24, 39, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 999px;
    margin: 0;
    font-size: 18px;
    font-weight: 400;
    color: #cbd5e1;
    letter-spacing: 0.5px;
  }

  .principle strong {
    font-weight: 700;
    color: #f1f5f9;
  }

  .principle i {
    color: var(--cyan-400);
    font-size: 22px;
  }

  .relations {
    display: flex;
    flex-direction: column;
    gap: 26px;
    width: 100%;
    margin-bottom: 32px;
  }

  .relation {
    padding: 24px 28px;
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 22px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.85s ease-out forwards;
    animation-delay: var(--delay, 0.4s);
  }

  .rel-flow {
    display: grid;
    grid-template-columns: 1fr 1.4fr 1fr;
    align-items: center;
    gap: 18px;
  }

  .box {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 22px;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(34, 211, 238, 0.45);
    border-radius: 16px;
    text-align: left;
  }

  .box i {
    flex: 0 0 auto;
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.4);
    color: var(--cyan-400);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
  }

  .box h4 {
    margin: 0 0 2px;
    font-size: 20px;
    font-weight: 700;
    color: #f1f5f9;
    letter-spacing: -0.2px;
    line-height: 1.1;
  }

  .box .tech {
    font-size: 13px;
    font-weight: 600;
    color: var(--cyan-400);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: 0.3px;
  }

  .connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 0 12px;
  }

  .protocol {
    display: inline-block;
    padding: 6px 14px;
    background: rgba(34, 211, 238, 0.14);
    border: 1px solid rgba(34, 211, 238, 0.5);
    border-radius: 999px;
    color: var(--cyan-400);
    font-size: 14px;
    font-weight: 700;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: 0.4px;
  }

  .protocol.event {
    background: rgba(168, 85, 247, 0.12);
    border-color: rgba(168, 85, 247, 0.5);
    color: #c084fc;
  }

  .arrow-line {
    position: relative;
    width: 100%;
    height: 18px;
    display: flex;
    align-items: center;
  }

  .arrow-line .line {
    flex: 1;
    height: 2px;
    background: linear-gradient(90deg, rgba(34, 211, 238, 0.2), rgba(34, 211, 238, 0.85));
    border-radius: 2px;
  }

  .arrow-line .line.dashed {
    background: none;
    border-top: 2px dashed rgba(168, 85, 247, 0.7);
    height: 0;
  }

  .arrow-line .tip {
    font-size: 26px;
    color: var(--cyan-400);
    margin-left: -6px;
    filter: drop-shadow(0 0 8px rgba(34, 211, 238, 0.55));
  }

  .relation:nth-child(3) .arrow-line .tip {
    color: #c084fc;
    filter: drop-shadow(0 0 8px rgba(168, 85, 247, 0.55));
  }

  .action {
    font-size: 13px;
    font-weight: 500;
    color: #94a3b8;
    font-style: italic;
    letter-spacing: 0.3px;
  }

  .hint {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 16px 28px;
    background: rgba(34, 211, 238, 0.08);
    border: 1px solid rgba(34, 211, 238, 0.3);
    border-radius: 999px;
    font-size: 19px;
    font-weight: 400;
    color: #e2e8f0;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.05s forwards;
  }

  .hint i {
    font-size: 24px;
    color: var(--cyan-400);
  }

  .hint strong {
    font-weight: 700;
    color: var(--cyan-400);
  }
</style>
