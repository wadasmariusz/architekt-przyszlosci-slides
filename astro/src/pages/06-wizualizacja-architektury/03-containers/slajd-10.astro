---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 10 - Granica systemu"
  bgImage="/images/background-4.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="header">
      <span class="eyebrow"><i class="ti ti-fence"></i> System boundary</span>
      <h1 class="title">
        <span class="highlight">Granica</span> systemu
      </h1>
      <p class="subtitle">Co należy do naszego systemu, a co jest poza nim?</p>
    </div>

    <div class="board">
      <svg class="links" viewBox="0 0 1600 720" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 z" fill="rgba(34, 211, 238, 0.8)" />
          </marker>
          <marker id="arr-ext" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 z" fill="rgba(251, 191, 36, 0.85)" />
          </marker>
        </defs>

        <line x1="1100" y1="180" x2="1370" y2="120" stroke="rgba(251, 191, 36, 0.7)" stroke-width="2" stroke-dasharray="6 5" marker-end="url(#arr-ext)" />
        <text x="1235" y="135" fill="#fbbf24" font-size="16" text-anchor="middle">HTTPS · Stripe API</text>

        <line x1="1100" y1="380" x2="1370" y2="380" stroke="rgba(251, 191, 36, 0.7)" stroke-width="2" stroke-dasharray="6 5" marker-end="url(#arr-ext)" />
        <text x="1235" y="365" fill="#fbbf24" font-size="16" text-anchor="middle">OAuth 2.0</text>

        <line x1="1100" y1="560" x2="1370" y2="630" stroke="rgba(251, 191, 36, 0.7)" stroke-width="2" stroke-dasharray="6 5" marker-end="url(#arr-ext)" />
        <text x="1235" y="615" fill="#fbbf24" font-size="16" text-anchor="middle">SMTP / API</text>

        <line x1="430" y1="300" x2="710" y2="300" stroke="rgba(34, 211, 238, 0.65)" stroke-width="2" marker-end="url(#arr)" />
        <text x="570" y="285" fill="#cbd5e1" font-size="16" text-anchor="middle">SQL</text>

        <line x1="280" y1="240" x2="280" y2="430" stroke="rgba(34, 211, 238, 0.65)" stroke-width="2" marker-end="url(#arr)" />
        <text x="298" y="345" fill="#cbd5e1" font-size="16" text-anchor="start">publish</text>
      </svg>

      <div class="boundary">
        <span class="boundary-label">
          <i class="ti ti-fence"></i> system boundary — nasz system
        </span>

        <div class="node spa">
          <i class="ti ti-browser"></i>
          <div>
            <h4>Aplikacja webowa</h4>
            <span class="tech">[React SPA]</span>
          </div>
        </div>

        <div class="node api">
          <i class="ti ti-cloud-cog"></i>
          <div>
            <h4>Backend API</h4>
            <span class="tech">[ASP.NET Core]</span>
          </div>
        </div>

        <div class="node db">
          <i class="ti ti-database"></i>
          <div>
            <h4>Baza danych</h4>
            <span class="tech">[PostgreSQL]</span>
          </div>
        </div>

        <div class="node queue">
          <i class="ti ti-messages"></i>
          <div>
            <h4>Kolejka</h4>
            <span class="tech">[RabbitMQ]</span>
          </div>
        </div>
      </div>

      <div class="externals">
        <span class="ext-label">
          <i class="ti ti-world"></i> systemy zewnętrzne
        </span>

        <div class="ext-node payments">
          <i class="ti ti-credit-card"></i>
          <div>
            <h4>System płatności</h4>
            <span class="tech">[Stripe]</span>
          </div>
        </div>

        <div class="ext-node auth">
          <i class="ti ti-shield-lock"></i>
          <div>
            <h4>Usługa autoryzacyjna</h4>
            <span class="tech">[Auth0]</span>
          </div>
        </div>

        <div class="ext-node mail">
          <i class="ti ti-mail"></i>
          <div>
            <h4>Dostawca poczty</h4>
            <span class="tech">[SendGrid]</span>
          </div>
        </div>
      </div>
    </div>

    <div class="legend">
      <div class="legend-item">
        <span class="swatch internal"></span>
        <span>kontenery w naszym systemie</span>
      </div>
      <div class="legend-item">
        <span class="swatch external"></span>
        <span>systemy zewnętrzne — inny kolor, przerywana ramka</span>
      </div>
      <div class="legend-item">
        <span class="line internal-line"></span>
        <span>komunikacja wewnętrzna</span>
      </div>
      <div class="legend-item">
        <span class="line external-line"></span>
        <span>integracja zewnętrzna z opisanym protokołem</span>
      </div>
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1740px;
    padding: 50px 2.5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 28px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 16px;
  }

  .eyebrow i { font-size: 18px; }

  .title {
    font-size: 64px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 12px;
    color: #f8fafc;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    font-size: 20px;
    font-weight: 300;
    color: #cbd5e1;
    margin: 0;
  }

  .board {
    position: relative;
    width: 100%;
    height: 720px;
    margin-bottom: 24px;
  }

  .links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1s ease-out 1.4s forwards;
  }

  .boundary {
    position: absolute;
    top: 40px;
    left: 0;
    width: 70%;
    height: 600px;
    border: 2px solid rgba(34, 211, 238, 0.55);
    border-radius: 26px;
    background:
      radial-gradient(circle at 30% 20%, rgba(34, 211, 238, 0.08), transparent 65%),
      rgba(15, 23, 42, 0.4);
    box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.18), 0 22px 80px rgba(8, 145, 178, 0.22);
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.85s ease-out 0.4s forwards;
  }

  .boundary-label {
    position: absolute;
    top: -16px;
    left: 30px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px;
    background: rgba(15, 23, 42, 0.95);
    border: 1px solid rgba(34, 211, 238, 0.55);
    border-radius: 999px;
    color: var(--cyan-400);
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2.5px;
  }

  .boundary-label i { font-size: 16px; }

  .externals {
    position: absolute;
    top: 40px;
    right: 0;
    width: 26%;
    height: 600px;
    border: 2px dashed rgba(251, 191, 36, 0.5);
    border-radius: 26px;
    background:
      radial-gradient(circle at 70% 30%, rgba(251, 191, 36, 0.05), transparent 65%),
      rgba(15, 23, 42, 0.3);
    padding: 30px 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.85s ease-out 0.7s forwards;
  }

  .ext-label {
    position: absolute;
    top: -16px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px;
    background: rgba(15, 23, 42, 0.95);
    border: 1px dashed rgba(251, 191, 36, 0.55);
    border-radius: 999px;
    color: #fbbf24;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2.5px;
    white-space: nowrap;
  }

  .ext-label i { font-size: 16px; }

  .node {
    position: absolute;
    width: 300px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 22px;
    background: rgba(17, 24, 39, 0.92);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(34, 211, 238, 0.5);
    border-radius: 16px;
    text-align: left;
    box-shadow: 0 10px 30px rgba(2, 6, 23, 0.4);
    opacity: 0;
    animation: fadeUp 0.7s ease-out forwards;
  }

  .node i {
    flex: 0 0 auto;
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.4);
    color: var(--cyan-400);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
  }

  .node h4 {
    margin: 0 0 2px;
    font-size: 19px;
    font-weight: 700;
    color: #f1f5f9;
    line-height: 1.1;
    letter-spacing: -0.2px;
  }

  .node .tech {
    font-size: 13px;
    font-weight: 600;
    color: var(--cyan-400);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }

  .node.spa   { top: 80px;  left: 60px;  animation-delay: 0.55s; }
  .node.api   { top: 80px;  left: 700px; animation-delay: 0.7s; }
  .node.db    { top: 410px; left: 700px; animation-delay: 0.85s; }
  .node.queue { top: 410px; left: 60px;  animation-delay: 1.0s; }

  .ext-node {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    background: rgba(15, 23, 42, 0.85);
    border: 1px dashed rgba(251, 191, 36, 0.55);
    border-radius: 14px;
    text-align: left;
    opacity: 0;
    transform: translateX(20px);
    animation: fadeUpRight 0.7s ease-out forwards;
  }

  .ext-node i {
    flex: 0 0 auto;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: rgba(251, 191, 36, 0.1);
    border: 1px solid rgba(251, 191, 36, 0.4);
    color: #fbbf24;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
  }

  .ext-node h4 {
    margin: 0 0 2px;
    font-size: 17px;
    font-weight: 700;
    color: #f1f5f9;
    line-height: 1.1;
  }

  .ext-node .tech {
    font-size: 12px;
    font-weight: 600;
    color: #fbbf24;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }

  .ext-node.payments { animation-delay: 0.85s; }
  .ext-node.auth     { animation-delay: 1.0s; }
  .ext-node.mail     { animation-delay: 1.15s; }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    justify-content: center;
    padding: 14px 28px;
    background: rgba(17, 24, 39, 0.5);
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 14px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 1.5s forwards;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14.5px;
    font-weight: 500;
    color: #cbd5e1;
  }

  .swatch {
    width: 22px;
    height: 22px;
    border-radius: 6px;
  }

  .swatch.internal {
    background: rgba(17, 24, 39, 0.92);
    border: 1px solid rgba(34, 211, 238, 0.55);
  }

  .swatch.external {
    background: rgba(15, 23, 42, 0.85);
    border: 1px dashed rgba(251, 191, 36, 0.55);
  }

  .line {
    width: 36px;
    height: 2px;
    border-radius: 2px;
  }

  .line.internal-line {
    background: rgba(34, 211, 238, 0.75);
  }

  .line.external-line {
    background: transparent;
    border-top: 2px dashed rgba(251, 191, 36, 0.75);
    height: 0;
  }

  @keyframes fadeUpRight {
    from { opacity: 0; transform: translateX(20px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
</style>
