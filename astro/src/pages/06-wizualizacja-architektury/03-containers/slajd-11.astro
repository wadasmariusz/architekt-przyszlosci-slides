---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 11 - Anty-wzorzec: przeładowany diagram"
  bgImage="/images/background-5.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="header">
      <span class="eyebrow"><i class="ti ti-alert-triangle"></i> Anty-wzorzec</span>
      <h1 class="title">
        Diagram od <span class="highlight bad-glow">wszystkiego</span>
      </h1>
      <p class="subtitle">Łatwo jest dorzucić „jeszcze jeden szczegół". Trudniej — utrzymać czytelność.</p>
    </div>

    <div class="compare">
      <article class="diagram-card good">
        <header>
          <span class="tag good-tag"><i class="ti ti-check"></i> Właściwy poziom abstrakcji</span>
        </header>
        <div class="canvas">
          <div class="block-clean b1">SPA</div>
          <div class="block-clean b2">API</div>
          <div class="block-clean b3">Worker</div>
          <div class="block-clean b4">DB</div>
          <div class="block-clean b5">Queue</div>
          <div class="block-clean b6">Cache</div>
          <svg class="wires-clean" viewBox="0 0 400 240" preserveAspectRatio="none">
            <line x1="70" y1="50" x2="200" y2="50" stroke="rgba(34, 211, 238, 0.7)" stroke-width="2"/>
            <line x1="200" y1="70" x2="200" y2="180" stroke="rgba(34, 211, 238, 0.7)" stroke-width="2"/>
            <line x1="220" y1="50" x2="350" y2="50" stroke="rgba(34, 211, 238, 0.7)" stroke-width="2"/>
            <line x1="200" y1="180" x2="70" y2="180" stroke="rgba(34, 211, 238, 0.7)" stroke-width="2"/>
            <line x1="220" y1="180" x2="350" y2="180" stroke="rgba(34, 211, 238, 0.7)" stroke-width="2"/>
          </svg>
        </div>
        <p class="card-note">5–7 kontenerów, jasne relacje, jednoznaczne etykiety.</p>
      </article>

      <article class="diagram-card bad">
        <header>
          <span class="tag bad-tag"><i class="ti ti-x"></i> Diagram od wszystkiego</span>
        </header>
        <div class="canvas chaos">
          <div class="mess m1">SPA</div>
          <div class="mess m2">API</div>
          <div class="mess m3">Worker</div>
          <div class="mess m4">DB</div>
          <div class="mess m5">Queue</div>
          <div class="mess m6">Cache</div>
          <div class="chip c1">/orders</div>
          <div class="chip c2">/users</div>
          <div class="chip c3">/payments</div>
          <div class="chip c4">orders_table</div>
          <div class="chip c5">users_table</div>
          <div class="chip c6">LB</div>
          <div class="chip c7">replica-1</div>
          <div class="chip c8">replica-2</div>
          <div class="chip c9">node-A</div>
          <div class="chip c10">node-B</div>
          <div class="chip c11">k8s pod</div>
          <div class="chip c12">OrderSvc</div>
          <div class="chip c13">PaymentSvc</div>
          <svg class="wires-chaos" viewBox="0 0 400 240" preserveAspectRatio="none">
            <line x1="40" y1="30" x2="180" y2="80" stroke="rgba(248, 113, 113, 0.4)" stroke-width="1"/>
            <line x1="180" y1="80" x2="320" y2="40" stroke="rgba(248, 113, 113, 0.4)" stroke-width="1"/>
            <line x1="50" y1="120" x2="200" y2="150" stroke="rgba(248, 113, 113, 0.4)" stroke-width="1"/>
            <line x1="200" y1="150" x2="350" y2="120" stroke="rgba(248, 113, 113, 0.4)" stroke-width="1"/>
            <line x1="80" y1="200" x2="280" y2="180" stroke="rgba(248, 113, 113, 0.4)" stroke-width="1"/>
            <line x1="150" y1="40" x2="350" y2="220" stroke="rgba(248, 113, 113, 0.4)" stroke-width="1"/>
            <line x1="30" y1="180" x2="380" y2="60" stroke="rgba(248, 113, 113, 0.4)" stroke-width="1"/>
            <line x1="120" y1="100" x2="300" y2="200" stroke="rgba(248, 113, 113, 0.4)" stroke-width="1"/>
          </svg>
        </div>
        <p class="card-note">Endpointy, tabele, repliki, pody — chaos zamiast architektury.</p>
      </article>
    </div>

    <div class="exclusions">
      <span class="exclusions-label">
        <i class="ti ti-circle-x"></i> Co <strong>NIE</strong> należy do Container Diagram:
      </span>
      <div class="exclusions-grid">
        <div class="excl">
          <div class="excl-from">
            <i class="ti ti-api"></i>
            <span>endpointy i klasy serwisowe</span>
          </div>
          <i class="ti ti-arrow-narrow-right excl-arrow"></i>
          <div class="excl-to">
            <span class="lvl">Component · L3</span>
          </div>
        </div>
        <div class="excl">
          <div class="excl-from">
            <i class="ti ti-table"></i>
            <span>tabele bazy danych</span>
          </div>
          <i class="ti ti-arrow-narrow-right excl-arrow"></i>
          <div class="excl-to">
            <span class="lvl">Component / Code · L3–L4</span>
          </div>
        </div>
        <div class="excl">
          <div class="excl-from">
            <i class="ti ti-server-2"></i>
            <span>LB, repliki, nody klastra</span>
          </div>
          <i class="ti ti-arrow-narrow-right excl-arrow"></i>
          <div class="excl-to">
            <span class="lvl">widok Deployment</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1740px;
    padding: 50px 2.5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 28px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(248, 113, 113, 0.1);
    border: 1px solid rgba(248, 113, 113, 0.4);
    color: #f87171;
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 16px;
  }

  .eyebrow i { font-size: 18px; }

  .title {
    font-size: 66px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 12px;
    color: #f8fafc;
  }

  .title .bad-glow {
    background: linear-gradient(135deg, #f87171, #ef4444);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    font-size: 20px;
    font-weight: 300;
    color: #cbd5e1;
    margin: 0;
  }

  .compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    width: 100%;
    margin-bottom: 32px;
  }

  .diagram-card {
    position: relative;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 22px;
    padding: 22px 24px 24px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 18px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.85s ease-out forwards;
  }

  .diagram-card.good {
    animation-delay: 0.4s;
    border-color: rgba(34, 211, 238, 0.45);
    box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.12), 0 16px 50px rgba(8, 145, 178, 0.18);
  }

  .diagram-card.bad {
    animation-delay: 0.55s;
    border-color: rgba(248, 113, 113, 0.45);
    box-shadow: 0 0 0 1px rgba(248, 113, 113, 0.12), 0 16px 50px rgba(127, 29, 29, 0.18);
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2.5px;
  }

  .tag i { font-size: 16px; }

  .good-tag {
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.45);
    color: var(--cyan-400);
  }

  .bad-tag {
    background: rgba(248, 113, 113, 0.12);
    border: 1px solid rgba(248, 113, 113, 0.45);
    color: #f87171;
  }

  .canvas {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background:
      linear-gradient(180deg, rgba(15, 23, 42, 0.55), rgba(2, 6, 23, 0.55)),
      repeating-linear-gradient(0deg, rgba(148, 163, 184, 0.05) 0 1px, transparent 1px 28px),
      repeating-linear-gradient(90deg, rgba(148, 163, 184, 0.05) 0 1px, transparent 1px 28px);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 14px;
    overflow: hidden;
  }

  .wires-clean, .wires-chaos {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Clean blocks */
  .block-clean {
    position: absolute;
    padding: 10px 16px;
    background: rgba(17, 24, 39, 0.92);
    border: 1.5px solid rgba(34, 211, 238, 0.55);
    border-radius: 10px;
    font-size: 16px;
    font-weight: 700;
    color: #f1f5f9;
    letter-spacing: 0.3px;
  }

  .b1 { top: 12%;  left: 8%; }
  .b2 { top: 12%;  left: 44%; }
  .b3 { top: 12%;  right: 8%; }
  .b4 { bottom: 12%; left: 8%; }
  .b5 { bottom: 12%; left: 44%; }
  .b6 { bottom: 12%; right: 8%; }

  /* Chaos */
  .canvas.chaos {
    background:
      linear-gradient(180deg, rgba(45, 15, 15, 0.4), rgba(2, 6, 23, 0.6)),
      repeating-linear-gradient(0deg, rgba(148, 163, 184, 0.05) 0 1px, transparent 1px 28px),
      repeating-linear-gradient(90deg, rgba(148, 163, 184, 0.05) 0 1px, transparent 1px 28px);
    border-color: rgba(248, 113, 113, 0.3);
  }

  .mess {
    position: absolute;
    padding: 6px 10px;
    background: rgba(17, 24, 39, 0.85);
    border: 1.5px solid rgba(248, 113, 113, 0.5);
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    color: #f1f5f9;
  }

  .m1 { top: 8%;  left: 6%; }
  .m2 { top: 10%; left: 40%; }
  .m3 { top: 6%;  right: 7%; }
  .m4 { bottom: 10%; left: 5%; }
  .m5 { bottom: 14%; left: 42%; }
  .m6 { bottom: 8%;  right: 5%; }

  .chip {
    position: absolute;
    padding: 3px 8px;
    background: rgba(248, 113, 113, 0.08);
    border: 1px dashed rgba(248, 113, 113, 0.4);
    border-radius: 6px;
    font-size: 10px;
    font-weight: 600;
    color: #fca5a5;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: 0.2px;
  }

  .c1  { top: 26%; left: 18%; }
  .c2  { top: 22%; left: 35%; }
  .c3  { top: 28%; left: 58%; }
  .c4  { top: 48%; left: 12%; }
  .c5  { top: 52%; left: 30%; }
  .c6  { top: 38%; right: 24%; }
  .c7  { top: 50%; right: 8%; }
  .c8  { bottom: 28%; right: 22%; }
  .c9  { bottom: 36%; left: 25%; }
  .c10 { bottom: 42%; left: 55%; }
  .c11 { top: 44%; left: 48%; }
  .c12 { top: 60%; right: 38%; }
  .c13 { bottom: 22%; left: 22%; }

  .card-note {
    margin: 0;
    font-size: 16px;
    font-weight: 300;
    line-height: 1.5;
    color: #cbd5e1;
  }

  .exclusions {
    width: 100%;
    padding: 24px 28px;
    background: rgba(17, 24, 39, 0.55);
    border: 1px solid rgba(248, 113, 113, 0.3);
    border-radius: 18px;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 0.85s forwards;
  }

  .exclusions-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 700;
    color: #f87171;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 18px;
  }

  .exclusions-label i { font-size: 22px; }
  .exclusions-label strong {
    color: #fff;
    font-weight: 800;
    background: rgba(248, 113, 113, 0.2);
    padding: 0 6px;
    border-radius: 4px;
  }

  .exclusions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .excl {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 12px;
  }

  .excl-from {
    display: flex;
    align-items: center;
    gap: 10px;
    text-align: left;
  }

  .excl-from i {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: rgba(248, 113, 113, 0.1);
    border: 1px solid rgba(248, 113, 113, 0.35);
    color: #f87171;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex: 0 0 auto;
  }

  .excl-from span {
    font-size: 14px;
    font-weight: 600;
    color: #e2e8f0;
    line-height: 1.25;
  }

  .excl-arrow {
    color: rgba(148, 163, 184, 0.7);
    font-size: 22px;
  }

  .excl-to {
    text-align: right;
  }

  .excl-to .lvl {
    display: inline-block;
    padding: 6px 12px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.4);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
    color: var(--cyan-400);
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }
</style>
