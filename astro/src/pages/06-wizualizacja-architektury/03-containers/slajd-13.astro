---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 13 - Czy diagram spełnia swoją rolę?"
  bgImage="/images/background-1.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="header">
      <span class="eyebrow"><i class="ti ti-checklist"></i> Checklista weryfikacyjna</span>
      <h1 class="title">
        Czy diagram <span class="highlight">spełnia swoją rolę?</span>
      </h1>
    </div>

    <div class="checklist">
      <div class="check-item" style="--delay: 0.35s;">
        <div class="check-icon"><i class="ti ti-brain"></i></div>
        <div class="check-body">
          <h3>Gdzie jest logika biznesowa?</h3>
          <p>Który kontener trzyma reguły i przepływy domenowe?</p>
        </div>
      </div>

      <div class="check-item" style="--delay: 0.5s;">
        <div class="check-icon"><i class="ti ti-database"></i></div>
        <div class="check-body">
          <h3>Gdzie są dane?</h3>
          <p>Jedna baza czy wiele? Jaka technologia trwałości?</p>
        </div>
      </div>

      <div class="check-item" style="--delay: 0.65s;">
        <div class="check-icon"><i class="ti ti-plug-connected"></i></div>
        <div class="check-body">
          <h3>Z czym integruje się system?</h3>
          <p>Jakie systemy zewnętrzne i przez jakie protokoły?</p>
        </div>
      </div>

      <div class="check-item" style="--delay: 0.8s;">
        <div class="check-icon"><i class="ti ti-affiliate"></i></div>
        <div class="check-body">
          <h3>Które elementy są od siebie zależne?</h3>
          <p>Co rozmawia z czym, w jakim kierunku, synchronicznie czy asynchronicznie?</p>
        </div>
      </div>

      <div class="check-item span-full" style="--delay: 0.95s;">
        <div class="check-icon"><i class="ti ti-tools"></i></div>
        <div class="check-body">
          <h3>Jakie decyzje technologiczne zostały podjęte?</h3>
          <p>Stack uruchomieniowy każdego kontenera.</p>
        </div>
      </div>
    </div>

  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1740px;
    padding: 50px 2.5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 32px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 18px;
  }

  .eyebrow i { font-size: 18px; }

  .title {
    font-size: 64px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 14px;
    color: #f8fafc;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    font-size: 20px;
    font-weight: 300;
    color: #cbd5e1;
    margin: 0;
  }

  .checklist {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    width: 100%;
    margin-bottom: 32px;
  }

  .check-item {
    position: relative;
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: 26px;
    padding: 24px 30px;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(34, 211, 238, 0.3);
    border-radius: 18px;
    text-align: left;
    opacity: 0;
    transform: translateY(18px);
    animation: fadeUp 0.75s ease-out forwards;
    animation-delay: var(--delay, 0.4s);
  }

  .check-item.span-full {
    grid-column: auto;
  }

  .check-num {
    font-size: 38px;
    font-weight: 800;
    color: rgba(34, 211, 238, 0.5);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: -1px;
    line-height: 1;
  }

  .check-icon {
    width: 60px;
    height: 60px;
    border-radius: 14px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.4);
    color: var(--cyan-400);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    flex: 0 0 auto;
  }

  .check-body h3 {
    margin: 0 0 6px;
    font-size: 30px;
    font-weight: 700;
    color: #f1f5f9;
    letter-spacing: -0.2px;
    line-height: 1.2;
  }

  .check-body p {
    margin: 0;
    font-size: 21px;
    font-weight: 300;
    line-height: 1.45;
    color: #cbd5e1;
  }

  .verdicts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    width: 100%;
  }

  .verdict {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 22px 26px;
    border-radius: 18px;
    text-align: left;
    opacity: 0;
    transform: translateY(18px);
    animation: fadeUp 0.85s ease-out forwards;
  }

  .verdict.good {
    background: rgba(34, 211, 238, 0.08);
    border: 1px solid rgba(34, 211, 238, 0.4);
    box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.1), 0 12px 36px rgba(8, 145, 178, 0.18);
    animation-delay: 1.15s;
  }

  .verdict.bad {
    background: rgba(248, 113, 113, 0.06);
    border: 1px dashed rgba(248, 113, 113, 0.45);
    animation-delay: 1.3s;
  }

  .v-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    flex: 0 0 auto;
  }

  .verdict.good .v-icon {
    background: rgba(34, 211, 238, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.5);
    color: var(--cyan-400);
  }

  .verdict.bad .v-icon {
    background: rgba(248, 113, 113, 0.1);
    border: 1px solid rgba(248, 113, 113, 0.4);
    color: #f87171;
  }

  .verdict strong {
    display: block;
    font-size: 22px;
    font-weight: 800;
    color: #f8fafc;
    letter-spacing: -0.2px;
    line-height: 1.15;
    margin-bottom: 4px;
  }

  .verdict.good strong { color: var(--cyan-400); }
  .verdict.bad strong  { color: #f87171; }

  .verdict span {
    display: block;
    font-size: 16px;
    font-weight: 300;
    line-height: 1.45;
    color: #cbd5e1;
  }

  .verdict em {
    font-style: normal;
    font-weight: 700;
    color: #f1f5f9;
  }
</style>
