---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 09 - Container Diagram a styl architektoniczny"
  bgImage="/images/background-3.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="header">
      <span class="eyebrow"><i class="ti ti-vocabulary"></i>Container · Level 2</span>
      <h1 class="title">
        Container Diagram a <span class="highlight">styl architektoniczny</span>
      </h1>
      <p class="subtitle">Container Diagram zależy od stylu, w jakim zbudowany jest system.</p>
    </div>
    
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1740px;
    padding: 50px 2.5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 30px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 18px;
  }

  .eyebrow i { font-size: 18px; }

  .title {
    font-size: 78px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 12px;
    color: #f8fafc;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    font-size: 20px;
    font-weight: 300;
    color: #cbd5e1;
    margin: 0;
  }

  .styles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    width: 100%;
    margin-bottom: 32px;
  }

  .style-card {
    position: relative;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 22px;
    padding: 28px 26px 30px;
    text-align: left;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.85s ease-out forwards;
    animation-delay: var(--delay, 0.4s);
    overflow: hidden;
  }

  .style-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--cyan-400), transparent);
    opacity: 0.7;
  }

  .style-card header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 22px;
  }

  .style-card header i {
    width: 50px;
    height: 50px;
    border-radius: 14px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.4);
    color: var(--cyan-400);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
  }

  .style-card header h3 {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    color: #f1f5f9;
    letter-spacing: -0.2px;
  }

  .diagram {
    flex: 1;
    background: rgba(15, 23, 42, 0.5);
    border: 1px dashed rgba(148, 163, 184, 0.25);
    border-radius: 14px;
    padding: 18px;
    margin-bottom: 18px;
    min-height: 230px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
  }

  /* Monolit */
  .monolith {
    border: 2px solid rgba(34, 211, 238, 0.5);
    border-radius: 14px;
    padding: 18px 16px 14px;
    background: rgba(34, 211, 238, 0.04);
    position: relative;
  }

  .m-label {
    display: block;
    text-align: center;
    font-size: 12px;
    font-weight: 800;
    color: var(--cyan-400);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 12px;
  }

  .modules {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .mod {
    padding: 8px 10px;
    background: rgba(17, 24, 39, 0.85);
    border: 1px solid rgba(148, 163, 184, 0.3);
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #e2e8f0;
    text-align: center;
  }

  /* Mikroserwisy */
  .micro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .micro-pair {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .svc {
    padding: 8px 10px;
    background: rgba(17, 24, 39, 0.9);
    border: 1.5px solid rgba(34, 211, 238, 0.5);
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    color: #f1f5f9;
    text-align: center;
  }

  .svc-db {
    padding: 5px 8px;
    background: rgba(15, 23, 42, 0.85);
    border: 1px dashed rgba(148, 163, 184, 0.4);
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    color: #94a3b8;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }

  .svc-db i { font-size: 13px; color: var(--cyan-400); }

  .bus {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 8px 12px;
    background: rgba(168, 85, 247, 0.1);
    border: 1px dashed rgba(168, 85, 247, 0.5);
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
    color: #c084fc;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }

  .bus i { font-size: 14px; }

  /* Clean Architecture */
  .clean-block {
    border: 2px solid rgba(34, 211, 238, 0.5);
    border-radius: 14px;
    padding: 18px 16px 14px;
    background: rgba(34, 211, 238, 0.04);
  }

  .layers {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .layer {
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
    color: #e2e8f0;
    text-align: center;
    border: 1px solid rgba(148, 163, 184, 0.3);
  }

  .layer.l1 { background: rgba(34, 211, 238, 0.18); color: var(--cyan-400); border-color: rgba(34, 211, 238, 0.4); }
  .layer.l2 { background: rgba(34, 211, 238, 0.12); color: #67e8f9; border-color: rgba(34, 211, 238, 0.3); }
  .layer.l3 { background: rgba(17, 24, 39, 0.7); }
  .layer.l4 { background: rgba(17, 24, 39, 0.7); }

  .extras {
    display: flex;
    justify-content: center;
  }

  .ext-box {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgba(15, 23, 42, 0.85);
    border: 1px dashed rgba(148, 163, 184, 0.4);
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    color: #cbd5e1;
  }

  .ext-box i { font-size: 16px; color: var(--cyan-400); }

  .style-card p {
    margin: 0;
    font-size: 17px;
    font-weight: 300;
    line-height: 1.45;
    color: #cbd5e1;
  }

  .style-card p strong {
    font-weight: 700;
    color: #f1f5f9;
  }

  .key-note {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 18px 32px;
    background: rgba(34, 211, 238, 0.08);
    border: 1px solid rgba(34, 211, 238, 0.4);
    border-radius: 18px;
    font-size: 19px;
    font-weight: 400;
    color: #e2e8f0;
    line-height: 1.4;
    opacity: 0;
    animation: fadeUp 0.9s ease-out 1.1s forwards;
    max-width: 1500px;
  }

  .key-note i {
    flex: 0 0 auto;
    font-size: 28px;
    color: var(--cyan-400);
  }

  .key-note .strike {
    font-weight: 700;
    color: #94a3b8;
    text-decoration: line-through;
    text-decoration-color: rgba(248, 113, 113, 0.7);
    text-decoration-thickness: 2px;
  }

  .key-note .emph {
    font-weight: 700;
    color: var(--cyan-400);
  }
</style>
