---
import SlideLayout from '../../../layouts/SlideLayout.astro';
---
<SlideLayout
  title="Slide 14 - Podsumowanie — C4 Container Level"
  bgImage="/images/background-2.jpg"
  bgOverlay="linear-gradient(rgba(10,14,23,0.78), rgba(10,14,23,0.9))"
>
  <div class="content">
    <div class="header">
      <span class="eyebrow"><i class="ti ti-vocabulary"></i>Container · Level 2</span>
      <h1 class="title">
        Podsumowanie
      </h1>
    </div>

    <div class="grid">
      <article class="takeaway" style="--delay: 0.35s;">
        <div class="t-icon"><i class="ti ti-stack-2"></i></div>
        <h3>Co pokazuje</h3>
        <p>Aplikacje, bazy, kolejki, procesy, integracje — klocki, z których zbudowany jest system.</p>
      </article>

      <article class="takeaway" style="--delay: 0.55s;">
        <div class="t-icon"><i class="ti ti-list-details"></i></div>
        <h3>Każdy element</h3>
        <p><strong>Nazwa</strong> + <strong>technologia</strong> + <strong>odpowiedzialność</strong> — bez tego diagram jest tylko szkicem.</p>
      </article>

      <article class="takeaway" style="--delay: 0.65s;">
        <div class="t-icon"><i class="ti ti-route"></i></div>
        <h3>Relacje</h3>
        <p><strong>Kto</strong> → <strong>z kim</strong> → <strong>czym</strong> → <strong>w jakim kierunku</strong>. Każda strzałka opisana.</p>
      </article>

      <article class="takeaway" style="--delay: 0.75s;">
        <div class="t-icon"><i class="ti ti-fence"></i></div>
        <h3>Granica systemu</h3>
        <p>Jasne rozróżnienie <strong>nasze</strong> vs. <strong>zewnętrzne</strong> — inny kolor, inna ramka.</p>
      </article>
    </div>
    
  </div>
</SlideLayout>

<style is:global>
  .stage {
    justify-content: flex-start;
  }

  .content {
    max-width: 1740px;
    padding: 60px 2.5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .header {
    margin-bottom: 40px;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 0.15s forwards;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: var(--cyan-400);
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 18px;
  }

  .eyebrow i { font-size: 18px; }

  .title {
    font-size: 82px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.05;
    margin: 0 0 14px;
    color: #f8fafc;
  }

  .title .highlight {
    background: linear-gradient(135deg, var(--cyan-400), var(--cyan-600));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    font-size: 22px;
    font-weight: 300;
    color: #cbd5e1;
    margin: 0;
    font-style: italic;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    width: 100%;
    margin-bottom: 36px;
  }

  .takeaway {
    position: relative;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 20px;
    padding: 28px 28px 26px;
    text-align: left;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.85s ease-out forwards;
    animation-delay: var(--delay, 0.4s);
    overflow: hidden;
  }

  .takeaway::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--cyan-400), transparent);
    opacity: 0.7;
  }

  .t-icon {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.4);
    color: var(--cyan-400);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    margin-bottom: 18px;
  }

  .takeaway h3 {
    margin: 0 0 10px;
    font-size: 24px;
    font-weight: 700;
    color: #f1f5f9;
    letter-spacing: -0.2px;
    line-height: 1.15;
  }

  .takeaway p {
    margin: 0;
    font-size: 17px;
    font-weight: 300;
    line-height: 1.5;
    color: #cbd5e1;
  }

  .takeaway p strong {
    font-weight: 700;
    color: #f8fafc;
  }

  .closing {
    width: 100%;
    max-width: 1500px;
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 28px 36px;
    background:
      linear-gradient(135deg, rgba(34, 211, 238, 0.1), rgba(8, 145, 178, 0.05)),
      rgba(17, 24, 39, 0.65);
    border: 1px solid rgba(34, 211, 238, 0.5);
    border-radius: 22px;
    box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.15), 0 22px 60px rgba(8, 145, 178, 0.22);
    text-align: left;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.9s ease-out 1.1s forwards;
  }

  .closing-mark {
    flex: 0 0 auto;
    width: 76px;
    height: 76px;
    border-radius: 22px;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.22), rgba(8, 145, 178, 0.15));
    border: 1px solid rgba(34, 211, 238, 0.5);
    color: var(--cyan-400);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 42px;
    box-shadow: 0 0 28px rgba(34, 211, 238, 0.3);
  }

  .closing-label {
    display: inline-block;
    margin-bottom: 6px;
    padding: 4px 14px;
    background: rgba(34, 211, 238, 0.15);
    border: 1px solid rgba(34, 211, 238, 0.5);
    border-radius: 999px;
    color: var(--cyan-400);
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 3px;
  }

  .closing p {
    margin: 0;
    font-size: 26px;
    font-weight: 400;
    line-height: 1.4;
    color: #f1f5f9;
    letter-spacing: -0.1px;
  }

  .closing p strong {
    font-weight: 800;
    color: var(--cyan-400);
  }
</style>
